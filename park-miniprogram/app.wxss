page {
  background: #f5f6f8;
  color: #1f2329;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "Microsoft YaHei", sans-serif;
}

.wrap {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(31, 35, 41, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.muted {
  color: #8a8f99;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grow {
  flex: 1;
}

.field {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.field:last-child {
  border-bottom: 0;
}

.field-label {
  width: 180rpx;
  color: #646a73;
  font-size: 26rpx;
}

.field-value {
  flex: 1;
  text-align: right;
}

.input {
  height: 80rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.btn {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: #3370ff;
  color: #ffffff;
  font-size: 30rpx;
  text-align: center;
  margin-top: 24rpx;
}

.btn.ghost {
  background: #eef2ff;
  color: #3370ff;
}

.btn.danger {
  background: #fff1f0;
  color: #d4380d;
}

.btn.small {
  display: inline-block;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  margin: 0 12rpx 0 0;
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #3370ff;
  font-size: 22rpx;
}

.tag.green {
  background: #e8f8ef;
  color: #0f9d58;
}

.tag.orange {
  background: #fff7e6;
  color: #d97706;
}

.tag.red {
  background: #fff1f0;
  color: #d4380d;
}

.tag.gray {
  background: #f2f3f5;
  color: #8a8f99;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #8a8f99;
}

.pass-code {
  font-size: 56rpx;
  letter-spacing: 8rpx;
  font-weight: 700;
  color: #3370ff;
  text-align: center;
  padding: 24rpx 0;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.quick {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
}

.quick-icon {
  display: block;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.message {
  max-width: 78%;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.message.visitor {
  margin-left: auto;
  background: #3370ff;
  color: #ffffff;
}

.message.agent,
.message.ai,
.message.system {
  margin-right: auto;
  background: #ffffff;
  color: #1f2329;
}
