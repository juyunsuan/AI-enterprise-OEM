<view class="wrap" wx:if="{{activity}}">
  <view class="card">
    <view class="row">
      <view class="section-title">{{activity.title}}</view>
      <text class="tag">{{activity.statusLabel}}</text>
    </view>
    <view class="muted">{{activity.startAt}} → {{activity.endAt}}</view>
    <view class="muted" wx:if="{{activity.location}}">地点：{{activity.location}}</view>
    <view class="muted">已报名 {{activity.signupCount}} 人{{activity.capacity > 0 ? ' / ' + activity.capacity : ''}}</view>
    <view wx:if="{{activity.signupDeadline}}" class="muted">报名截止：{{activity.signupDeadline}}</view>
    <view wx:if="{{activity.summary}}" class="tag orange" style="margin-top: 12rpx;">{{activity.summary}}</view>
  </view>

  <view class="card" wx:if="{{signup && signup.status === 'SIGNED'}}">
    <view class="section-title">你已报名</view>
    <view class="muted">{{signup.name}} · {{signup.phone}}</view>
    <view class="btn danger" bindtap="cancel">取消报名</view>
  </view>

  <view class="card" wx:else>
    <view class="section-title">报名</view>
    <view class="field">
      <view class="field-label">姓名</view>
      <input class="input grow" data-field="name" value="{{name}}" bindinput="onInput" placeholder="姓名" />
    </view>
    <view class="field">
      <view class="field-label">手机号</view>
      <input class="input grow" data-field="phone" value="{{phone}}" bindinput="onInput" placeholder="手机号" />
    </view>
    <textarea class="textarea" data-field="note" bindinput="onInput" placeholder="备注（选填）"></textarea>
    <view class="btn" bindtap="signup">{{submitting ? "提交中…" : "提交报名"}}</view>
  </view>

  <view class="card" wx:if="{{activity.content}}">
    <view class="section-title">活动详情</view>
    <view class="muted">{{activity.content}}</view>
  </view>
</view>
<view wx:else class="empty">加载中…</view>
