<view class="wrap">
  <view class="card">
    <view class="field">
      <view class="field-label">问题类型</view>
      <picker class="field-value" mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view>{{categories[categoryIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">紧急程度</view>
      <picker class="field-value" mode="selector" range="{{urgency}}" value="{{urgencyIndex}}" bindchange="onUrgencyChange">
        <view>{{urgency[urgencyIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">位置</view>
      <input class="input grow" data-field="location" bindinput="onInput" placeholder="楼宇/房间/公共区域" />
    </view>
    <view class="field">
      <view class="field-label">标题</view>
      <input class="input grow" data-field="title" bindinput="onInput" placeholder="一句话描述问题" />
    </view>
  </view>

  <view class="card">
    <view class="section-title">详细描述</view>
    <textarea class="textarea" data-field="description" bindinput="onInput" placeholder="可填写故障现象、影响范围、期望上门时间等"></textarea>
    <view class="section-title" style="margin-top: 16rpx;">现场图片</view>
    <view class="quick-grid">
      <view wx:for="{{images}}" wx:key="*this" class="quick" data-index="{{index}}" bindtap="removeImage">
        <image src="{{item}}" mode="aspectFill" style="width: 100%; height: 120rpx; border-radius: 8rpx;" />
      </view>
      <view wx:if="{{images.length < 9}}" class="quick" bindtap="chooseImages">＋ 添加</view>
    </view>
  </view>

  <view class="btn" bindtap="submit">{{submitting ? "提交中…" : "提交工单"}}</view>
  <view class="btn ghost" bindtap="goList">查看我的工单</view>
</view>
