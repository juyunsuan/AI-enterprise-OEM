<view class="wrap">
  <view class="card">
    <view class="section-title">申请停车许可</view>
    <view class="field">
      <view class="field-label">车牌号</view>
      <input class="input grow" data-field="plateNo" value="{{plateNo}}" bindinput="onInput" placeholder="京A12345" />
    </view>
    <view class="field">
      <view class="field-label">车型</view>
      <picker class="field-value" mode="selector" range="{{vehicleTypes}}" value="{{vehicleIndex}}" bindchange="onVehicle">
        <view>{{vehicleTypes[vehicleIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">有效期起</view>
      <picker class="field-value" mode="date" value="{{validFrom}}" data-field="validFrom" bindchange="onPicker"><view>{{validFrom || "选填"}}</view></picker>
    </view>
    <view class="field">
      <view class="field-label">有效期止</view>
      <picker class="field-value" mode="date" value="{{validTo}}" data-field="validTo" bindchange="onPicker"><view>{{validTo || "选填"}}</view></picker>
    </view>
    <textarea class="textarea" data-field="note" bindinput="onInput" placeholder="备注（选填）"></textarea>
    <view class="btn" bindtap="submit">{{submitting ? "提交中…" : "提交申请"}}</view>
  </view>

  <view wx:if="{{!list.length && !loading}}" class="empty">暂无停车许可。</view>
  <view wx:for="{{list}}" wx:key="id" class="card">
    <view class="row">
      <view class="section-title">{{item.plateNo}}</view>
      <text class="tag">{{item.statusLabel}}</text>
    </view>
    <view class="muted">{{item.vehicleTypeLabel}} · {{item.validFrom || "-"}} ~ {{item.validTo || "-"}}</view>
  </view>
</view>
