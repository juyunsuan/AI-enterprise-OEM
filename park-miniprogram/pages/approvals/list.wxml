<view class="wrap">
  <view wx:if="{{!list.length && !loading}}" class="empty">暂无待你审批的申请。</view>
  <view wx:for="{{list}}" wx:key="id" class="card">
    <view class="row">
      <view class="section-title">{{item.title}}</view>
      <text class="tag orange">{{item.bizLabel}}</text>
    </view>
    <view class="muted">{{item.applicantName}} · {{item.nodeName}} · {{item.createdAt}}</view>
    <view class="row" style="margin-top: 12rpx;">
      <view></view>
      <view>
        <text class="btn small" data-id="{{item.id}}" data-action="approve" bindtap="act">通过</text>
        <text class="btn small danger" data-id="{{item.id}}" data-action="reject" bindtap="act">驳回</text>
      </view>
    </view>
  </view>
</view>
