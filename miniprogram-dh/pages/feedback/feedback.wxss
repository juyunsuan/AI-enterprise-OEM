.contact {
  margin-top: 20rpx;
}

.images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.image-box {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 12rpx;
  background: #f5f6f8;
  overflow: hidden;
}

.image {
  width: 100%;
  height: 100%;
}

.add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #b6bbc4;
  border: 2rpx dashed #d5d8de;
}

.remove {
  position: absolute;
  right: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 0 0 0 12rpx;
}

.submit {
  margin-top: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 30rpx;
}

.submit.disabled {
  opacity: 0.6;
}
