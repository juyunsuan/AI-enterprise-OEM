<view class="page" style="{{themeStyle}}">
  <view class="card">
    <view class="balance-row">
      <text>可提现佣金</text>
      <text class="balance">{{balanceText}}</text>
    </view>
    <view class="muted small">最低提现 {{minWithdrawText}}，提交后佣金冻结，审核通过后打款。</view>

    <view class="field">
      <text class="label">提现金额（元）</text>
      <input class="input" type="digit" value="{{amount}}" placeholder="请输入金额" bindinput="onAmount" />
    </view>

    <view class="chips">
      <view class="chip {{method === 'bank' ? 'on' : ''}}" data-method="bank" bindtap="switchMethod">银行卡</view>
      <view class="chip {{method === 'qrcode' ? 'on' : ''}}" data-method="qrcode" bindtap="switchMethod">收款码</view>
    </view>

    <block wx:if="{{method === 'bank'}}">
      <view class="field">
        <text class="label">收款人姓名</text>
        <input class="input" value="{{accountName}}" data-key="accountName" placeholder="与银行卡一致" bindinput="onField" />
      </view>
      <view class="field">
        <text class="label">银行卡号</text>
        <input class="input" type="number" value="{{accountNo}}" data-key="accountNo" placeholder="请输入银行卡号" bindinput="onField" />
      </view>
      <view class="field">
        <text class="label">开户银行</text>
        <input class="input" value="{{bankName}}" data-key="bankName" placeholder="如：招商银行深圳分行" bindinput="onField" />
      </view>
    </block>

    <block wx:else>
      <view class="qr-box" bindtap="uploadQr">
        <image wx:if="{{qrUrl}}" class="qr-img" src="{{qrUrl}}" mode="aspectFit" />
        <text wx:else class="muted">上传收款二维码</text>
      </view>
    </block>

    <view class="submit {{submitting ? 'disabled' : ''}}" bindtap="submit">
      {{submitting ? '提交中…' : '提交提现申请'}}
    </view>
  </view>

  <view class="card">
    <view class="card-title">提现记录</view>
    <view wx:if="{{!list.length}}" class="empty">暂无记录</view>
    <view wx:for="{{list}}" wx:key="id" class="line">
      <view>
        <view>{{item.amountText}} · {{item.methodText}}</view>
        <view class="muted small">{{item.createdAt}}</view>
        <view wx:if="{{item.rejectReason}}" class="reject">{{item.rejectReason}}</view>
      </view>
      <text class="tag {{item.statusText === '待处理' ? 'gray' : ''}}">{{item.statusText}}</text>
    </view>
  </view>
</view>
