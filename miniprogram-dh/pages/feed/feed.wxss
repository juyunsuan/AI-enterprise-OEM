.masonry {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx;
}

.masonry-item {
  width: 50%;
  padding: 12rpx;
  box-sizing: border-box;
}

.masonry-cover {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  background: #e8eaee;
}

.masonry-empty {
  line-height: 320rpx;
  text-align: center;
  color: #b6bbc4;
  font-size: 26rpx;
}

.masonry-title {
  margin-top: 12rpx;
  font-size: 28rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.masonry-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8f99;
}

.empty-btn {
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 24rpx auto 0;
  border-radius: 36rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 28rpx;
}
