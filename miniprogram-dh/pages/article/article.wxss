.head {
  padding: 32rpx 28rpx 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.4;
}

.time {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8a8f99;
}

.cover {
  width: 100%;
}

.body {
  padding: 24rpx 28rpx 60rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #2b3038;
  background: #ffffff;
}

.video {
  width: 100%;
  height: 420rpx;
}

.summary {
  font-size: 28rpx;
  color: #4e5561;
  line-height: 1.7;
}

.open-link {
  margin-top: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  background: var(--primary);
  color: #ffffff;
}
