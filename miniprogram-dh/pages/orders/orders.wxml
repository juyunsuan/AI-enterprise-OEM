<view class="page" style="{{themeStyle}}">
  <view wx:if="{{error}}" class="status-banner">{{error}}</view>

  <view wx:for="{{list}}" wx:key="id" class="card order">
    <view class="row between">
      <view class="order-name">{{item.packageName}}</view>
      <view class="tag {{item.paid ? '' : 'gray'}}">{{item.statusText}}</view>
    </view>
    <view class="order-no">订单号 {{item.orderNo}}</view>
    <view class="row between order-bottom">
      <view class="muted">{{item.createdAt}}</view>
      <view class="order-amount">{{item.amountText}}</view>
    </view>
  </view>

  <view wx:if="{{!loading && !list.length}}" class="empty">还没有订单</view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>
</view>
