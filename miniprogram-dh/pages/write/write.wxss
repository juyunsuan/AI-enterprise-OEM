.topics {
  margin-top: 24rpx;
}

.label {
  font-size: 26rpx;
  color: #4e5561;
  margin-bottom: 12rpx;
}

.slider {
  flex: 1;
  margin-left: 40rpx;
}

.generate {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 30rpx;
}

.generate.disabled {
  opacity: 0.6;
}

.result {
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.use {
  margin-top: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  border: 1rpx solid var(--primary);
  color: var(--primary);
  font-size: 28rpx;
}
