.hero {
  padding: 40rpx 32rpx 36rpx;
  background: var(--primary);
  color: #ffffff;
  border-radius: 0 0 36rpx 36rpx;
}

.hero-top {
  display: flex;
  align-items: center;
}

.hero-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  margin-right: 20rpx;
  background: rgba(255, 255, 255, 0.2);
}

.hero-name {
  font-size: 40rpx;
  font-weight: 600;
}

.hero-slogan {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.hero-gift {
  margin-top: 22rpx;
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
}

.hero-cta {
  margin-top: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: #ffffff;
  color: var(--primary);
  font-size: 32rpx;
  font-weight: 600;
}

.hero-assets {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.hero-assets text {
  margin-right: 24rpx;
  opacity: 0.9;
}

.hero-vip {
  padding: 2rpx 14rpx;
  border-radius: 18rpx;
  background: #ffd666;
  color: #7a4d00 !important;
  opacity: 1 !important;
}

.banner {
  margin: 24rpx 24rpx 0;
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.notice {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.notice-label {
  flex: none;
  margin-right: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #fff7e6;
  color: #ad6800;
  font-size: 22rpx;
}

.notice-swiper {
  flex: 1;
  height: 48rpx;
}

.notice-text {
  height: 48rpx;
  line-height: 48rpx;
  font-size: 26rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 12rpx 12rpx 0;
  padding: 8rpx 0;
}

.grid-item {
  width: 25%;
  padding: 20rpx 0;
  text-align: center;
}

.grid-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0 auto 10rpx;
  border-radius: 26rpx;
  background: #eef2ff;
  color: var(--primary);
  font-size: 34rpx;
  font-weight: 600;
}

.grid-title {
  font-size: 24rpx;
  color: #4e5561;
}

.feed-list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.feed-item {
  width: 33.33%;
  padding: 8rpx;
  box-sizing: border-box;
}

.feed-cover {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #e8eaee;
}

.feed-cover-empty {
  line-height: 200rpx;
  text-align: center;
  color: #b6bbc4;
  font-size: 24rpx;
}

.feed-title {
  margin-top: 10rpx;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.feed-meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8a8f99;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.diy-swiper {
  margin: 0 24rpx 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.diy-swiper-img {
  width: 100%;
  height: 100%;
}

.diy-images {
  margin: 0 24rpx 20rpx;
}

.diy-image {
  width: 100%;
  display: block;
  margin-bottom: 16rpx;
}

.diy-buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin: 0 24rpx 20rpx;
}

.diy-button {
  width: 48%;
  margin-bottom: 16rpx;
  overflow: hidden;
  background: #ffffff;
}

.diy-button-img {
  width: 100%;
  display: block;
}

.diy-button-text {
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  color: #333333;
  text-align: center;
}

.diy-title {
  margin: 0 24rpx 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
