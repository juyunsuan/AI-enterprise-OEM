<view class="container" wx:if="{{error}}">
  <view class="empty">{{error}}</view>
  <button class="primary-btn" bindtap="home">返回首页</button>
</view>

<block wx:elif="{{result}}">
  <view class="container">
    <view class="card result-hero">
      <view class="muted">{{bankTitle || '本次答题'}}</view>
      <view style="margin-top:10rpx;">
        <text class="score">{{result.score}}</text>
        <text class="score-unit">分</text>
      </view>
      <view style="margin-top:12rpx;">
        <text class="tag {{result.passed ? 'green' : 'red'}}">{{result.passed ? '已及格' : '未及格'}}</text>
        <text class="tag" style="margin-left:10rpx;">{{mode === 'exam' ? '考试' : '练习'}}</text>
      </view>
      <view class="result-grid">
        <view class="result-stat">
          <view class="value">{{result.correct}}/{{result.total}}</view>
          <view class="label">答对</view>
        </view>
        <view class="result-stat">
          <view class="value">{{result.wrongCount}}</view>
          <view class="label">错题</view>
        </view>
        <view class="result-stat">
          <view class="value">{{durationText}}</view>
          <view class="label">用时</view>
        </view>
        <view class="result-stat">
          <view class="value">{{result.rank || '—'}}</view>
          <view class="label">排名</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="between">
        <view class="subtitle">AI 错题复盘</view>
        <button class="mini-btn" bindtap="aiReview" loading="{{aiLoading}}">生成复盘</button>
      </view>
      <view class="muted" style="margin-top:8rpx;">
        根据本次错题给出薄弱点与复习建议，每次生成都走平台模型网关。
      </view>
      <view wx:if="{{aiText}}" class="analysis" style="margin-top:16rpx;">{{aiText}}</view>
    </view>

    <view class="card">
      <view class="subtitle">答题明细</view>
      <view wx:for="{{answers}}" wx:key="questionId" class="list-row" style="box-shadow:none;padding:18rpx 0;border-bottom:1rpx solid #f0f2f5;">
        <view class="between">
          <text class="tag {{item.correct ? 'green' : 'red'}}">{{item.correct ? '正确' : '错误'}}</text>
          <text class="muted">你的答案：{{item.yourAnswer}} · 正确：{{item.correctAnswer}}</text>
        </view>
        <view style="margin-top:8rpx;font-weight:600;">{{item.title}}</view>
        <view wx:if="{{item.analysis}}" class="muted" style="margin-top:6rpx;">{{item.analysis}}</view>
      </view>
    </view>

    <view class="bottom-space"></view>
  </view>

  <view class="bottom-bar">
    <button class="ghost-btn" bindtap="home">回首页</button>
    <button class="ghost-btn" bindtap="goWrong" wx:if="{{result.wrongCount}}">看错题</button>
    <button class="primary-btn" bindtap="again">再答一次</button>
  </view>
</block>