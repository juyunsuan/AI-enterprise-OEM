page {
  background: #f5f6f8;
  font-size: 28rpx;
  color: #1f2329;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.muted {
  color: #8a8f99;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.button-primary {
  background: #3370ff;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.button-ghost {
  background: #fff;
  color: #3370ff;
  border: 1rpx solid #3370ff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #8a8f99;
}

.page {
  padding-bottom: 40rpx;
}

.list-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.list-item:last-child {
  border-bottom: none;
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-title {
  flex: 1;
  margin-right: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  margin-top: 8rpx;
  color: #8a8f99;
  font-size: 24rpx;
  line-height: 1.6;
}

.price {
  color: #f54a45;
  font-weight: 600;
}

.tag {
  display: inline-block;
  padding: 2rpx 10rpx;
  margin-right: 8rpx;
  border-radius: 6rpx;
  background: #eef3ff;
  color: #3370ff;
  font-size: 22rpx;
}

.status {
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  background: #eef3ff;
  color: #3370ff;
  font-size: 22rpx;
}

.form-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.form-label {
  color: #5c6066;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.form-input {
  width: 100%;
  font-size: 30rpx;
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(31, 35, 41, 0.06);
}

.footer-bar button {
  flex: 1;
}

.cover {
  width: 180rpx;
  height: 130rpx;
  border-radius: 12rpx;
  background: #eef0f4;
}

.cover-large {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  background: #eef0f4;
}

.thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 10rpx;
  background: #eef0f4;
  margin-right: 12rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.actions button {
  flex: 1;
}
.quick {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx;
}

.quick-item {
  flex: 1;
  padding: 22rpx 20rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.quick-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.section {
  margin-top: 12rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 0;
}

.link {
  color: #3370ff;
}

.shop-phone {
  margin-top: 8rpx;
  color: #3370ff;
}

.item-card {
  display: flex;
  align-items: flex-start;
}

.item-main {
  flex: 1;
  margin-left: 16rpx;
}

.tags {
  margin-top: 8rpx;
}

.filter-bar {
  display: flex;
  white-space: nowrap;
  padding: 16rpx 24rpx 0;
}

.filter {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 28rpx;
  background: #fff;
  color: #5c6066;
  font-size: 26rpx;
}

.filter.active {
  background: #3370ff;
  color: #fff;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 24rpx;
}

.stat {
  width: calc(50% - 8rpx);
  padding: 26rpx 20rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.stat-value {
  font-size: 44rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.image-item {
  position: relative;
}

.image-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.notice-card {
  border-left: 6rpx solid #3370ff;
}

.notice-text {
  margin-top: 10rpx;
  line-height: 1.7;
  color: #5c6066;
}
