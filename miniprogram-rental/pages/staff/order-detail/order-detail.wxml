<view class="page">
  <view class="empty" wx:if="{{loading}}">正在读取租单…</view>
  <view class="empty" wx:elif="{{error}}">{{error}}</view>

  <block wx:elif="{{order}}">
    <view class="card">
      <view class="row">
        <text class="title">{{order.itemName}}</text>
        <text class="status">{{order.statusLabel}}</text>
      </view>
      <view class="muted" style="margin-top: 10rpx;">{{order.periodText}} · 共 {{order.days}} 天</view>
      <view class="muted" style="margin-top: 6rpx;">单号 {{order.orderNo}}</view>
    </view>

    <view class="card">
      <view class="row"><text class="muted">租车人</text><text>{{order.customerName || '未留姓名'}}</text></view>
      <view class="row" style="margin-top: 8rpx;" bindtap="callCustomer">
        <text class="muted">联系电话</text><text>{{order.customerPhone || '—'}}</text>
      </view>
      <view class="row" style="margin-top: 8rpx;"><text class="muted">租金 / 押金</text><text>{{order.rentText}} / {{order.depositText}}</text></view>
      <view class="row" style="margin-top: 8rpx;"><text class="muted">实付</text><text class="price">{{order.payText}}</text></view>
      <view class="row" style="margin-top: 8rpx;" wx:if="{{order.refundAmount > 0}}">
        <text class="muted">已退押金</text><text>{{order.refundText}}</text>
      </view>
      <view class="muted" style="margin-top: 10rpx;" wx:if="{{order.remark}}">备注：{{order.remark}}</view>
    </view>

    <view class="card" wx:if="{{attributes.length}}">
      <view class="title" style="font-size: 30rpx;">租品信息</view>
      <view class="tags" style="margin-top: 12rpx;">
        <text class="tag" wx:for="{{attributes}}" wx:key="key">{{item.key}}：{{item.value}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{order.inspections.length}}">
      <view class="title" style="font-size: 30rpx;">验车记录</view>
      <view class="list-item" wx:for="{{order.inspections}}" wx:key="id">
        <view class="row"><text>{{item.kindLabel}}</text><text class="muted">{{item.operatorName || '员工'}}</text></view>
        <view class="muted" style="margin-top: 6rpx;">里程 {{item.mileage}} km · 油量 {{item.fuelPercent}}%</view>
        <view class="muted" style="margin-top: 6rpx;" wx:if="{{item.damage}}">车况：{{item.damage}}</view>
        <view class="muted" style="margin-top: 6rpx;" wx:if="{{item.damageFee > 0}}">车损扣款：{{item.damageFee}} 元</view>
        <view class="tag-list" wx:if="{{item.images.length}}">
          <image class="thumb" wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill"></image>
        </view>
      </view>
    </view>

    <view class="footer-bar">
      <button class="button-primary" bindtap="goInspection" data-kind="HANDOVER" data-next="pickup" wx:if="{{order.status === 'PAID'}}">取车验车</button>
      <button class="button-primary" bindtap="goInspection" data-kind="RETURN" data-next="return" wx:if="{{order.status === 'PICKED_UP'}}">还回验车</button>
      <button class="button-primary" bindtap="act" data-action="complete" wx:if="{{order.status === 'RETURNED'}}" disabled="{{busy}}">结算并退押金</button>
      <button class="button-ghost" bindtap="act" data-action="cancel" wx:if="{{order.status === 'PENDING_PAYMENT' || order.status === 'PAID'}}" disabled="{{busy}}">取消订单</button>
    </view>
  </block>
</view>