.article-title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 50rpx;
}

.article-meta {
  margin-top: 12rpx;
  gap: 16rpx;
}

.summary {
  margin-top: 16rpx;
  line-height: 38rpx;
}

.article-body {
  font-size: 28rpx;
  line-height: 48rpx;
  word-break: break-all;
}

.article-image {
  width: 100%;
  margin-top: 16rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
}
