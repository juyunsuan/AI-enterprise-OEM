.gallery {
  width: 100%;
  height: 620rpx;
  background: #e9ebef;
}

.gallery-img {
  width: 100%;
  height: 620rpx;
}

.price-lg {
  font-size: 44rpx;
}

.goods-title {
  margin: 12rpx 0 8rpx;
}

.tags {
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tier-row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.step-value {
  min-width: 90rpx;
  text-align: center;
  font-size: 30rpx;
}

.rich {
  font-size: 26rpx;
  line-height: 44rpx;
  color: var(--text);
  word-break: break-all;
}

.bottom-space {
  height: 160rpx;
}

.foot-action {
  padding: 0 24rpx;
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
}

.buy-btn {
  margin-left: 16rpx;
}

.lock-card {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.lock-input {
  margin-top: 8rpx;
}
