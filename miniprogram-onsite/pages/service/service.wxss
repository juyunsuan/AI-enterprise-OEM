.page {
  padding-bottom: 40rpx;
}

.search {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 24rpx;
}

.search-input {
  flex: 1;
  height: 68rpx;
  padding: 0 20rpx;
  background: #f5f6f8;
  border-radius: 34rpx;
  font-size: 28rpx;
}

.search-placeholder {
  color: #b7bcc4;
}

.search-btn {
  margin-left: 20rpx;
  color: #3370ff;
  font-size: 28rpx;
}

.search-clear {
  margin-left: 20rpx;
  color: #8a8f99;
  font-size: 26rpx;
}

.summary {
  padding: 16rpx 24rpx 0;
}

.link {
  color: #3370ff;
  margin-top: 16rpx;
}

.svc {
  display: flex;
  padding: 20rpx;
}

.svc-cover {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #f0f2f5;
}

.svc-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.svc-title {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.svc-subtitle {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tags {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  color: #3370ff;
  background: #eef3ff;
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
  margin: 0 10rpx 8rpx 0;
}

.svc-foot {
  margin-top: auto;
  display: flex;
  align-items: baseline;
}

.price {
  color: #f5413d;
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.price-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #8a8f99;
}

.svc-foot .muted {
  margin-right: 16rpx;
}

.more {
  text-align: center;
  padding: 24rpx 0 8rpx;
}
