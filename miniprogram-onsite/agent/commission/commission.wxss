.tabs {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 24rpx 0;
}

.list {
  padding-bottom: 40rpx;
}

.item {
  margin-top: 16rpx;
}

.order-no {
  font-size: 30rpx;
  font-weight: 600;
}

.bottom {
  margin-top: 10rpx;
}

.hint {
  margin-top: 8rpx;
}

.footer {
  padding: 24rpx 0;
  text-align: center;
}

.error {
  margin: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: #fdecec;
  color: #d93026;
  font-size: 26rpx;
  line-height: 1.6;
}
