<view class="page">
  <view class="error" wx:if="{{errorText}}">{{errorText}}</view>

  <view class="loading" wx:if="{{loading}}">正在合成海报…</view>

  <block wx:if="{{!loading && imagePath}}">
    <image class="preview" src="{{imagePath}}" mode="widthFix" bindtap="preview" />
    <view class="muted tip">点击图片可放大预览；保存后可直接发朋友圈或转发给顾客。</view>
    <view class="actions">
      <button class="btn ghost" bindtap="preview">预览</button>
      <button class="btn primary" loading="{{saving}}" bindtap="save">保存到相册</button>
    </view>
  </block>

  <view class="loading" wx:if="{{!loading && !imagePath && !errorText}}">
    海报还没有生成，请下拉刷新重试。
  </view>

  <canvas
    canvas-id="poster"
    class="poster-canvas"
    style="width: 750px; height: 1180px;"
  ></canvas>
</view>
