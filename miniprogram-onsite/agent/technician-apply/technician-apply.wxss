.page {
  padding-bottom: 80rpx;
}

.notice {
  margin: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #eef4ff;
  color: #2b4d8f;
  font-size: 24rpx;
  line-height: 1.6;
}

.form {
  padding: 8rpx 24rpx;
}

.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.field:last-child {
  border-bottom: none;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  color: #5b616b;
  font-size: 26rpx;
}

.input {
  font-size: 30rpx;
}

.textarea {
  width: 100%;
  height: 180rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.submit {
  margin: 32rpx 24rpx 0;
  border-radius: 12rpx;
  background: #3370ff;
  color: #fff;
  font-size: 30rpx;
}

.submit.ghost {
  margin-top: 24rpx;
  background: #fff;
  border: 1rpx solid #d9dde5;
  color: #1f2329;
}

.done {
  text-align: center;
  line-height: 1.7;
}

.done-title {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1f7a3d;
}

.error {
  margin: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #fff1f0;
  color: #cf1322;
  line-height: 1.6;
}
