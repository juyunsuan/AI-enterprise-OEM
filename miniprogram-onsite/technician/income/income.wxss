.head .notice {
  margin-top: 16rpx;
}

.cards {
  display: flex;
  flex-wrap: wrap;
  margin: 24rpx 24rpx 0;
}

.stat {
  width: 50%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.stat-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a6a9b0;
}

.tabs {
  display: flex;
  white-space: nowrap;
  padding: 8rpx 24rpx 0;
}

.list {
  padding-bottom: 40rpx;
}

.item {
  margin-top: 16rpx;
}

.bottom {
  margin-top: 10rpx;
}

.hint {
  margin-top: 8rpx;
}

.footer {
  padding: 24rpx 0;
  text-align: center;
}

.error {
  margin: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: #fdecec;
  color: #d93026;
  font-size: 26rpx;
  line-height: 1.6;
}
