.error {
  margin: 24rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #fdecec;
  color: #c62828;
  font-size: 24rpx;
  line-height: 1.6;
}

.badge {
  padding: 6rpx 16rpx;
  border-radius: 18rpx;
  background: #eef3ff;
  color: #3370ff;
  font-size: 24rpx;
}

.line {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
  font-size: 27rpx;
}

.label {
  width: 160rpx;
  color: #8a8f99;
  flex-shrink: 0;
}

.value {
  flex: 1;
  line-height: 1.6;
}

.row-inline {
  display: flex;
  align-items: center;
}

.buttons {
  margin-top: 16rpx;
}

.buttons .action + .action {
  margin-left: 32rpx;
}

.action {
  color: #3370ff;
  font-size: 26rpx;
}

.item {
  margin-top: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.item-title {
  font-size: 28rpx;
}

.total {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef0f3;
  font-size: 30rpx;
  font-weight: 600;
}

.remark {
  margin-top: 12rpx;
  line-height: 1.6;
  font-size: 27rpx;
}

.stage {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  font-size: 27rpx;
}

.stage-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #3370ff;
  margin-right: 16rpx;
}

.stage-label {
  width: 160rpx;
}

.signature {
  margin-top: 24rpx;
}

.signature-image {
  width: 100%;
  margin-top: 12rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
}

.leave-image {
  width: 240rpx;
  height: 240rpx;
  margin-top: 16rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
}

.tip {
  margin-top: 12rpx;
  line-height: 1.6;
}

.gap {
  margin-top: 20rpx;
}

.flex {
  flex: 1;
  margin-left: 12rpx;
}

.flex:first-child {
  margin-left: 0;
}

.button-ghost {
  margin-top: 16rpx;
  background: #f2f5ff;
  color: #3370ff;
  border-radius: 12rpx;
  font-size: 28rpx;
}
