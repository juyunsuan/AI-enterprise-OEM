<view class="card day-bar">
  <view class="row">
    <text class="day-btn" data-delta="-1" bindtap="shiftDay">前一天</text>
    <picker mode="date" value="{{day}}" bindchange="pickDay">
      <view class="day-value">{{dayText}} {{day}}</view>
    </picker>
    <text class="day-btn" data-delta="1" bindtap="shiftDay">后一天</text>
  </view>
  <view class="muted tip">档期规则（营业时段、缓冲时间、可约天数）由店主在后台配置，本页只读。</view>
</view>

<view class="error" wx:if="{{errorText}}">{{errorText}}</view>
<view class="empty" wx:elif="{{loading}}">正在加载…</view>

<block wx:if="{{!loading && !errorText}}">
  <view class="card" wx:if="{{inTimeline}}">
    <view class="row">
      <text class="title">当日档期</text>
      <text class="muted">{{windowText}}</text>
    </view>
    <view class="muted summary">{{summaryText}}</view>
    <view class="slots">
      <view
        class="slot {{item.slotClass}}"
        wx:for="{{slots}}"
        wx:key="key"
        data-id="{{item.orderId}}"
        bindtap="openOrder"
      >
        <text class="slot-label">{{item.label}}</text>
        <text class="slot-reason">{{item.reasonLabel}}</text>
      </view>
    </view>
  </view>

  <view class="card" wx:else>
    <view class="title">当日档期</view>
    <view class="muted summary">{{note}}</view>
  </view>

  <view class="card">
    <view class="row">
      <text class="title">已排订单</text>
      <text class="muted">{{orders.length}} 单</text>
    </view>
    <view class="order" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="openOrder">
      <view class="row">
        <text class="order-time">{{item.timeText}}</text>
        <text class="badge" wx:if="{{item.statusLabel}}">{{item.statusLabel}}</text>
      </view>
      <view class="order-service">{{item.serviceText}}</view>
      <view class="muted">订单号 {{item.orderNo}}</view>
    </view>
    <view class="muted summary" wx:if="{{!orders.length}}">当天暂无排单。</view>
    <view class="muted tip" wx:if="{{orders.length}}">点击订单进入详情；订单号与服务名取自接单列表，未在列表里时只显示订单编号。</view>
  </view>

  <view class="card">
    <view class="row">
      <text class="title">休息段</text>
      <text class="action" bindtap="goRest">去设置</text>
    </view>
    <view class="rest" wx:for="{{rests}}" wx:key="id">
      <text>{{item.rangeText}}</text>
      <text class="muted" wx:if="{{item.reason}}">{{item.reason}}</text>
    </view>
    <view class="muted summary" wx:if="{{!rests.length}}">当天没有休息段。</view>
  </view>
</block>
