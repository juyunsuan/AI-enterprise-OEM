.tabs {
  white-space: nowrap;
  background: #fff;
  padding: 0 12rpx;
}

.tab {
  display: inline-block;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  color: #4e5969;
}

.tab-active {
  color: #3370ff;
  font-weight: 600;
  border-bottom: 4rpx solid #3370ff;
}

.error {
  margin: 24rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #fdecec;
  color: #c62828;
  font-size: 24rpx;
  line-height: 1.6;
}

.list {
  padding-bottom: 24rpx;
}

.item {
  margin-bottom: 0;
}

.order-no {
  font-size: 26rpx;
  color: #4e5969;
}

.badge {
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  background: #eef3ff;
  color: #3370ff;
  font-size: 22rpx;
}

.service {
  margin: 12rpx 0 8rpx;
  font-size: 30rpx;
}

.bottom {
  margin-top: 12rpx;
}

.amount {
  font-size: 30rpx;
  font-weight: 600;
}

.footer {
  text-align: center;
  padding: 24rpx 0;
}
