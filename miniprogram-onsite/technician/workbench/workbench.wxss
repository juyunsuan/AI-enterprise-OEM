.who {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  margin-right: 20rpx;
  background: #eef1f6;
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #8a8f99;
  overflow: hidden;
}

.who-text {
  display: flex;
  flex-direction: column;
}

.badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #eef3ff;
  color: #3370ff;
  font-size: 24rpx;
}

.rating {
  margin-top: 12rpx;
}

.notice {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #fff7e8;
  color: #b26a00;
  font-size: 24rpx;
  line-height: 1.6;
}

.notice-warn {
  background: #fdecec;
  color: #c62828;
}

.stats {
  display: flex;
  margin: 0 24rpx;
  padding: 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.next {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f7f9ff;
}

.next-time {
  font-size: 30rpx;
  font-weight: 600;
}

.next-service {
  margin: 10rpx 0;
  font-size: 28rpx;
}

.next-link {
  margin-top: 12rpx;
  color: #3370ff;
  font-size: 26rpx;
}

.next-empty {
  margin-top: 16rpx;
  line-height: 1.6;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.grid-item {
  width: 33.33%;
  margin-top: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #1f2329;
}
