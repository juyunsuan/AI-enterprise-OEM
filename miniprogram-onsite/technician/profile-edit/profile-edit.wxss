.notice {
  padding: 16rpx;
  border-radius: 12rpx;
  background: #fff7e8;
  color: #b26a00;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}

.field.column {
  flex-direction: column;
  align-items: stretch;
}

.label {
  width: 180rpx;
  color: #4e5969;
  font-size: 27rpx;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 27rpx;
}

.field.column .label {
  width: auto;
  margin-bottom: 12rpx;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 27rpx;
  box-sizing: border-box;
}

.picker-value {
  color: #3370ff;
  font-size: 27rpx;
}

.avatar-wrap {
  display: flex;
  align-items: center;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: #eef1f6;
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #8a8f99;
}

.tip {
  margin-top: 16rpx;
  line-height: 1.6;
}

.error {
  margin-top: 20rpx;
  color: #f53f3f;
  font-size: 25rpx;
  line-height: 1.6;
}

.submit {
  margin-top: 28rpx;
}
