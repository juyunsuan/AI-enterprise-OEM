.closed {
  text-align: center;
}

.note {
  margin-top: 8rpx;
  line-height: 1.6;
}

.field {
  margin-bottom: 24rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #5c6068;
  font-size: 26rpx;
}

.field-input {
  width: 100%;
  padding: 16rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.field-textarea {
  width: 100%;
  height: 140rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.link {
  color: #3370ff;
  font-size: 26rpx;
}

.tag-row {
  display: flex;
  margin-top: 16rpx;
}

.tag {
  margin-right: 20rpx;
  padding: 10rpx 32rpx;
  border: 2rpx solid #dcdfe6;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #5c6068;
}

.tag.on {
  border-color: #3370ff;
  background: #eef3ff;
  color: #3370ff;
}

.footer {
  padding: 0 24rpx 48rpx;
}
