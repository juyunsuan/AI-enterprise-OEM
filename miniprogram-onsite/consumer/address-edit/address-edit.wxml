<view class="empty" wx:if="{{loading}}">正在加载地址…</view>

<view class="card closed" wx:elif="{{notReady}}">
  <view class="title">店铺暂未开通</view>
  <view class="muted note">{{readyReason}}</view>
</view>

<view class="empty" wx:elif="{{error}}">{{error}}</view>

<block wx:else>
  <view class="card">
    <view class="field">
      <text class="field-label">联系人</text>
      <input
        class="field-input"
        value="{{form.contactName}}"
        maxlength="60"
        placeholder="请输入联系人姓名"
        data-field="contactName"
        bindinput="onInput"
      />
    </view>
    <view class="field">
      <text class="field-label">手机号</text>
      <input
        class="field-input"
        type="number"
        value="{{form.phone}}"
        maxlength="11"
        placeholder="请输入 11 位手机号"
        data-field="phone"
        bindinput="onInput"
      />
    </view>
    <view class="field">
      <text class="field-label">省份</text>
      <input
        class="field-input"
        value="{{form.province}}"
        maxlength="60"
        placeholder="如：广东省"
        data-field="province"
        bindinput="onInput"
      />
    </view>
    <view class="field">
      <text class="field-label">城市</text>
      <input
        class="field-input"
        value="{{form.city}}"
        maxlength="60"
        placeholder="如：深圳市"
        data-field="city"
        bindinput="onInput"
      />
    </view>
    <view class="field">
      <text class="field-label">区县</text>
      <input
        class="field-input"
        value="{{form.district}}"
        maxlength="60"
        placeholder="如：南山区"
        data-field="district"
        bindinput="onInput"
      />
    </view>
    <view class="muted note">省市区为文字填写：端上没有行政区划数据源，未做三级联动选择器。</view>
    <view class="field">
      <text class="field-label">详细地址</text>
      <textarea
        class="field-textarea"
        value="{{form.detail}}"
        maxlength="200"
        placeholder="街道、小区、楼栋"
        data-field="detail"
        bindinput="onInput"
      ></textarea>
    </view>
    <view class="field">
      <text class="field-label">门牌号</text>
      <input
        class="field-input"
        value="{{form.houseNumber}}"
        maxlength="40"
        placeholder="如：3 栋 502"
        data-field="houseNumber"
        bindinput="onInput"
      />
      <view class="muted note">后端地址字段没有独立门牌号，保存时会并入详细地址。</view>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <text>地图选点</text>
      <text class="link" bindtap="chooseLocation">打开地图</text>
    </view>
    <view class="muted note" wx:if="{{locationText}}">{{locationText}}</view>
    <view class="muted note" wx:else>可选，用于上门距离与车费测算</view>
  </view>

  <view class="card">
    <view class="title">标签</view>
    <view class="tag-row">
      <view
        class="tag {{form.tag === item ? 'on' : ''}}"
        wx:for="{{tags}}"
        wx:key="*this"
        data-tag="{{item}}"
        bindtap="pickTag"
      >{{item}}</view>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <text>设为默认地址</text>
      <switch checked="{{form.isDefault}}" bindchange="toggleDefault"></switch>
    </view>
  </view>

  <view class="footer">
    <button class="button-primary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存</button>
  </view>
</block>
