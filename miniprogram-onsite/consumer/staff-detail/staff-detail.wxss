.head {
  display: flex;
  align-items: flex-start;
}

.avatar.big {
  width: 120rpx;
  height: 120rpx;
  margin-right: 24rpx;
}

.avatar-fallback {
  width: 120rpx;
  height: 120rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: #eef3ff;
  color: #3370ff;
  text-align: center;
  line-height: 120rpx;
  font-size: 44rpx;
}

.head-main {
  flex: 1;
}

.images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.shot {
  width: 200rpx;
  height: 200rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 12rpx;
  background: #f0f1f5;
}
