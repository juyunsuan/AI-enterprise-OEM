<view class="empty" wx:if="{{loading}}">正在确认支付结果…</view>

<view class="empty" wx:elif="{{error}}">{{error}}</view>

<view class="card" wx:elif="{{notReady}}">
  <view class="title">店铺暂未开通</view>
  <view class="muted detail-text">{{readyReason}}</view>
</view>

<block wx:else>
  <view class="card result">
    <view class="result-icon {{paid ? 'ok' : 'warn'}}">{{paid ? '√' : '!'}}</view>
    <view class="title result-title">{{paid ? '支付成功' : '尚未支付'}}</view>
    <view class="muted result-hint">{{hint}}</view>
    <view class="kv">
      <text class="kv-label">订单号</text>
      <text class="kv-value">{{orderNo}}</text>
    </view>
    <view class="kv">
      <text class="kv-label">金额</text>
      <text class="amount">{{amountText}}</text>
    </view>
    <view class="kv" wx:if="{{statusText}}">
      <text class="kv-label">订单状态</text>
      <text class="kv-value">{{statusText}}</text>
    </view>
    <view class="notice notice-warn" wx:if="{{reason}}">{{reason}}</view>
  </view>

  <view class="footer">
    <button class="button-primary" bindtap="retryPay" wx:if="{{!paid}}" disabled="{{paying}}">
      {{paying ? '正在唤起支付…' : '重新支付'}}
    </button>
    <button class="button-ghost" bindtap="openOrder">查看订单</button>
    <button class="button-ghost" bindtap="goHome">返回首页</button>
  </view>
</block>
