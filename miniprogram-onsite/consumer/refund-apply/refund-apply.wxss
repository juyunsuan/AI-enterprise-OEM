.closed {
  text-align: center;
}

.note {
  margin-top: 8rpx;
  line-height: 1.6;
}

.order-item {
  margin-top: 0;
}

.amount-row {
  margin-top: 16rpx;
}

.amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}

.warn {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #fff7e8;
  color: #a86b00;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.link {
  color: #3370ff;
  font-size: 26rpx;
  margin-top: 16rpx;
}

.retry {
  margin-top: 24rpx;
}

.line {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.line:last-child {
  border-bottom: none;
}

.line-head {
  display: flex;
  align-items: center;
}

.check {
  padding: 4rpx 14rpx;
  margin-right: 16rpx;
  border: 2rpx solid #dcdfe6;
  border-radius: 10rpx;
  font-size: 22rpx;
  color: #8a8f99;
}

.check.on {
  border-color: #3370ff;
  background: #eef3ff;
  color: #3370ff;
}

.line-title {
  flex: 1;
  font-size: 28rpx;
}

.line-meta {
  margin-top: 10rpx;
}

.stepper {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.step-btn {
  padding: 8rpx 24rpx;
  border: 2rpx solid #dcdfe6;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #5c6068;
}

.step-value {
  min-width: 120rpx;
  text-align: center;
  font-size: 26rpx;
}

.text-input {
  width: 100%;
  margin-top: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.text-input.area {
  height: 180rpx;
}

.images-head {
  margin-bottom: 8rpx;
}

.images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.image-item {
  position: relative;
  margin: 0 16rpx 16rpx 0;
}

.image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f0f1f5;
}

.image-del {
  position: absolute;
  right: 0;
  bottom: 0;
  padding: 4rpx 12rpx;
  background: rgba(31, 35, 41, 0.65);
  color: #fff;
  font-size: 22rpx;
  border-radius: 12rpx 0 12rpx 0;
}

.image-add {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 16rpx;
  line-height: 160rpx;
  text-align: center;
  color: #8a8f99;
  background: #f7f8fa;
  border: 2rpx dashed #dcdfe6;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.footer {
  padding: 0 24rpx 48rpx;
}
