.closed {
  text-align: center;
}

.note {
  margin-top: 8rpx;
  line-height: 1.6;
}

.status {
  font-size: 26rpx;
  color: #3370ff;
}

.row-line {
  margin-top: 12rpx;
  line-height: 1.6;
}

.amount-row {
  margin-top: 12rpx;
}

.amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}

.block-title {
  margin-top: 20rpx;
  font-size: 28rpx;
}

.block-text {
  margin-top: 12rpx;
  padding: 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.image {
  width: 160rpx;
  height: 160rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 12rpx;
  background: #f0f1f5;
}

.footer {
  padding: 0 24rpx 48rpx;
}

.button-plain {
  background: #fff;
  color: #d4380d;
  border: 2rpx solid #f0c4b4;
  border-radius: 12rpx;
  font-size: 30rpx;
}
