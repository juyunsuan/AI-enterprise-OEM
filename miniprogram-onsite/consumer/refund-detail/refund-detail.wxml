<view class="empty" wx:if="{{loading}}">正在加载退款单…</view>

<view class="card closed" wx:elif="{{notReady}}">
  <view class="title">店铺暂未开通</view>
  <view class="muted note">{{readyReason}}</view>
</view>

<view class="empty" wx:elif="{{error}}">{{error}}</view>

<view class="empty" wx:elif="{{notFound}}">未找到这笔退款单，可能已被处理或不属于当前账号</view>

<block wx:elif="{{refund}}">
  <view class="card">
    <view class="row">
      <text class="title">退款单 {{refund.refundNo}}</text>
      <text class="status">{{refund.statusText}}</text>
    </view>
    <view class="muted row-line">订单号 {{refund.orderNo || '—'}}</view>
    <view class="row amount-row">
      <text class="muted">申请金额</text>
      <text class="amount">{{refund.applyAmountText}}</text>
    </view>
    <view class="row amount-row" wx:if="{{refund.hasRefunded}}">
      <text class="muted">实退金额</text>
      <text class="amount">{{refund.refundAmountText}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{refund.lines.length}}">
    <view class="title">退款明细</view>
    <view class="row row-line" wx:for="{{refund.lines}}" wx:key="id">
      <text>{{item.title}} {{item.quantityText}}</text>
      <text>{{item.amountText}}</text>
    </view>
  </view>

  <view class="card">
    <view class="title">申请信息</view>
    <view class="row-line">退款原因：{{refund.reason || '—'}}</view>
    <view class="block-text" wx:if="{{refund.description}}">{{refund.description}}</view>
    <view class="muted" wx:else>未填写补充说明</view>
    <view class="block-title" wx:if="{{photos.length}}">凭证图</view>
    <view class="images" wx:if="{{photos.length}}">
      <image
        class="image"
        wx:for="{{photos}}"
        wx:key="*this"
        src="{{item}}"
        mode="aspectFill"
        data-index="{{index}}"
        bindtap="previewPhoto"
      ></image>
    </view>
  </view>

  <view class="card">
    <view class="title">{{refund.isRejected ? '驳回理由' : '处理说明'}}</view>
    <view class="block-text" wx:if="{{refund.auditRemark}}">{{refund.auditRemark}}</view>
    <view class="muted" wx:else>店主暂未填写处理说明</view>
    <view class="muted row-line" wx:if="{{refund.refundTransactionId}}">退款交易号 {{refund.refundTransactionId}}</view>
  </view>

  <view class="card">
    <view class="title">时间</view>
    <view class="row row-line">
      <text class="muted">申请时间</text>
      <text>{{refund.createdAtText}}</text>
    </view>
    <view class="row row-line" wx:if="{{refund.refundedAtText}}">
      <text class="muted">退款时间</text>
      <text>{{refund.refundedAtText}}</text>
    </view>
  </view>

  <view class="footer" wx:if="{{canCancel}}">
    <button
      class="button-plain"
      bindtap="cancel"
      loading="{{cancelling}}"
      disabled="{{cancelling}}"
    >撤销售后申请</button>
  </view>
</block>
