<view class="empty" wx:if="{{loading}}">正在加载表单…</view>

<view class="card closed" wx:elif="{{notReady}}">
  <view class="title">店铺暂未开通</view>
  <view class="muted note">{{readyReason}}</view>
</view>

<view class="empty" wx:elif="{{error}}">{{error}}</view>

<view class="card" wx:elif="{{submitted}}">
  <view class="title">已提交</view>
  <view class="muted note">提交编号 {{resultId}}</view>
  <view class="muted note" wx:if="{{resultStatus}}">当前状态：{{resultStatus}}</view>
  <view class="muted note">处理结果以店主通知为准。</view>
  <button class="button-primary back-btn" bindtap="back">返回</button>
</view>

<block wx:else>
  <view class="card">
    <view class="title">{{articleTitle}}</view>
    <view class="muted note">带「必填」标记的字段不能为空。</view>
  </view>

  <view class="card">
    <view class="field" wx:for="{{fields}}" wx:key="key">
      <view class="field-label">
        <text>{{item.name}}</text>
        <text class="required" wx:if="{{item.required}}">必填</text>
      </view>

      <input
        wx:if="{{item.fieldType === 'text' || item.fieldType === 'idcard'}}"
        class="field-input {{errorField === item.key ? 'invalid' : ''}}"
        value="{{item.value}}"
        maxlength="2000"
        placeholder="{{item.placeholder || '请输入'}}"
        data-index="{{index}}"
        bindinput="onInput"
      />

      <textarea
        wx:elif="{{item.fieldType === 'textarea'}}"
        class="field-textarea {{errorField === item.key ? 'invalid' : ''}}"
        value="{{item.value}}"
        maxlength="2000"
        placeholder="{{item.placeholder || '请输入'}}"
        data-index="{{index}}"
        bindinput="onInput"
      ></textarea>

      <input
        wx:elif="{{item.fieldType === 'number'}}"
        class="field-input {{errorField === item.key ? 'invalid' : ''}}"
        type="digit"
        value="{{item.value}}"
        placeholder="{{item.placeholder || '请输入数字'}}"
        data-index="{{index}}"
        bindinput="onInput"
      />

      <input
        wx:elif="{{item.fieldType === 'phone'}}"
        class="field-input {{errorField === item.key ? 'invalid' : ''}}"
        type="number"
        maxlength="11"
        value="{{item.value}}"
        placeholder="{{item.placeholder || '请输入 11 位手机号'}}"
        data-index="{{index}}"
        bindinput="onInput"
      />

      <picker
        wx:elif="{{item.fieldType === 'select'}}"
        range="{{item.options}}"
        value="{{item.optionIndex}}"
        data-index="{{index}}"
        bindchange="onSelect"
      >
        <view class="field-picker {{item.value ? '' : 'placeholder'}} {{errorField === item.key ? 'invalid' : ''}}">
          {{item.value || '请选择'}}
        </view>
      </picker>

      <picker
        wx:elif="{{item.fieldType === 'date'}}"
        mode="date"
        data-index="{{index}}"
        bindchange="onDate"
      >
        <view class="field-picker {{item.value ? '' : 'placeholder'}} {{errorField === item.key ? 'invalid' : ''}}">
          {{item.value || '请选择日期'}}
        </view>
      </picker>

      <picker
        wx:elif="{{item.fieldType === 'region'}}"
        mode="region"
        data-index="{{index}}"
        bindchange="onRegion"
      >
        <view class="field-picker {{item.value ? '' : 'placeholder'}} {{errorField === item.key ? 'invalid' : ''}}">
          {{item.value || '请选择省市区'}}
        </view>
      </picker>

      <input
        wx:else
        class="field-input {{errorField === item.key ? 'invalid' : ''}}"
        value="{{item.value}}"
        placeholder="{{item.placeholder || '请输入'}}"
        data-index="{{index}}"
        bindinput="onInput"
      />

      <view class="field-error" wx:if="{{errorField === item.key}}">{{errorMessage}}</view>
    </view>
  </view>

  <view class="footer">
    <button
      class="button-primary"
      bindtap="submit"
      loading="{{submitting}}"
      disabled="{{submitting}}"
    >提交</button>
  </view>
</block>
