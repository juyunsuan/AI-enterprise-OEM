.closed {
  text-align: center;
}

.note {
  margin-top: 8rpx;
  line-height: 1.6;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  font-size: 28rpx;
}

.required {
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  background: #fff1f0;
  color: #d4380d;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.field-input {
  width: 100%;
  padding: 16rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.field-textarea {
  width: 100%;
  height: 180rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.field-picker {
  padding: 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.field-picker.placeholder {
  color: #8a8f99;
}

.invalid {
  border-color: #d4380d;
}

.field-error {
  margin-top: 8rpx;
  color: #d4380d;
  font-size: 24rpx;
}

.back-btn {
  margin-top: 24rpx;
}

.footer {
  padding: 0 24rpx 48rpx;
}
