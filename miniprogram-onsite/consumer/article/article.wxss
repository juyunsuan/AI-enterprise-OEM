.closed {
  text-align: center;
}

.note {
  margin-top: 8rpx;
  line-height: 1.6;
}

.article-title {
  font-size: 38rpx;
  line-height: 1.4;
}

.meta {
  display: flex;
  margin-top: 12rpx;
}

.meta-right {
  margin-left: 24rpx;
}

.cover {
  width: 100%;
  height: 360rpx;
  margin-top: 20rpx;
  border-radius: 12rpx;
  background: #f0f1f5;
}

.summary {
  margin-top: 20rpx;
  padding: 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  color: #5c6068;
  line-height: 1.6;
}

.content {
  display: block;
  margin-top: 20rpx;
  line-height: 1.8;
  font-size: 28rpx;
  word-break: break-all;
}

.form-btn {
  margin-top: 24rpx;
}
