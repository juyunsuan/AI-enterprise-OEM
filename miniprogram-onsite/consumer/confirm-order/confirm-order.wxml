<view class="empty" wx:if="{{loading}}">正在准备订单…</view>

<view class="card" wx:elif="{{notReady}}">
  <view class="title">店铺暂未开通</view>
  <view class="muted detail-text">{{readyReason}}</view>
</view>

<view class="empty" wx:elif="{{error}}">{{error}}</view>

<block wx:else>
  <view class="card">
    <view class="row">
      <text class="title">上门地址</text>
      <text class="link" bindtap="chooseAddress" wx:if="{{address}}">更换</text>
    </view>
    <block wx:if="{{address}}">
      <view class="addr-contact">
        <text class="addr-name">{{address.contactName}}</text>
        <text class="muted" wx:if="{{address.phone}}">{{address.phone}}</text>
      </view>
      <view class="detail-text">{{address.text}}</view>
    </block>
    <block wx:else>
      <view class="notice notice-warn" wx:if="{{addressEmpty}}">还没有上门地址，先添加一个再下单。</view>
      <view class="muted" wx:else>正在获取地址…</view>
      <button class="button-ghost" bindtap="addAddress">新增地址</button>
    </block>
  </view>

  <view class="card">
    <view class="row">
      <text class="title">上门时间</text>
      <text class="link" bindtap="repickTime">重新选择</text>
    </view>
    <view class="detail-text" wx:if="{{preview}}">{{preview.startText}} 至 {{preview.endText}}</view>
    <view class="muted" wx:if="{{preview}}">预计 {{preview.durationText}} · 服务人员 {{preview.staffName}}</view>
  </view>

  <view class="card">
    <view class="row">
      <text class="title">服务项目</text>
      <view class="stepper">
        <view class="stepper-btn" data-delta="-1" bindtap="changeQuantity">-</view>
        <view class="stepper-value">{{quantityText}}</view>
        <view class="stepper-btn" data-delta="1" bindtap="changeQuantity">+</view>
      </view>
    </view>
    <view class="list-item" wx:for="{{previewRows}}" wx:key="serviceId">
      <view class="item-head">
        <text class="item-title">{{item.title}} {{item.quantityText}}</text>
        <text class="kv-value">{{item.priceText}}</text>
      </view>
      <view class="item-meta">
        <text>{{item.durationText}}</text>
        <text wx:if="{{item.materialText}}"> · {{item.materialText}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{previewing}}">正在试算金额…</view>
    <view class="notice notice-error" wx:elif="{{previewError}}">
      <view>{{previewError}}</view>
      <view class="link" bindtap="onRetryPreview">重新试算</view>
    </view>
  </view>

  <view class="card" wx:if="{{preview}}">
    <view class="title">费用明细</view>
    <view class="kv" wx:for="{{amountRows}}" wx:key="label">
      <text class="kv-label">{{item.label}}</text>
      <text class="kv-value">{{item.value}}</text>
    </view>
    <view class="kv" wx:if="{{preview.distanceText}}">
      <text class="kv-label">上门距离</text>
      <text class="kv-value">{{preview.distanceText}}</text>
    </view>
    <view class="kv">
      <text class="kv-label">应付合计</text>
      <text class="amount">{{preview.payText}}</text>
    </view>
    <view class="muted" wx:if="{{preview.travelNote}}">{{preview.travelNote}}</view>
    <view class="notice">金额由服务端按店铺规则计算，页面不做加减。</view>
  </view>

  <view class="card">
    <view class="title">订单备注</view>
    <textarea
      class="textarea"
      value="{{remark}}"
      maxlength="300"
      placeholder="可填写门牌号、宠物情况等，最多 300 字"
      bindinput="onRemarkInput"
    ></textarea>
  </view>

  <view class="footer">
    <view class="row" wx:if="{{preview}}">
      <text class="muted">应付</text>
      <text class="amount">{{preview.payText}}</text>
    </view>
    <button
      class="button-primary"
      bindtap="submit"
      disabled="{{!preview || submitting}}"
    >{{submitting ? '正在下单…' : '提交订单并支付'}}</button>
  </view>
</block>
