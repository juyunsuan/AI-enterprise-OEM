<view class="empty" wx:if="{{loading}}">正在加载订单…</view>

<view class="empty" wx:elif="{{error}}">{{error}}</view>

<view class="card" wx:elif="{{notReady}}">
  <view class="title">店铺暂未开通</view>
  <view class="muted detail-text">{{readyReason}}</view>
</view>

<block wx:else>
  <view class="card">
    <view class="title">服务已完成，请签字确认</view>
    <view class="muted detail-text">订单号 {{orderNo}}{{amountText ? ' · 金额 ' + amountText : ''}}</view>
  </view>

  <view class="card" wx:if="{{signed}}">
    <view class="title">已签字</view>
    <image class="sign-image" src="{{signImage}}" mode="aspectFit"></image>
    <view class="muted">签名已提交，无需重复签字。</view>
  </view>

  <block wx:else>
    <view class="card">
      <view class="row">
        <text class="title">请在下方空白处签名</text>
        <text class="link" bindtap="clear">清除</text>
      </view>
      <canvas
        class="canvas"
        canvas-id="signCanvas"
        disable-scroll="true"
        bindtouchstart="onTouchStart"
        bindtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
        bindtouchcancel="onTouchEnd"
      ></canvas>
      <view class="muted">手指书写即为有效签名，提交后作为服务完成的确认凭证。</view>
    </view>

    <view class="footer">
      <button class="button-primary" bindtap="submit" disabled="{{submitting}}">
        {{submitting ? '正在提交…' : '确认提交'}}
      </button>
    </view>
  </block>
</block>
