.kv {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.kv-k {
  color: var(--muted);
  font-size: 26rpx;
}

.kv-v {
  font-size: 26rpx;
  max-width: 62%;
  text-align: right;
  word-break: break-all;
}

.record {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 26rpx;
}

.record:last-child {
  border-bottom: none;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #fbfbfc;
  font-size: 28rpx;
  box-sizing: border-box;
}

.row.gap {
  gap: 20rpx;
}

.btn-block {
  display: flex;
  flex: 1;
}

.transfer {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  align-items: center;
}

.transfer .input {
  flex: 1;
}
