.kv {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.kv-k {
  color: var(--muted);
  font-size: 26rpx;
}

.kv-v {
  font-size: 26rpx;
  max-width: 62%;
  text-align: right;
  word-break: break-all;
}

.row.wrap {
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: var(--muted);
  font-size: 26rpx;
}

.chip-on {
  background: var(--brand);
  color: #fff;
}

.server-field {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  align-items: center;
}

.server-field .input {
  flex: 1;
}

.btn-block {
  display: flex;
  width: 100%;
}

.muted {
  margin-top: 8rpx;
}
