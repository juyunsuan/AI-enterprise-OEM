.hero {
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.hero-name {
  font-size: 44rpx;
  font-weight: 600;
}

.hero-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.btn-block {
  display: flex;
  width: 100%;
  margin-top: 24rpx;
}

.server-field {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.server-field .input {
  flex: 1;
}

.center {
  text-align: center;
  margin-top: 12rpx;
}
