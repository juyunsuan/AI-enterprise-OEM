<view class="page">
  <view class="hero" style="background: {{themeColor}}">
    <view class="hero-name">{{appName}}</view>
    <view class="hero-tip">移动办公 · 待办随时处理</view>
  </view>

  <view class="card">
    <view class="card-title">微信一键登录</view>
    <view class="muted">已绑定的账号进入即免密登录；未绑定则输入账号密码完成绑定。</view>
    <view class="btn btn-block" bindtap="onWechatLogin">{{loading ? '登录中…' : '一键进入'}}</view>
  </view>

  <view class="card" wx:if="{{showAccount}}">
    <view class="card-title">账号密码登录并绑定</view>
    <view class="field">
      <view class="field-label">账号</view>
      <input class="input" value="{{username}}" placeholder="用户名 / 邮箱 / 手机号" bindinput="onUsername" />
    </view>
    <view class="field">
      <view class="field-label">密码</view>
      <input class="input" value="{{password}}" password placeholder="登录密码" bindinput="onPassword" />
    </view>
    <view class="btn btn-block" bindtap="onAccountLogin">{{loading ? '提交中…' : '登录并绑定'}}</view>
  </view>

  <view class="card">
    <view class="card-title">服务器地址</view>
    <view class="muted">接口所在域名（如需更换，填写后保存；微信后台需把该域名加入 request 合法域名）。</view>
    <view class="field server-field">
      <input class="input" value="{{apiBase}}" placeholder="https://your-domain.com" bindinput="onApiBase" />
      <view class="btn btn-plain" bindtap="onSaveApiBase">保存</view>
    </view>
  </view>

  <view class="muted center" wx:if="{{message}}">{{message}}</view>
</view>
