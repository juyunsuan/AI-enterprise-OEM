<view class="page" wx:if="{{notice}}">
  <view class="card">
    <view class="title">{{notice.title}}</view>
    <view class="row between" style="margin-top: 16rpx">
      <view class="tag tag-plain">{{notice.categoryLabel}}</view>
      <view class="muted">{{notice.createdAtText}}</view>
    </view>
    <view class="divider"></view>
    <view class="body">{{notice.body}}</view>
  </view>

  <view class="card" wx:if="{{notice.link}}">
    <view class="field-label">关联入口</view>
    <view class="muted link">{{notice.link}}</view>
    <view class="btn btn-plain btn-block" bindtap="copyLink">复制链接</view>
    <view class="muted hint">在浏览器或电脑端打开该链接可继续处理。</view>
  </view>
  <view class="footer-gap"></view>
</view>
<view class="empty" wx:if="{{!notice && !loading}}">消息不存在或已删除</view>
