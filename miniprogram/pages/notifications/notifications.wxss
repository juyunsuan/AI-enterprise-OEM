.filters {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  align-items: center;
}

.spacer {
  flex: 1;
}

.chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--muted);
  font-size: 26rpx;
  border: 1rpx solid var(--line);
}

.chip-on {
  background: var(--brand);
  color: #fff;
  border-color: var(--brand);
}

.notice-read .notice-title {
  color: var(--muted);
  font-weight: 400;
}

.notice-title {
  font-size: 30rpx;
  font-weight: 500;
  flex: 1;
  margin-right: 16rpx;
}

.notice-body {
  margin: 12rpx 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.notice-meta {
  align-items: center;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #f53f3f;
}

.loading {
  text-align: center;
  padding: 20rpx;
}
