.chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.messages {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.visitor-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
}

.msg {
  display: flex;
  margin-bottom: 20rpx;
}

.msg-mine {
  justify-content: flex-end;
}

.msg-system {
  justify-content: center;
}

.system-text {
  font-size: 22rpx;
  color: var(--muted);
  background: rgba(0, 0, 0, 0.04);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.bubble {
  max-width: 74%;
  background: #fff;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.msg-mine .bubble {
  background: var(--brand);
  color: #fff;
}

.sender {
  font-size: 22rpx;
  margin-bottom: 6rpx;
}

.bubble-text {
  word-break: break-all;
  white-space: pre-wrap;
}

.bottom-anchor {
  height: 20rpx;
}

.composer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--line);
}

.composer-input {
  flex: 1;
  height: 76rpx;
  padding: 0 22rpx;
  background: #f2f3f5;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.composer .btn {
  height: 76rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
}

.btn-disabled {
  opacity: 0.5;
}
