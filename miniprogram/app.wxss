page {
  --brand: #3370ff;
  --bg: #f5f6f8;
  --card: #ffffff;
  --text: #1f2329;
  --muted: #8a8f99;
  --line: #eaecef;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 36rpx;
  background: rgba(51, 112, 255, 0.1);
  color: var(--brand);
}

.tag-warn {
  background: rgba(255, 143, 0, 0.12);
  color: #d98200;
}

.tag-danger {
  background: rgba(245, 63, 63, 0.12);
  color: #f53f3f;
}

.tag-plain {
  background: #f2f3f5;
  color: var(--muted);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: var(--brand);
  color: #fff;
}

.btn-plain {
  background: #f2f3f5;
  color: var(--text);
}

.btn-danger {
  background: #f53f3f;
  color: #fff;
}

.btn[disabled] {
  opacity: 0.5;
}

.btn-block {
  display: flex;
  width: 100%;
}

.empty {
  padding: 120rpx 24rpx;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
}

.input {
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #fbfbfc;
  font-size: 28rpx;
  box-sizing: border-box;
  width: 100%;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 10rpx;
}

.footer-gap {
  height: 40rpx;
}

/* ---------- 工商年报 ---------- */

.hero-card {
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #3370ff 0%, #5b8cff 100%);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
  line-height: 1.6;
}

.hero-meta {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.24);
  font-size: 24rpx;
  opacity: 0.92;
}

.btn-row {
  display: flex;
  gap: 20rpx;
}

.btn-main {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
}

.entry-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.entry-title {
  font-size: 30rpx;
  font-weight: 500;
}

.entry-desc {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.entry-arrow {
  margin-left: 20rpx;
  color: var(--muted);
  font-size: 40rpx;
}

.notice-box {
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 143, 0, 0.08);
  color: #a35f00;
  font-size: 24rpx;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.picker {
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #fbfbfc;
  font-size: 28rpx;
  box-sizing: border-box;
  width: 100%;
  line-height: 80rpx;
  color: var(--text);
}

.picker-placeholder {
  color: #b8bcc4;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #fbfbfc;
  font-size: 28rpx;
  box-sizing: border-box;
}

.field-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
}

.steps {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.step {
  display: flex;
  align-items: flex-start;
}

.step-index {
  flex: 0 0 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: rgba(51, 112, 255, 0.1);
  color: var(--brand);
  font-size: 22rpx;
  line-height: 40rpx;
  text-align: center;
}

.step-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
}

.record-card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
}

.record-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx 16rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.record-fields {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.kv-row {
  display: flex;
  padding: 10rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
}

.kv-k {
  flex: 0 0 210rpx;
  color: var(--muted);
}

.kv-v {
  flex: 1;
  word-break: break-all;
}

.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 28rpx;
}

.link-row:last-child {
  border-bottom: none;
}

.link-action {
  color: var(--brand);
  font-size: 26rpx;
}

.form-note {
  margin-top: 4rpx;
  margin-bottom: 20rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
}
