page {
  --brand: #3370ff;
  --bg: #f5f6f8;
  --card: #ffffff;
  --text: #1f2329;
  --muted: #8a8f99;
  --line: #eaecef;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 36rpx;
  background: rgba(51, 112, 255, 0.1);
  color: var(--brand);
}

.tag-warn {
  background: rgba(255, 143, 0, 0.12);
  color: #d98200;
}

.tag-danger {
  background: rgba(245, 63, 63, 0.12);
  color: #f53f3f;
}

.tag-plain {
  background: #f2f3f5;
  color: var(--muted);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: var(--brand);
  color: #fff;
}

.btn-plain {
  background: #f2f3f5;
  color: var(--text);
}

.btn-danger {
  background: #f53f3f;
  color: #fff;
}

.btn[disabled] {
  opacity: 0.5;
}

.empty {
  padding: 120rpx 24rpx;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
}

.input {
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #fbfbfc;
  font-size: 28rpx;
  box-sizing: border-box;
  width: 100%;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 10rpx;
}

.footer-gap {
  height: 40rpx;
}
