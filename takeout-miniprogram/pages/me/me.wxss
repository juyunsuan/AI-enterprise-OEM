.page {
  padding: 24rpx 24rpx 40rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 34rpx 28rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #e64340 0%, #f06a45 100%);
  color: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(230, 67, 64, 0.22);
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  margin-right: 22rpx;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
}

.nickname {
  font-size: 34rpx;
  font-weight: 700;
}

.phone {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.86;
}

.login-btn {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #c73b36;
  font-size: 25rpx;
  font-weight: 700;
}

.stats {
  display: flex;
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 22rpx;
  padding: 24rpx 0;
  box-shadow: 0 8rpx 22rpx rgba(44, 38, 34, 0.05);
}

.stat {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #f3eeea;
}

.stat:last-child {
  border-right: none;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #c73b36;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #948b84;
}

.card {
  margin-top: 20rpx;
}

.orders-head {
  margin-bottom: 22rpx;
}

.orders-title {
  font-size: 29rpx;
  font-weight: 700;
}

.order-links {
  display: flex;
}

.order-link {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #5e534c;
}

.order-icon {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 10rpx;
  border-radius: 22rpx;
  background: #fdf0ed;
  color: #d0453f;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-card {
  padding: 4rpx 26rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f3eeea;
  font-size: 27rpx;
}

.menu-row:last-child {
  border-bottom: none;
}

.points-title {
  font-size: 29rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.points-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f6f1ed;
}

.points-row:last-child {
  border-bottom: none;
}

.points-remark {
  font-size: 26rpx;
}

.points-plus {
  color: #4c8c5a;
  font-weight: 700;
}

.minus {
  color: #d0453f;
  font-weight: 700;
}