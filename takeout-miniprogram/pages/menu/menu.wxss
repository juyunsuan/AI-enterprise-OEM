.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.shop-bar {
  padding: 22rpx 28rpx 18rpx;
  background: #ffffff;
}

.shop-name {
  font-size: 32rpx;
  font-weight: 700;
}

.shop-meta {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  font-size: 23rpx;
  color: #948b84;
}

.open-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4caf50;
  margin-right: 8rpx;
}

.dot {
  margin: 0 10rpx;
  color: #d3cbc5;
}

.menu {
  flex: 1;
  min-height: 0;
  display: flex;
}

.cat-pane {
  width: 184rpx;
  height: 100%;
  background: #f1ece8;
}

.cat-item {
  padding: 28rpx 16rpx;
  text-align: center;
  color: #7a6f67;
  position: relative;
}

.cat-active {
  background: #f6f4f1;
  color: #c73b36;
  font-weight: 700;
}

.cat-active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 30rpx;
  bottom: 30rpx;
  width: 6rpx;
  border-radius: 3rpx;
  background: #e64340;
}

.cat-name {
  font-size: 26rpx;
  line-height: 1.3;
}

.cat-count {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #b0a69f;
}

.dish-pane {
  flex: 1;
  height: 100%;
  padding: 0 20rpx;
}

.cat-section-title {
  padding: 22rpx 6rpx 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #5e534c;
}

.dish {
  display: flex;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid #f3eeea;
}

.dish-media {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.dish-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: #f7efec;
}

.dish-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d8b9ae;
  font-size: 38rpx;
  font-weight: 700;
}

.soldout {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 16rpx;
  background: rgba(44, 38, 34, 0.55);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dish-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.dish-title {
  font-size: 29rpx;
  font-weight: 700;
}

.dish-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #948b84;
}

.dish-tags {
  margin-top: 8rpx;
  display: flex;
  gap: 8rpx;
}

.tag-soft {
  background: #f3f1ef;
  color: #8a7f77;
}

.dish-foot {
  margin-top: auto;
  display: flex;
  align-items: center;
}

.dish-sales {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #b0a69f;
}

.dish-add {
  margin-left: auto;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #e64340;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.dish-add-off {
  background: #d8d0ca;
}

.dish-qty {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 15rpx;
  background: #2c2622;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
}

.dish-bottom-space {
  height: 180rpx;
}

.cart-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #2c2622;
  color: #ffffff;
  display: flex;
  align-items: center;
  padding: 0 12rpx 0 22rpx;
  box-shadow: 0 16rpx 40rpx rgba(44, 38, 34, 0.32);
  z-index: 20;
}

.cart-left {
  flex: 1;
  display: flex;
  align-items: center;
}

.cart-icon {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #e64340;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.cart-count {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 6rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #e64340;
  font-size: 19rpx;
  line-height: 32rpx;
  text-align: center;
  font-weight: 700;
}

.cart-total {
  margin-left: 18rpx;
}

.cart-total .price {
  color: #ffffff;
  font-size: 36rpx;
}

.cart-tip {
  font-size: 20rpx;
  color: #a89d95;
}

.checkout-btn {
  padding: 0 34rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #e64340;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(30, 24, 21, 0.45);
  z-index: 30;
}

.cart-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 65vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 31;
  display: flex;
  flex-direction: column;
}

.cart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx 16rpx;
}

.cart-head-title {
  font-size: 30rpx;
  font-weight: 700;
}

.cart-clear {
  font-size: 24rpx;
  color: #948b84;
}

.cart-list {
  max-height: 52vh;
  padding: 0 30rpx 20rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3eeea;
}

.cart-item-title {
  font-size: 27rpx;
  font-weight: 600;
}

.cart-item-price {
  margin-top: 6rpx;
  color: #e64340;
  font-weight: 700;
  font-size: 26rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f6f4f1;
  color: #5e534c;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-value {
  min-width: 54rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
}

.spec-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 78vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 30rpx;
  z-index: 31;
  overflow-y: auto;
}

.spec-head {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.spec-title {
  font-size: 32rpx;
  font-weight: 700;
}

.spec-price {
  margin-top: 10rpx;
  color: #e64340;
  font-size: 34rpx;
  font-weight: 700;
}

.spec-close {
  font-size: 24rpx;
  color: #948b84;
  padding: 6rpx 0 6rpx 20rpx;
}

.spec-group {
  margin-bottom: 22rpx;
}

.spec-name {
  font-size: 25rpx;
  color: #6c625b;
  margin-bottom: 12rpx;
}

.spec-values {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.spec-value {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: #f6f4f1;
  color: #5e534c;
  font-size: 25rpx;
}

.spec-value-active {
  background: #fdf0ef;
  color: #c73b36;
  font-weight: 600;
  box-shadow: inset 0 0 0 1rpx #f0a9a6;
}

.spec-foot {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 20rpx;
}

.spec-add {
  flex: 1;
}

.spec-add-off {
  background: #d8d0ca;
}

.error-card {
  margin: 120rpx 24rpx 0;
  text-align: center;
}

.error-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.retry {
  margin-top: 24rpx;
}