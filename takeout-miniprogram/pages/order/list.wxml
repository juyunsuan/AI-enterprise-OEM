<view class="page safe-bottom">
  <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
    <view class="tabs-inner">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab {{tab === item.key ? 'tab-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="pickTab"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{error}}" class="card error-card">
    <view class="muted">{{error}}</view>
    <view class="btn btn-primary retry" bindtap="load">重试</view>
  </view>

  <view wx:if="{{!list.length && !loading && !error}}" class="empty">
    <view>还没有订单</view>
    <view class="btn btn-ghost empty-btn" bindtap="goMenu">去点餐</view>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="order-card">
    <view class="order-head" data-id="{{item.id}}" bindtap="goDetail">
      <view class="order-no">{{item.orderNo}}</view>
      <view class="order-status status-{{item.status}}">{{item.statusText}}</view>
    </view>
    <view class="order-meta">
      <text>{{item.modeText}}</text>
      <text class="dot">·</text>
      <text>{{item.createdAtText}}</text>
      <text wx:if="{{item.pickupCode}}" class="dot">·</text>
      <text wx:if="{{item.pickupCode}}">取餐号 {{item.pickupCode}}</text>
    </view>
    <view class="order-body" data-id="{{item.id}}" bindtap="goDetail">
      <image wx:if="{{item.coverImage}}" src="{{item.coverImage}}" mode="aspectFill" class="order-cover" />
      <view wx:else class="order-cover order-placeholder">菜</view>
      <view class="flex-1">
        <view class="order-items">{{item.itemsText || item.itemSummary}}</view>
        <view class="order-hint">{{item.statusHint}}</view>
        <view wx:if="{{item.canPay && item.countdownText}}" class="order-countdown">
          剩余 {{item.countdownText}} 自动取消
        </view>
      </view>
      <view class="order-amount">
        <view class="price"><text class="price-symbol">¥</text>{{item.payAmountText}}</view>
        <view class="muted text-12">共 {{item.itemCount}} 件</view>
      </view>
    </view>
    <view class="order-actions">
      <view class="action-btn" data-id="{{item.id}}" bindtap="goDetail">查看详情</view>
      <view wx:if="{{item.canCancel}}" class="action-btn" data-id="{{item.id}}" bindtap="cancelOrder">取消订单</view>
      <view wx:if="{{item.canPay}}" class="action-btn action-primary" data-id="{{item.id}}" bindtap="payOrder">去支付</view>
      <view wx:if="{{item.canReceive}}" class="action-btn action-primary" data-id="{{item.id}}" bindtap="receiveOrder">确认完成</view>
      <view wx:if="{{item.canAgain}}" class="action-btn action-primary" data-id="{{item.id}}" bindtap="again">再来一单</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading muted">加载中...</view>
  <view wx:if="{{!hasMore && list.length}}" class="loading muted">没有更多了</view>
</view>