.page {
  padding: 0 24rpx 40rpx;
}

.tabs {
  width: 100%;
  background: #ffffff;
  margin-bottom: 20rpx;
  position: sticky;
  top: 0;
  z-index: 5;
}

.tabs-inner {
  display: flex;
  padding: 12rpx 10rpx;
}

.tab {
  flex-shrink: 0;
  padding: 16rpx 26rpx;
  font-size: 26rpx;
  color: #7a6f67;
  border-radius: 14rpx;
}

.tab-active {
  background: #fdf0ef;
  color: #c73b36;
  font-weight: 700;
}

.order-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(44, 38, 34, 0.05);
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  font-size: 24rpx;
  color: #948b84;
}

.order-status {
  font-size: 26rpx;
  font-weight: 700;
  color: #b23b35;
}

.status-COMPLETED {
  color: #4c8c5a;
}

.status-CANCELLED {
  color: #a89d95;
}

.order-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a89d95;
}

.dot {
  margin: 0 8rpx;
}

.order-body {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
}

.order-cover {
  width: 108rpx;
  height: 108rpx;
  border-radius: 14rpx;
  margin-right: 18rpx;
  background: #f7efec;
  flex-shrink: 0;
}

.order-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d8b9ae;
  font-weight: 700;
}

.order-items {
  font-size: 26rpx;
  line-height: 1.5;
  color: #4a403a;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.order-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a89d95;
}

.order-countdown {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #d0453f;
}

.order-amount {
  margin-left: 16rpx;
  text-align: right;
  flex-shrink: 0;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f3eeea;
}

.action-btn {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e5ddd7;
  color: #6c625b;
  font-size: 24rpx;
}

.action-primary {
  border-color: #e64340;
  color: #c73b36;
  font-weight: 600;
}

.loading {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
}

.empty {
  padding-top: 160rpx;
}

.empty-btn {
  margin: 30rpx auto 0;
  width: 260rpx;
}

.error-card {
  margin-top: 80rpx;
  text-align: center;
}

.retry {
  margin-top: 24rpx;
}