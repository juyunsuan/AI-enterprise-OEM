.page {
  padding: 20rpx 24rpx 180rpx;
}

.hero {
  border-radius: 26rpx;
  padding: 34rpx 30rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #e64340 0%, #f06a45 100%);
  box-shadow: 0 14rpx 34rpx rgba(230, 67, 64, 0.22);
}

.hero-COMPLETED {
  background: linear-gradient(135deg, #4f8d5c 0%, #6aa776 100%);
  box-shadow: 0 14rpx 34rpx rgba(79, 141, 92, 0.2);
}

.hero-CANCELLED {
  background: linear-gradient(135deg, #8d827a 0%, #a89d95 100%);
  box-shadow: none;
}

.hero-status {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-hint {
  margin-top: 10rpx;
  font-size: 25rpx;
  opacity: 0.9;
}

.hero-count {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.pickup {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.18);
  text-align: center;
}

.pickup-label {
  font-size: 22rpx;
  opacity: 0.86;
}

.pickup-code {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  margin: 6rpx 0;
}

.pickup-tip {
  font-size: 22rpx;
  opacity: 0.86;
}

.table-no {
  margin-top: 16rpx;
  font-size: 26rpx;
}

.card {
  margin-top: 20rpx;
}

.block-head {
  font-size: 29rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.receiver-name {
  font-size: 30rpx;
  font-weight: 700;
}

.receiver-address {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #5e534c;
  line-height: 1.5;
}

.store-name {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.line {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.line-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 14rpx;
  margin-right: 18rpx;
  background: #f7efec;
}

.line-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d8b9ae;
  font-weight: 700;
}

.line-title {
  font-size: 27rpx;
  font-weight: 600;
}

.line-price {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #948b84;
}

.line-total {
  font-size: 27rpx;
  font-weight: 600;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 26rpx;
  color: #6c625b;
}

.amount-row.total {
  margin-top: 10rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1ece8;
  font-size: 28rpx;
  color: #2c2622;
  font-weight: 700;
}

.minus {
  color: #d0453f;
}

.timeline {
  padding-left: 8rpx;
}

.timeline-item {
  position: relative;
  padding: 0 0 26rpx 30rpx;
  border-left: 2rpx solid #f0e9e4;
}

.timeline-item:last-child {
  border-left-color: transparent;
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -9rpx;
  top: 6rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e64340;
}

.timeline-content {
  font-size: 26rpx;
  color: #4a403a;
  line-height: 1.5;
}

.timeline-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a89d95;
}

.remark-text {
  font-size: 26rpx;
  color: #5e534c;
  line-height: 1.6;
}

.bottom-space {
  height: 20rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  padding: 18rpx 28rpx;
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(44, 38, 34, 0.08);
  z-index: 10;
}

.action-btn {
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e5ddd7;
  color: #6c625b;
  font-size: 26rpx;
}

.action-primary {
  border-color: #e64340;
  background: #e64340;
  color: #ffffff;
  font-weight: 600;
}

.error-card {
  margin-top: 100rpx;
  text-align: center;
}

.retry {
  margin-top: 24rpx;
}