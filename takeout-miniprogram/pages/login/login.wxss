.page {
  padding: 160rpx 60rpx 60rpx;
  text-align: center;
}

.brand-mark {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 26rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #e64340 0%, #f06a45 100%);
  color: #ffffff;
  font-size: 58rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 36rpx rgba(230, 67, 64, 0.26);
}

.brand-title {
  font-size: 40rpx;
  font-weight: 700;
}

.brand-sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #948b84;
}

.error {
  margin-top: 50rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #fdf0ef;
  color: #c73b36;
  font-size: 25rpx;
  text-align: left;
}

.login-btn {
  margin-top: 60rpx;
}

.tip {
  margin-top: 24rpx;
  line-height: 1.6;
}