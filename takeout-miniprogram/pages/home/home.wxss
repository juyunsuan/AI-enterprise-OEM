.page {
  padding: 24rpx 24rpx 40rpx;
}

.hero {
  background: linear-gradient(135deg, #e64340 0%, #f06a45 100%);
  border-radius: 28rpx;
  padding: 34rpx 30rpx;
  color: #ffffff;
  box-shadow: 0 16rpx 36rpx rgba(230, 67, 64, 0.24);
}

.hero-top {
  display: flex;
  align-items: center;
}

.logo {
  width: 108rpx;
  height: 108rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  margin-right: 20rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-img {
  width: 100%;
  height: 100%;
}

.logo-fallback {
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  padding: 0 8rpx;
  line-height: 1.2;
}

.hero-name {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-slogan {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.86;
}

.status {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
}

.status-open {
  background: rgba(255, 255, 255, 0.92);
  color: #c73b36;
  font-weight: 600;
}

.status-closed {
  background: rgba(60, 40, 38, 0.35);
  color: #ffe7e5;
}

.hero-info {
  margin-top: 26rpx;
  font-size: 26rpx;
  opacity: 0.95;
}

.closed-tip {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(60, 40, 38, 0.24);
  font-size: 23rpx;
}

.announcement {
  margin-top: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 22rpx 24rpx;
}

.announcement-text {
  flex: 1;
  font-size: 25rpx;
  color: #6c625b;
  line-height: 1.5;
}

.mode-row {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.mode-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #ffffff;
  color: #7b6f67;
  font-size: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(44, 38, 34, 0.04);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 4rpx 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
}

.section-more {
  font-size: 24rpx;
  color: #b23b35;
}

.order-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #fff5ef;
  border: 1rpx solid #ffe0d2;
}

.cta-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #c54239;
}

.cta-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #a28174;
}

.cta-btn {
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  background: #e64340;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.hot-scroll {
  width: 100%;
}

.hot-list {
  display: flex;
  gap: 18rpx;
  padding: 4rpx 2rpx 12rpx;
}

.hot-card {
  width: 240rpx;
  flex-shrink: 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 14rpx;
  box-shadow: 0 8rpx 20rpx rgba(44, 38, 34, 0.05);
}

.hot-img {
  width: 100%;
  height: 160rpx;
  border-radius: 14rpx;
  background: #f7efec;
}

.hot-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d8b9ae;
  font-size: 44rpx;
  font-weight: 700;
}

.hot-title {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.hot-foot {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.hot-sales {
  font-size: 20rpx;
  color: #a89d95;
}

.quick-grid {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 10rpx;
  box-shadow: 0 8rpx 24rpx rgba(44, 38, 34, 0.05);
}

.quick-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #6c625b;
}

.quick-icon {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 12rpx;
  border-radius: 22rpx;
  background: #fdf0ed;
  color: #d0453f;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.footer {
  margin: 40rpx 0 10rpx;
  text-align: center;
}

.error-card {
  margin-top: 120rpx;
  text-align: center;
}

.error-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.retry {
  margin-top: 28rpx;
}