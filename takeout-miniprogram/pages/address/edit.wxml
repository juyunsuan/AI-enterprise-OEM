<view class="page">
  <view wx:if="{{loading}}" class="empty">正在加载地址...</view>

  <block wx:else>
    <view class="card form">
      <view class="field">
        <view class="label">收货人</view>
        <input class="input" data-field="realName" value="{{form.realName}}" placeholder="姓名" bindinput="onInput" />
      </view>
      <view class="field">
        <view class="label">手机号</view>
        <input class="input" type="number" data-field="phone" value="{{form.phone}}" placeholder="手机号" bindinput="onInput" />
      </view>
      <picker mode="region" value="{{region}}" bindchange="onRegion">
        <view class="field">
          <view class="label">所在地区</view>
          <view class="input picker-value {{form.city ? '' : 'placeholder'}}">{{regionText}}</view>
        </view>
      </picker>
      <view class="field">
        <view class="label">详细地址</view>
        <input class="input" data-field="detail" value="{{form.detail}}" placeholder="街道、门牌号、楼层房间号" bindinput="onInput" />
      </view>
      <view class="field">
        <view class="label">标签</view>
        <input class="input" data-field="tag" value="{{form.tag}}" placeholder="家 / 公司 / 学校（选填）" bindinput="onInput" />
      </view>
      <view class="field switch-row">
        <view>
          <view class="label">设为默认地址</view>
          <view class="muted text-12">下单时优先使用</view>
        </view>
        <switch checked="{{form.isDefault}}" color="#e64340" bindchange="onDefault" />
      </view>
    </view>

    <view class="btn btn-primary save-btn" bindtap="save">{{saving ? '保存中...' : '保存地址'}}</view>
  </block>
</view>