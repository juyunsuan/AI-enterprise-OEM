<view class="page safe-bottom">
  <view wx:if="{{loading}}" class="empty">正在加载地址...</view>

  <view wx:elif="{{error}}" class="card error-card">
    <view class="muted">{{error}}</view>
    <view class="btn btn-primary retry" bindtap="load">重试</view>
  </view>

  <block wx:else>
    <view wx:if="{{!addresses.length}}" class="empty">
      <view>还没有收货地址</view>
      <view class="muted text-12">添加后外卖配送可直接选用</view>
    </view>

    <view wx:for="{{addresses}}" wx:key="id" class="address-card" data-id="{{item.id}}" bindtap="choose">
      <view class="address-head">
        <view class="address-name">{{item.realName}}</view>
        <view class="address-phone">{{item.phone}}</view>
        <view wx:if="{{item.isDefault}}" class="default-tag">默认</view>
        <view wx:if="{{item.tag}}" class="tag">{{item.tag}}</view>
      </view>
      <view class="address-line">{{item.regionText}} {{item.detail}}</view>
      <view class="address-actions">
        <view class="link" data-id="{{item.id}}" catchtap="setDefault">
          {{item.isDefault ? '已设为默认' : '设为默认'}}
        </view>
        <view class="link" data-id="{{item.id}}" catchtap="edit">编辑</view>
        <view class="link link-danger" data-id="{{item.id}}" catchtap="remove">删除</view>
      </view>
    </view>

    <view class="btn btn-primary add-btn safe-bottom" bindtap="add">新增收货地址</view>
  </block>
</view>