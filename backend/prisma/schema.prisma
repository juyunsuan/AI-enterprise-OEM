}

/// 店铺自有字典项（过敏原、疾病名、生活习惯等）。
model HealthDictItem {
  id       Int    @id @default(autoincrement())
  shopId   Int    @map("shop_id")
  groupKey String @map("group_key") @db.VarChar(40)
  label    String @db.VarChar(60)
  value    String @default("") @db.VarChar(60)
  sort     Int    @default(0)
  status   String @default("ON") @db.VarChar(8)

  @@index([shopId, groupKey, status])
  @@map("health_dict_items")
}

/// 监测指标定义（血压/血糖/体重…；含正常区间与单位）。
model HealthMetric {
  id           Int      @id @default(autoincrement())
  shopId       Int      @map("shop_id")
  mKey         String   @map("metric_key") @db.VarChar(40)
  name         String   @db.VarChar(40)
  unit         String   @default("") @db.VarChar(20)
  decimalScale Int      @default(1) @map("decimal_scale")
  normalMin    Decimal  @default(0) @map("normal_min") @db.Decimal(10, 3)
  normalMax    Decimal  @default(0) @map("normal_max") @db.Decimal(10, 3)
  extraFieldsJson Json  @default("[]") @map("extra_fields_json")
  sort         Int      @default(0)
  status       String   @default("ON") @db.VarChar(8)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([shopId, mKey])
  @@map("health_metrics")
}

/// 指标读数（采集来源：手动 / 设备 / 报告 / 导入）。
model HealthMetricLog {
  id            Int      @id @default(autoincrement())
  shopId        Int      @map("shop_id")
  patientId     Int      @map("patient_id")
  metricId      Int      @map("metric_id")
  metricKey     String   @map("metric_key") @db.VarChar(40)
  value         Decimal  @db.Decimal(10, 3)
  extrasJson    Json     @default("{}") @map("extras_json")
  /// MANUAL | DEVICE | REPORT | IMPORT
  source        String   @default("MANUAL") @db.VarChar(16)
  sourceRefId   Int      @default(0) @map("source_ref_id")
  measuredAt    DateTime @map("measured_at")
  abnormal      Boolean  @default(false)
  remark        String   @default("") @db.VarChar(200)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([shopId, patientId, metricKey, measuredAt])
  @@index([shopId, measuredAt])
  @@map("health_metric_logs")
}

/// 预警规则：绝对值 / 基线偏移 / 连续 N 次 / 周期次数上限。
model HealthAlertRule {
  id            Int      @id @default(autoincrement())
  shopId        Int      @map("shop_id")
  name          String   @db.VarChar(60)
  metricKey     String   @map("metric_key") @db.VarChar(40)
  /// ABSOLUTE | BASELINE_DELTA | CONSECUTIVE | PERIOD_LIMIT
  ruleType      String   @map("rule_type") @db.VarChar(20)
  direction     String   @default("ANY") @db.VarChar(8)
  threshold     Decimal  @default(0) @db.Decimal(10, 3)
  lowThreshold  Decimal  @default(0) @map("low_threshold") @db.Decimal(10, 3)
  deltaPercent  Int      @default(0) @map("delta_percent")
  consecutive   Int      @default(1)
  windowHours   Int      @default(24) @map("window_hours")
  maxCount      Int      @default(0) @map("max_count")
  crowdGroupId  Int      @default(0) @map("crowd_group_id")
  patientId     Int      @default(0) @map("patient_id")
  /// LOW | MEDIUM | HIGH
  level         String   @default("MEDIUM") @db.VarChar(12)
  notifyJson    Json     @default("[]") @map("notify_json")
  dedupeMinutes Int      @default(60) @map("dedupe_minutes")
  status        String   @default("ON") @db.VarChar(8)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, metricKey])
  @@map("health_alert_rules")
}

/// 预警实例（去重窗口内同规则同就诊人只留一条未处理）。
model HealthAlert {
  id            Int      @id @default(autoincrement())
  shopId        Int      @map("shop_id")
  ruleId        Int      @map("rule_id")
  patientId     Int      @map("patient_id")
  metricKey     String   @map("metric_key") @db.VarChar(40)
  value         Decimal  @default(0) @db.Decimal(10, 3)
  baseline      Decimal  @default(0) @db.Decimal(10, 3)
  level         String   @default("MEDIUM") @db.VarChar(12)
  detailJson    Json     @default("{}") @map("detail_json")
  /// OPEN | HANDLED | IGNORED
  status        String   @default("OPEN") @db.VarChar(12)
  handleBy      String   @default("") @map("handle_by") @db.VarChar(64)
  handleNote    String   @default("") @map("handle_note") @db.VarChar(500)
  handledAt     DateTime? @map("handled_at")
  dedupeKey     String   @map("dedupe_key") @db.VarChar(120)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([shopId, dedupeKey, createdAt])
  @@index([shopId, status, createdAt])
  @@index([shopId, patientId, createdAt])
  @@map("health_alerts")
}

/// 管理方案模板（按人群/病种编排步骤）。
model HealthPlan {
  id          Int      @id @default(autoincrement())
  shopId      Int      @map("shop_id")
  name        String   @db.VarChar(80)
  crowdKind   String   @default("ALL") @map("crowd_kind") @db.VarChar(24)
  diseaseKey  String   @default("") @map("disease_key") @db.VarChar(40)
  desc        String   @default("") @db.VarChar(500)
  coverImage  String   @default("") @map("cover_image") @db.VarChar(500)
  durationDays Int     @default(30) @map("duration_days")
  priceCents  Int      @default(0) @map("price_cents")
  /// DRAFT | PUBLISHED | OFFLINE
  status      String   @default("DRAFT") @db.VarChar(16)
  sort        Int      @default(0)
  createdBy   String   @default("") @map("created_by") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, sort])
  @@map("health_plans")
}

/// 方案步骤（监测 / 随访 / 量表 / 用药提醒 / 任务）。
model HealthPlanStep {
  id            Int    @id @default(autoincrement())
  shopId        Int    @map("shop_id")
  planId        Int    @map("plan_id")
  /// METRIC | FOLLOWUP | SURVEY | MEDICATION | TASK | EDUCATION
  type          String @db.VarChar(20)
  name          String @db.VarChar(80)
  refKey        String @default("") @map("ref_key") @db.VarChar(60)
  /// DAY | WEEK | MONTH
  cycleUnit     String @default("DAY") @map("cycle_unit") @db.VarChar(8)
  cycleValue    Int    @default(1) @map("cycle_value")
  startOffsetDay Int   @default(0) @map("start_offset_day")
  endOffsetDay  Int    @default(0) @map("end_offset_day")
  required      Boolean @default(true)
  instruction   String @default("") @db.VarChar(1000)
  configJson    Json   @default("{}") @map("config_json")
  sort          Int    @default(0)

  @@index([shopId, planId, sort])
  @@map("health_plan_steps")
}

/// 患者已订购的方案实例（含生效/到期与完成度）。
model HealthPatientPlan {
  id           Int      @id @default(autoincrement())
  shopId       Int      @map("shop_id")
  planId       Int      @map("plan_id")
