  doctorName    String   @default("") @map("doctor_name") @db.VarChar(60)
  occurAt       DateTime? @map("occur_at")
  leaveAt       DateTime? @map("leave_at")
  diagnosis     String   @default("") @db.VarChar(500)
  summary       String   @default("") @db.Text
  filesJson     Json     @default("[]") @map("files_json")
  source        String   @default("CUSTOMER") @db.VarChar(16)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([shopId, patientId, occurAt])
