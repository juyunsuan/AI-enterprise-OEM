  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([shopId, pageKey])
  @@map("health_diy_pages")
}

/// 「全部服务」入口开关与排序（能力开关，不删数据）。
model HealthServiceEntry {
  id     Int    @id @default(autoincrement())
  shopId Int    @map("shop_id")
  eKey   String @map("entry_key") @db.VarChar(30)
  visible Boolean @default(true)
  sort   Int    @default(0)

  @@unique([shopId, eKey])
  @@map("health_service_entries")
}

/// 协议与须知（服务/隐私/就诊须知/采集告知/提现规则/退款规则）。
model HealthAgreement {
