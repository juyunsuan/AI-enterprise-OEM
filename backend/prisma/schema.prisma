  aiworkinSyncStatus   String   @default("PENDING") @map("aiworkin_sync_status") @db.VarChar(16)
  aiworkinSyncError    String   @default("") @map("aiworkin_sync_error") @db.VarChar(500)
  events               Json     @default("[]")
  messages             Json     @default("[]")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([createdBy])
  @@index([providerUserId, status])
  @@index([province, city])
  @@index([enterpriseId, id], map: "marketing_orders_enterprise_id_id_idx")
  @@index([staffUserId, id], map: "marketing_orders_staff_user_id_id_idx")
  @@map("marketing_orders")
