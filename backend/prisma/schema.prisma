  @@unique([siteId, riderId, cardNoHash])
  @@index([siteId, riderId])
  @@map("errand_rider_bank_cards")
}

/// 城市代理：下游独立账号（手机号+密码），由平台账号创建/停用；按城市分佣。
model ErrandAgent {
  id             Int      @id @default(autoincrement())
