  @@index([orderId])
  @@index([shopId, productId])
  @@map("takeout_order_items")
}

model TakeoutOrderLog {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  shopId       Int      @map("shop_id")
  operatorType String   @map("operator_type") @db.VarChar(16)
  operatorId   String   @default("") @map("operator_id") @db.VarChar(64)
  action       String   @db.VarChar(40)
  content      String   @default("") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([orderId, id])
  @@map("takeout_order_logs")
}

/// 通用终端 SCRM 接入开关与最近打标状态（onsite/card/kuaidi/errand/circle/dh/kp）。
/// 按 owner + scene + sourceId 隔离；品牌/外卖/健康/多店/租赁仍用各自 outbox。
model TerminalScrmSetting {
  id           Int       @id @default(autoincrement())
  ownerUserId  String    @map("owner_user_id") @db.VarChar(64)
  scene        String    @db.VarChar(16)
  sourceId     Int       @map("source_id")
  enabled      Boolean   @default(false)
  lastEventKind String   @default("") @map("last_event_kind") @db.VarChar(32)
  lastTaggedAt DateTime? @map("last_tagged_at")
  lastError    String    @default("") @map("last_error") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([ownerUserId, scene, sourceId], map: "terminal_scrm_settings_owner_scene_source_uniq")
  @@index([ownerUserId, scene])
  @@map("terminal_scrm_settings")
}

/// 通用终端 SCRM 事件去重台账：同一顾客注册/同一订单付款只打标一次。
model TerminalScrmEvent {
  id          Int      @id @default(autoincrement())
  dedupeKey   String   @unique @map("dedupe_key") @db.VarChar(191)
  scene       String   @db.VarChar(16)
  ownerUserId String   @map("owner_user_id") @db.VarChar(64)
  sourceId    Int      @map("source_id")
  customerId  Int      @map("customer_id")
  kind        String   @db.VarChar(32)
  recordKey   String   @default("") @map("record_key") @db.VarChar(64)
  /// SENT | SKIPPED | FAILED
  status      String   @default("SENT") @db.VarChar(16)
  error       String   @default("") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([scene, sourceId, createdAt])
  @@map("terminal_scrm_events")
}

/// SCRM 外发箱：外卖事件只进这张表，不写品牌商城的 outbox。
model TakeoutScrmOutbox {
  id          Int       @id @default(autoincrement())
  dedupeKey   String    @unique @map("dedupe_key") @db.VarChar(191)
  shopId      Int       @map("shop_id")
  ownerUserId String    @map("owner_user_id") @db.VarChar(64)
  customerId  Int       @map("customer_id")
  kind        String    @db.VarChar(32)
  payload     Json      @default("{}")
  /// PENDING | SENT | SKIPPED | DEAD
  status      String    @default("PENDING") @db.VarChar(16)
  attempts    Int       @default(0)
  nextRetryAt DateTime? @map("next_retry_at")
  lastError   String    @default("") @map("last_error") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")
  sentAt      DateTime? @map("sent_at")

  @@index([status, nextRetryAt])
  @@index([shopId, customerId])
  @@map("takeout_scrm_outbox")
}
// ============================================================================
// 租赁管理小程序：门店 / 通用租品 / C 端顾客 / 员工 / 租单 / 验车 / SCRM 外发箱
// 金额一律 DECIMAL(12,2)，服务层换算成分做整数运算；订单号前缀 RN。
// C 端顾客与员工令牌走 private-mini 底座，与站内账号物理隔离；后台管理复用站内账号。
// ============================================================================

model RentalShop {
  id               Int      @id @default(autoincrement())
  ownerUserId      String   @map("owner_user_id") @db.VarChar(64)
  name             String   @db.VarChar(120)
  /// 公开寻址码：小程序包内 shopCode，全局唯一，创建后不变
  shopCode         String   @unique @map("shop_code") @db.VarChar(16)
  logo             String   @default("") @db.VarChar(500)
  servicePhone     String   @default("") @map("service_phone") @db.VarChar(32)
  address          String   @default("") @db.VarChar(200)
  /// DRAFT 未上线 | ONLINE 营业中 | SUSPENDED 平台停服（数据保留）| CLOSED 已关闭
  status           String   @default("DRAFT") @db.VarChar(16)
  /// 主题：{ themeColor, navigationTitle }
  themeJson        Json     @default("{}") @map("theme_json")
  /// 交易参数：{ autoCancelMinutes, maxRentDays, depositRefundHours, depositRefundAuto, deskSiteKey, scrmCodeId }
  tradeJson        Json     @default("{}") @map("trade_json")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, status])
  @@map("rental_shops")
}

/// 通用租品：车辆/设备/场地共用一张表，差异放 attributes JSON。
model RentalItem {
  id             Int      @id @default(autoincrement())
  shopId         Int      @map("shop_id")
  category       String   @default("") @db.VarChar(60)
  name           String   @db.VarChar(120)
  cover          String   @default("") @db.VarChar(500)
  imagesJson     Json     @default("[]") @map("images_json")
  description    String   @default("") @db.Text
  /// 车牌/座位/变速箱、设备型号/功率、场地面积等：租品自定义键值
  attributesJson Json     @default("{}") @map("attributes_json")
  dailyRate      Decimal  @default(0) @map("daily_rate") @db.Decimal(12, 2)
  deposit        Decimal  @default(0) @db.Decimal(12, 2)
  stock          Int      @default(1)
  /// ONLINE 在租 | OFFLINE 下架
  status         String   @default("ONLINE") @db.VarChar(16)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, sortOrder])
  @@index([shopId, category])
  @@map("rental_items")
}

/// C 端顾客：一店一套，唯一键 (shopId, openid)；手机号可回挂 CRM 客户。
model RentalCustomer {
  id             Int       @id @default(autoincrement())
  shopId         Int       @map("shop_id")
  openid         String    @db.VarChar(64)
  unionId        String    @default("") @map("union_id") @db.VarChar(64)
  nickname       String    @default("") @db.VarChar(120)
  avatar         String    @default("") @db.VarChar(500)
  phone          String    @default("") @db.VarChar(32)
  /// MINIPROGRAM 小程序顾客 | ADMIN 后台手工建档
  source         String    @default("MINIPROGRAM") @db.VarChar(16)
  /// 0 未知 | 1 男 | 2 女（参考项目的客户性别统计口径）
  gender         Int       @default(0) @db.TinyInt
  city           String    @default("") @db.VarChar(60)
  remark         String    @default("") @db.VarChar(500)
  /// 回挂站内 CRM 客户（0 = 未关联），订单/统计仍以本域为准
  crmCustomerId  Int       @default(0) @map("crm_customer_id")
  /// ACTIVE 正常 | BLOCKED 店主拉黑
  status         String    @default("ACTIVE") @db.VarChar(16)
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([shopId, openid])
  @@index([shopId, phone])
  @@map("rental_customers")
}

/// 门店员工：只在本域使用，绑定小程序员工端的手机号 + 工号；
/// 后台管理员身份仍走站内 Account/RBAC，不在此表。
model RentalStaff {
  id         Int      @id @default(autoincrement())
  shopId     Int      @map("shop_id")
  name       String   @db.VarChar(60)
  phone      String   @db.VarChar(32)
  staffCode  String   @map("staff_code") @db.VarChar(32)
  /// OWNER 店长 | CLERK 店员 | INSPECTOR 验车员
  role       String   @default("CLERK") @db.VarChar(16)
  /// ACTIVE 在岗 | SUSPENDED 停用
  status     String   @default("ACTIVE") @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([shopId, staffCode])
  @@index([shopId, phone, status])
  @@map("rental_staffs")
}

/// 租单主表：一笔订单一个租品；金额为成交快照，退款与押金结算只追加不回溯。
model RentalOrder {
  id              Int       @id @default(autoincrement())
  orderNo         String    @unique @map("order_no") @db.VarChar(40)
  shopId          Int       @map("shop_id")
  customerId      Int       @map("customer_id")
  customerName    String    @default("") @map("customer_name") @db.VarChar(60)
  customerPhone   String    @default("") @map("customer_phone") @db.VarChar(32)
  itemId          Int       @map("item_id")
  itemName        String    @default("") @map("item_name") @db.VarChar(120)
  /// 下单时的租品快照（名称/属性/日租金/押金/封面）
  itemSnapshot    Json      @default("{}") @map("item_snapshot")
  startAt         DateTime  @map("start_at")
  endAt           DateTime  @map("end_at")
  days            Int       @default(1)
  dailyRate       Decimal   @default(0) @map("daily_rate") @db.Decimal(12, 2)
  rentAmount      Decimal   @default(0) @map("rent_amount") @db.Decimal(12, 2)
  depositAmount   Decimal   @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  discount        Decimal   @default(0) @db.Decimal(12, 2)
  payAmount       Decimal   @default(0) @map("pay_amount") @db.Decimal(12, 2)
  damageFee       Decimal   @default(0) @map("damage_fee") @db.Decimal(12, 2)
  refundAmount    Decimal   @default(0) @map("refund_amount") @db.Decimal(12, 2)
  /// 经办员工快照：线下开单 / 取车 / 还回三段分别留痕，用于业绩统计
  salesStaffId    Int       @default(0) @map("sales_staff_id")
  salesStaffName  String    @default("") @map("sales_staff_name") @db.VarChar(60)
  pickupStaffId   Int       @default(0) @map("pickup_staff_id")
  pickupStaffName String    @default("") @map("pickup_staff_name") @db.VarChar(60)
  returnStaffId   Int       @default(0) @map("return_staff_id")
  returnStaffName String    @default("") @map("return_staff_name") @db.VarChar(60)
  /// PENDING_PAYMENT | PAID | PICKED_UP | RETURNED | COMPLETED | CANCELLED | EXPIRED
  status          String    @default("PENDING_PAYMENT") @db.VarChar(24)
  /// UNPAID | PAID | REFUNDING | REFUNDED
  payStatus       String    @default("UNPAID") @map("pay_status") @db.VarChar(16)
  payType         String    @default("WECHAT") @map("pay_type") @db.VarChar(12)
  transactionId   String    @default("") @map("transaction_id") @db.VarChar(64)
  prepayId        String    @default("") @map("prepay_id") @db.VarChar(64)
  paidAt          DateTime? @map("paid_at")
  expireAt        DateTime? @map("expire_at")
  pickupAt        DateTime? @map("pickup_at")
  returnAt        DateTime? @map("return_at")
  completedAt     DateTime? @map("completed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  customerRemark  String    @default("") @map("customer_remark") @db.VarChar(500)
  staffNote       String    @default("") @map("staff_note") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([shopId, status, createdAt])
  @@index([shopId, customerId])
  @@index([shopId, itemId, startAt])
  @@map("rental_orders")
}

/// 交接与还回验车：取车/还回各一行，图片只存直链。
model RentalInspection {
  id             Int      @id @default(autoincrement())
  shopId         Int      @map("shop_id")
  orderId        Int      @map("order_id")
  /// HANDOVER 取车 | RETURN 还回
  kind           String   @db.VarChar(16)
  mileage        Int      @default(0)
  fuelPercent    Int      @default(100) @map("fuel_percent")
  damage         String   @default("") @db.Text
  damageFee      Decimal  @default(0) @map("damage_fee") @db.Decimal(12, 2)
  imagesJson     Json     @default("[]") @map("images_json")
  note           String   @default("") @db.VarChar(1000)
  operatorStaffId Int     @default(0) @map("operator_staff_id")
  operatorName   String   @default("") @map("operator_name") @db.VarChar(60)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([shopId, orderId, kind])
  @@map("rental_inspections")
}

/// SCRM 外发箱：租赁事件只进这张表，不写别域 outbox，也不直写 scrm_*。
model RentalScrmOutbox {
  id          Int       @id @default(autoincrement())
  dedupeKey   String    @unique @map("dedupe_key") @db.VarChar(191)
  shopId      Int       @map("shop_id")
  ownerUserId String    @map("owner_user_id") @db.VarChar(64)
  customerId  Int       @map("customer_id")
  kind        String    @db.VarChar(32)
  payload     Json      @default("{}")
  /// PENDING | SENT | SKIPPED | DEAD
  status      String    @default("PENDING") @db.VarChar(16)
  attempts    Int       @default(0)
  nextRetryAt DateTime? @map("next_retry_at")
  lastError   String    @default("") @map("last_error") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")
  sentAt      DateTime? @map("sent_at")

  @@index([status, nextRetryAt])
  @@index([shopId, customerId])
  @@map("rental_scrm_outbox")
}
// ---------------------------------------------------------------------------
// 园区管理（独立数据域：不与租赁/跑腿/商城的顾客、员工、订单表共用）
// ---------------------------------------------------------------------------

/// 园区站点：一个账号可管理多个园区；parkCode 是小程序寻址码，也是租户隔离锚点。
model ParkSite {
  id          Int      @id @default(autoincrement())
  ownerUserId String   @map("owner_user_id") @db.VarChar(64)
  parkCode    String   @unique @map("park_code") @db.VarChar(16)
  name        String   @db.VarChar(120)
  logo        String   @default("") @db.VarChar(500)
  themeColor  String   @default("#3370FF") @map("theme_color") @db.VarChar(16)
  province    String   @default("") @db.VarChar(40)
  city        String   @default("") @db.VarChar(40)
  district    String   @default("") @db.VarChar(40)
  addressLine String   @default("") @map("address_line") @db.VarChar(200)
  lng         Float    @default(0)
  lat         Float    @default(0)
  phone       String   @default("") @db.VarChar(32)
  notice      String   @default("") @db.VarChar(500)
  /// 在线客服：绑定 service-desk 站点 siteKey，空 = 不启用
  deskSiteKey String   @default("") @map("desk_site_key") @db.VarChar(64)
  /// 小程序栏目开关/园区设置 JSON
  settings    Json     @default("{}")
  /// DRAFT 未上线 | ONLINE 运营中 | SUSPENDED 已停用 | CLOSED 已关闭
  status      String   @default("DRAFT") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, status])
  @@map("park_sites")
}

/// 楼宇
model ParkBuilding {
  id          Int      @id @default(autoincrement())
  siteId      Int      @map("site_id")
  name        String   @db.VarChar(80)
  floors      Int      @default(1)
  addressLine String   @default("") @map("address_line") @db.VarChar(200)
  sort        Int      @default(0)
  status      String   @default("ACTIVE") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([siteId, name])
  @@index([siteId])
  @@map("park_buildings")
}

/// 房间/房源：园区最小的空间单元。
model ParkUnit {
  id         Int      @id @default(autoincrement())
  siteId     Int      @map("site_id")
  buildingId Int      @map("building_id")
  roomNo     String   @map("room_no") @db.VarChar(40)
  floor      Int      @default(1)
  area       Decimal  @default(0) @db.Decimal(12, 2)
  usage      String   @default("OFFICE") @db.VarChar(24)
  /// VACANT 空置 | OCCUPIED 已租 | DISABLED 停用
  status     String   @default("VACANT") @db.VarChar(16)
  tenantId   Int      @default(0) @map("tenant_id")
  attributes Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([siteId, buildingId, roomNo])
  @@index([siteId, status])
  @@index([siteId, tenantId])
  @@map("park_units")
}

/// 租户企业：园区外部主体，不关联站内 EnterpriseProfile。
model ParkTenant {
  id           Int      @id @default(autoincrement())
  siteId       Int      @map("site_id")
  name         String   @db.VarChar(120)
  creditCode   String   @default("") @map("credit_code") @db.VarChar(32)
  industry     String   @default("") @db.VarChar(40)
  contactName  String   @default("") @map("contact_name") @db.VarChar(64)
  contactPhone String   @default("") @map("contact_phone") @db.VarChar(32)
  /// 绑定房间 id 列表；ParkUnit.tenantId 同步维护，列表查询不用逐行反查。
  unitIds      Json     @default("[]") @map("unit_ids")
  /// 员工自助加入企业的邀请码；同一园区内唯一，创建时自动生成。
  joinCode     String   @default("") @map("join_code") @db.VarChar(12)
  /// ACTIVE 在园 | LEFT 已退园 | DISABLED 停用
  status       String   @default("ACTIVE") @db.VarChar(16)
  note         String   @default("") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([siteId, name])
  @@index([siteId, status])
  @@index([siteId, joinCode])
  @@map("park_tenants")
}

/// 园区 C 端用户：微信 openid 身份，与站内 User / 租赁顾客物理隔离。
model ParkCustomer {
  id          Int       @id @default(autoincrement())
  siteId      Int       @map("site_id")
  openid      String    @db.VarChar(64)
  unionId     String    @default("") @map("union_id") @db.VarChar(64)
  nickname    String    @default("") @db.VarChar(60)
  phone       String    @default("") @db.VarChar(32)
  avatar      String    @default("") @db.VarChar(500)
  tenantId    Int       @default(0) @map("tenant_id")
  /// EMPLOYEE 企业员工 | TENANT_ADMIN 企业管理员 | VISITOR 访客
  memberRole  String    @default("VISITOR") @map("member_role") @db.VarChar(16)
  status      String    @default("ACTIVE") @db.VarChar(16)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([siteId, openid])
  @@index([siteId, tenantId])
  @@index([siteId, phone])
  @@map("park_customers")
}

/// 园区员工：手机号 + 工号绑定员工端，与站内职员/租赁员工物理隔离。
model ParkStaff {
  id         Int      @id @default(autoincrement())
  siteId     Int      @map("site_id")
  name       String   @db.VarChar(60)
  phone      String   @db.VarChar(32)
  staffCode  String   @map("staff_code") @db.VarChar(32)
  /// OWNER 园区管理员 | CLERK 运营 | GUARD 门岗 | APPROVER 审批人 | INSPECTOR 巡检
  role       String   @default("CLERK") @db.VarChar(20)
  department String   @default("") @db.VarChar(40)
  status     String   @default("ACTIVE") @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([siteId, staffCode])
  @@index([siteId, phone, status])
  @@map("park_staffs")
}

/// 审批流模板：按园区 + 业务类型唯一；节点定义冻结进单据快照。
model ParkApprovalFlow {
  id        Int      @id @default(autoincrement())
  siteId    Int      @map("site_id")
  /// VISITOR | VENUE | MOVE_IN | DECORATION | WORK_ORDER
  bizType   String   @map("biz_type") @db.VarChar(24)
  name      String   @db.VarChar(80)
  /// { nodes: [{ name, approverType, role, staffIds, mode }] }
  nodes     Json     @default("[]")
  enabled   Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([siteId, bizType])
  @@map("park_approval_flows")
}

/// 审批单：外部申请人（顾客）与内部申请人（员工）共用；应用层按 applicantType 区分。
model ParkApproval {
  id            Int       @id @default(autoincrement())
  siteId        Int       @map("site_id")
  bizType       String    @map("biz_type") @db.VarChar(24)
  bizId         Int       @default(0) @map("biz_id")
  title         String    @db.VarChar(160)
  /// CUSTOMER | STAFF
  applicantType String    @map("applicant_type") @db.VarChar(16)
  applicantId   Int       @map("applicant_id")
  applicantName String    @default("") @map("applicant_name") @db.VarChar(60)
  tenantId      Int       @default(0) @map("tenant_id")
  formData      Json      @default("{}") @map("form_data")
  flowSnapshot  Json      @default("[]") @map("flow_snapshot")
  /// APPROVING | APPROVED | REJECTED | WITHDRAWN | EXPIRED
  status        String    @default("APPROVING") @db.VarChar(16)
  currentNode   Int       @default(0) @map("current_node")
  submittedAt   DateTime? @map("submitted_at")
  finishedAt    DateTime? @map("finished_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([siteId, bizType, status])
  @@index([applicantType, applicantId])
  @@map("park_approvals")
}

/// 审批任务：approverType=STAFF 时 approverId 是 park_staffs.id；TENANT_ADMIN 时是 park_customers.id。
model ParkApprovalTask {
  id           Int       @id @default(autoincrement())
  approvalId   Int       @map("approval_id")
  nodeIndex    Int       @map("node_index")
  nodeName     String    @default("") @map("node_name") @db.VarChar(60)
  approverType String    @map("approver_type") @db.VarChar(16)
  approverId   Int       @map("approver_id")
  /// PENDING | APPROVED | REJECTED | SKIPPED
  status       String    @default("PENDING") @db.VarChar(16)
  action       String    @default("") @db.VarChar(16)
  comment      String    @default("") @db.VarChar(500)
  actedAt      DateTime? @map("acted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([approverType, approverId, status])
  @@index([approvalId, nodeIndex])
  @@map("park_approval_tasks")
}

/// 审批日志
model ParkApprovalLog {
  id           Int      @id @default(autoincrement())
  approvalId   Int      @map("approval_id")
  action       String   @db.VarChar(16)
  operatorType String   @map("operator_type") @db.VarChar(16)
  operatorId   Int      @map("operator_id")
  operatorName String   @default("") @map("operator_name") @db.VarChar(60)
  comment      String   @default("") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([approvalId, createdAt])
  @@map("park_approval_logs")
}

/// 园区场地/会议室：关联 gaps.AppointmentEvent 复用时段与并发占位，不另造时段引擎。
model ParkResource {
  id               Int      @id @default(autoincrement())
  siteId           Int      @map("site_id")
  buildingId       Int      @default(0) @map("building_id")
  name             String   @db.VarChar(120)
  /// VENUE 场地 | MEETING 会议室
  kind             String   @default("MEETING") @db.VarChar(16)
  capacity         Int      @default(1)
  location         String   @default("") @db.VarChar(200)
  description      String   @default("") @db.VarChar(2000)
  cover            String   @default("") @db.VarChar(500)
  /// 单次预约/日租费用；0 = 免费
  feeAmount        Decimal  @default(0) @map("fee_amount") @db.Decimal(12, 2)
  /// 设备库存（场地/会议室固定为 1）
  stock            Int      @default(1)
  /// 设备押金
  deposit          Decimal  @default(0) @db.Decimal(12, 2)
  approvalRequired Boolean  @default(true) @map("approval_required")
  /// { start, end, stepMin, weekdays }
  schedule         Json     @default("{}")
  status           String   @default("ONLINE") @db.VarChar(16)
  sort             Int      @default(0)
  /// gaps.AppointmentEvent.id；0 = 未建立对应事件
  eventId          Int      @default(0) @map("event_id")
  /// 公开预约 slug（与 appointment_events.slug 同步）
  slug             String   @default("") @db.VarChar(48)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([siteId, name])
  @@index([siteId, status])
  @@map("park_resources")
}

/// 预约/访客单：场地与访客共用；审批通过后生成通行码。
model ParkReservation {
  id             Int       @id @default(autoincrement())
  siteId         Int       @map("site_id")
  /// VISITOR 访客 | VENUE 场地 | MEETING 会议室
  kind           String    @db.VarChar(16)
  customerId     Int       @default(0) @map("customer_id")
  tenantId       Int       @default(0) @map("tenant_id")
  applicantName  String    @map("applicant_name") @db.VarChar(60)
  applicantPhone String    @default("") @map("applicant_phone") @db.VarChar(32)
  visitorName    String    @default("") @map("visitor_name") @db.VarChar(60)
  visitorPhone   String    @default("") @map("visitor_phone") @db.VarChar(32)
  visitorCompany String    @default("") @map("visitor_company") @db.VarChar(120)
  visitorIdNo    String    @default("") @map("visitor_id_no") @db.VarChar(64)
  plateNo        String    @default("") @map("plate_no") @db.VarChar(20)
  companions     Int       @default(0)
  /// 设备租赁数量
  quantity       Int       @default(1)
  depositAmount  Decimal   @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  buildingId     Int       @default(0) @map("building_id")
  unitId         Int       @default(0) @map("unit_id")
  resourceName   String    @default("") @map("resource_name") @db.VarChar(120)
  /// 场地/会议室资源；访客预约为 0
  resourceId     Int       @default(0) @map("resource_id")
  /// 复用的 appointment_events / appointment_slots / appointment_bookings
  eventId        Int       @default(0) @map("event_id")
  slotId         Int       @default(0) @map("slot_id")
  appointmentBookingId Int  @default(0) @map("appointment_booking_id")
  startAt        DateTime  @map("start_at")
  endAt          DateTime  @map("end_at")
  purpose        String    @default("") @db.VarChar(200)
  note           String    @default("") @db.VarChar(500)
  approvalId     Int       @default(0) @map("approval_id")
  /// PENDING | APPROVED | REJECTED | CANCELED | CHECKED_IN | COMPLETED | EXPIRED
  status         String    @default("PENDING") @db.VarChar(16)
  /// 通行码：审批通过后生成，门岗扫码/输码核验；一次性，核验后置空。
  passCode       String    @default("") @map("pass_code") @db.VarChar(20)
  passExpiresAt  DateTime? @map("pass_expires_at")
  checkedInAt    DateTime? @map("checked_in_at")
  checkedInBy    Int       @default(0) @map("checked_in_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([siteId, kind, status, startAt])
  @@index([siteId, resourceId])
  @@index([siteId, passCode])
  @@index([customerId, status])
  @@map("park_reservations")
}

/// 工单：报修/投诉/保洁/其他。
model ParkWorkOrder {
  id              Int       @id @default(autoincrement())
  siteId          Int       @map("site_id")
  orderNo         String    @unique @map("order_no") @db.VarChar(32)
  customerId      Int       @default(0) @map("customer_id")
  tenantId        Int       @default(0) @map("tenant_id")
  reporterName    String    @map("reporter_name") @db.VarChar(60)
  reporterPhone   String    @default("") @map("reporter_phone") @db.VarChar(32)
  /// REPAIR | COMPLAINT | CLEANING | OTHER
  category        String    @default("REPAIR") @db.VarChar(24)
  title           String    @db.VarChar(120)
  description     String    @default("") @db.Text
  images          Json      @default("[]")
  buildingId      Int       @default(0) @map("building_id")
  unitId          Int       @default(0) @map("unit_id")
  location        String    @default("") @db.VarChar(200)
  urgency         String    @default("NORMAL") @db.VarChar(16)
  assigneeStaffId Int       @default(0) @map("assignee_staff_id")
  assigneeName    String    @default("") @map("assignee_name") @db.VarChar(60)
  /// PENDING | ASSIGNED | PROCESSING | DONE | CLOSED | CANCELED
  status          String    @default("PENDING") @db.VarChar(16)
  result          String    @default("") @db.Text
  feeAmount       Decimal   @default(0) @map("fee_amount") @db.Decimal(12, 2)
  rating          Int       @default(0)
  ratingComment   String    @default("") @map("rating_comment") @db.VarChar(300)
  finishedAt      DateTime? @map("finished_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([siteId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([assigneeStaffId, status])
  @@map("park_work_orders")
}

/// 工单处理日志
model ParkWorkOrderLog {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  action       String   @db.VarChar(24)
  operatorType String   @map("operator_type") @db.VarChar(16)
  operatorId   Int      @map("operator_id")
  operatorName String   @default("") @map("operator_name") @db.VarChar(60)
  note         String   @default("") @db.VarChar(500)
  images       Json     @default("[]")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("park_work_order_logs")
}

/// 园区公告/政策/党建/活动：小程序首页与列表读取，后台发布。
model ParkAnnouncement {
  id          Int       @id @default(autoincrement())
  siteId      Int       @map("site_id")
  /// NOTICE 公告 | POLICY 政策 | PARTY 党建 | ACTIVITY 活动
  category    String    @default("NOTICE") @db.VarChar(24)
  title       String    @db.VarChar(160)
  summary     String    @default("") @db.VarChar(300)
  content     String    @default("") @db.Text
  cover       String    @default("") @db.VarChar(500)
  pinned      Boolean   @default(false)
  /// DRAFT | PUBLISHED | OFFLINE
  status      String    @default("DRAFT") @db.VarChar(16)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([siteId, status, pinned, publishedAt])
  @@map("park_announcements")
}

/// 园区活动：发布、容量、报名截止；报名人是园区外部顾客，不落站内账号。
model ParkActivity {
  id             Int      @id @default(autoincrement())
  siteId         Int      @map("site_id")
  title          String   @db.VarChar(160)
  cover          String   @default("") @db.VarChar(500)
  summary        String   @default("") @db.VarChar(300)
  content        String   @default("") @db.Text
  location       String   @default("") @db.VarChar(200)
  startAt        DateTime @map("start_at")
  endAt          DateTime @map("end_at")
  /// 报名截止时间（ISO 字符串；空 = 不限制）
  signupDeadline String   @default("") @map("signup_deadline") @db.VarChar(40)
  /// 0 = 不限人数
  capacity       Int      @default(0)
  /// DRAFT | PUBLISHED | CLOSED
  status         String   @default("DRAFT") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([siteId, status, startAt])
  @@map("park_activities")
}

/// 活动报名：同一活动内同一顾客唯一；取消后保留记录，释放名额。
model ParkActivitySignup {
  id         Int      @id @default(autoincrement())
  activityId Int      @map("activity_id")
  siteId     Int      @map("site_id")
  customerId Int      @map("customer_id")
  name       String   @db.VarChar(60)
  phone      String   @default("") @db.VarChar(32)
  tenantId   Int      @default(0) @map("tenant_id")
  /// SIGNED | CANCELED
  status     String   @default("SIGNED") @db.VarChar(16)
  note       String   @default("") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([activityId, customerId])
  @@index([siteId, customerId])
  @@index([activityId, status])
  @@map("park_activity_signups")
}


/// 园区订单：场地预约费用与后续工单/服务费共用；支付方式先支持线下收款，微信支付适配器后续接入。
model ParkOrder {
  id         Int       @id @default(autoincrement())
  orderNo    String    @unique @map("order_no") @db.VarChar(32)
  siteId     Int       @map("site_id")
  customerId Int       @default(0) @map("customer_id")
  tenantId   Int       @default(0) @map("tenant_id")
  /// VENUE | WORK_ORDER | SERVICE
  bizType    String    @default("VENUE") @map("biz_type") @db.VarChar(24)
  bizId      Int       @default(0) @map("biz_id")
  title      String    @db.VarChar(160)
  amount     Decimal   @default(0) @db.Decimal(12, 2)
  /// PENDING | PAID | CANCELED | REFUNDED
  status     String    @default("PENDING") @db.VarChar(16)
  /// OFFLINE | WECHAT
  payMethod  String    @default("OFFLINE") @map("pay_method") @db.VarChar(16)
  paidAt     DateTime? @map("paid_at")
  /// 微信支付预下单与交易号；线下收款为空
  prepayId   String    @default("") @map("prepay_id") @db.VarChar(64)
  transactionId String @default("") @map("transaction_id") @db.VarChar(64)
  note       String    @default("") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([siteId, status, createdAt])
  @@index([siteId, customerId])
  @@index([siteId, bizType, bizId])
  @@map("park_orders")
}

/// 园区租约合同：租户企业维度，按月/季/年出账；与站内服务合同表分离。
model ParkLease {
  id           Int      @id @default(autoincrement())
  siteId       Int      @map("site_id")
  tenantId     Int      @map("tenant_id")
  title        String   @db.VarChar(160)
  startDate    String   @map("start_date") @db.VarChar(10)
  endDate      String   @map("end_date") @db.VarChar(10)
  rentAmount   Decimal  @default(0) @map("rent_amount") @db.Decimal(12, 2)
  deposit      Decimal  @default(0) @db.Decimal(12, 2)
  /// MONTH | QUARTER | YEAR
  billingCycle String   @default("MONTH") @map("billing_cycle") @db.VarChar(16)
  /// DRAFT | ACTIVE | ENDED
  status       String   @default("DRAFT") @db.VarChar(16)
  note         String   @default("") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([siteId, status])
  @@index([siteId, tenantId])
  @@map("park_leases")
}

/// 园区账单：按租约周期生成；可选同步 ERP 应收（ERP 写端口，不直写 ERP 表）。
model ParkBill {
  id              Int       @id @default(autoincrement())
  siteId          Int       @map("site_id")
  leaseId         Int       @map("lease_id")
  tenantId        Int       @map("tenant_id")
  billNo          String    @unique @map("bill_no") @db.VarChar(32)
  periodStart     String    @map("period_start") @db.VarChar(10)
  periodEnd       String    @map("period_end") @db.VarChar(10)
  dueDate         String    @map("due_date") @db.VarChar(10)
  amount          Decimal   @default(0) @db.Decimal(12, 2)
  /// OPEN | PAID | OVERDUE | CANCELED
  status          String    @default("OPEN") @db.VarChar(16)
  paidAt          DateTime? @map("paid_at")
  /// ERP 应收 id；0 = 未同步
  erpReceivableId Int       @default(0) @map("erp_receivable_id")
  note            String    @default("") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([leaseId, periodStart])
  @@index([siteId, status, dueDate])
  @@index([siteId, tenantId])
  @@map("park_bills")
}


/// 园区发票：线下/电子发票台账，从订单或账单开具；不接税务厂商。
model ParkInvoice {
  id         Int       @id @default(autoincrement())
  siteId     Int       @map("site_id")
  /// ORDER | BILL
  bizType    String    @default("ORDER") @map("biz_type") @db.VarChar(16)
  bizId      Int       @default(0) @map("biz_id")
  customerId Int       @default(0) @map("customer_id")
  tenantId   Int       @default(0) @map("tenant_id")
  title      String    @db.VarChar(160)
  taxNo      String    @default("") @map("tax_no") @db.VarChar(32)
  amount     Decimal   @default(0) @db.Decimal(12, 2)
  /// ISSUED | VOID
  status     String    @default("ISSUED") @db.VarChar(16)
  issuedAt   DateTime? @map("issued_at")
  note       String    @default("") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([siteId, status, createdAt])
  @@index([siteId, tenantId])
  @@map("park_invoices")
}

/// 巡检计划：点位以 JSON 保存（name + code），员工在小程序逐点提交记录。
model ParkPatrolPlan {
  id        Int      @id @default(autoincrement())
  siteId    Int      @map("site_id")
  name      String   @db.VarChar(120)
  /// [{ name, code }]
  points    Json     @default("[]")
  /// [{ staffId, name }]
  staffIds  Json     @default("[]") @map("staff_ids")
  status    String   @default("ACTIVE") @db.VarChar(16)
  note      String   @default("") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([siteId, status])
  @@map("park_patrol_plans")
}

/// 巡检记录
model ParkPatrolRecord {
  id        Int      @id @default(autoincrement())
  siteId    Int      @map("site_id")
  planId    Int      @map("plan_id")
  staffId   Int      @map("staff_id")
  staffName String   @default("") @map("staff_name") @db.VarChar(60)
  pointName String   @default("") @map("point_name") @db.VarChar(120)
  result    String   @default("NORMAL") @db.VarChar(16)
  note      String   @default("") @db.VarChar(500)
  images    Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([siteId, planId, createdAt])
  @@index([staffId, createdAt])
  @@map("park_patrol_records")
}

/// 停车许可：租户车辆登记与审批
model ParkParkingPermit {
  id          Int      @id @default(autoincrement())
  siteId      Int      @map("site_id")
  tenantId    Int      @default(0) @map("tenant_id")
  customerId  Int      @default(0) @map("customer_id")
  plateNo     String   @map("plate_no") @db.VarChar(20)
  vehicleType String   @default("CAR") @map("vehicle_type") @db.VarChar(16)
  validFrom   String   @default("") @map("valid_from") @db.VarChar(10)
  validTo     String   @default("") @map("valid_to") @db.VarChar(10)
  /// PENDING | APPROVED | REJECTED | EXPIRED
  status      String   @default("PENDING") @db.VarChar(16)
  note        String   @default("") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([siteId, status, plateNo])
  @@index([siteId, tenantId])
  @@map("park_parking_permits")
}

/// 园区资产台账
model ParkAsset {
  id             Int      @id @default(autoincrement())
  siteId         Int      @map("site_id")
  name           String   @db.VarChar(120)
  category       String   @default("EQUIPMENT") @db.VarChar(40)
  location       String   @default("") @db.VarChar(200)
  status         String   @default("IN_USE") @db.VarChar(16)
  assigneeStaffId Int     @default(0) @map("assignee_staff_id")
  assigneeName   String   @default("") @map("assignee_name") @db.VarChar(60)
  purchaseDate   String   @default("") @map("purchase_date") @db.VarChar(10)
  value          Decimal  @default(0) @db.Decimal(12, 2)
  note           String   @default("") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([siteId, category, status])
  @@map("park_assets")
}

/// 能耗抄表
model ParkMeterReading {
  id        Int      @id @default(autoincrement())
  siteId    Int      @map("site_id")
  /// WATER | ELECTRIC | GAS
  meterType String   @default("ELECTRIC") @map("meter_type") @db.VarChar(16)
  meterNo   String   @default("") @map("meter_no") @db.VarChar(40)
  unitId    Int      @default(0) @map("unit_id")
  period    String   @db.VarChar(10)
  reading   Decimal  @default(0) @db.Decimal(14, 2)
  amount    Decimal  @default(0) @db.Decimal(12, 2)
  note      String   @default("") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([siteId, meterType, period])
  @@map("park_meter_readings")
}
