  subtitleOn     Boolean  @default(true) @map("subtitle_on")
  /// 0 合成中 | 1 成功 | 2 失败
  status         Int      @default(0) @db.TinyInt
  /// 阶段游标：tts | lipsync | done
  stage          String   @default("tts") @db.VarChar(16)
  ttsStatus      Int      @default(0) @map("tts_status") @db.TinyInt
  lipsyncStatus  Int      @default(0) @map("lipsync_status") @db.TinyInt
  ttsTaskId      String   @default("") @map("tts_task_id") @db.VarChar(64)
  lipsyncTaskId  String   @default("") @map("lipsync_task_id") @db.VarChar(64)
  resultVideoUrl String   @default("") @map("result_video_url") @db.VarChar(500)
  audioUrl       String   @default("") @map("audio_url") @db.VarChar(500)
  coverUrl       String   @default("") @map("cover_url") @db.VarChar(500)
  durationSec    Int      @default(0) @map("duration_sec")
