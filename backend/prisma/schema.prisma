/// 科普文章（图文；审核开关由交易参数控制）。
model HealthArticle {
  id          Int      @id @default(autoincrement())
  shopId      Int      @map("shop_id")
  categoryId  Int      @default(0) @map("category_id")
  title       String   @db.VarChar(120)
  /// ARTICLE | VIDEO | AUDIO | LIVE
  kind        String   @default("ARTICLE") @db.VarChar(12)
  coverImage  String   @default("") @map("cover_image") @db.VarChar(500)
  mediaUrl    String   @default("") @map("media_url") @db.VarChar(1000)
  summary     String   @default("") @db.VarChar(300)
  contentHtml String   @map("content_html") @db.LongText
  /// 内容来源：平台运营 / 医生投稿 / 专家认证
  authorKind  String   @default("SHOP") @map("author_type") @db.VarChar(16)
  authorId    Int      @default(0) @map("author_id")
  authorName  String   @default("") @map("author_name") @db.VarChar(60)
  tagsJson    Json     @default("[]") @map("tags_json")
  /// PUBLIC | MEMBER | CROWD | SIGNED
  visibility  String   @default("PUBLIC") @db.VarChar(12)
  crowdKindsJson Json  @default("[]") @map("crowd_kinds_json")
  /// ON | OFF（可下线）
  status      String   @default("ON") @db.VarChar(8)
  /// PENDING | APPROVED | REJECTED | OFFLINE
  auditStatus String   @default("PENDING") @map("audit_status") @db.VarChar(16)
  auditReason String   @default("") @map("audit_reason") @db.VarChar(200)
  auditBy     String   @default("") @map("audit_by") @db.VarChar(64)
  auditAt     DateTime? @map("audit_at")
  viewCount   Int      @default(0) @map("read_count")
  likeCount   Int      @default(0) @map("like_count")
  commentCount Int     @default(0) @map("comment_count")
  collectCount Int     @default(0) @map("collect_count")
  topFlag     Boolean  @default(false) @map("top_flag")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, topFlag, publishedAt])
  @@index([shopId, auditStatus, status, publishedAt])
  @@index([shopId, categoryId, status])
  @@map("health_articles")
}

