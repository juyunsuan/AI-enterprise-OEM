  balanceAfter Decimal  @default(0) @map("balance_after") @db.Decimal(18, 2)
  orderId      Int      @default(0) @map("order_id")
  orderNo      String   @default("") @map("order_no") @db.VarChar(40)
  remark       String   @default("") @db.VarChar(200)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([siteId, agentId, createdAt])
