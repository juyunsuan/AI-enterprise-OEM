  @@unique([shopId, word])
  @@index([shopId, status, searchNum])
  @@map("health_hot_keywords")
}

model HealthSearchLog {
  id         Int      @id @default(autoincrement())
  shopId     Int      @map("shop_id")
  customerId Int      @default(0) @map("customer_id")
  keyword    String   @db.VarChar(60)
  resultKind String   @default("") @map("result_type") @db.VarChar(20)
  resultNum  Int      @default(0) @map("result_num")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([shopId, keyword, createdAt])
  @@index([shopId, createdAt])
  @@map("health_search_logs")
}

/// 日统计快照（看板加速；按店按日一行）。
model HealthDailyStat {
  id                Int      @id @default(autoincrement())
  shopId            Int      @map("shop_id")
  statDate          String   @unique @map("stat_date") @db.VarChar(10)
  customerNew       Int      @default(0) @map("customer_new")
  orderCount        Int      @default(0) @map("order_count")
  payOrderCount     Int      @default(0) @map("pay_order_count")
  payAmountCents    Int      @default(0) @map("pay_amount_cents")
  refundAmountCents Int      @default(0) @map("refund_amount_cents")
  consultCount      Int      @default(0) @map("consult_count")
  alertCount        Int      @default(0) @map("alert_count")
  followupDone      Int      @default(0) @map("followup_done")
  followupOverdue   Int      @default(0) @map("followup_overdue")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([shopId, statDate])
  @@map("health_daily_stats")
}

// ----------------------------------------------------------------------------
// 与营销工具「企业微信 SCRM」的松耦合对接
//
// 边界：健康侧只写自己的出站事件表与映射表，**不读写 scrm_* 表、不 import SCRM 服务**。
// SCRM 侧通过可插拔适配器拉取事件并回写处理结果；任一工具被平台关闭时，
// 适配器不运行即可，事件留在队列里，两侧数据与功能都不受影响。
// ----------------------------------------------------------------------------

/// 健康店铺 ↔ SCRM 组织绑定（一个 SCRM 组织可绑多个健康店铺）。
model HealthScrmLink {
  id            Int      @id @default(autoincrement())
  shopId        Int      @map("shop_id")
  /// SCRM 侧组织键（HRM 口径），仅作匹配串，不建立外键
  orgType       String   @map("org_type") @db.VarChar(20)
  orgUserId     String   @map("org_user_id") @db.VarChar(64)
  /// 是否允许把顾客事件推给 SCRM
  pushEnabled   Boolean  @default(true) @map("push_enabled")
  /// 是否允许 SCRM 回写标签/备注到健康顾客画像
  pullEnabled   Boolean  @default(false) @map("pull_enabled")
  lastPullAt    DateTime? @map("last_pull_at")
  lastPushAt    DateTime? @map("last_push_at")
  lastError     String   @default("") @map("last_error") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([shopId, orgType, orgUserId])
  @@index([orgType, orgUserId])
  @@map("health_scrm_links")
}

/// 出站事件队列：健康侧只追加，SCRM 适配器按店领取（拉取式，不反向依赖）。
model HealthScrmEvent {
  id           Int      @id @default(autoincrement())
  shopId       Int      @map("shop_id")
  /// CUSTOMER_CREATED | ORDER_PAID | ORDER_REFUNDED | CONSULT_FINISHED |
  /// ALERT_OPEN | FOLLOWUP_DUE | MEMBER_LEVEL_CHANGED | REVIEW_PUBLISHED
  eventType    String   @map("event_type") @db.VarChar(32)
  customerId   Int      @default(0) @map("customer_id")
  refType      String   @default("") @map("ref_type") @db.VarChar(24)
  refId        Int      @default(0) @map("ref_id")
  payloadJson  Json     @default("{}") @map("payload_json")
  /// PENDING | SENT | FAILED | SKIPPED
  status       String   @default("PENDING") @db.VarChar(12)
  attempts     Int      @default(0)
  lastError    String   @default("") @map("last_error") @db.VarChar(500)
  occurredAt   DateTime @default(now()) @map("occurred_at")
  sentAt       DateTime? @map("sent_at")

  @@index([shopId, status, occurredAt])
  @@index([shopId, customerId, occurredAt])
  @@map("health_scrm_events")
}

/// 健康顾客 ↔ SCRM 外部联系人映射（只存 id 与同步时间，不复制企微资料）。
model HealthScrmContactRef {
  id             Int      @id @default(autoincrement())
  shopId         Int      @map("shop_id")
  customerId     Int      @map("customer_id")
  externalUserId String   @map("external_user_id") @db.VarChar(64)
  followUserId   String   @default("") @map("follow_user_id") @db.VarChar(64)
  syncedAt       DateTime @default(now()) @map("synced_at")

  @@unique([shopId, customerId])
  @@unique([shopId, externalUserId])
  @@map("health_scrm_contact_refs")
}

// =====================================================================
// 建站管理 · 快递寄件小程序工具（设计见 docs/建站管理·快递寄件小程序工具设计方案.md）
//
// 每个本站用户可建自己的快递寄件平台：按站点配置快递公司报价，小程序接单，
// 运费只由后端报价引擎按「首重/续重 + 偏远 + 保价」算，端上传来的重量尺寸只是输入。
// 收款走店主自己的微信支付商户号（凭据在 miniprogram_apps，scene='EXPRESS'），
// 平台不经手资金，因此本域没有资金账本与提现链路；在线客服复用 service-desk，
// 只存 desk_site_key，不建会话表。金额一律 DECIMAL(18, 2)，服务层按「分」整数运算。
// =====================================================================

/// 快递寄件站点：siteCode 是小程序 config.js 的寻址码，创建后不变。
/// 微信凭据与出包台账走 miniprogram_apps / miniprogram_tenant_releases
/// （scene='EXPRESS' + shopId=站点 id）。
model KuaidiSite {
  id               Int      @id @default(autoincrement())
  ownerUserId      String   @map("owner_user_id") @db.VarChar(64)
  enterpriseId     Int      @default(0) @map("enterprise_id")
  enterpriseUserId String   @default("") @map("enterprise_user_id") @db.VarChar(64)
  siteCode         String   @unique @map("site_code") @db.VarChar(16)
  name             String   @db.VarChar(120)
  logo             String   @default("") @db.VarChar(500)
  slogan           String   @default("") @db.VarChar(200)
  themeColor       String   @default("#3370FF") @map("theme_color") @db.VarChar(16)
  notice           String   @default("") @db.VarChar(500)
  /// 寄件点位置（C 端选点 / 扫码进站 / 地图导航）
  province         String   @default("") @db.VarChar(40)
  city             String   @default("") @db.VarChar(40)
  district         String   @default("") @db.VarChar(40)
  addressLine      String   @default("") @map("address_line") @db.VarChar(200)
  lng              Float    @default(0)
  lat              Float    @default(0)
  businessHours    String   @default("") @map("business_hours") @db.VarChar(80)
  phone            String   @default("") @db.VarChar(32)
  pickupNote       String   @default("") @map("pickup_note") @db.VarChar(300)
  /// 共用收款账户 id（企业级，多个寄件点可指向同一账户）；0 = 账号下第一个启用账户
  payAccountId     Int      @default(0) @map("pay_account_id")
  /// 联系方式兜底 JSON：{ phone, wechat, email }（未绑 AI 客服服务站时展示）
  serviceContact   Json     @default("{}") @map("service_contact")
  /// 在线客服：绑定的 AI 客服（service-desk）服务站 siteKey，空 = 不启用在线会话
  deskSiteKey      String   @default("") @map("desk_site_key") @db.VarChar(64)
  /// 模块显隐 JSON：indexNotice/deskChat/contact/insurance/addressBook/myOrders/protocol/pickupTime/tracking
  toggles          Json     @default("{}")
  insuranceEnabled Boolean  @default(true) @map("insurance_enabled")
  /// 保价费率（0.005 = 千分之五），按声明价值计费
  insuranceRate    Decimal  @default(0.005) @map("insurance_rate") @db.Decimal(8, 4)
  /// 单件最高保价金额（元），0 = 不限
  insuranceMax     Decimal  @default(20000) @map("insurance_max") @db.Decimal(18, 2)
  /// 单件最大计费重量（kg），超过时小程序直接拒单
  maxWeightKg      Decimal  @default(100) @map("max_weight_kg") @db.Decimal(10, 2)
  /// 未支付订单保留时长（分钟），到期自动关闭
  payMinutes       Int      @default(30) @map("pay_minutes")
  /// 可预约取件时段 JSON：["09:00-12:00", ...]
  pickupSlots      Json     @default("[]") @map("pickup_slots")
  /// 寄件协议富文本（买家下单须勾选）
  protocolText     String   @default("") @map("protocol_text") @db.MediumText
  /// DRAFT 未上线 | ONLINE 营业中 | CLOSED 已关闭
  status           String   @default("DRAFT") @db.VarChar(16)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, status])
  @@index([enterpriseId])
  @@map("kuaidi_sites")
}

/// 企业级收款账户：多个寄件点共用一个微信商户号；资金直进该商户号，平台不经手。
/// 凭据按 (ownerUserId, mchId, 字段) 派生独立子密钥加密，账号内改 AppID 不会作废商户号密钥。
model KuaidiPayAccount {
  id                  Int      @id @default(autoincrement())
  ownerUserId         String   @map("owner_user_id") @db.VarChar(64)
  /// 归属已备案企业；0 = 个人主体（未绑定企业）
  enterpriseId        Int      @default(0) @map("enterprise_id")
  name                String   @db.VarChar(80)
  mchId               String   @map("mch_id") @db.VarChar(64)
  apiV3KeyCipher      String   @default("") @map("pay_api_v3_key_cipher") @db.Text
  certSerial          String   @default("") @map("cert_serial") @db.VarChar(128)
  privateKeyCipher    String   @default("") @map("private_key_cipher") @db.Text
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([ownerUserId, mchId])
  @@index([ownerUserId, enabled])
  @@map("kuaidi_pay_accounts")
}

/// 快递公司报价：站点内可多条（同一公司不同产品线也可），运价只在这里配。
model KuaidiCompany {
  id              Int      @id @default(autoincrement())
  siteId          Int      @map("site_id")
  code            String   @default("") @db.VarChar(20)
  name            String   @db.VarChar(60)
  logo            String   @default("") @db.VarChar(500)
  /// 首重重量（kg）与首重价（元）
  firstWeightKg   Decimal  @default(1) @map("first_weight_kg") @db.Decimal(10, 2)
  firstPrice      Decimal  @default(8) @map("first_price") @db.Decimal(18, 2)
  /// 续重单位（kg）与续重单价（元）
  extraWeightKg   Decimal  @default(1) @map("extra_weight_kg") @db.Decimal(10, 2)
  extraPrice      Decimal  @default(3) @map("extra_price") @db.Decimal(18, 2)
  /// 偏远地区省份名 JSON：["新疆","西藏","内蒙古"]
  remoteProvinces Json     @default("[]") @map("remote_provinces")
  remoteExtra     Decimal  @default(0) @map("remote_extra") @db.Decimal(18, 2)
  deliveryDays    String   @default("") @map("delivery_days") @db.VarChar(40)
  remark          String   @default("") @db.VarChar(200)
  enabled         Boolean  @default(true)
  sort            Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([siteId, enabled, sort])
  @@map("kuaidi_companies")
}

/// 寄件订单：金额全部由后端报价引擎落定，端上金额一律不采信。
model KuaidiOrder {
  id              Int       @id @default(autoincrement())
  siteId          Int       @map("site_id")
  ownerUserId     String    @map("owner_user_id") @db.VarChar(64)
  /// KD + yyyyMMddHHmmss + 6 位随机；账号级小程序要按回调单号全局定位，故全表唯一
  orderNo         String    @unique @map("order_no") @db.VarChar(40)
  companyId       Int       @map("company_id")
  companyName     String    @default("") @map("company_name") @db.VarChar(60)
  /// 寄件人快照 JSON：{ name, mobile, province, city, district, address }
  sender          Json      @default("{}")
  /// 收件人快照 JSON：同上
  receiver        Json      @default("{}")
  itemName        String    @default("") @map("item_name") @db.VarChar(80)
  itemWeightKg    Decimal   @default(0) @map("item_weight_kg") @db.Decimal(10, 2)
  itemCount       Int       @default(1) @map("item_count")
  length          Decimal   @default(0) @db.Decimal(10, 2)
  width           Decimal   @default(0) @db.Decimal(10, 2)
  height          Decimal   @default(0) @db.Decimal(10, 2)
  volumeWeightKg  Decimal   @default(0) @map("volume_weight_kg") @db.Decimal(10, 2)
  chargeWeightKg  Decimal   @default(0) @map("charge_weight_kg") @db.Decimal(10, 2)
  insuredValue    Decimal   @default(0) @map("insured_value") @db.Decimal(18, 2)
  baseFee         Decimal   @default(0) @map("base_fee") @db.Decimal(18, 2)
  extraFee        Decimal   @default(0) @map("extra_fee") @db.Decimal(18, 2)
  remoteFee       Decimal   @default(0) @map("remote_fee") @db.Decimal(18, 2)
  insuranceFee    Decimal   @default(0) @map("insurance_fee") @db.Decimal(18, 2)
  totalAmount     Decimal   @default(0) @map("total_amount") @db.Decimal(18, 2)
  /// ONLINE 微信在线支付 | OFFLINE 线下登记
  payMode         String    @default("OFFLINE") @map("pay_mode") @db.VarChar(8)
  /// 收款账户 id（企业级，多个寄件点共用）；0 = 创建时未配置在线收款
  payAccountId    Int       @default(0) @map("pay_account_id")
  /// PENDING 待支付 | PAID 已支付 | REFUNDED 已退款 | CLOSED 已关闭
  payState        String    @default("PENDING") @map("pay_state") @db.VarChar(16)
  transactionId   String    @default("") @map("transaction_id") @db.VarChar(64)
  prepayId        String    @default("") @map("prepay_id") @db.VarChar(64)
  /// PENDING_PICKUP | ACCEPTED | PICKED_UP | IN_TRANSIT | DELIVERED | COMPLETED | CANCELLED | EXCEPTION
  status          String    @default("PENDING_PICKUP") @db.VarChar(24)
  pickupSlot      String    @default("") @map("pickup_slot") @db.VarChar(40)
  remark          String    @default("") @db.VarChar(300)
  trackingNo      String    @default("") @map("tracking_no") @db.VarChar(64)
  cancelReason    String    @default("") @map("cancel_reason") @db.VarChar(300)
  customerId      Int       @default(0) @map("customer_id")
  openid          String    @default("") @db.VarChar(64)
  createIp        String    @default("") @map("create_ip") @db.VarChar(64)
  paidAt          DateTime? @map("paid_at")
  closedAt        DateTime? @map("closed_at")
  refundedAt      DateTime? @map("refunded_at")
  /// 待支付到期时间，调度器据此关单
  expireAt        DateTime? @map("expire_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([siteId, status, createdAt])
  @@index([siteId, payState, createdAt])
  @@index([siteId, expireAt])
  @@index([siteId, customerId])
  @@map("kuaidi_orders")
}

/// 订单履约轨迹：只追加，店主每次推进状态写一条，买家端按时间展示。
model KuaidiOrderEvent {
  id        Int      @id @default(autoincrement())
  siteId    Int      @map("site_id")
  orderId   Int      @map("order_id")
  status    String   @db.VarChar(24)
  note      String   @default("") @db.VarChar(300)
  operator  String   @default("") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@index([siteId, status])
  @@map("kuaidi_order_events")
}

/// 地址簿（C 端，按 openid 归属站点；匿名单不落这里）。
model KuaidiAddress {
  id         Int      @id @default(autoincrement())
  siteId     Int      @map("site_id")
  customerId Int      @default(0) @map("customer_id")
  openid     String   @default("") @db.VarChar(64)
  /// SENDER 寄件地址 | RECEIVER 收件地址
  type       String   @default("SENDER") @db.VarChar(16)
  name       String   @db.VarChar(40)
  mobile     String   @db.VarChar(20)
  province   String   @default("") @db.VarChar(40)
  city       String   @default("") @db.VarChar(40)
  district   String   @default("") @db.VarChar(40)
  address    String   @db.VarChar(200)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([siteId, openid, type])
  @@map("kuaidi_addresses")
}

/// C 端顾客（openid 维度，与站内 User 物理隔离；匿名下单不落这张表）。
model KuaidiCustomer {
  id             Int       @id @default(autoincrement())
  siteId         Int       @map("site_id")
  ownerUserId    String    @map("owner_user_id") @db.VarChar(64)
  openid         String    @db.VarChar(64)
  unionid        String    @default("") @db.VarChar(64)
  nickname       String    @default("") @db.VarChar(60)
  avatar         String    @default("") @db.VarChar(500)
  orderCount     Int       @default(0) @map("order_count")
  paidOrderCount Int       @default(0) @map("paid_order_count")
  totalAmount    Decimal   @default(0) @map("total_amount") @db.Decimal(18, 2)
  points         Int       @default(0)
  lastOrderAt    DateTime? @map("last_order_at")
  status         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([siteId, openid], map: "kuaidi_customers_site_openid_key")
  @@index([siteId, createdAt])
  @@map("kuaidi_customers")
}

// =====================================================================
// 建站管理 · 跑腿小程序工具
//
// 一个账号＝一部小程序＝一个跑腿站点（owner_user_id 唯一），账号负责人就是管理员；
// 顾客与骑手都是小程序内的微信身份（openid），不进本站账号体系。
// 金额只由后端计价引擎算：起步价 + 距离 + 重量 + 夜间 + 帮买服务费 + 小费 - 优惠券；
// 收款走店主自己的微信商户号（凭据在 miniprogram_apps，scene='ERRAND'），平台不经手资金。
// 客服只存 service-desk 的 siteKey 引用；AI 调度走平台模型网关；二维码等字节进数字资产。
// =====================================================================

/// 跑腿站点：一个账号一个，siteCode 是小程序寻址码，创建后不变。
model ErrandSite {
  id           Int      @id @default(autoincrement())
  ownerUserId  String   @unique @map("owner_user_id") @db.VarChar(64)
  siteCode     String   @unique @map("site_code") @db.VarChar(16)
  name         String   @db.VarChar(120)
  logo         String   @default("") @db.VarChar(500)
  banner       String   @default("") @db.VarChar(500)
  slogan       String   @default("") @db.VarChar(200)
  themeColor   String   @default("#3370FF") @map("theme_color") @db.VarChar(16)
  notice       String   @default("") @db.VarChar(500)
  province     String   @default("") @db.VarChar(40)
  city         String   @default("") @db.VarChar(40)
  district     String   @default("") @db.VarChar(40)
  addressLine  String   @default("") @map("address_line") @db.VarChar(200)
  lng          Float    @default(0)
  lat          Float    @default(0)
  businessHours String  @default("") @map("business_hours") @db.VarChar(80)
  phone        String   @default("") @db.VarChar(32)
  /// 联系方式兜底 JSON：{ phone, wechat, email }（未绑 AI 客服服务站时展示）
  contact      Json     @default("{}")
  /// 在线客服：绑定的 AI 客服（service-desk）服务站 siteKey，空 = 不启用在线会话
  deskSiteKey  String   @default("") @map("desk_site_key") @db.VarChar(64)
  /// 小程序栏目开关 JSON（ERRAND_TOGGLES）
  toggles      Json     @default("{}")
  protocolText String   @default("") @map("protocol_text") @db.MediumText
  status       String   @default("DRAFT") @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("errand_sites")
}

/// 服务城市：一个站点可开多个城市，每个城市有自己的计价、骑手与订单。
model ErrandCity {
  id          Int      @id @default(autoincrement())
  siteId      Int      @map("site_id")
  name        String   @db.VarChar(60)
  province    String   @default("") @db.VarChar(40)
  city        String   @default("") @db.VarChar(40)
  district    String   @default("") @db.VarChar(40)
  addressLine String   @default("") @map("address_line") @db.VarChar(200)
  lng         Float    @default(0)
  lat         Float    @default(0)
  /// ENABLED 开通 | DISABLED 停用
  status      String   @default("ENABLED") @db.VarChar(16)
  sort        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([siteId, name])
  @@index([siteId, status, sort])
  @@map("errand_cities")
}

/// 计价规则：一城一条，店主自助改价，报价引擎是唯一计算入口。
model ErrandRule {
  id              Int      @id @default(autoincrement())
  siteId          Int      @map("site_id")
  cityId          Int      @unique @map("city_id")
  baseFee         Decimal  @default(5) @map("base_fee") @db.Decimal(18, 2)
  baseDistanceKm  Decimal  @default(3) @map("base_distance_km") @db.Decimal(10, 2)
  perKmFee        Decimal  @default(2) @map("per_km_fee") @db.Decimal(18, 2)
  baseWeightKg    Decimal  @default(5) @map("base_weight_kg") @db.Decimal(10, 2)
  perKgFee        Decimal  @default(1) @map("per_kg_fee") @db.Decimal(18, 2)
  nightStart      String   @default("22:00") @map("night_start") @db.VarChar(5)
  nightEnd        String   @default("06:00") @map("night_end") @db.VarChar(5)
  nightFee        Decimal  @default(3) @map("night_fee") @db.Decimal(18, 2)
  buyServiceRate  Decimal  @default(0.1) @map("buy_service_rate") @db.Decimal(8, 4)
  minOrderAmount  Decimal  @default(0) @map("min_order_amount") @db.Decimal(18, 2)
  maxDistanceKm   Decimal  @default(30) @map("max_distance_km") @db.Decimal(10, 2)
  maxWeightKg     Decimal  @default(30) @map("max_weight_kg") @db.Decimal(10, 2)
  tipPresets      Json     @default("[]") @map("tip_presets")
  couponEnabled   Boolean  @default(true) @map("coupon_enabled")
  /// 抢单/自动派单半径（公里），0 = 不限
  acceptRadiusKm  Decimal  @default(5) @map("accept_radius_km") @db.Decimal(10, 2)
  /// 支付成功后自动派给最近在线骑手
  autoDispatch    Boolean  @default(false) @map("auto_dispatch")
  /// 骑手劳务分成比例（0.8 = 服务费 80% 归骑手，小费全额）
  riderShareRate  Decimal  @default(1) @map("rider_share_rate") @db.Decimal(5, 4)
  /// 每名骑手同时在途单上限
  maxActiveOrders Int      @default(3) @map("max_active_orders")
  /// 每消费 1 元返多少积分
  pointsEarnRate  Decimal  @default(1) @map("points_earn_rate") @db.Decimal(10, 2)
  /// 多少积分抵 1 元
  pointsDeductRate Decimal @default(100) @map("points_deduct_rate") @db.Decimal(10, 2)
  /// 单笔最多抵扣服务费比例
  maxPointsDiscountRate Decimal @default(0.2) @map("max_points_discount_rate") @db.Decimal(5, 4)
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("errand_rules")
}

/// 跑腿订单：金额全部由后端报价引擎落定，端上金额一律不采信。
model ErrandOrder {
  id             Int       @id @default(autoincrement())
  siteId         Int       @map("site_id")
  cityId         Int       @default(0) @map("city_id")
  cityName       String    @default("") @map("city_name") @db.VarChar(60)
  ownerUserId    String    @map("owner_user_id") @db.VarChar(64)
  /// PT + yyyyMMddHHmmss + 6 位随机；账号级小程序按回调单号全局定位，故全表唯一
  orderNo        String    @unique @map("order_no") @db.VarChar(40)
  /// SEND 帮我送 | BUY 帮我买
  serviceType    String    @default("SEND") @map("service_type") @db.VarChar(8)
  /// PENDING_PAY | PENDING_ACCEPT | ACCEPTED | PICKED_UP | DELIVERING | ARRIVED | COMPLETED | CANCELLED | EXCEPTION
  status         String    @default("PENDING_PAY") @db.VarChar(24)
  /// PENDING | PAID | REFUNDED | CLOSED
  payState       String    @default("PENDING") @map("pay_state") @db.VarChar(16)
  /// ONLINE 微信在线支付 | OFFLINE 线下结算
  payMode        String    @default("OFFLINE") @map("pay_mode") @db.VarChar(8)
  /// 取货地址快照 JSON：{ name, mobile, province, city, district, address, lng, lat }
  fromParty      Json      @default("{}") @map("from_party")
  /// 送达地址快照 JSON：同上
  toParty        Json      @default("{}") @map("to_party")
  goodsDesc      String    @default("") @map("goods_desc") @db.VarChar(300)
  goodsAmount    Decimal   @default(0) @map("goods_amount") @db.Decimal(18, 2)
  weightKg       Decimal   @default(0) @map("weight_kg") @db.Decimal(10, 2)
  distanceKm     Decimal   @default(0) @map("distance_km") @db.Decimal(10, 2)
  baseFee        Decimal   @default(0) @map("base_fee") @db.Decimal(18, 2)
  distanceFee    Decimal   @default(0) @map("distance_fee") @db.Decimal(18, 2)
  weightFee      Decimal   @default(0) @map("weight_fee") @db.Decimal(18, 2)
  timeFee        Decimal   @default(0) @map("time_fee") @db.Decimal(18, 2)
  goodsFee       Decimal   @default(0) @map("goods_fee") @db.Decimal(18, 2)
  tip            Decimal   @default(0) @db.Decimal(18, 2)
  couponId       Int       @default(0) @map("coupon_id")
  couponDiscount Decimal   @default(0) @map("coupon_discount") @db.Decimal(18, 2)
  pointsUsed     Int       @default(0) @map("points_used")
  pointsDiscount Decimal   @default(0) @map("points_discount") @db.Decimal(18, 2)
  /// 完成时返给顾客的积分（退款冲正依据）
  pointsEarned   Int       @default(0) @map("points_earned")
  totalAmount    Decimal   @default(0) @map("total_amount") @db.Decimal(18, 2)
  /// 完成时快照的骑手劳务收入（退款冲正依据）
  riderIncomeAmount Decimal @default(0) @map("rider_income_amount") @db.Decimal(18, 2)
  /// 完成时快照的代理分佣（退款冲正依据）
  agentId        Int       @default(0) @map("agent_id")
  agentIncomeAmount Decimal @default(0) @map("agent_income_amount") @db.Decimal(18, 2)
  /// 帮买实际采购金额、小票、差额（change=应退顾客，extra=需补收）
  purchaseAmount Decimal   @default(0) @map("purchase_amount") @db.Decimal(18, 2)
  purchaseReceipt String   @default("") @map("purchase_receipt") @db.VarChar(500)
  purchaseNote   String    @default("") @map("purchase_note") @db.VarChar(300)
  changeAmount   Decimal   @default(0) @map("change_amount") @db.Decimal(18, 2)
  extraAmount    Decimal   @default(0) @map("extra_amount") @db.Decimal(18, 2)
  /// 帮买补收线上补款完成时间
  extraPaidAt    DateTime? @map("extra_paid_at")
  /// 顾客对骑手的评价
  rating         Int       @default(0)
  ratingComment  String    @default("") @map("rating_comment") @db.VarChar(300)
  ratedAt        DateTime? @map("rated_at")
  riderId        Int       @default(0) @map("rider_id")
  riderNo        String    @default("") @map("rider_no") @db.VarChar(16)
  riderName      String    @default("") @map("rider_name") @db.VarChar(40)
  customerId     Int       @default(0) @map("customer_id")
  openid         String    @default("") @db.VarChar(64)
  contactName    String    @default("") @map("contact_name") @db.VarChar(40)
  contactMobile  String    @default("") @map("contact_mobile") @db.VarChar(20)
  remark         String    @default("") @db.VarChar(300)
  photos         Json      @default("[]")
  cancelReason   String    @default("") @map("cancel_reason") @db.VarChar(300)
  transactionId  String    @default("") @map("transaction_id") @db.VarChar(64)
  prepayId       String    @default("") @map("prepay_id") @db.VarChar(64)
  createIp       String    @default("") @map("create_ip") @db.VarChar(64)
  expireAt       DateTime? @map("expire_at")
  paidAt         DateTime? @map("paid_at")
  acceptedAt     DateTime? @map("accepted_at")
  pickedAt       DateTime? @map("picked_at")
  deliveredAt    DateTime? @map("delivered_at")
  completedAt    DateTime? @map("completed_at")
  closedAt       DateTime? @map("closed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([siteId, cityId, status, createdAt])
  @@index([siteId, payState, createdAt])
  @@index([status, expireAt])
  @@index([riderId, status])
  @@index([riderId, createdAt])
  @@index([siteId, customerId])
  @@map("errand_orders")
}

/// 订单履约轨迹：只追加，店主/骑手每次推进状态写一条。
model ErrandOrderEvent {
  id        Int      @id @default(autoincrement())
  siteId    Int      @map("site_id")
  orderId   Int      @map("order_id")
  status    String   @db.VarChar(24)
  note      String   @default("") @db.VarChar(300)
  operator  String   @default("") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@index([siteId, status])
  @@map("errand_order_events")
}

/// 骑手：小程序内微信身份（openid），一个站点内唯一；身份证号只存掩码与哈希。
model ErrandRider {
  id             Int       @id @default(autoincrement())
  siteId         Int       @map("site_id")
  cityId         Int       @default(0) @map("city_id")
  cityName       String    @default("") @map("city_name") @db.VarChar(60)
  ownerUserId    String    @map("owner_user_id") @db.VarChar(64)
  riderNo        String    @unique @map("rider_no") @db.VarChar(16)
  openid         String    @default("") @db.VarChar(64)
  unionid        String    @default("") @db.VarChar(64)
  name           String    @db.VarChar(40)
  mobile         String    @default("") @db.VarChar(20)
  /// 身份证掩码（前 3 后 2），不落明文
  idCardMasked   String    @default("") @map("id_card_masked") @db.VarChar(32)
  idCardHash     String    @default("") @map("id_card_hash") @db.VarChar(64)
  vehicleType    String    @default("EBIKE") @map("vehicle_type") @db.VarChar(16)
  /// 可接服务类型 JSON：["SEND","BUY"]
  serviceTypes   Json      @default("[]") @map("service_types")
  /// PENDING | APPROVED | REJECTED | SUSPENDED
  status         String    @default("PENDING") @db.VarChar(16)
  online         Boolean   @default(false)
  rejectReason   String    @default("") @map("reject_reason") @db.VarChar(300)
  idCardFront    String    @default("") @map("id_card_front") @db.VarChar(500)
  idCardBack     String    @default("") @map("id_card_back") @db.VarChar(500)
  vehiclePhoto   String    @default("") @map("vehicle_photo") @db.VarChar(500)
  /// 骑手最近上报位置（小程序 wx.getLocation）
  lng            Float     @default(0)
  lat            Float     @default(0)
  lastLocatedAt  DateTime? @map("last_located_at")
  rating         Decimal   @default(5) @db.Decimal(3, 2)
  orderCount     Int       @default(0) @map("order_count")
  incomeTotal    Decimal   @default(0) @map("income_total") @db.Decimal(18, 2)
  balance        Decimal   @default(0) @db.Decimal(18, 2)
  frozen         Decimal   @default(0) @db.Decimal(18, 2)
  lastActiveAt   DateTime? @map("last_active_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([siteId, openid], map: "errand_riders_site_openid_key")
  @@index([siteId, cityId, status, online])
  @@map("errand_riders")
}

/// 小程序顾客（openid 维度，与站内 User 物理隔离；匿名下单不落这张表）。
model ErrandCustomer {
  id             Int       @id @default(autoincrement())
  siteId         Int       @map("site_id")
  ownerUserId    String    @map("owner_user_id") @db.VarChar(64)
  openid         String    @db.VarChar(64)
  unionid        String    @default("") @db.VarChar(64)
  nickname       String    @default("") @db.VarChar(60)
  avatar         String    @default("") @db.VarChar(500)
  orderCount     Int       @default(0) @map("order_count")
  paidOrderCount Int       @default(0) @map("paid_order_count")
  totalAmount    Decimal   @default(0) @map("total_amount") @db.Decimal(18, 2)
  points         Int       @default(0)
  lastOrderAt    DateTime? @map("last_order_at")
  status         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([siteId, openid], map: "errand_customers_site_openid_key")
  @@index([siteId, createdAt])
  @@map("errand_customers")
}

/// 顾客地址簿：FROM 取货 / TO 送达。
model ErrandAddress {
  id         Int      @id @default(autoincrement())
  siteId     Int      @map("site_id")
  customerId Int      @default(0) @map("customer_id")
  openid     String   @default("") @db.VarChar(64)
  type       String   @default("FROM") @db.VarChar(8)
  name       String   @db.VarChar(40)
  mobile     String   @default("") @db.VarChar(20)
  province   String   @default("") @db.VarChar(40)
  city       String   @default("") @db.VarChar(40)
