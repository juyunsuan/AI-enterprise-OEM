// =====================================================================
// 外卖点餐小程序（独立数据域）
//
// 与品牌商城物理隔离：店铺、菜单、顾客、购物车、订单、券各有自己的表。
// 复用的只是公共服务：顾客令牌签发、微信登录、微信支付客户端、SCRM 桥、
// commerce-core 算价/订单状态机；任何一次查询都不会跨到 brand_* 表。
// =====================================================================

/// 外卖门店：与品牌商城店铺互不可见，shopCode 是外卖端唯一寻址码。
model TakeoutShop {
  id           Int      @id @default(autoincrement())
  ownerUserId  String   @map("owner_user_id") @db.VarChar(64)
  name         String   @db.VarChar(120)
  shopCode     String   @unique @map("shop_code") @db.VarChar(16)
  logo         String   @default("") @db.VarChar(500)
  slogan       String   @default("") @db.VarChar(120)
  servicePhone String   @default("") @map("service_phone") @db.VarChar(32)
  themeColor   String   @default("#E64340") @map("theme_color") @db.VarChar(16)
  /// DRAFT 未上线 | ONLINE 营业中 | SUSPENDED 平台停服 | CLOSED 已关闭
  status       String   @default("DRAFT") @db.VarChar(16)
  /// 交易参数 { minOrderAmount, deliveryFee, freeDeliveryAmount, autoCancelMinutes, points... }
  tradeJson    Json     @default("{}") @map("trade_json")
  /// 外卖参数 { businessHours, estimatedMinutes, deliveryEnabled, pickupEnabled, dineInEnabled, announcement }
  takeoutJson  Json     @default("{}") @map("takeout_json")
  /// 顾客层企业微信 SCRM 开关；关闭时只停事件生产，不影响交易
  scrmEnabled  Boolean  @default(false) @map("scrm_enabled")
  /// 自动开通的 AI 客服站点 id（service_desk_sites.id，0 = 还没建）
  supportSiteId Int     @default(0) @map("support_site_id")
  offReason    String   @default("") @map("off_reason") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, status])
  @@map("takeout_shops")
}

/// 菜单分类：外卖独立分类，不读商城分类。
model TakeoutCategory {
  id        Int      @id @default(autoincrement())
  shopId    Int      @map("shop_id")
  name      String   @db.VarChar(30)
  icon      String   @default("") @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([shopId, sortOrder])
  @@map("takeout_categories")
}

/// 菜品主表：多规格维度放 specs，可售单元在 takeout_product_skus。
model TakeoutProduct {
  id          Int      @id @default(autoincrement())
  shopId      Int      @map("shop_id")
  ownerUserId String   @map("owner_user_id") @db.VarChar(64)
  categoryId  Int      @default(0) @map("category_id")
  title       String   @db.VarChar(120)
  subtitle    String   @default("") @db.VarChar(200)
  coverImage  String   @default("") @map("cover_image") @db.VarChar(500)
  images      Json     @default("[]")
  /// 图文详情（HTML）
  detail      String   @default("") @db.MediumText
  price       Decimal  @default(0) @db.Decimal(18, 2)
  marketPrice Decimal  @default(0) @map("market_price") @db.Decimal(18, 2)
  stock       Int      @default(0)
  sales       Int      @default(0)
  unit        String   @default("份") @db.VarChar(20)
  /// 规格定义 [{ name, values: [] }]
  specs       Json     @default("[]")
  /// DRAFT | OFFLINE | ONLINE
  status      String   @default("DRAFT") @db.VarChar(16)
  isHot       Boolean  @default(false) @map("is_hot")
  isNew       Boolean  @default(false) @map("is_new")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, sortOrder])
  @@index([shopId, categoryId])
  @@map("takeout_products")
}

model TakeoutProductSku {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  shopId     Int      @map("shop_id")
  skuName    String   @default("") @map("sku_name") @db.VarChar(200)
  image      String   @default("") @db.VarChar(500)
  uniqueId   String   @default("") @map("unique_id") @db.VarChar(191)
  specValues Json     @default("{}") @map("spec_values")
  price      Decimal  @default(0) @db.Decimal(18, 2)
  marketPrice Decimal @default(0) @map("market_price") @db.Decimal(18, 2)
  stock      Int      @default(0)
  sales      Int      @default(0)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([shopId, uniqueId])
  @@map("takeout_product_skus")
}

/// 外卖顾客：一店一套，与商城顾客、站内 User 都不共享行。
model TakeoutCustomer {
