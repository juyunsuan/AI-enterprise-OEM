// =====================================================================
// 建站管理 · 数字人小程序工具（参考「AI 数字人分身系统」全量按本站架构重写）
//
// 每个平台账号可建立一套自己的数字人小程序站点（DigitalHumanSite，userId 唯一）。
// 租户模型两层：本站用户＝站点主人（ownerUserId 落到每张表的 userId），
// C 端终端会员（digital_human_members）按 openid 归站点，与站内 User 物理隔离。
// 收款走用户自己的微信商户号（miniprogram_apps scene='DIGITAL_HUMAN' 的 payRuntime），
// 平台不经手资金。形象克隆/声音克隆/TTS/对口型走本站「模型配置」新增的数字人渠道
// （digital_human_channels，fox|synclabs|custom 三协议 + webhook 状态机），
// AI 文案复用 ai-gateway。金额一律「分」整数运算，积分/克隆点数三账户走余额流水。
// =====================================================================

/// 数字人站点：一个平台账号一套（懒创建，同 KpSite 口径）。装修/品牌/计价/分销等配置以 JSON 落本站一行。
model DigitalHumanSite {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id") @db.VarChar(64)
  /// 公开寻址码：小程序端 config 里的 site 值，创建后不变
  siteCode  String   @unique @map("site_code") @db.VarChar(16)
  siteName  String   @default("") @map("site_name") @db.VarChar(60)
  logo      String   @default("") @db.VarChar(500)
  slogan    String   @default("") @db.VarChar(120)
  themeColor String  @default("#3370ff") @map("theme_color") @db.VarChar(16)
  servicePhone String @default("") @map("service_phone") @db.VarChar(32)
  /// 品牌与分享配置 JSON：{ shareTitle, shareImage, navigationTitle }
  brand     Json     @default("{}")
  /// 模块显隐 JSON（关掉的模块端上整块不渲染）：见 DH_TOGGLE_KEYS
  toggles   Json     @default("{}")
  /// 计价与资产名 JSON：{ pointTitle, priceVideo, priceTts, priceBody, priceVoice }
  pricing   Json     @default("{}")
  /// 新人礼 JSON：{ vipDays, point, body, voice }
  gift      Json     @default("{}")
  /// 登录与合规 JSON：{ mustVip }
  login     Json     @default("{}")
  /// 数字人参数 JSON：{ bodyMinSec, bodyMaxSec, voiceMinSec, voiceMaxSec, scriptMaxLen }
  clone     Json     @default("{}")
  /// 分销参数 JSON：{ enabled, level1Rate, level2Rate, joinType, payPackageId, minWithdrawCents }
  commission Json    @default("{}")
  /// AI 客服接入：本站点在 service-desk 建的站点 siteKey（小程序访客会话用）
  serviceDeskSiteKey String @default("") @map("service_desk_site_key") @db.VarChar(64)
  /// 首页 DIY 装修 JSON（组件树，打包与运行时都读它）
  diyPage   Json     @default("{}")
  /// DRAFT 未上线 | ONLINE 营业中 | SUSPENDED 平台停服（数据保留）| CLOSED 已关闭
  status    String   @default("DRAFT") @db.VarChar(16)
  offBy     String   @default("") @map("off_by") @db.VarChar(64)
  offReason String   @default("") @map("off_reason") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("digital_human_sites")
}

/// 数字人模型渠道：本站「模型配置」新增的数字人供应商通道（形象训练/声音克隆/TTS/对口型）。
/// 三协议：fox（api.workai.cc 聚合）| synclabs（lipsync 代理）| custom（自定义 OpenAI 兼容占位）。
/// Key 密文（MiniAppCrypto 同套 AES-256-GCM），出参只回 keyConfigured，绝不明文回显。
model DigitalHumanChannel {
  id         Int       @id @default(autoincrement())
  userId     String    @map("user_id") @db.VarChar(64)
  /// voice-clone | body-train | tts | lipsync
  capability String    @db.VarChar(16)
  /// fox | synclabs | custom
  protocol   String    @default("fox") @db.VarChar(16)
  name       String    @db.VarChar(64)
  baseUrl    String    @default("") @map("base_url") @db.VarChar(300)
  keyCipher  String    @default("") @map("key_cipher") @db.Text
  /// 模型档位（如 wav2lip++ / sync-1.6.0）或音色语言标记
  modelTier  String    @default("") @map("model_tier") @db.VarChar(64)
  /// 回调密钥（provider webhook 校验用），密文
  secretCipher String  @default("") @map("secret_cipher") @db.Text
  enabled    Boolean   @default(true)
  /// 同一 capability 只允许一个默认渠道生效
  isDefault  Boolean   @default(false) @map("is_default")
  /// 渠道连通自检通过时间；换 key/baseUrl 后清空
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([userId, capability, name], map: "dh_channels_user_cap_name_key")
  @@index([userId, capability, enabled])
  @@map("digital_human_channels")
}

/// C 端终端会员（openid 维度，与平台账号无关）。三账户：算力 point、形象点 body、声音点 voice。
model DigitalHumanMember {
  id          Int       @id @default(autoincrement())
  siteId      Int       @map("site_id")
  userId      String    @map("user_id") @db.VarChar(64)
  openid      String    @db.VarChar(64)
  unionId     String    @default("") @map("union_id") @db.VarChar(64)
  nickname    String    @default("") @db.VarChar(60)
  avatar      String    @default("") @db.VarChar(500)
  phone       String    @default("") @db.VarChar(20)
  /// 算力余额（视频合成/TTS/AI 写作计价扣它）
  point       Int       @default(0)
  /// 形象克隆点数
  bodyQuota   Int       @default(0) @map("body_quota")
  /// 声音克隆点数
  voiceQuota  Int       @default(0) @map("voice_quota")
  /// 会员到期时间；null 或过期即非会员
  vipExpireAt DateTime? @map("vip_expire_at")
  /// 直推人 tuid（注册时写入，之后不变）
  referrerId  Int       @default(0) @map("referrer_id")
  /// 间推人 ptuid
  parentReferrerId Int  @default(0) @map("parent_referrer_id")
  /// 0 普通用户 | 1 推广员
  promoterLevel Int     @default(0) @map("promoter_level") @db.TinyInt
  /// 可提现佣金（分）
  commissionBalance Int @default(0) @map("commission_balance")
  /// 累计佣金（分）
  commissionTotal   Int @default(0) @map("commission_total")
  /// ACTIVE | FROZEN | DELETED（注销）
  status      String    @default("ACTIVE") @db.VarChar(16)
  loginCount  Int       @default(0) @map("login_count")
  lastLoginAt DateTime? @map("last_login_at")
  giftClaimed Boolean   @default(false) @map("gift_claimed")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([siteId, openid], map: "dh_members_site_openid_key")
  @@index([siteId, phone])
  @@index([siteId, promoterLevel])
  @@index([siteId, referrerId])
  @@index([siteId, createdAt])
  @@map("digital_human_members")
}

/// 资产流水（三账户统一走这张表；失败原路退回记 isRefund）。
model DigitalHumanBalanceLog {
  id           Int      @id @default(autoincrement())
  siteId       Int      @map("site_id")
  memberId     Int      @map("member_id")
  /// point | body | voice
  account      String   @db.VarChar(16)
  delta        Int
  balanceAfter Int      @map("balance_after")
  /// gift|recharge|work|tts|body|voice|card|refund|admin|commission
  bizType      String   @map("biz_type") @db.VarChar(24)
  refId        Int      @default(0) @map("ref_id")
  isRefund     Boolean  @default(false) @map("is_refund")
  remark       String   @default("") @db.VarChar(200)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([siteId, memberId, createdAt])
  @@index([siteId, bizType])
  @@map("digital_human_balance_logs")
}

/// 用户形象分身（出镜视频训练；status 0 训练中 | 1 可用 | 2 失败）。
model DigitalHumanBody {
