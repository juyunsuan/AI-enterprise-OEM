  /// 父页面（0 ＝ 一级）
  parentId  Int      @default(0) @map("parent_id")
  /// LIST / FORM / DETAIL / KANBAN / APPROVAL_INBOX / DASHBOARD / CUSTOM
  type      String   @db.VarChar(16)
  name      String   @db.VarChar(50)
  entityId  Int      @default(0) @map("entity_id")
  /// 页面配置：列表/表单/看板参数，或 CUSTOM 的画布组件树
  config    Json     @default("{}")
  sort      Int      @default(0)
  visible   Boolean  @default(true)
  builtin   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId, sort])
  @@map("lowcode_pages")
}

model LowCodeApprovalFlow {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  entityId  Int      @map("entity_id")
  name      String   @db.VarChar(50)
  /// ACTIVE / DISABLED
  status    String   @default("ACTIVE") @db.VarChar(16)
  /// 当前生效版本（lowcode_approval_flow_versions.version）
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId, entityId])
  @@map("lowcode_approval_flows")
}

model LowCodeApprovalFlowVersion {
  id        Int      @id @default(autoincrement())
  flowId    Int      @map("flow_id")
  version   Int
  /// 节点数组：[{ type:'APPROVE', name, assigneeType:'USER|MANAGER|DEPT_LEADER', userIds:[], mode:'ALL|ANY' }]
  nodes     Json     @default("[]")
  createdBy String   @map("created_by") @db.VarChar(64)
