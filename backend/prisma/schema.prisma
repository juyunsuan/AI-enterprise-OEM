  lng          Decimal  @default(0) @db.Decimal(10, 6)
  lat          Decimal  @default(0) @db.Decimal(10, 6)
  tag          String   @default("") @db.VarChar(20)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([shopId, customerId])
  @@map("health_customer_addresses")
}

/// 就诊人（本人/家人）：预约、随访、监测都挂就诊人而不是顾客。
model HealthPatient {
  id                   Int      @id @default(autoincrement())
  shopId               Int      @map("shop_id")
  customerId           Int      @map("customer_id")
  name                 String   @db.VarChar(60)
  /// SELF | SPOUSE | CHILD | PARENT | OTHER
  relation             String   @default("SELF") @db.VarChar(16)
  gender               String   @default("") @db.VarChar(8)
  birthday             String   @default("") @db.VarChar(20)
  phone                String   @default("") @db.VarChar(32)
  /// 证件号加密存储（列表页只回后 4 位）
  idCardCipher         String   @default("") @map("id_card_cipher") @db.VarChar(255)
  idCardTail           String   @default("") @map("id_card_tail") @db.VarChar(8)
  bloodType            String   @default("") @map("blood_type") @db.VarChar(8)
  heightCm             Decimal  @default(0) @map("height_cm") @db.Decimal(5, 1)
  weightKg             Decimal  @default(0) @map("weight_kg") @db.Decimal(5, 1)
  ownerPractitionerId  Int      @default(0) @map("owner_practitioner_id")
  teamId               Int      @default(0) @map("team_id")
  remark               String   @default("") @db.VarChar(500)
  isDefault            Boolean  @default(false) @map("is_default")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([shopId, customerId])
  @@index([shopId, ownerPractitionerId])
  @@index([shopId, name])
  @@map("health_patients")
}

model HealthCrowdGroup {
  id        Int      @id @default(autoincrement())
  shopId    Int      @map("shop_id")
  name      String   @db.VarChar(40)
  /// ALL | ELDERLY | HYPERTENSION | DIABETES | MATERNAL | CHILD | POST_OPERATION | CHRONIC_OTHER
  kind      String   @default("ALL") @db.VarChar(24)
  desc      String   @default("") @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([shopId, name])
  @@map("health_crowd_groups")
}

model HealthCrowdMember {
  id         Int @id @default(autoincrement())
  shopId     Int @map("shop_id")
  groupId    Int @map("group_id")
  patientId  Int @map("patient_id")

  @@unique([groupId, patientId])
  @@index([shopId, patientId])
  @@map("health_crowd_members")
}

/// 健康档案主表（基本信息 JSON + 完整性标记）。
model HealthRecord {
  id         Int      @id @default(autoincrement())
  shopId     Int      @map("shop_id")
  patientId  Int      @unique @map("patient_id")
  basicsJson Json     @default("{}") @map("basics_json")
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([shopId, updatedAt])
  @@map("health_records")
}

/// 档案分型条目（既往史/过敏史/家族史/生活方式/症状/接种史）。
model HealthRecordItem {
  id        Int      @id @default(autoincrement())
  shopId    Int      @map("shop_id")
  patientId Int      @map("patient_id")
  /// PAST | ALLERGY | FAMILY | LIFESTYLE | SYMPTOM | IMMUNE
