  pointCost      Int      @default(0) @map("point_cost")
  isRefund       Boolean  @default(false) @map("is_refund")
  failReason     String   @default("") @map("fail_reason") @db.VarChar(300)
  playCount      Int      @default(0) @map("play_count")
