  amount      Decimal   @default(0) @db.Decimal(18, 2)
  status      String    @default("PENDING") @db.VarChar(16)
  bankInfo    String    @default("") @map("bank_info") @db.VarChar(200)
  handledNote String    @default("") @map("handled_note") @db.VarChar(300)
  handledAt   DateTime? @map("handled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([siteId, status, createdAt])
  @@map("errand_agent_withdrawals")
}

/// 骑手提现申请：店主在台账号按打款/驳回，资金不经平台。
model ErrandWithdrawal {
  id           Int       @id @default(autoincrement())
  siteId       Int       @map("site_id")
  ownerUserId  String    @map("owner_user_id") @db.VarChar(64)
  riderId      Int       @map("rider_id")
  riderName    String    @default("") @map("rider_name") @db.VarChar(40)
  riderNo      String    @default("") @map("rider_no") @db.VarChar(16)
  amount       Decimal   @default(0) @db.Decimal(18, 2)
  /// PENDING | PAID | REJECTED
  status       String    @default("PENDING") @db.VarChar(16)
  bankInfo     String    @default("") @map("bank_info") @db.VarChar(200)
  reason       String    @default("") @db.VarChar(300)
  handledNote  String    @default("") @map("handled_note") @db.VarChar(300)
  handledBy    String    @default("") @map("handled_by") @db.VarChar(64)
  handledAt    DateTime? @map("handled_at")
  /// MANUAL 手工打款 | WECHAT 商家转账
  method       String    @default("MANUAL") @db.VarChar(8)
  /// 微信商家转账批次号
  transferBatchId String @default("") @map("transfer_batch_id") @db.VarChar(64)
  /// NONE | SUBMITTED | FAILED
  transferState String   @default("NONE") @map("transfer_state") @db.VarChar(24)
  transferredAt DateTime? @map("transferred_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([siteId, status, createdAt])
  @@map("errand_withdrawals")
}

/// 多店铺商城平台（B2B2C）· 市场实例：一个本站用户一个市场，shopCode 供公开寻址。
/// 商户账号体系独立于站内 User / org-staff（外部商户不进企业组织树，评审红线）。
model MpMarket {
  id               Int      @id @default(autoincrement())
  /// 归属账号（本站用户＝市场运营方）
  ownerUserId      String   @unique @map("owner_user_id") @db.VarChar(64)
  enterpriseId     Int      @default(0) @map("enterprise_id")
  enterpriseUserId String   @default("") @map("enterprise_user_id") @db.VarChar(64)
  /// 公开寻址码：小程序 config.js 的 market 值，创建后不变
  shopCode         String   @unique @map("shop_code") @db.VarChar(16)
  name             String   @db.VarChar(120)
  logo             String   @default("") @db.VarChar(500)
  description      String   @default("") @db.VarChar(500)
  /// 市场装修与主题：{ themeColor, navStyle, ... }（B3 装修能力上收后使用）
  themeJson        Json     @default("{}") @map("theme_json")
  /// 交易参数：未支付关单分钟数、默认运费、售后期限等
  tradeJson        Json     @default("{}") @map("trade_json")
  /// 结算参数：默认抽佣比例、结算周期、提现门槛（B2 结算单使用）
  settleJson       Json     @default("{}") @map("settle_json")
  /// 绑定的 AI 客服站点 id（0 = 未开通）；只存 id，不建外键
  supportSiteId    Int      @default(0) @map("support_site_id")
  /// 企业微信 SCRM 外发开关：关闭时不生产事件（历史待发事件保留）
  scrmEnabled      Boolean  @default(false) @map("scrm_enabled")
  /// DRAFT 筹备中 | ONLINE 营业中 | SUSPENDED 平台停服 | CLOSED 已关闭
  status           String   @default("DRAFT") @db.VarChar(16)
  offReason        String   @default("") @map("off_reason") @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("mp_markets")
}

/// 商户主体：入驻申请即一行，审核通过前不能上架商品（auditStatus 状态机在服务层收口）。
model MpMerchant {
  id             Int       @id @default(autoincrement())
  marketId       Int       @map("market_id")
  name           String    @db.VarChar(120)
  licenseNo      String    @default("") @map("license_no") @db.VarChar(64)
  licenseImage   String    @default("") @map("license_image") @db.VarChar(500)
  contactName    String    @map("contact_name") @db.VarChar(60)
  contactPhone   String    @map("contact_phone") @db.VarChar(32)
  /// 经营范围：市场统一类目 id 数组
  categoryIds    Json      @default("[]") @map("category_ids")
  /// PENDING 待审核 | APPROVED 已通过 | REJECTED 已驳回 | BANNED 已封禁
  auditStatus    String    @default("PENDING") @map("audit_status") @db.VarChar(16)
  auditNote      String    @default("") @map("audit_note") @db.VarChar(500)
  auditAt        DateTime? @map("audit_at")
  auditBy        String    @default("") @map("audit_by") @db.VarChar(64)
  /// null = 按类目/平台默认抽佣（B2 结算引擎读取）
  commissionRate Decimal?  @map("commission_rate") @db.Decimal(5, 2)
  expireAt       DateTime? @map("expire_at")
  /// ACTIVE 正常 | CLOSED 已退出
  status         String    @default("ACTIVE") @db.VarChar(16)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([marketId, auditStatus])
  @@index([marketId, status])
  @@map("mp_merchants")
}

/// 商户店铺：审核通过即自动建一店（首期 1:1，后续可 1:N）。
model MpShop {
  id          Int      @id @default(autoincrement())
  marketId    Int      @map("market_id")
  merchantId  Int      @map("merchant_id")
  name        String   @db.VarChar(120)
  logo        String   @default("") @db.VarChar(500)
  intro       String   @default("") @db.VarChar(500)
  categoryIds Json     @default("[]") @map("category_ids")
  /// 公开寻址码：市场内店铺页使用，创建后不变
  shopCode    String   @unique @map("shop_code") @db.VarChar(16)
  /// 微信支付商户号（空 = 回落到市场运营方配置）
  mchId       String   @default("") @map("mch_id") @db.VarChar(64)
  payEnabled  Boolean  @default(false) @map("pay_enabled")
  /// DRAFT 装修中 | ONLINE 营业中 | SUSPENDED 平台停服 | CLOSED 已关闭
  status      String   @default("DRAFT") @db.VarChar(16)
  sortOrder   Int      @default(0) @map("sort_order")
  themeJson   Json     @default("{}") @map("theme_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([marketId, status, sortOrder])
  @@index([merchantId])
  @@map("mp_shops")
}

/// 商户后台账号：口令 scrypt(salt, 32B) 分列存储；停用即断权（每次请求回库校验）。
model MpMerchantUser {
  id           Int       @id @default(autoincrement())
  marketId     Int       @map("market_id")
  merchantId   Int       @map("merchant_id")
  /// 全局唯一（登录只凭用户名，不要求先选市场）
  username     String    @unique @db.VarChar(64)
  passwordHash String    @map("password_hash") @db.VarChar(128)
  salt         String    @db.VarChar(64)
  /// OWNER 商户负责人 | STAFF 店员
  role         String    @default("OWNER") @db.VarChar(16)
  phone        String    @default("") @db.VarChar(32)
  lastLoginAt  DateTime? @map("last_login_at")
  /// ACTIVE 正常 | DISABLED 已停用
  status       String    @default("ACTIVE") @db.VarChar(16)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([merchantId, status])
  @@index([marketId])
  @@map("mp_merchant_users")
}

/// 平台统一类目：商户只能选不能造（商品域在 B1 接入）。
model MpCategory {
  id        Int      @id @default(autoincrement())
  marketId  Int      @map("market_id")
  parentId  Int      @default(0) @map("parent_id")
  name      String   @db.VarChar(60)
  icon      String   @default("") @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  /// ONLINE 启用 | OFFLINE 停用（停用后不可再被商家选中，存量商品保持展示）
  status    String   @default("ONLINE") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([marketId, parentId, sortOrder])
  @@map("mp_categories")
}

// ============================================================
// 多店铺商城平台（B2B2C）· B1 商品域与交易域
// 设计见 docs/品牌商城与多店铺商城平台设计方案.md §5.2。
// 商品先审后上架；父单只做支付与整体状态，子单是发货/售后/结算单位。
// ============================================================

/// 商户商品：归属「市场 + 商户 + 店铺」三级；只有审核通过才能上线。
model MpProduct {
  id            Int      @id @default(autoincrement())
  marketId      Int      @map("market_id")
  merchantId    Int      @map("merchant_id")
  shopId        Int      @map("shop_id")
  /// 平台统一类目 id（0 = 未分类）
  categoryId    Int      @default(0) @map("category_id")
  title         String   @db.VarChar(200)
  subtitle      String   @default("") @db.VarChar(200)
  coverImage    String   @default("") @map("cover_image") @db.VarChar(500)
  images        Json     @default("[]")
  /// 富文本详情（HTML）
  detail        String   @default("") @db.MediumText
  /// NORMAL 实物 | VIRTUAL 虚拟（下单即完成，不占库存不发货）
  type          String   @default("NORMAL") @db.VarChar(16)
  price         Decimal  @default(0) @db.Decimal(12, 2)
  marketPrice   Decimal  @default(0) @map("market_price") @db.Decimal(12, 2)
  costPrice     Decimal  @default(0) @map("cost_price") @db.Decimal(12, 2)
  /// 单规格库存；多规格以 SKU 汇总为准
  stock         Int      @default(0)
  sales         Int      @default(0)
  unit          String   @default("件") @db.VarChar(20)
  weight        Decimal  @default(0) @db.Decimal(12, 3)
  /// 单件运费（元/件）；0 = 回落市场交易参数里的默认运费
  freightAmount Decimal  @default(0) @map("freight_amount") @db.Decimal(12, 2)
  /// 规格定义 [{ name, values: [] }]
  specs         Json     @default("[]")
  /// 服务保障标签
  guarantee     Json     @default("[]")
  /// DRAFT 草稿 | PENDING 待审核 | ONLINE 在售 | OFFLINE 已下架 | REJECTED 审核驳回
  status        String   @default("DRAFT") @db.VarChar(16)
  /// 最近一次审核意见（驳回原因对商户可见）
  auditNote     String   @default("") @map("audit_note") @db.VarChar(500)
  sortOrder     Int      @default(0) @map("sort_order")
  isHot         Boolean  @default(false) @map("is_hot")
  isNew         Boolean  @default(false) @map("is_new")
  reviewCount   Int      @default(0) @map("review_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([marketId, status, sortOrder])
  @@index([shopId, status, sortOrder])
  @@index([merchantId])
  @@index([marketId, categoryId])
  @@map("mp_products")
}

/// 规格组合后的可售单元：specValues 是 { 规格名: 规格值 }。
model MpProductSku {
  id          Int      @id @default(autoincrement())
  marketId    Int      @map("market_id")
  merchantId  Int      @map("merchant_id")
  shopId      Int      @map("shop_id")
  productId   Int      @map("product_id")
  skuName     String   @default("") @map("sku_name") @db.VarChar(200)
  image       String   @default("") @db.VarChar(500)
  /// 规格值拼接的稳定标识，购物车与下单快照用它对齐
  uniqueId    String   @default("") @map("unique_id") @db.VarChar(191)
  specValues  Json     @default("{}") @map("spec_values")
  price       Decimal  @default(0) @db.Decimal(12, 2)
  marketPrice Decimal  @default(0) @map("market_price") @db.Decimal(12, 2)
  costPrice   Decimal  @default(0) @map("cost_price") @db.Decimal(12, 2)
  stock       Int      @default(0)
  sales       Int      @default(0)
  weight      Decimal  @default(0) @db.Decimal(12, 3)
  barcode     String   @default("") @db.VarChar(64)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([shopId, uniqueId])
  @@map("mp_product_skus")
}

/// 商品评价：C 端确认收货后提交，status 控制显隐。
model MpProductReview {
  id          Int      @id @default(autoincrement())
  marketId    Int      @map("market_id")
  shopId      Int      @map("shop_id")
  productId   Int      @map("product_id")
  orderId     Int      @default(0) @map("order_id")
  orderItemId Int      @default(0) @map("order_item_id")
  customerId  Int      @map("customer_id")
  rating      Int      @default(5)
  content     String   @default("") @db.VarChar(500)
  images      Json     @default("[]")
  /// PUBLISHED 展示 | HIDDEN 隐藏
  status      String   @default("PUBLISHED") @db.VarChar(16)
  reply       String   @default("") @db.VarChar(500)
  replyAt     DateTime? @map("reply_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([marketId, productId, status])
  @@index([shopId, status, createdAt])
  @@index([customerId])
  @@map("mp_product_reviews")
}

/// 商品送审流水：每次提交一行 PENDING，平台决定后改 APPROVED/REJECTED 并留痕。
model MpProductAudit {
  id           Int      @id @default(autoincrement())
  marketId     Int      @map("market_id")
  merchantId   Int      @map("merchant_id")
  shopId       Int      @map("shop_id")
  productId    Int      @map("product_id")
  /// PENDING 待审核 | APPROVED 通过 | REJECTED 驳回
  auditStatus  String   @default("PENDING") @map("audit_status") @db.VarChar(16)
  /// 提交时商品内容快照 hash（改内容必须重新送审）
  snapshotHash String   @default("") @map("snapshot_hash") @db.VarChar(64)
  reason       String   @default("") @db.VarChar(500)
  submitBy     String   @default("") @map("submit_by") @db.VarChar(64)
  auditBy      String   @default("") @map("audit_by") @db.VarChar(64)
  auditAt      DateTime? @map("audit_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([marketId, auditStatus, createdAt])
  @@index([productId, id])
  @@map("mp_product_audits")
}

/// C 端顾客：一市场一套，按 (marketId, openid) 唯一，与站内 User 完全隔离。
model MpCustomer {
  id          Int       @id @default(autoincrement())
  marketId    Int       @map("market_id")
  openid      String    @db.VarChar(64)
  unionId     String    @default("") @map("union_id") @db.VarChar(64)
  nickname    String    @default("") @db.VarChar(60)
  avatar      String    @default("") @db.VarChar(500)
  phone       String    @default("") @db.VarChar(20)
  gender      Int       @default(0)
  /// 会员等级名（二期启用权益）
  level       String    @default("") @db.VarChar(30)
  points      Int       @default(0)
  balance     Decimal   @default(0) @db.Decimal(12, 2)
  source      String    @default("MINIPROGRAM") @db.VarChar(16)
  /// ACTIVE 正常 | BLOCKED 拉黑
  status      String    @default("ACTIVE") @db.VarChar(16)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([marketId, openid], map: "mp_customers_market_openid_uniq")
  @@index([marketId, createdAt])
  @@map("mp_customers")
}

/// 顾客收货地址。
model MpCustomerAddress {
  id         Int      @id @default(autoincrement())
  marketId   Int      @map("market_id")
  customerId Int      @map("customer_id")
  realName   String   @map("real_name") @db.VarChar(30)
  phone      String   @db.VarChar(20)
  province   String   @default("") @db.VarChar(40)
  city       String   @default("") @db.VarChar(40)
  district   String   @default("") @db.VarChar(40)
  detail     String   @db.VarChar(200)
  postalCode String   @default("") @map("postal_code") @db.VarChar(10)
  isDefault  Boolean  @default(false) @map("is_default")
  tag        String   @default("") @db.VarChar(10)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([marketId, customerId])
  @@map("mp_customer_addresses")
}

/// 跨商户购物车：一客一 SKU 一行，改数量即 upsert。
model MpCartItem {
  id         Int      @id @default(autoincrement())
  marketId   Int      @map("market_id")
  customerId Int      @map("customer_id")
  shopId     Int      @map("shop_id")
  productId  Int      @map("product_id")
  /// 0 = 无规格商品
  skuId      Int      @default(0) @map("sku_id")
  quantity   Int      @default(1)
  selected   Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([marketId, customerId, productId, skuId], map: "mp_carts_market_customer_product_sku_uniq")
  @@index([marketId, customerId])
  @@map("mp_carts")
}

/// 父单：一次结算一个父单，只做支付与整体状态，不持有发货动作。
model MpOrder {
  id             Int       @id @default(autoincrement())
  marketId       Int       @map("market_id")
  ownerUserId    String    @map("owner_user_id") @db.VarChar(64)
  orderNo        String    @unique @map("order_no") @db.VarChar(32)
  customerId     Int       @map("customer_id")
  /// PENDING_PAYMENT | PAID | SHIPPED | COMPLETED | CANCELLED（由子单汇总推进）
  status         String    @default("PENDING_PAYMENT") @db.VarChar(20)
  /// UNPAID | PAID | REFUNDING | REFUNDED
  payStatus      String    @default("UNPAID") @map("pay_status") @db.VarChar(20)
  goodsAmount    Decimal   @default(0) @map("goods_amount") @db.Decimal(12, 2)
  freightAmount  Decimal   @default(0) @map("freight_amount") @db.Decimal(12, 2)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  payAmount      Decimal   @default(0) @map("pay_amount") @db.Decimal(12, 2)
  /// 使用的券（mp_coupon_tickets.id，0 = 未用券）；券面额按子单商品额分摊进子单 discount_amount
  couponTicketId Int       @default(0) @map("coupon_ticket_id")
  couponName     String    @default("") @map("coupon_name") @db.VarChar(40)
  /// WECHAT | OFFLINE
  payType        String    @default("WECHAT") @map("pay_type") @db.VarChar(16)
  transactionId  String    @default("") @map("transaction_id") @db.VarChar(64)
  prepayId       String    @default("") @map("prepay_id") @db.VarChar(64)
  /// 拆出的子单数
  shopOrderCount Int       @default(0) @map("shop_order_count")
  receiverName   String    @default("") @map("receiver_name") @db.VarChar(30)
  receiverPhone  String    @default("") @map("receiver_phone") @db.VarChar(20)
  receiverProvince String  @default("") @map("receiver_province") @db.VarChar(40)
  receiverCity   String    @default("") @map("receiver_city") @db.VarChar(40)
  receiverDistrict String  @default("") @map("receiver_district") @db.VarChar(40)
  receiverDetail String    @default("") @map("receiver_detail") @db.VarChar(200)
  buyerRemark    String    @default("") @map("buyer_remark") @db.VarChar(200)
  paidAt         DateTime? @map("paid_at")
  completedAt    DateTime? @map("completed_at")
  cancelledAt    DateTime? @map("cancelled_at")
  cancelReason   String    @default("") @map("cancel_reason") @db.VarChar(200)
  /// 未付款自动取消锚点（定时任务按它扫）
  expireAt       DateTime? @map("expire_at")
  clientIp       String    @default("") @map("client_ip") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([marketId, status, createdAt])
  @@index([marketId, customerId, id])
  @@index([marketId, expireAt])
  @@index([ownerUserId])
  @@map("mp_orders")
}

/// 商户子单：拆单产物，发货 / 售后 / 结算的最小单位。
model MpShopOrder {
  id             Int       @id @default(autoincrement())
  orderId        Int       @map("order_id")
  marketId       Int       @map("market_id")
  merchantId     Int       @map("merchant_id")
  shopId         Int       @map("shop_id")
  customerId     Int       @default(0) @map("customer_id")
  subOrderNo     String    @unique @map("sub_order_no") @db.VarChar(32)
  /// PENDING_PAYMENT | PAID | SHIPPED | COMPLETED | CANCELLED
  status         String    @default("PENDING_PAYMENT") @db.VarChar(20)
  /// UNPAID | PAID | REFUNDING | REFUNDED
  payStatus      String    @default("UNPAID") @map("pay_status") @db.VarChar(20)
  /// NONE | PENDING | APPROVED | REJECTED | DONE
  refundStatus   String    @default("NONE") @map("refund_status") @db.VarChar(20)
  goodsAmount    Decimal   @default(0) @map("goods_amount") @db.Decimal(12, 2)
  freightAmount  Decimal   @default(0) @map("freight_amount") @db.Decimal(12, 2)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  payAmount      Decimal   @default(0) @map("pay_amount") @db.Decimal(12, 2)
  /// 下单时的抽佣快照（百分比，如 8.00）
  commissionRate Decimal   @default(0) @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Decimal @default(0) @map("commission_amount") @db.Decimal(12, 2)
  receiverName   String    @default("") @map("receiver_name") @db.VarChar(30)
  receiverPhone  String    @default("") @map("receiver_phone") @db.VarChar(20)
  receiverProvince String  @default("") @map("receiver_province") @db.VarChar(40)
  receiverCity   String    @default("") @map("receiver_city") @db.VarChar(40)
  receiverDistrict String  @default("") @map("receiver_district") @db.VarChar(40)
  receiverDetail String    @default("") @map("receiver_detail") @db.VarChar(200)
  buyerRemark    String    @default("") @map("buyer_remark") @db.VarChar(200)
  sellerRemark   String    @default("") @map("seller_remark") @db.VarChar(500)
  expressCompany String    @default("") @map("express_company") @db.VarChar(40)
  expressNo      String    @default("") @map("express_no") @db.VarChar(60)
  shippedAt      DateTime? @map("shipped_at")
  completedAt    DateTime? @map("completed_at")
  cancelledAt    DateTime? @map("cancelled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([marketId, merchantId, status, createdAt])
  @@index([marketId, shopId, status])
  @@index([customerId, id])
  @@map("mp_shop_orders")
}

/// 子单明细：下单瞬间的商品快照，改价改名不影响历史单。
model MpOrderItem {
  id               Int      @id @default(autoincrement())
  orderId          Int      @map("order_id")
  shopOrderId      Int      @map("shop_order_id")
  marketId         Int      @map("market_id")
  merchantId       Int      @map("merchant_id")
  shopId           Int      @map("shop_id")
  customerId       Int      @default(0) @map("customer_id")
  productId        Int      @map("product_id")
  skuId            Int      @default(0) @map("sku_id")
  title            String   @db.VarChar(200)
  skuName          String   @default("") @map("sku_name") @db.VarChar(200)
  image            String   @default("") @db.VarChar(500)
  price            Decimal  @default(0) @db.Decimal(12, 2)
  quantity         Int      @default(1)
  totalPrice       Decimal  @default(0) @map("total_price") @db.Decimal(12, 2)
  commissionRate   Decimal  @default(0) @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Decimal  @default(0) @map("commission_amount") @db.Decimal(12, 2)
  /// NONE | PENDING | APPROVED | REJECTED | DONE
  refundStatus     String   @default("NONE") @map("refund_status") @db.VarChar(20)
  refundedAmount   Decimal  @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  reviewed         Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([shopOrderId])
  @@index([marketId, productId])
  @@map("mp_order_items")
}

/// 订单时间线：父单与子单共用一份，operatorType 区分四类操作者。
model MpOrderLog {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  /// 0 = 父单级事件
  shopOrderId  Int      @default(0) @map("shop_order_id")
  marketId     Int      @map("market_id")
  shopId       Int      @default(0) @map("shop_id")
  /// SYSTEM | CUSTOMER | MERCHANT | PLATFORM
  operatorType String   @default("SYSTEM") @map("operator_type") @db.VarChar(16)
  operatorId   String   @default("") @map("operator_id") @db.VarChar(64)
  action       String   @db.VarChar(40)
  content      String   @default("") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([orderId, id])
  @@index([shopOrderId, id])
  @@index([marketId, createdAt])
  @@map("mp_order_logs")
}

/// 售后单：买家对子单明细发起，商户审核，平台可介入仲裁。
model MpAfterSale {
  id              Int       @id @default(autoincrement())
  marketId        Int       @map("market_id")
  merchantId      Int       @map("merchant_id")
  shopId          Int       @map("shop_id")
  orderId         Int       @map("order_id")
  shopOrderId     Int       @map("shop_order_id")
  customerId      Int       @map("customer_id")
  afterSaleNo     String    @unique @map("after_sale_no") @db.VarChar(32)
  /// REFUND_ONLY 仅退款 | RETURN_REFUND 退货退款
  type            String    @default("REFUND_ONLY") @db.VarChar(20)
  reason          String    @default("") @db.VarChar(100)
  description     String    @default("") @db.VarChar(500)
  images          Json      @default("[]")
  amount          Decimal   @default(0) @db.Decimal(12, 2)
  /// PENDING | AGREED | REJECTED | REFUNDED | CANCELLED
  status          String    @default("PENDING") @db.VarChar(20)
  merchantRemark  String    @default("") @map("merchant_remark") @db.VarChar(200)
  rejectReason    String    @default("") @map("reject_reason") @db.VarChar(200)
  platformNote    String    @default("") @map("platform_note") @db.VarChar(200)
  returnExpress   String    @default("") @map("return_express") @db.VarChar(60)
  returnExpressNo String    @default("") @map("return_express_no") @db.VarChar(60)
  /// 同意后生成的退款单 mp_refunds.id
  refundId        Int       @default(0) @map("refund_id")
  auditedAt       DateTime? @map("audited_at")
  refundedAt      DateTime? @map("refunded_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([marketId, status, createdAt])
  @@index([merchantId, status, createdAt])
  @@index([shopId, status])
  @@index([shopOrderId])
  @@index([customerId, id])
  @@map("mp_after_sales")
}

/// 售后明细：申请时的商品快照，金额按行分摊。
model MpAfterSaleItem {
  id          Int      @id @default(autoincrement())
  afterSaleId Int      @map("after_sale_id")
  marketId    Int      @map("market_id")
  shopOrderId Int      @map("shop_order_id")
  orderItemId Int      @map("order_item_id")
  productId   Int      @default(0) @map("product_id")
  skuId       Int      @default(0) @map("sku_id")
  title       String   @default("") @db.VarChar(200)
  skuName     String   @default("") @map("sku_name") @db.VarChar(200)
  image       String   @default("") @db.VarChar(500)
  price       Decimal  @default(0) @db.Decimal(12, 2)
  quantity    Int      @default(1)
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([afterSaleId, orderItemId])
  @@index([shopOrderId])
  @@map("mp_after_sale_items")
}

/// 统一退款单：售后同意即落一条，渠道退款单号与结果回填在此。
model MpRefund {
  id            Int       @id @default(autoincrement())
  marketId      Int       @map("market_id")
  merchantId    Int       @map("merchant_id")
  shopId        Int       @map("shop_id")
  refundNo      String    @unique @map("refund_no") @db.VarChar(32)
  afterSaleId   Int       @default(0) @map("after_sale_id")
  orderId       Int       @map("order_id")
  shopOrderId   Int       @map("shop_order_id")
  customerId    Int       @map("customer_id")
  /// WECHAT 原路退回 | OFFLINE 线下退款
  channel       String    @default("OFFLINE") @db.VarChar(16)
  amount        Decimal   @default(0) @db.Decimal(12, 2)
  /// PENDING | SUCCESS | FAILED
  status        String    @default("PENDING") @db.VarChar(16)
  reason        String    @default("") @db.VarChar(200)
  transactionId String    @default("") @map("transaction_id") @db.VarChar(64)
  error         String    @default("") @db.VarChar(200)
  operatorType  String    @default("MERCHANT") @map("operator_type") @db.VarChar(16)
  operatorId    String    @default("") @map("operator_id") @db.VarChar(64)
  refundedAt    DateTime? @map("refunded_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([marketId, status, createdAt])
  @@index([merchantId, status])
  @@index([shopOrderId])
  @@index([afterSaleId])
  @@map("mp_refunds")
}

/// 退款副作用幂等台账：唯一键 [refundId, effect] 保证重试不重复执行。
model MpRefundEffect {
  id         Int       @id @default(autoincrement())
  marketId   Int       @map("market_id")
  refundId   Int       @map("refund_id")
  /// RESTORE_STOCK 回补库存 | REVOKE_COMMISSION 佣金冲销
  effect     String    @db.VarChar(24)
  /// PENDING | DONE | FAILED
  status     String    @default("PENDING") @db.VarChar(16)
  detail     Json      @default("{}")
  error      String    @default("") @db.VarChar(200)
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([refundId, effect])
  @@index([marketId, status])
  @@map("mp_refund_effects")
}

/// 支付流水：父单一次支付，按子单拆分记录，供结算对账。
model MpPayRecord {
  id               Int       @id @default(autoincrement())
  marketId         Int       @map("market_id")
  orderId          Int       @map("order_id")
  shopOrderId      Int       @map("shop_order_id")
  orderNo          String    @map("order_no") @db.VarChar(32)
  subOrderNo       String    @default("") @map("sub_order_no") @db.VarChar(32)
  transactionId    String    @default("") @map("transaction_id") @db.VarChar(64)
  /// WECHAT | OFFLINE
  payType          String    @default("WECHAT") @map("pay_type") @db.VarChar(16)
  amount           Decimal   @default(0) @db.Decimal(12, 2)
  commissionAmount Decimal   @default(0) @map("commission_amount") @db.Decimal(12, 2)
  /// PAID | REFUNDED（退款不删流水，结算按净额）
  status           String    @default("PAID") @db.VarChar(16)
  paidAt           DateTime? @map("paid_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([shopOrderId])
  @@index([marketId, paidAt])
  @@map("mp_pay_records")
}

/// 抽佣规则：商户专属 > 类目 > 平台默认，按 scopeType 决定优先级。
model MpCommissionRule {
  id        Int      @id @default(autoincrement())
  marketId  Int      @map("market_id")
  /// PLATFORM | CATEGORY | MERCHANT
  scopeType String   @map("scope_type") @db.VarChar(16)
  /// 平台默认为 0
  scopeId   Int      @default(0) @map("scope_id")
  rate      Decimal  @default(0) @db.Decimal(5, 2)
  remark    String   @default("") @db.VarChar(200)
  /// ACTIVE | DISABLED
  status    String   @default("ACTIVE") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([marketId, scopeType, scopeId])
  @@index([marketId, status])
  @@map("mp_commission_rules")
}

/// 结算单：按周期汇总已完成子单的净额（实付 - 退款 - 佣金）。
model MpSettlement {
  id               Int       @id @default(autoincrement())
  marketId         Int       @map("market_id")
  merchantId       Int       @map("merchant_id")
  shopId           Int       @map("shop_id")
  settleNo         String    @unique @map("settle_no") @db.VarChar(32)
  periodStart      DateTime  @map("period_start")
  periodEnd        DateTime  @map("period_end")
  orderCount       Int       @default(0) @map("order_count")
  grossAmount      Decimal   @default(0) @map("gross_amount") @db.Decimal(12, 2)
  refundAmount     Decimal   @default(0) @map("refund_amount") @db.Decimal(12, 2)
  commissionAmount Decimal   @default(0) @map("commission_amount") @db.Decimal(12, 2)
  netAmount        Decimal   @default(0) @map("net_amount") @db.Decimal(12, 2)
  /// PENDING 待确认 | CONFIRMED 已确认 | PAID 已打款
  status           String    @default("PENDING") @db.VarChar(16)
  remark           String    @default("") @db.VarChar(200)
  voucher          String    @default("") @db.VarChar(500)
  confirmedAt      DateTime? @map("confirmed_at")
  paidAt           DateTime? @map("paid_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([marketId, status, createdAt])
  @@index([merchantId, status])
  @@index([marketId, shopId, createdAt])
  @@map("mp_settlements")
}

/// 结算明细：一张子单只能进一张结算单。
model MpSettlementItem {
  id               Int       @id @default(autoincrement())
  settlementId     Int       @map("settlement_id")
  marketId         Int       @map("market_id")
  merchantId       Int       @map("merchant_id")
  shopId           Int       @map("shop_id")
  shopOrderId      Int       @unique @map("shop_order_id")
  subOrderNo       String    @default("") @map("sub_order_no") @db.VarChar(32)
  completedAt      DateTime? @map("completed_at")
  payAmount        Decimal   @default(0) @map("pay_amount") @db.Decimal(12, 2)
  refundAmount     Decimal   @default(0) @map("refund_amount") @db.Decimal(12, 2)
  commissionAmount Decimal   @default(0) @map("commission_amount") @db.Decimal(12, 2)
  netAmount        Decimal   @default(0) @map("net_amount") @db.Decimal(12, 2)
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([settlementId])
  @@index([marketId, merchantId, id])
  @@map("mp_settlement_items")
}

/// 提现申请：商户按已打款结算单的可用余额申请，平台审核并回填打款凭证。
model MpWithdrawal {
  id           Int       @id @default(autoincrement())
  marketId     Int       @map("market_id")
  merchantId   Int       @map("merchant_id")
  shopId       Int       @default(0) @map("shop_id")
  withdrawNo   String    @unique @map("withdraw_no") @db.VarChar(32)
  applyAmount  Decimal   @default(0) @map("apply_amount") @db.Decimal(12, 2)
  fee          Decimal   @default(0) @db.Decimal(12, 2)
  actualAmount Decimal   @default(0) @map("actual_amount") @db.Decimal(12, 2)
  bankName     String    @default("") @map("bank_name") @db.VarChar(60)
  bankAccount  String    @default("") @map("bank_account") @db.VarChar(64)
  accountName  String    @default("") @map("account_name") @db.VarChar(60)
  /// PENDING | APPROVED | REJECTED | PAID
  status       String    @default("PENDING") @db.VarChar(16)
  auditNote    String    @default("") @map("audit_note") @db.VarChar(200)
  voucher      String    @default("") @db.VarChar(500)
  auditedAt    DateTime? @map("audited_at")
  auditedBy    String    @default("") @map("audited_by") @db.VarChar(64)
  paidAt       DateTime? @map("paid_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([marketId, status, createdAt])
  @@index([merchantId, status])
  @@map("mp_withdrawals")
}

/// 市场/店铺两级装修页：components/styles 是草稿，published* 是 C 端读的线上快照。
model MpDiyPage {
  id                  Int       @id @default(autoincrement())
  marketId            Int       @map("market_id")
  /// 0 = 市场级页面；>0 = 商户店铺页面
  shopId              Int       @default(0) @map("shop_id")
  name                String    @db.VarChar(40)
  /// HOME 首页 | CATEGORY 分类页 | MINE 个人中心 | ACTIVITY 活动页
  type                String    @default("ACTIVITY") @db.VarChar(16)
  /// [{ type, props }]，组件白名单见 mp.diy-widgets.ts
  components          Json      @default("[]")
  styles              Json      @default("{}")
  coverImage          String    @default("") @map("cover_image") @db.VarChar(500)
  /// 同 marketId+shopId+type 下只有一条 isDefault，C 端按它取
  isDefault           Boolean   @default(false) @map("is_default")
  /// DRAFT | PUBLISHED
  status              String    @default("DRAFT") @db.VarChar(16)
  publishedComponents Json?     @map("published_components")
  publishedStyles     Json?     @map("published_styles")
  publishedAt         DateTime? @map("published_at")
  sortOrder           Int       @default(0) @map("sort_order")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([marketId, shopId, type, status])
  @@map("mp_diy_pages")
}

/// 优惠券：issuerType=PLATFORM 的平台券（shopId/merchantId=0）与商户券（绑店铺）。
model MpCoupon {
  id            Int       @id @default(autoincrement())
  marketId      Int       @map("market_id")
  /// 0 = 平台券；>0 = 商户券所属店铺
  shopId        Int       @default(0) @map("shop_id")
  merchantId    Int       @default(0) @map("merchant_id")
  /// PLATFORM | MERCHANT
  issuerType    String    @default("PLATFORM") @map("issuer_type") @db.VarChar(16)
  name          String    @db.VarChar(40)
  /// FULL_REDUCE 满减 | DISCOUNT 折扣
  type          String    @default("FULL_REDUCE") @db.VarChar(16)
  value         Decimal   @default(0) @db.Decimal(12, 2)
  /// 使用门槛（满多少元），0 = 无门槛
  threshold     Decimal   @default(0) @db.Decimal(12, 2)
  totalCount    Int       @default(0) @map("total_count")
  receivedCount Int       @default(0) @map("received_count")
  usedCount     Int       @default(0) @map("used_count")
  perLimit      Int       @default(1) @map("per_limit")
  /// FIXED 固定有效期 | DAYS 领取后 N 天
  validType     String    @default("FIXED") @map("valid_type") @db.VarChar(16)
  startAt       DateTime? @map("start_at")
  endAt         DateTime? @map("end_at")
  validDays     Int       @default(7) @map("valid_days")
  /// ALL 全场 | SHOP 指定店铺 | CATEGORY 指定类目 | PRODUCT 指定商品
  scope         String    @default("ALL") @db.VarChar(16)
  scopeIds      Json      @default("[]") @map("scope_ids")
  /// ONLINE 发放中 | OFFLINE 已停发 | ENDED 已结束
  status        String    @default("ONLINE") @db.VarChar(16)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([marketId, status, createdAt])
  @@index([marketId, shopId, status])
  @@map("mp_coupons")
}

/// 顾客领券台账：UNUSED → USED / EXPIRED；下单核销写 orderId。
model MpCouponTicket {
  id         Int       @id @default(autoincrement())
  marketId   Int       @map("market_id")
  couponId   Int       @map("coupon_id")
  customerId Int       @map("customer_id")
  /// UNUSED | USED | EXPIRED
  status     String    @default("UNUSED") @db.VarChar(16)
  orderId    Int       @default(0) @map("order_id")
  receivedAt DateTime  @default(now()) @map("received_at")
  usedAt     DateTime? @map("used_at")
  expireAt   DateTime? @map("expire_at")

  @@index([marketId, customerId, status])
  @@index([couponId, customerId])
  @@map("mp_coupon_tickets")
}

/// 顾客关注的店铺：私域复访入口，同一顾客对同一店只一行。
model MpCustomerFollow {
  id         Int      @id @default(autoincrement())
  marketId   Int      @map("market_id")
  shopId     Int      @map("shop_id")
  customerId Int      @map("customer_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([shopId, customerId], map: "mp_customer_follows_shop_customer_uniq")
  @@index([marketId, customerId])
  @@map("mp_customer_follows")
}

/// 商户维度的企微 SCRM 绑定：0 = 未匹配（不猜、不新建企微客户）。
model MpScrmBinding {
  id          Int       @id @default(autoincrement())
  marketId    Int       @map("market_id")
  merchantId  Int       @map("merchant_id")
  ownerUserId String    @map("owner_user_id") @db.VarChar(64)
  customerId  Int       @map("customer_id")
  contactId   Int       @default(0) @map("contact_id")
  unionId     String    @default("") @map("union_id") @db.VarChar(64)
  mobileHash  String    @default("") @map("mobile_hash") @db.VarChar(64)
  /// AUTO_UNIONID | AUTO_MOBILE | MANUAL
  bindSource  String    @default("AUTO_UNIONID") @map("bind_source") @db.VarChar(16)
  /// BOUND | UNBOUND | IGNORED
  status      String    @default("BOUND") @db.VarChar(16)
  lastSyncAt  DateTime? @map("last_sync_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([merchantId, customerId], map: "mp_scrm_bindings_merchant_customer_uniq")
  @@index([marketId, status])
  @@index([ownerUserId, status])
  @@map("mp_scrm_bindings")
}

/// 商户维度事件 outbox：主事务只写一行，投递由 scheduler 异步完成。
model MpScrmOutbox {
  id          Int       @id @default(autoincrement())
  marketId    Int       @map("market_id")
  merchantId  Int       @map("merchant_id")
  ownerUserId String    @map("owner_user_id") @db.VarChar(64)
  customerId  Int       @map("customer_id")
  /// ScrmEventKind（commerce-core/scrm-port.ts）
  eventKind   String    @map("event_kind") @db.VarChar(32)
  /// <biz>:<eventKind>:<业务主键>，重放不产生重复时间线
  dedupeKey   String    @unique @map("dedupe_key") @db.VarChar(120)
  payloadJson Json      @default("{}") @map("payload_json")
  /// PENDING | SENT | SKIPPED | DEAD
  status      String    @default("PENDING") @db.VarChar(16)
  attempts    Int       @default(0)
  nextAt      DateTime? @map("next_at")
  lastError   String    @default("") @map("last_error") @db.VarChar(500)
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, nextAt])
  @@index([merchantId, createdAt])
  @@index([ownerUserId, status])
  @@map("mp_scrm_outbox")
}

// ---------------------------------------------------------------------------
// 建站管理 · 圈子社区小程序（账号负责人＝社区管理员，C 端成员与站内账号物理隔离）
// 表间一律用 id 松散关联、不建 Prisma 关系：跨模块读写都在服务层按 communityId 收口，
// 避免级联删除误伤社区内容；与 kuaidi_* / mp_* 同一口径。
// ---------------------------------------------------------------------------

/// 社区实例：一个账号一个（ownerUserId 唯一），账号负责人就是小程序管理员。
model CircleCommunity {
  id                   Int      @id @default(autoincrement())
  ownerUserId          String   @unique @map("owner_user_id") @db.VarChar(64)
  /// 公开寻址码：分享链接与本地调试用，创建后不变
  code                 String   @unique @db.VarChar(16)
  name                 String   @db.VarChar(40)
  logo                 String   @default("") @db.VarChar(500)
  cover                String   @default("") @db.VarChar(500)
  slogan               String   @default("") @db.VarChar(80)
  intro                String   @default("") @db.Text
  themeColor           String   @default("#1677ff") @map("theme_color") @db.VarChar(20)
  notice               String   @default("") @db.Text
  /// DRAFT | ONLINE | SUSPENDED
  status               String   @default("DRAFT") @db.VarChar(16)
  joinApproval         Boolean  @default(true) @map("join_approval")
  allowUserCreateCircle Boolean @default(true) @map("allow_user_create_circle")
  postReview           Boolean  @default(true) @map("post_review")
  commentReview        Boolean  @default(false) @map("comment_review")
  aiAssistantEnabled   Boolean  @default(true) @map("ai_assistant_enabled")
  /// 绑定的 AI 客服站点 siteKey；空＝不启用在线客服（只引用 service-desk，不建会话表）
  deskSiteKey          String   @default("") @map("desk_site_key") @db.VarChar(64)
  servicePhone         String   @default("") @map("service_phone") @db.VarChar(30)
