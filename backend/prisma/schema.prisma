/// 异步任务与 webhook 状态机（训练/合成统一走这张：provider 回调按 token 定位）。
model DigitalHumanTask {
  id          Int      @id @default(autoincrement())
  siteId      Int      @map("site_id")
  memberId    Int      @default(0) @map("member_id")
  /// voice-clone | body-train | tts | lipsync | bgm-merge
  kind        String   @db.VarChar(16)
  /// 关联业务表名（bodies/voices/works）
  refTable    String   @default("") @map("ref_table") @db.VarChar(24)
  refId       Int      @default(0) @map("ref_id")
  protocol    String   @default("") @db.VarChar(16)
  provider    String   @default("") @db.VarChar(32)
  /// 供应商任务号（回调定位）
  providerTaskId String @default("") @map("provider_task_id") @db.VarChar(120)
  /// webhook 校验 token（回调 URL 带它，杜绝伪造）
  callbackToken String @unique @map("callback_token") @db.VarChar(48)
  /// 0 待发起 | 1 进行中 | 2 成功 | 3 失败
  status      Int      @default(0) @db.TinyInt
  requestUrl  String   @default("") @map("request_url") @db.VarChar(500)
  resultUrl   String   @default("") @map("result_url") @db.VarChar(500)
  payload     Json     @default("{}")
  /// 合成类任务预扣的算力（失败退回）
  pointCost  Int      @default(0) @map("point_cost")
  error      String   @default("") @db.VarChar(500)
  attempts   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([siteId, kind, status])
  @@index([refTable, refId])
  @@index([providerTaskId])
  @@map("digital_human_tasks")
}

