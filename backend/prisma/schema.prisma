/// 课时：课程（knowledge_pay_resources）下的有序小节。
/// 课程本身仍承载封面/讲师/价格/解锁方式；课时只描述可播放单元，
/// freeTrial 的课时在未解锁时也允许播放，用于试看。
model KnowledgePayLesson {
  id          Int      @id @default(autoincrement())
  siteId      Int      @map("site_id")
  userId      String   @map("user_id") @db.VarChar(64)
  resourceId  Int      @map("resource_id")
  /// 所属章节（0 = 未分章，兼容旧课时）
  chapterId   Int      @default(0) @map("chapter_id")
  title       String   @db.VarChar(120)
  /// video | audio | article | image | live（缺省继承课程形态）
  mediaType   String   @default("video") @map("media_type") @db.VarChar(16)
  url         String   @default("") @db.VarChar(512)
  /// 图文课时正文；音视频课时可放补充说明
  intro       String   @default("") @db.Text
  /// 时长（秒），用于进度条与完课判定
  durationSec Int      @default(0) @map("duration_sec")
  freeTrial   Boolean  @default(false) @map("free_trial")
  sort        Int      @default(0)
  status      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([siteId, resourceId, status, sort])
  @@map("knowledge_pay_lessons")
}

/// 学习进度：会员 × 课时 一行，记录播放位置与完课状态。
model KnowledgePayProgress {
