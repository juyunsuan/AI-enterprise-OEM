  userId    String   @unique @map("user_id") @db.VarChar(64)
  openId    String   @unique @map("open_id") @db.VarChar(64)
  unionId   String?  @map("union_id") @db.VarChar(64)
  nickname  String   @default("") @db.VarChar(120)
  avatarUrl String   @default("") @map("avatar_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([unionId])
  @@map("miniprogram_bindings")
}

/// 出海导航：两级分类（parent 为空即一级分类），默认数据由 0105 迁移写入。
model OverseasNavCategory {
  id        Int      @id @default(autoincrement())
  parentId  Int?     @map("parent_id")
  name      String   @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  visible   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   OverseasNavCategory?  @relation("OverseasNavCategoryTree", fields: [parentId], references: [id])
  children OverseasNavCategory[] @relation("OverseasNavCategoryTree")
  items    OverseasNavItem[]

  @@index([parentId, sortOrder])
  @@map("overseas_nav_categories")
}

/// 出海导航站点：同一分类下 URL 唯一。
model OverseasNavItem {
  id          Int      @id @default(autoincrement())
  categoryId  Int      @map("category_id")
  title       String   @db.VarChar(200)
  description String   @default("") @db.VarChar(500)
  url         String   @db.VarChar(500)
  logoUrl     String   @default("") @map("logo_url") @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category OverseasNavCategory @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, url])
  @@index([categoryId, sortOrder])
  @@map("overseas_nav_items")
}

// ================= 智慧分析板块（全域内容热点分析 + 流行趋势分析）=================
// 设计见 docs/智慧分析板块设计方案.md。全部按账号（user_id）归属；
// 采集行不落本模块表，走既有 data_table_rows（预置「热点内容」表），热点是可重算的聚合产物。

/// 每账号一份智慧分析设置：两张预置多维表格 id + 分析模型 + 打分权重 + 联动开关。
model InsightSetting {
  id             Int      @id @default(autoincrement())
  userId         String   @unique @map("user_id") @db.VarChar(64)
  /// 「热点内容」预置表 id（data_tables.id，0＝尚未生成）
  contentTableId Int      @default(0) @map("content_table_id")
  /// 「热点追踪台账」预置表 id（0＝尚未生成）
  ledgerTableId  Int      @default(0) @map("ledger_table_id")
  /// 「电商选品观测」预置表 id（趋势侧采集落表，0＝尚未生成）
  ecomTableId    Int      @default(0) @map("ecom_table_id")
  /// 默认 AIPDD 模型名（Key 走「API Key 管理」统一维护）
  model          String   @default("") @db.VarChar(128)
  /// 打分权重与阶段阈值 JSON（缺省用 contracts 的 INSIGHT_SCORE_DEFAULTS）
  scoreConfig    Json     @default("{}") @map("score_config")
  /// 双板块联动开关（1＝开，四象限与信号回流可用）
  linkageEnabled Int      @default(1) @map("linkage_enabled") @db.TinyInt
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("insight_settings")
}

/// 采集数据源对象：采集「抓什么」——目的 + 站点源头 + 页面对象 + 关键词/URL 模板。
model InsightCollectionSource {
  id            Int       @id @default(autoincrement())
  userId        String    @map("user_id") @db.VarChar(64)
  name          String    @db.VarChar(120)
  /// 采集目的（闭集见 INSIGHT_PURPOSES）：无目的不采集
  purpose       String    @default("hotspot") @db.VarChar(32)
  /// 数据源类型（闭集见 INSIGHT_SOURCE_KINDS）
  kind          String    @default("platformSearch") @db.VarChar(32)
  /// 平台（自定义网站源头时空串）
  platform      String    @default("") @db.VarChar(32)
  /// 自定义网站源头的站点地址（kind=customSite 时必填）
  siteUrl       String    @default("") @map("site_url") @db.VarChar(500)
  /// 页面对象（闭集见 INSIGHT_PAGE_OBJECTS）
  pageObject    String    @default("") @map("page_object") @db.VarChar(32)
  /// URL 模板（含 {keyword} / {page} 占位符）
  urlTemplate   String    @default("") @map("url_template") @db.VarChar(500)
  keyword       String    @default("") @db.VarChar(200)
  loginRequired Int       @default(0) @map("login_required") @db.TinyInt
  /// 站点技能引用（自定义源头命中已知结构后回填）
  siteSkillKey  String    @default("") @map("site_skill_key") @db.VarChar(120)
  /// ACTIVE | PAUSED
  status        String    @default("ACTIVE") @db.VarChar(16)
  lastRunAt     DateTime? @map("last_run_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([userId, purpose])
  @@map("insight_collection_sources")
}

/// 采集批次：一行一轮，把采集内容回溯到 订阅 → 数据源 → 采集包 → 执行通道。
model InsightCollectionRun {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id") @db.VarChar(64)
  subscriptionId Int       @default(0) @map("subscription_id")
  sourceId       Int       @default(0) @map("source_id")
  skillKey       String    @default("") @map("skill_key") @db.VarChar(32)
  skillVersion   String    @default("") @map("skill_version") @db.VarChar(20)
  /// host | local | workbuddy | codex | manual | import
  channel        String    @default("") @db.VarChar(20)
  hostId         Int       @default(0) @map("host_id")
  deviceId       String    @default("") @map("device_id") @db.VarChar(64)
  scheduleId     Int       @default(0) @map("schedule_id")
  /// queued | dispatched | succeeded | failed | skipped
  status         String    @default("queued") @db.VarChar(16)
  rowCount       Int       @default(0) @map("row_count")
  insertedCount  Int       @default(0) @map("inserted_count")
  dedupCount     Int       @default(0) @map("dedup_count")
  error          String    @default("") @db.VarChar(500)
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([sourceId, createdAt])
  @@index([subscriptionId, createdAt])
  @@map("insight_collection_runs")
}

/// 垂类订阅策略：一条订阅派生采集计划任务 + 圈定热点聚合范围。
model InsightSubscription {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id") @db.VarChar(64)
  name           String    @db.VarChar(120)
  /// 采集目的（无目的不采集）：hotspot | trend-element | trend-color | trend-commercial
  purpose        String    @default("hotspot") @db.VarChar(32)
  /// 关联的数据源对象 id JSON 数组（insight_collection_sources.id）
  sourceIds      Json      @default("[]") @map("source_ids")
  /// 平台集合 JSON（闭集见 INSIGHT_PLATFORMS）
  platforms      Json      @default("[]")
  /// 关键词 / 话题标签 / 博主账号，可组合
  keywords       Json      @default("[]")
  topics         Json      @default("[]")
  creators       Json      @default("[]")
  /// 采集频率：hourly | daily | weekly
  frequency      String    @default("daily") @db.VarChar(16)
  /// 排除词 JSON
  excludeWords   Json      @default("[]") @map("exclude_words")
  /// 最低互动门槛（低于此互动值的内容不入聚合）
  minEngagement  Int       @default(0) @map("min_engagement")
  /// 告警阈值：热点增速超过 N% 提醒
  alertGrowthPct Int       @default(50) @map("alert_growth_pct")
  /// 单次 / 单日采集上限 JSON：{ perRun, perDay }
  quota          Json      @default("{}")
  /// ACTIVE | PAUSED
  status         String    @default("ACTIVE") @db.VarChar(16)
  /// 关联 BotBuddy / 浏览器代理计划任务 id JSON 数组
  scheduleIds    Json      @default("[]") @map("schedule_ids")
  lastRunAt      DateTime? @map("last_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("insight_subscriptions")
}

/// 热点事件（聚合产物）：一个聚类一行，删了可由热点内容表重算。
model InsightHotspot {
  id               Int       @id @default(autoincrement())
  userId           String    @map("user_id") @db.VarChar(64)
  subscriptionId   Int       @default(0) @map("subscription_id")
  subscriptionName String    @default("") @map("subscription_name") @db.VarChar(120)
  /// 聚类名称（可由 LLM 命名，缺省取代表内容关键词）
  name             String    @db.VarChar(200)
  /// 覆盖平台 JSON
  platforms        Json      @default("[]")
  /// emerging | rising | peak | declining
  stage            String    @default("emerging") @db.VarChar(16)
  hotScore         Decimal   @default(0) @map("hot_score") @db.Decimal(12, 4)
  growthRate       Decimal   @default(0) @map("growth_rate") @db.Decimal(10, 4)
  contentCount     Int       @default(0) @map("content_count")
  /// 情感分布 JSON：{ pos, neu, neg }
  sentiment        Json      @default("{}")
  /// 关联关键词 JSON
  keywords         Json      @default("[]") @map("keyword_list")
  firstPlatform    String    @default("") @map("first_platform") @db.VarChar(32)
  firstPublishAt   DateTime? @map("first_publish_at")
  windowStart      DateTime? @map("window_start")
  windowEnd        DateTime? @map("window_end")
  /// 人工纠偏标记：merged | split | ignored（不改原始采集行）
  reviewNote       String    @default("") @map("review_note") @db.VarChar(200)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId, subscriptionId])
  @@index([userId, stage, updatedAt])
  @@index([userId, hotScore])
  @@map("insight_hotspots")
}

/// 热点-内容关联：热点指向「热点内容」表里的具体行（tableId+rowId），可回溯、可代表内容标记。
model InsightHotspotContent {
  id             Int      @id @default(autoincrement())
  hotspotId      Int      @map("hotspot_id")
  tableId        Int      @map("table_id")
  rowId          Int      @map("row_id")
  similarity     Decimal  @default(0) @db.Decimal(6, 4)
  representative Boolean  @default(false) @map("is_representative")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([hotspotId, tableId, rowId])
  @@index([hotspotId])
  @@map("insight_hotspot_contents")
}

/// 时序指标：标签/品类/关键词/热点随时间三热度（interaction/visual/commercial）曲线与增速。
model InsightMetric {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(64)
  /// 指标键：标签 / 品类 / 关键词 / 热点 ID
  metricKey  String   @map("metric_key") @db.VarChar(120)
  /// interaction | visual | commercial
  metricType String   @map("metric_type") @db.VarChar(16)
  /// 统计周期（按天 YYYY-MM-DD 或按周 YYYY-Www）
  period     String   @db.VarChar(16)
  /// 归一值（0–100）
  value      Decimal  @default(0) @db.Decimal(12, 4)
  /// 原始聚合值 JSON（互动/曝光/销量分量，供交叉分析）
  rawValue   Json     @default("{}") @map("raw_value")
  growthRate Decimal  @default(0) @map("growth_rate") @db.Decimal(10, 4)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, metricKey, metricType, period], map: "insight_metrics_user_key_type_period_key")
  @@index([userId, metricType, period])
  @@map("insight_metrics")
}

/// AI 快报 / 趋势报告生成记录（产物经 deliverable 通道登记入数字资产，这里只留生成台账）。
model InsightReport {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(64)
  /// hotspot | trend
  kind      String   @db.VarChar(16)
  /// 统计窗口 JSON：{ from, to }
  window    Json     @default("{}")
  /// pending | running | success | failed
  status    String   @default("pending") @db.VarChar(16)
  /// 数字资产产物 id（登记成功时回填）
  assetId   String   @default("") @map("asset_id") @db.VarChar(64)
  content   String   @default("") @db.Text
  error     String   @default("") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, kind, createdAt])
  @@map("insight_reports")
}

/// AI-FDE 实施分析：一次提交一行，profile 存企业现状，result 存结构化实施框架。
/// 只按 userId 归属；报告由统一模型网关生成，模型名与失败原因一并留痕。
model InsightFdeAnalysis {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.VarChar(64)
  companyName String   @map("company_name") @db.VarChar(200)
  industry    String   @db.VarChar(32)
  /// pending | running | success | failed
  status      String   @default("pending") @db.VarChar(16)
  /// 提交的企业现状（键值口径见 FDE_PROFILE_FIELDS）
  profile     Json?
  /// 结构化实施框架（overview/dimensions/opportunities/roadmap/...）
  result      Json?
  model       String   @default("") @db.VarChar(128)
  error       String   @default("") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("insight_fde_analyses")
}

/// 企业咨询：一次提交一行，profile 存企业数据，frameworks 存所选模型 key，
/// result 存逐模型结论与综合建议；只按 user_id 归属，不建外键。
model InsightConsultingAnalysis {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.VarChar(64)
  companyName String   @map("company_name") @db.VarChar(200)
  industry    String   @db.VarChar(32)
  /// 所选分析模型 key，逗号分隔（与 CONSULTING_FRAMEWORK_KEYS 一致）
  frameworks  String   @default("") @db.VarChar(512)
  /// pending | running | success | failed
  status      String   @default("pending") @db.VarChar(16)
  /// 提交的企业数据（键值口径见 CONSULTING_PROFILE_FIELDS）
  profile     Json?
  /// 结构化分析结果（overview/frameworks/crossInsights/recommendations/...）
  result      Json?
  model       String   @default("") @db.VarChar(128)
  error       String   @default("") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("insight_consulting_analyses")
}

// ============================================================================
// 工作台 · 私域小程序 · 知识付费小程序工具
// 每个平台账号可建一套自己的知识付费小程序站点（siteCode 公开寻址），
// 会员/内容/订单/卡密等数据按 siteId 隔离；小程序端只走 /api/public/knowledge-pay。
// ============================================================================

/// 知识付费站点配置：一账号一站点（凭据密文存储，只回掩码）。
model KnowledgePaySite {
  id          Int      @id @default(autoincrement())
  userId      String   @unique @map("user_id") @db.VarChar(64)
  /// 公开寻址码：小程序端 config 里的 site 值，创建后不变
  siteCode    String   @unique @map("site_code") @db.VarChar(16)
  siteName    String   @default("") @map("site_name") @db.VarChar(60)
  slogan      String   @default("") @db.VarChar(120)
  /// 主题色 #RRGGBB（打包时写进小程序 app.json 导航栏）
  themeColor  String   @default("#3370ff") @map("theme_color") @db.VarChar(16)
  /// 页面/功能开关 JSON：{ indexBanner, indexNotice, typePage, faxianPage, vipPage, search, signIn, buyVip, kami, praise, faq, about, contact, adTab, adDetail }
  toggles     Json     @default("{}")
  faq         String   @default("") @db.Text
  about       String   @default("") @db.Text
  /// 会员定价 JSON：[{ plan: 1|6|12, price }]（price 为积分数）
  vipPlans    Json     @default("[]") @map("vip_plans")
  /// 连续签到 7 天每日积分奖励 [d1..d7]
  signRewards Json     @default("[1,1,2,2,3,3,5]") @map("sign_rewards")
  /// 首页热门搜索词，逗号分隔
  hotWords    String   @default("") @map("hot_words") @db.VarChar(255)
  /// 首页「更多」位文案
  moreTitle   String   @default("精选推荐") @map("more_title") @db.VarChar(60)
  /// 微信小程序凭据：AppID 明文、Secret AES-256-GCM 密文
  wxAppId     String   @default("") @map("wx_app_id") @db.VarChar(64)
  wxAppSecret String   @default("") @map("wx_app_secret") @db.Text
  /// 微信代码上传密钥（PEM）密文；留空保留原值
  /// 站点自有微信商户号（资金不进平台）：商户号/证书序列号明文，APIv3 密钥与私钥密文
  wxMchId       String @default("") @map("wx_mch_id") @db.VarChar(32)
  wxPaySerial   String @default("") @map("wx_pay_serial") @db.VarChar(64)
  wxPayApiV3Key String @default("") @map("wx_pay_apiv3_key") @db.Text
  wxPayPrivateKey String @default("") @map("wx_pay_private_key") @db.Text
  /// 微信流量主广告单元 ID（可选）
  adUnitTab    String   @default("") @map("ad_unit_tab") @db.VarChar(64)
  adUnitDetail String   @default("") @map("ad_unit_detail") @db.VarChar(64)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("knowledge_pay_sites")
}

/// 内容分类（首页按分类分栏展示，sort 大者靠前）。
model KnowledgePayCategory {
  id        Int      @id @default(autoincrement())
  siteId    Int      @map("site_id")
  userId    String   @map("user_id") @db.VarChar(64)
  title     String   @db.VarChar(60)
  cover     String   @default("") @db.VarChar(512)
  sort      Int      @default(0)
  status    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([siteId, status, sort])
  @@map("knowledge_pay_categories")
}

/// 付费内容：mediaType 决定小程序端播放形态，accessMode 决定解锁方式。
model KnowledgePayResource {
  id         Int      @id @default(autoincrement())
  siteId     Int      @map("site_id")
  userId     String   @map("user_id") @db.VarChar(64)
  categoryId Int      @default(0) @map("category_id")
  /// video | audio | article | image | live
  mediaType  String   @default("video") @map("media_type") @db.VarChar(16)
  /// free（可免费获取）| points（积分购买，看 price）| vip（会员专享）
  accessMode String   @default("points") @map("access_mode") @db.VarChar(16)
  /// 积分价（accessMode=points 生效）
  price      Int      @default(0)
  /// 现金价（分）；>0 时小程序端额外提供微信支付
  cashPriceCents Int @default(0) @map("cash_price_cents")
  /// 关联讲师（0 = 未绑定，兼容旧的纯文本讲师信息）
  teacherId  Int      @default(0) @map("teacher_id")
  title      String   @db.VarChar(120)
  cover      String   @default("") @db.VarChar(512)
  /// 简介（详情页可见，图文类即正文）
  intro      String   @default("") @db.Text
  /// 资源地址：视频/音频/直播播放地址；图文类可空
  url        String   @default("") @db.VarChar(512)
  /// 讲师展示信息（课程详情页讲师卡与搜索）
  teacherName   String @default("") @map("teacher_name") @db.VarChar(60)
  teacherTitle  String @default("") @map("teacher_title") @db.VarChar(60)
  teacherAvatar String @default("") @map("teacher_avatar") @db.VarChar(512)
  teacherIntro  String @default("") @map("teacher_intro") @db.Text
  /// 上架审核：draft | pending | published | rejected（公开通道只展示 published）
  auditStatus String @default("published") @map("audit_status") @db.VarChar(16)
  auditNote   String @default("") @map("audit_note") @db.VarChar(255)
  hot        Boolean  @default(false)
  sort       Int      @default(0)
  viewCount  Int      @default(0) @map("view_count")
  status     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([siteId, status, categoryId])
  @@index([siteId, hot, status])
  @@map("knowledge_pay_resources")
}

/// 小程序终端会员（openid 维度，与平台账号无关）。
model KnowledgePayMember {
  id             Int       @id @default(autoincrement())
  siteId         Int       @map("site_id")
  userId         String    @map("user_id") @db.VarChar(64)
  openid         String    @db.VarChar(64)
  unionid        String    @default("") @db.VarChar(64)
  nickname       String    @default("") @db.VarChar(60)
  avatar         String    @default("") @db.VarChar(512)
  points         Int       @default(0)
  /// 会员到期时间；null 或过期即非会员
  vipUntil       DateTime? @map("vip_until")
  /// 当前连续签到天数
  signInStreak   Int       @default(0) @map("sign_in_streak")
  /// 最近签到日 YYYYMMDD
  lastSignInDate String    @default("") @map("last_sign_in_date") @db.VarChar(8)
  loginCount     Int       @default(0) @map("login_count")
  status         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([siteId, openid], map: "kp_members_site_openid_key")
  @@index([siteId, createdAt])
  @@map("knowledge_pay_members")
}

/// 解锁/购买订单（一个会员对同一内容只有一条）。
model KnowledgePayOrder {
  id         Int      @id @default(autoincrement())
  siteId     Int      @map("site_id")
  userId     String   @map("user_id") @db.VarChar(64)
  memberId   Int      @map("member_id")
  resourceId Int      @map("resource_id")
  title      String   @default("") @db.VarChar(120)
  cover      String   @default("") @db.VarChar(512)
  url        String   @default("") @db.VarChar(512)
  /// free | points | vip | card | admin
  payMethod  String   @default("free") @map("pay_method") @db.VarChar(16)
  amount     Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([siteId, memberId, resourceId], map: "kp_orders_site_member_resource_key")
  @@index([siteId, createdAt])
  @@index([siteId, memberId])
  @@map("knowledge_pay_orders")
}

