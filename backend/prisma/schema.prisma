// ---------------------------------------------------------------------------
// 附录 B 补齐（2026-11-07）：权益配额 / 预约忙闲 / 邮件模板 / 页面助手 /
// 语音转写 / 工时审计 / 商城三点 / 三方同步 / 条款留痕 / 入职引导 /
// 产品更新日志 / 主体切换 / 使用埋点。
// 组织域一律带 (orgType, orgUserId)；表间引用用普通 INT 列，级联在服务层做。
// ---------------------------------------------------------------------------

/// 套餐目录（B1#2）：套餐本身是数据，功能可用性与数量上限写在 EntitlementQuota
model EntitlementPlan {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(32)
  name         String   @db.VarChar(64)
  /// USER 个人版 | ENTERPRISE 企业版 | PROVIDER 服务商版
  audience     String   @default("ENTERPRISE") @db.VarChar(16)
  description  String   @default("") @db.VarChar(500)
  priceMonthly Decimal  @default(0) @map("price_monthly") @db.Decimal(18, 2)
  /// ACTIVE | ARCHIVED
  status       String   @default("ACTIVE") @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([audience, status])
  @@map("entitlement_plans")
}

/// 套餐权益明细：featureCode 对应 FeatureCatalog.code；limitCount=-1 表示不限
model EntitlementQuota {
  id          Int      @id @default(autoincrement())
  planCode    String   @map("plan_code") @db.VarChar(32)
  featureCode String   @map("feature_code") @db.VarChar(64)
  /// allowed | denied
  access      String   @default("allowed") @db.VarChar(8)
  limitCount  Int      @default(-1) @map("limit_count")
  /// 计数单位（人 / 次 / GB / 个项目）
  unit        String   @default("") @db.VarChar(16)
  note        String   @default("") @db.VarChar(200)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([planCode, featureCode], map: "entitlement_quotas_plan_feature_key")
  @@map("entitlement_quotas")
}

/// 组织当前套餐（手动指定；无行时按 audience 取平台默认套餐）
model OrgEntitlement {
  id        Int       @id @default(autoincrement())
  orgType   String    @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId String    @map("org_user_id") @db.VarChar(64)
  planCode  String    @map("plan_code") @db.VarChar(32)
  /// MANUAL | DEFAULT
  source    String    @default("MANUAL") @db.VarChar(16)
  /// ACTIVE | EXPIRED
  status    String    @default("ACTIVE") @db.VarChar(16)
  startedAt DateTime  @default(now()) @map("started_at")
  expiresAt DateTime? @map("expires_at")
  updatedBy String    @default("") @map("updated_by") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId], map: "org_entitlements_org_key")
  @@index([planCode, status])
  @@map("org_entitlements")
}

/// 配额用量（按自然月）；写操作前由服务校验 limitCount，超限抛 403
model EntitlementUsage {
  id          Int      @id @default(autoincrement())
  orgType     String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId   String   @map("org_user_id") @db.VarChar(64)
  featureCode String   @map("feature_code") @db.VarChar(64)
  /// YYYY-MM
  period      String   @db.VarChar(8)
  usedCount   Int      @default(0) @map("used_count")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, featureCode, period], map: "entitlement_usage_org_feature_period_key")
  @@map("entitlement_usage")
}

/// 可预约事件（B1#7）：面试 / 客户会面 / 项目会议共用一套忙闲
model AppointmentEvent {
  id          Int      @id @default(autoincrement())
  orgType     String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId   String   @map("org_user_id") @db.VarChar(64)
  slug        String   @unique @db.VarChar(48)
  title       String   @db.VarChar(120)
  /// INTERVIEW 面试 | SERVICE 客户会面 | MEETING 会议
  purpose     String   @default("MEETING") @db.VarChar(16)
  durationMin Int      @default(30) @map("duration_min")
  bufferMin   Int      @default(10) @map("buffer_min")
  location    String   @default("") @db.VarChar(200)
  description String   @default("") @db.VarChar(1000)
  /// 提前可约天数
  horizonDays Int      @default(30) @map("horizon_days")
  active      Boolean  @default(true)
  createdBy   String   @default("") @map("created_by") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([orgType, orgUserId, active])
  @@map("appointment_events")
}

model AppointmentSlot {
  id        Int      @id @default(autoincrement())
  orgType   String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId String   @map("org_user_id") @db.VarChar(64)
  eventId   Int      @map("event_id")
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  booked    Boolean  @default(false)
  bookingId Int      @default(0) @map("booking_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([eventId, startAt], map: "appointment_slots_event_start_key")
  @@index([orgType, orgUserId, startAt])
  @@map("appointment_slots")
}

model AppointmentBooking {
  id        Int      @id @default(autoincrement())
  orgType   String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId String   @map("org_user_id") @db.VarChar(64)
  eventId   Int      @map("event_id")
  slotId    Int      @map("slot_id")
  name      String   @db.VarChar(64)
  phone     String   @default("") @db.VarChar(32)
  email     String   @default("") @db.VarChar(120)
  company   String   @default("") @db.VarChar(120)
  note      String   @default("") @db.VarChar(1000)
  /// 关联业务对象：HRM_INTERVIEW / CUSTOMER / PROJECT_MEETING
  refType   String   @default("") @map("ref_type") @db.VarChar(24)
  refId     String   @default("") @map("ref_id") @db.VarChar(64)
  /// BOOKED | DONE | CANCELED
  status    String   @default("BOOKED") @db.VarChar(16)
  createdBy String   @default("") @map("created_by") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orgType, orgUserId, status, createdAt])
  @@index([slotId])
  @@map("appointment_bookings")
}

/// 邮件模板（B1#10）：站内触发点 → 模板 → 渠道渲染；变量用 {{name}}，多语言按 locale 分行
model EmailTemplate {
  id        Int      @id @default(autoincrement())
  orgType   String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId String   @map("org_user_id") @db.VarChar(64)
  code      String   @db.VarChar(48)
  name      String   @db.VarChar(80)
  locale    String   @default("zh-CN") @db.VarChar(16)
  subject   String   @db.VarChar(200)
  html      String   @db.LongText
  text      String   @default("") @db.Text
  /// 变量声明 JSON：[{ key, label, required }]
  variables Json     @default("[]")
  enabled   Boolean  @default(true)
  updatedBy String   @default("") @map("updated_by") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, code, locale], map: "email_templates_org_code_locale_key")
  @@index([orgType, orgUserId, enabled])
  @@map("email_templates")
}

/// 页面感知助手的调用台账（B2#15）：记录提问时的页面/记录上下文，便于审计与复盘
model AssistantPageQuery {
  id         Int      @id @default(autoincrement())
  orgType    String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId  String   @map("org_user_id") @db.VarChar(64)
  userId     String   @map("user_id") @db.VarChar(64)
  route      String   @db.VarChar(200)
  entityType String   @default("") @map("entity_type") @db.VarChar(32)
  entityId   String   @default("") @map("entity_id") @db.VarChar(64)
  question   String   @db.VarChar(1000)
  answer     String   @default("") @db.Text
  model      String   @default("") @db.VarChar(128)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("assistant_page_queries")
}

/// 会议/面试录音转写（B2#16）：音频只做转写不长期落盘，正文与摘要落库
model AiTranscript {
  id          Int      @id @default(autoincrement())
  orgType     String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId   String   @map("org_user_id") @db.VarChar(64)
  /// INTERVIEW | MEETING | SERVICE | OTHER
  targetType  String   @default("OTHER") @map("target_type") @db.VarChar(16)
  targetId    Int      @default(0) @map("target_id")
  title       String   @db.VarChar(120)
  audioName   String   @default("") @map("audio_name") @db.VarChar(200)
  durationSec Int      @default(0) @map("duration_sec")
  language    String   @default("zh") @db.VarChar(16)
  transcript  String   @default("") @db.LongText
  summary     String   @default("") @db.Text
  /// 摘要结构化结果：{ highlights: string[], actionItems: string[], dimensions?: {...} }
  insights    Json     @default("{}")
  model       String   @default("") @db.VarChar(128)
  /// DONE | FAILED
  status      String   @default("DONE") @db.VarChar(16)
  createdBy   String   @default("") @map("created_by") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([orgType, orgUserId, targetType, targetId])
  @@map("ai_transcripts")
}

/// 工时改动审计（B3#21）：谁在什么时候把哪条工时改成了什么
model PjTimeLogEdit {
  id         Int      @id @default(autoincrement())
  orgType    String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId  String   @map("org_user_id") @db.VarChar(64)
  timeLogId  Int      @map("time_log_id")
  /// UPDATE | DELETE | APPROVE | REJECT
  action     String   @db.VarChar(16)
  editorId   String   @map("editor_id") @db.VarChar(64)
  beforeJson Json     @default("{}") @map("before_json")
  afterJson  Json     @default("{}") @map("after_json")
  reason     String   @default("") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orgType, orgUserId, createdAt])
  @@index([timeLogId])
  @@map("pj_time_log_edits")
}

/// 促销/抵扣码（B3#22①）：与积分券合流，核销即入账积分
model PointPromoCode {
  id             Int       @id @default(autoincrement())
  code           String    @unique @db.VarChar(32)
  name           String    @db.VarChar(80)
  /// FIXED 固定积分 | PERCENT 按充值/消费金额百分比返积分
  kind           String    @default("FIXED") @db.VarChar(16)
  value          Decimal   @db.Decimal(18, 4)
  minAmount      Decimal   @default(0) @map("min_amount") @db.Decimal(18, 4)
  maxRedemptions Int       @default(0) @map("max_redemptions")
  redeemedCount  Int       @default(0) @map("redeemed_count")
  perUserLimit   Int       @default(1) @map("per_user_limit")
  startsAt       DateTime? @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  /// ACTIVE | DISABLED
  status         String    @default("ACTIVE") @db.VarChar(16)
  createdBy      String    @default("") @map("created_by") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  /// 兑换内容：POINTS 兑积分（存量码默认）| CARD 兑时长卡
  assetType      String    @default("POINTS") @map("asset_type") @db.VarChar(16)
  /// assetType=CARD 时指向 point_card_templates.code
  cardCode       String    @default("") @map("card_code") @db.VarChar(32)

  @@index([status, endsAt])
  @@map("point_promo_codes")
}

model PointPromoRedemption {
  id         Int      @id @default(autoincrement())
  promoId    Int      @map("promo_id")
  code       String   @db.VarChar(32)
  userId     String   @map("user_id") @db.VarChar(64)
  points     Decimal  @db.Decimal(18, 4)
  refAmount  Decimal  @default(0) @map("ref_amount") @db.Decimal(18, 4)
  /// 卡码核销时快照规格 code（积分码留空）；兑换记录页据此说明「兑的是哪张卡」
  cardCode   String   @default("") @map("card_code") @db.VarChar(32)
  /// 卡码核销发出的卡（0=未发卡）；撤销后仍能顺着这里查到「已撤销」
  userCardId Int      @default(0) @map("user_card_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([promoId, userId])
  @@index([userId, createdAt])
  @@map("point_promo_redemptions")
}

/// 时长卡规格目录（平台管理员维护）：一张卡 = 一个模型 + 一个额度 + 一个有效期
model PointCardTemplate {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(32)
  name            String   @db.VarChar(80)
  /// 绑定的唯一模型（model_catalog.id）；一张卡不允许挂多个模型
  catalogId       Int      @map("catalog_id")
  /// 模型快照：目录行改名/下架后，已发出去的卡仍能说明自己本来配的是谁
  provider        String   @db.VarChar(24)
  modelKey        String   @map("model_key") @db.VarChar(128)
  /// 量纲快照（token | image | second），由 catalogId 的 billingUnit 派生后写死
  billingUnit     String   @map("billing_unit") @db.VarChar(16)
  /// 额度总量：token=tokens 个数；image=张；second=秒（基准档，倍率见 specMultipliers）
  quotaTotal      Decimal  @default(0) @map("quota_total") @db.Decimal(18, 4)
  /// 有效天数：日卡=1，30 天卡=30；从 activatedAt 起算，精确到秒
  validDays       Int      @default(1) @map("valid_days")
  /// 规格倍率：[{ match: { video_resolution: "720p" }, multiplier: 2 }]；空表=一律 1 倍
  specMultipliers Json     @default("[]") @map("spec_multipliers")
  /// 积分直兑价（0=不允许用积分兑换）
  pointsPrice     Decimal  @default(0) @map("points_price") @db.Decimal(18, 4)
  /// 现金购买价（分，0=不上架购买）
  cashCents       Int      @default(0) @map("cash_cents")
  /// 同一用户在该规格下最多持有几张（兑换码 / 积分 / 现金三入口合计）；0=不限
  perUserLimit    Int      @default(0) @map("per_user_limit")
  /// ACTIVE | DISABLED
  status          String   @default("ACTIVE") @db.VarChar(16)
  sortOrder       Int      @default(0) @map("sort_order")
  remark          String   @default("") @db.VarChar(200)
  createdBy       String   @default("") @map("created_by") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@index([catalogId])
  @@map("point_card_templates")
}

/// 用户持有的卡实例：码兑换 / 积分直兑 / 现金购买 / 后台发放都写这一张
model PointUserCard {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id") @db.VarChar(64)
  templateId   Int      @map("template_id")
  templateCode String   @map("template_code") @db.VarChar(32)
  name         String   @db.VarChar(80)
  provider     String   @db.VarChar(24)
  modelKey     String   @map("model_key") @db.VarChar(128)
  billingUnit  String   @map("billing_unit") @db.VarChar(16)
  quotaTotal   Decimal  @default(0) @map("quota_total") @db.Decimal(18, 4)
  quotaUsed    Decimal  @default(0) @map("quota_used") @db.Decimal(18, 4)
  /// ACTIVE | EXHAUSTED | EXPIRED | REVOKED
  status       String   @default("ACTIVE") @db.VarChar(16)
  /// 发卡那一刻；expiresAt = activatedAt + validDays×24h
  activatedAt  DateTime @default(now()) @map("activated_at")
  expiresAt    DateTime @map("expires_at")
  /// REDEEM 码兑换 | POINTS 积分直兑 | CASH 现金购买 | ADMIN 后台发放
  source       String   @db.VarChar(16)
  /// 来源单据：兑换订单 orderNo（码兑换同样走 point_card_orders，四类来源口径统一）
  sourceRef    String   @default("") @map("source_ref") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId, provider, modelKey, status])
  @@index([userId, status, expiresAt])
  @@index([templateId])
  @@map("point_user_cards")
}

/// 兑换订单：日卡购买 / 日卡兑换 / 积分兑换三类同表，消耗进度关联 point_user_cards
model PointCardOrder {
  id            Int       @id @default(autoincrement())
  orderNo       String    @unique @map("order_no") @db.VarChar(32)
  userId        String    @map("user_id") @db.VarChar(64)
  /// CARD_CASH 日卡购买 | CARD_CODE 日卡兑换 | CARD_POINTS 积分兑换
  kind          String    @db.VarChar(16)
  templateId    Int       @map("template_id")
  templateCode  String    @map("template_code") @db.VarChar(32)
  name          String    @db.VarChar(80)
  billingUnit   String    @map("billing_unit") @db.VarChar(16)
  quotaTotal    Decimal   @default(0) @map("quota_total") @db.Decimal(18, 4)
  /// 现金单实付（分）
  amountCents   Int       @default(0) @map("amount_cents")
  /// 积分单实扣积分
  pointsAmount  Decimal   @default(0) @map("points_amount") @db.Decimal(18, 4)
  /// CREATED | PAID | ISSUED | CLOSED | FAILED | REFUNDED
  status        String    @default("CREATED") @db.VarChar(16)
  transactionId String?   @unique @map("transaction_id") @db.VarChar(64)
  prepayId      String    @default("") @map("prepay_id") @db.VarChar(128)
  codeUrl       String    @default("") @map("code_url") @db.VarChar(512)
  /// 发卡后回填，进度条据此读 point_user_cards
  userCardId    Int?      @map("user_card_id")
  promoCode     String    @default("") @map("promo_code") @db.VarChar(32)
  paidAt        DateTime? @map("paid_at")
  issuedAt      DateTime? @map("issued_at")
  failReason    String    @default("") @map("fail_reason") @db.VarChar(200)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([userId, kind, createdAt])
  @@index([userId, createdAt])
  @@map("point_card_orders")
}

/// 售后工单（B3#22②）：引入 returns 的状态机，挂在服务台的会话/订单上
model ServiceAfterSalesTicket {
  id             Int      @id @default(autoincrement())
  ownerUserId    String   @map("owner_user_id") @db.VarChar(64)
  conversationId Int      @default(0) @map("conversation_id")
  orderNo        String   @default("") @map("order_no") @db.VarChar(64)
  /// RETURN 退货 | REPAIR 维修 | REFUND 退款 | EXCHANGE 换货
  kind           String   @default("RETURN") @db.VarChar(16)
  reason         String   @default("") @db.VarChar(500)
  amount         Decimal  @default(0) @db.Decimal(18, 2)
  contact        String   @default("") @db.VarChar(80)
  note           String   @default("") @db.VarChar(1000)
  /// PENDING | REVIEWING | APPROVED | REJECTED | RECEIVED | SHIPPED | COMPLETED | CANCELED
  status         String   @default("PENDING") @db.VarChar(16)
  assigneeUserId String   @default("") @map("assignee_user_id") @db.VarChar(64)
  createdBy      String   @default("") @map("created_by") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  events ServiceAfterSalesEvent[]

  @@index([ownerUserId, status, createdAt])
  @@index([conversationId])
  @@map("service_after_sales_tickets")
}

model ServiceAfterSalesEvent {
  id         Int      @id @default(autoincrement())
  ticketId   Int      @map("ticket_id")
  fromStatus String   @default("") @map("from_status") @db.VarChar(16)
  toStatus   String   @map("to_status") @db.VarChar(16)
  note       String   @default("") @db.VarChar(500)
  operatorId String   @default("") @map("operator_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  ticket ServiceAfterSalesTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("service_after_sales_events")
}

/// 服务/商品评价（B3#22③）：挂到 market-board 的挂单（listingId 为平台 UUID）
model MarketServiceReview {
  id             Int      @id @default(autoincrement())
  orgType        String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId      String   @map("org_user_id") @db.VarChar(64)
  listingId      String   @map("listing_id") @db.VarChar(64)
  /// DEMAND 需求方评价 | SUPPLY 服务方评价
  listingType    String   @default("SUPPLY") @map("listing_type") @db.VarChar(16)
  rating         Int      @default(5)
  content        String   @default("") @db.VarChar(1000)
  reviewerName   String   @default("") @map("reviewer_name") @db.VarChar(64)
  reviewerUserId String   @map("reviewer_user_id") @db.VarChar(64)
  orderRef       String   @default("") @map("order_ref") @db.VarChar(64)
  /// VISIBLE | HIDDEN
  status         String   @default("VISIBLE") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([orgType, orgUserId, listingId])
  @@index([listingType, status, createdAt])
  @@map("market_service_reviews")
}

/// 三方任务同步绑定（B3#23）：Jira / Teambition / TAPD 双向
model TaskSyncBinding {
  id         Int       @id @default(autoincrement())
  orgType    String    @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId  String    @map("org_user_id") @db.VarChar(64)
  projectId  Int       @default(0) @map("project_id")
  /// JIRA | TEAMBITION | TAPD
  provider   String    @db.VarChar(16)
  baseUrl    String    @map("base_url") @db.VarChar(300)
  projectKey String    @default("") @map("project_key") @db.VarChar(80)
  username   String    @default("") @db.VarChar(120)
  /// 访问令牌密文（AES-256-GCM，密钥取 EXTERNAL_CRED_KEY）
  tokenEnc   String    @map("token_enc") @db.Text
  enabled    Boolean   @default(true)
  lastRunAt  DateTime? @map("last_run_at")
  lastResult String    @default("") @map("last_result") @db.VarChar(500)
  createdBy  String    @default("") @map("created_by") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, projectId, provider], map: "task_sync_bindings_org_project_provider_key")
  @@map("task_sync_bindings")
}

model TaskSyncLink {
  id           Int       @id @default(autoincrement())
  bindingId    Int       @map("binding_id")
  taskId       Int       @map("task_id")
  remoteId     String    @map("remote_id") @db.VarChar(128)
  remoteKey    String    @default("") @map("remote_key") @db.VarChar(80)
  remoteStatus String    @default("") @map("remote_status") @db.VarChar(32)
  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([bindingId, taskId], map: "task_sync_links_binding_task_key")
  @@index([remoteId])
  @@map("task_sync_links")
}

model TaskSyncRun {
  id        Int      @id @default(autoincrement())
  bindingId Int      @map("binding_id")
  /// PUSH 本地→远端 | PULL 远端→本地 | BOTH
  direction String   @default("BOTH") @db.VarChar(8)
  pushed    Int      @default(0)
  pulled    Int      @default(0)
  failed    Int      @default(0)
