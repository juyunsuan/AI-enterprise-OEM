  organId       Int      @default(0) @map("organ_id")
  hospitalId    Int      @default(0) @map("hospital_id")
  departmentId  Int      @default(0) @map("department_id")
  teamId        Int      @default(0) @map("team_id")
  name          String   @db.VarChar(60)
  /// DOCTOR | MANAGER | PHARMACIST | GUIDE
  role          String   @default("DOCTOR") @db.VarChar(20)
  title         String   @default("") @db.VarChar(40)
  avatar        String   @default("") @db.VarChar(500)
  phone         String   @default("") @db.VarChar(32)
  /// 绑定的站内登录账号（医护工作台端登录用，可空表示未绑定）
  userId        String   @default("") @map("user_id") @db.VarChar(64)
  /// 绑用的纯AI客服员工 id（service_desk_ai_agents.id）：本域只存引用，人设/模型/知识库都在 AI客服那侧
  deskAiAgentId Int      @default(0) @map("desk_ai_agent_id")
  city          String   @default("") @db.VarChar(60)
  intro         String   @default("") @db.Text
  goodAtJson    Json     @default("[]") @map("good_at_json")
  licenseNo     String   @default("") @map("license_no") @db.VarChar(64)
  licenseImagesJson Json @default("[]") @map("license_images_json")
  commissionPercent Int  @default(0) @map("commission_percent")
  auditStatus   String   @default("PENDING") @map("audit_status") @db.VarChar(16)
  auditReason   String   @default("") @map("audit_reason") @db.VarChar(200)
  auditBy       String   @default("") @map("audit_by") @db.VarChar(64)
  auditAt       DateTime? @map("audit_at")
  status        String   @default("ON") @db.VarChar(8)
  scoreSum      Int      @default(0) @map("score_sum")
  scoreCount    Int      @default(0) @map("score_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([shopId, role, status])
  @@index([shopId, auditStatus])
  @@index([shopId, organId])
  @@index([shopId, hospitalId, departmentId])
  @@index([phone])
  @@map("health_practitioners")
}

/// 医护开通的服务与定价。
