/// 纯AI客服员工：AI客服团队里的一类「员工」，与真人坐席并列。
/// 人设、模型与知识库范围都挂在它身上（账号级 AI 设置只做回落），业务工具要 AI 助手时只引用它的 id，不在各自域内再造 AI 实体。
model ServiceDeskAiAgent {
  id              Int      @id @default(autoincrement())
  ownerUserId     String   @map("owner_user_id") @db.VarChar(64)
  name            String   @db.VarChar(60)
  avatar          String   @default("") @db.VarChar(500)
  intro           String   @default("") @db.VarChar(200)
  /// 归属客服组：0 = 不按组分流，参与全局自动分配
  groupId         Int      @default(0) @map("group_id")
  /// ON | DISABLED
  status          String   @default("ON") @db.VarChar(16)
  /// AUTO = AI 先接待，命中转人工口径后转真人；BOT = 纯AI接待，永不转人工
  mode            String   @default("AUTO") @db.VarChar(16)
  /// 人设与回答口径提示词（留空回落内置客服口径）
  persona         String   @default("") @db.Text
  /// 模型渠道覆盖：0 = 回落账号级 AI 设置
  aiChannelId     Int      @default(0) @map("ai_channel_id")
  /// 模型覆盖：空 = 回落账号级 AI 设置
  aiModel         String   @default("") @map("ai_model") @db.VarChar(128)
  /// 绑定的知识库空间 id 列表：空 = 回落账号级 SERVICE_DESK 消费者绑定
  kbSpaceIds      Json     @default("[]") @map("kb_space_ids")
  /// 转人工关键词：空 = 回落账号级 aiHandoffKeywords
  handoffKeywords Json     @default("[]") @map("handoff_keywords")
  /// 转人工兜底客服组：0 = 按自动分配选真人
  handoffGroupId  Int      @default(0) @map("handoff_group_id")
  /// 同时在处理的会话上限
  maxConcurrent   Int      @default(50) @map("max_concurrent")
  /// 接待时段 { days: number[], start: "09:00", end: "18:00" }：空对象 = 全天
  workingHours    Json     @default("{}") @map("working_hours")
  greetingText    String   @default("") @map("greeting_text") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, status])
  @@index([ownerUserId, groupId])
  @@map("service_desk_ai_agents")
}

/// 匿名访客（只存令牌哈希，不存完整 IP）
