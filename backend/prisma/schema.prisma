  customerId   Int      @map("customer_id")
  orderId      Int      @default(0) @map("order_id")
  practitionerId Int    @default(0) @map("practitioner_id")
  startAt      DateTime @map("start_at")
  endAt        DateTime? @map("end_at")
  /// ACTIVE | FINISHED | CANCELED
  status       String   @default("ACTIVE") @db.VarChar(16)
  progressJson Json     @default("{}") @map("progress_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([shopId, patientId, status])
  @@index([shopId, practitionerId, status])
  @@map("health_patient_plans")
}

/// 随访任务（引擎按方案/规则生成，人工可补）。
model HealthFollowupTask {
  id             Int      @id @default(autoincrement())
  shopId         Int      @map("shop_id")
  patientId      Int      @map("patient_id")
  planStepId     Int      @default(0) @map("plan_step_id")
  patientPlanId  Int      @default(0) @map("patient_plan_id")
  alertId        Int      @default(0) @map("alert_id")
  /// PLAN | ALERT | MANUAL | EXAM
  source         String   @default("PLAN") @db.VarChar(16)
  title          String   @db.VarChar(120)
  /// PHONE | SMS | MINI_MSG | SURVEY | VISIT
  way            String   @default("PHONE") @db.VarChar(16)
  content        String   @default("") @db.Text
  dueAt          DateTime @map("due_at")
  practitionerId Int      @default(0) @map("practitioner_id")
  assigneeUserId String   @default("") @map("assignee_user_id") @db.VarChar(64)
  assigneeName   String   @default("") @map("assignee_name") @db.VarChar(60)
  /// PENDING | DONE | OVERDUE | CANCELED
  status         String   @default("PENDING") @db.VarChar(16)
  resultSummary  String   @default("") @map("result_summary") @db.VarChar(500)
  doneAt         DateTime? @map("done_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, dueAt])
  @@index([shopId, assigneeUserId, status, dueAt])
  @@index([shopId, patientId, dueAt])
  @@map("health_followup_tasks")
}

/// 随访执行记录（沟通内容一律走 AI客服会话，这里只留结论与附件）。
