/// 客服会话
model ServiceDeskConversation {
  id                 Int       @id @default(autoincrement())
  ownerUserId        String    @map("owner_user_id") @db.VarChar(64)
  orgType            String    @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId          String    @default("") @map("org_user_id") @db.VarChar(64)
  siteId             Int       @map("site_id")
  groupId            Int       @default(0) @map("group_id")
  assigneeUserId     String    @default("") @map("assignee_user_id") @db.VarChar(64)
  /// 接待方类型：USER = 真人坐席（assignee_user_id 生效）；AI = 纯AI客服员工（ai_agent_id 生效）
  assigneeType       String    @default("USER") @map("assignee_type") @db.VarChar(16)
  /// 接待该会话的纯AI客服员工 id（service_desk_ai_agents.id），0 = 非AI接待
  aiAgentId          Int       @default(0) @map("ai_agent_id")
  visitorId          Int       @map("visitor_id")
  /// 外部渠道：0 = 官网插件；>0 = service_desk_channels.id
  channelId          Int       @default(0) @map("channel_id")
  externalChatId     String    @default("") @map("external_chat_id") @db.VarChar(191)
  externalUserId     String    @default("") @map("external_user_id") @db.VarChar(191)
  externalUserName   String    @default("") @map("external_user_name") @db.VarChar(120)
  externalMessageId  String    @default("") @map("external_message_id") @db.VarChar(191)
  /// 自定义渠道的会话级额外字段（入站映射登记，出站模板用 {{extra.x}} 带回）
  externalMeta       Json      @default("{}") @map("external_meta")
  /// waiting | active | closed
  status             String    @default("waiting") @db.VarChar(16)
  /// 转为 CRM 线索后的回写 id（0＝未转化）
  crmLeadId          Int       @default(0) @map("crm_lead_id")
  sourceUrl          String    @default("") @map("source_url") @db.VarChar(500)
  subject            String    @default("") @db.VarChar(120)
  lastMessageAt      DateTime  @default(now()) @map("last_message_at")
  unreadForAgent     Int       @default(0) @map("unread_for_agent")
  unreadForRequester Int       @default(0) @map("unread_for_requester")
  /// OFF | CANNED | SUGGEST | AUTO | BOT
  aiMode             String    @default("CANNED") @map("ai_mode") @db.VarChar(16)
  transferCount      Int       @default(0) @map("transfer_count")
  firstResponseAt    DateTime? @map("first_response_at")
  closedAt           DateTime? @map("closed_at")
  rating             Int       @default(0)
  ratingComment      String    @default("") @map("rating_comment") @db.VarChar(500)
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([ownerUserId, status, lastMessageAt])
  @@index([assigneeUserId, status])
  @@index([ownerUserId, aiAgentId])
  @@index([siteId, createdAt])
  @@index([channelId, externalChatId, status])
  @@index([orgType, orgUserId])
  @@map("service_desk_conversations")
}

