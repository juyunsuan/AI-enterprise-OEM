  partnered Boolean  @default(false)
  sort      Int      @default(0)
  status    String   @default("ON") @db.VarChar(8)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, sort])
  @@index([shopId, city])
