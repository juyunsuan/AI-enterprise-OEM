  category   String  @default("") @db.VarChar(40)
  intro      String  @default("") @db.VarChar(1000)
  sort       Int     @default(0)
  status     String  @default("ON") @db.VarChar(8)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, sort])
  @@index([shopId, hospitalId])
  @@map("health_departments")
}

/// 本店开通城市（C 端切城市的数据源）。
model HealthCity {
  id      Int     @id @default(autoincrement())
  shopId  Int     @map("shop_id")
  name    String  @db.VarChar(40)
  code    String  @default("") @db.VarChar(20)
  sort    Int     @default(0)
  status  String  @default("ON") @db.VarChar(8)

  @@unique([shopId, name])
  @@map("health_cities")
}

/// 入驻机构（诊所/医院/体检中心/药房/健管机构）。
model HealthOrgan {
  id                Int     @id @default(autoincrement())
  shopId            Int     @map("shop_id")
  name              String  @db.VarChar(120)
  /// CLINIC | HOSPITAL | EXAM_CENTER | PHARMACY | HEALTH_MANAGEMENT
  kind              String  @default("CLINIC") @db.VarChar(24)
  city              String  @default("") @db.VarChar(60)
  address           String  @default("") @db.VarChar(200)
  contactName       String  @default("") @map("contact_name") @db.VarChar(60)
  contactPhone      String  @default("") @map("contact_phone") @db.VarChar(32)
  licenseNo         String  @default("") @map("license_no") @db.VarChar(64)
  licenseImagesJson Json    @default("[]") @map("license_images_json")
  /// 机构分成比例（%），0 = 按店铺分账规则
  commissionPercent Int     @default(0) @map("commission_percent")
  intro             String  @default("") @db.Text
  /// PENDING | APPROVED | REJECTED | OFFLINE
  auditStatus       String  @default("PENDING") @map("audit_status") @db.VarChar(16)
  auditReason       String  @default("") @map("audit_reason") @db.VarChar(200)
  auditBy           String  @default("") @map("audit_by") @db.VarChar(64)
  auditAt           DateTime? @map("audit_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([shopId, auditStatus])
  @@index([shopId, kind, city])
  @@map("health_organs")
}

/// 入驻与认证申请流水（机构 / 医护共用；材料图片 URL，不存证件明文之外的东西）。
model HealthApplication {
  id         Int      @id @default(autoincrement())
  shopId     Int      @map("shop_id")
  /// ORGAN | PRACTITIONER | PROMOTER
  kind       String   @db.VarChar(20)
  targetId   Int      @default(0) @map("target_id")
  name       String   @default("") @db.VarChar(60)
  phone      String   @default("") @db.VarChar(32)
  city       String   @default("") @db.VarChar(60)
  extrasJson Json     @default("{}") @map("extras_json")
  materialsJson Json   @default("[]") @map("materials_json")
  auditStatus String  @default("PENDING") @map("audit_status") @db.VarChar(16)
  auditReason String  @default("") @map("audit_reason") @db.VarChar(200)
  auditBy    String   @default("") @map("audit_by") @db.VarChar(64)
  auditAt    DateTime? @map("audit_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([shopId, kind, auditStatus])
  @@map("health_applications")
}

/// 医护（执业医师 / 健康管理师 / 药师 / 导诊师）。
model HealthPractitioner {
  id            Int      @id @default(autoincrement())
