  title     String   @default("") @db.VarChar(60)
  avatar    String   @default("") @db.VarChar(512)
  intro     String   @default("") @db.Text
  sort      Int      @default(0)
  status    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([siteId, status, sort])
  @@map("knowledge_pay_teachers")
}

/// 小程序「发现」页导航：可跳课程/自定义单页/外链/他方小程序。
model KnowledgePayNav {
  id        Int      @id @default(autoincrement())
  siteId    Int      @map("site_id")
  userId    String   @map("user_id") @db.VarChar(64)
  title     String   @db.VarChar(60)
  icon      String   @default("") @db.VarChar(512)
  /// resource:<id> | page:<id> | url:<https> | app:<appid>|<path> | none
  link      String   @default("none") @db.VarChar(512)
  sort      Int      @default(0)
  status    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([siteId, status, sort])
  @@map("knowledge_pay_navs")
}

/// 自定义单页（关于我们/用户协议/活动说明），小程序按 id 渲染富文本。
model KnowledgePayPage {
  id        Int      @id @default(autoincrement())
  siteId    Int      @map("site_id")
  userId    String   @map("user_id") @db.VarChar(64)
  title     String   @db.VarChar(120)
  slug      String   @default("") @db.VarChar(60)
  content   String   @default("") @db.Text
  sort      Int      @default(0)
  status    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([siteId, slug], map: "kp_pages_site_slug_key")
  @@index([siteId, status, sort])
  @@map("knowledge_pay_pages")
}

/// 现金订单（站点自有微信商户号直连）：支付成功后落解锁凭据或会员时长。
/// 金额一律按「分」存整数；与积分订单分表，避免两套口径互相污染。
model KnowledgePayCashOrder {
  id            Int       @id @default(autoincrement())
  siteId        Int       @map("site_id")
  userId        String    @map("user_id") @db.VarChar(64)
  memberId      Int       @map("member_id")
  /// course | vip
  kind          String    @db.VarChar(16)
  resourceId    Int       @default(0) @map("resource_id")
  /// kind=vip 时的会员月数
  plan          Int       @default(0)
  title         String    @default("") @db.VarChar(120)
  amountCents   Int       @map("amount_cents")
  outTradeNo    String    @unique @map("out_trade_no") @db.VarChar(40)
  transactionId String    @default("") @map("transaction_id") @db.VarChar(64)
  /// pending | paid | closed | refunded
  status        String    @default("pending") @db.VarChar(16)
  refundNo      String    @default("") @map("refund_no") @db.VarChar(64)
  refundReason  String    @default("") @map("refund_reason") @db.VarChar(120)
  /// 支付成功后生成的解锁订单 ID（退款时据此撤销）
  unlockOrderId Int       @default(0) @map("unlock_order_id")
  paidAt        DateTime? @map("paid_at")
  refundedAt    DateTime? @map("refunded_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([siteId, status, createdAt])
  @@index([siteId, memberId, createdAt])
  @@map("knowledge_pay_cash_orders")
}

// =====================================================================
// 私域小程序 · 电商小程序工具（设计见 docs/私域小程序与电商小程序工具设计方案.md）
//
// 租户模型是两层：本站用户＝商城主人（ownerUserId + shopId 归属），
// C 端顾客归店铺（brand_customers），与站内 User 物理隔离，绝不复用。
// 收款走用户自己的微信商户号，平台不经手资金，因此没有平台侧资金账本。
// 金额一律 DECIMAL(18, 2)，服务层按「分」做整数运算；布尔用 Boolean
// （Prisma 在 MySQL 落 TINYINT(1)、PG 落 BOOLEAN，比裸 TinyInt 更稳）。
// =====================================================================

/// 商城实例：一个用户可开多店（配额由平台侧 brand_mall_platform_settings 控制）。
/// 一店即一个独立微信小程序主体，凭据与出包记录在 miniprogram_apps /
/// miniprogram_tenant_releases（scene='BRAND'）按 shopId 关联。
model BrandShop {
  id               Int      @id @default(autoincrement())
  /// 归属账号（本站用户＝商城主人）
  ownerUserId      String   @map("owner_user_id") @db.VarChar(64)
  /// 企业档案 id（0 = 未绑定企业），与 GeoSite 同口径用于代客作业留痕
  enterpriseId     Int      @default(0) @map("enterprise_id")
  enterpriseUserId String   @default("") @map("enterprise_user_id") @db.VarChar(64)
  name             String   @db.VarChar(120)
  /// 公开寻址码：与底座 miniBootstrap.shopCode 同口径，C 端按它取店铺，创建后不变
  shopCode         String   @unique @map("shop_code") @db.VarChar(16)
  logo             String   @default("") @db.VarChar(500)
  slogan           String   @default("") @db.VarChar(120)
  servicePhone     String   @default("") @map("service_phone") @db.VarChar(32)
  /// 主题色 #RRGGBB：打包时写进小程序 app.json 导航栏
  themeColor       String   @default("#FA3534") @map("theme_color") @db.VarChar(16)
  /// DRAFT 未上线 | ONLINE 营业中 | SUSPENDED 平台停服 | CLOSED 已关闭
  status           String   @default("DRAFT") @db.VarChar(16)
  /// 交易与售后参数，结构同契约 mallTradeConfigSchema
  tradeJson        Json     @default("{}") @map("trade_json")
  /// 顾客层对接企业微信 SCRM 的开关（默认关）：关掉即停止生产事件，不影响交易
  scrmEnabled      Boolean  @default(false) @map("scrm_enabled")
  /// 自动开通的 AI 客服服务站 id（service_desk_sites.id，0 = 还没建）：站点由本店创建与维护，不手工挑
  supportSiteId    Int      @default(0) @map("support_site_id")
  shareImage       String   @default("") @map("share_image") @db.VarChar(500)
  /// 平台停服操作人与原因（合规处置留痕）
  offBy            String   @default("") @map("off_by") @db.VarChar(64)
  offReason        String   @default("") @map("off_reason") @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, status])
  @@index([enterpriseId])
  @@map("brand_shops")
}

/// 微信侧凭据与代码包台账**不在本域建表**：私域小程序底座
/// `miniprogram_apps` / `miniprogram_tenant_releases` 以 `scene='BRAND' + shopId`
/// 承载同一店铺自己的 AppID、上传密钥、商户号与出包记录。
/// 一个店铺 = 一个独立小程序主体（AppID 全局唯一），租户之间互不相通；
/// 共享的只是出包注入与直传微信的机制，不是同一个小程序。
/// 契约见 packages/contracts/src/private-mini.ts。

/// 店铺自定义分类（三级，parentId=0 为一级）。
model BrandCategory {
  id        Int      @id @default(autoincrement())
  shopId    Int      @map("shop_id")
  parentId  Int      @default(0) @map("parent_id")
  name      String   @db.VarChar(30)
  icon      String   @default("") @db.VarChar(500)
  image     String   @default("") @db.VarChar(500)
  level     Int      @default(1)
  sortOrder Int      @default(0) @map("sort_order")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([shopId, parentId, sortOrder])
  @@map("brand_categories")
}

/// 商品主表：多规格用 specs JSON 描述维度，具体行在 brand_product_skus。
model BrandProduct {
  id           Int      @id @default(autoincrement())
  shopId       Int      @map("shop_id")
  ownerUserId  String   @map("owner_user_id") @db.VarChar(64)
  categoryId   Int      @default(0) @map("category_id")
  title        String   @db.VarChar(200)
  subtitle     String   @default("") @db.VarChar(200)
  coverImage   String   @default("") @map("cover_image") @db.VarChar(500)
  images       Json     @default("[]")
  /// 富文本详情（HTML）
  detail       String   @default("") @db.MediumText
  /// NORMAL 实物 | VIRTUAL 虚拟（下单即完成，不占库存不发货）
  type         String   @default("NORMAL") @db.VarChar(16)
  price        Decimal  @default(0) @db.Decimal(18, 2)
  marketPrice  Decimal  @default(0) @map("market_price") @db.Decimal(18, 2)
  costPrice    Decimal  @default(0) @map("cost_price") @db.Decimal(18, 2)
  /// 单规格库存；多规格以 SKU 汇总为准
  stock        Int      @default(0)
  sales        Int      @default(0)
  unit         String   @default("件") @db.VarChar(20)
  weight       Decimal  @default(0) @db.Decimal(18, 3)
  volume       Decimal  @default(0) @db.Decimal(18, 3)
  /// 运费模板 id；0 = 回落店铺统一运费
  freightTemplateId Int @default(0) @map("freight_template_id")
  /// 规格定义 [{ name, values: [] }]
  specs        Json     @default("[]")
  /// 服务保障标签
  guarantee    Json     @default("[]")
  /// DRAFT | OFFLINE | ONLINE
  status       String   @default("DRAFT") @db.VarChar(16)
  isHot        Boolean  @default(false) @map("is_hot")
  isNew        Boolean  @default(false) @map("is_new")
  isGood       Boolean  @default(false) @map("is_good")
  sortOrder    Int      @default(0) @map("sort_order")
  virtualRemark String  @default("") @map("virtual_remark") @db.VarChar(500)
  reviewCount  Int      @default(0) @map("review_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, sortOrder])
  @@index([shopId, categoryId])
  @@index([ownerUserId])
  @@map("brand_products")
}

/// 规格组合后的可售单元：specValues 是 { 规格名: 规格值 }。
model BrandProductSku {
  id          Int      @id @default(autoincrement())
  productId   Int      @map("product_id")
  shopId      Int      @map("shop_id")
  skuName     String   @default("") @map("sku_name") @db.VarChar(200)
  image       String   @default("") @db.VarChar(500)
  /// 规格值拼接的稳定标识，购物车与下单快照用它对齐
  uniqueId    String   @default("") @map("unique_id") @db.VarChar(191)
  specValues  Json     @default("{}") @map("spec_values")
  price       Decimal  @default(0) @db.Decimal(18, 2)
  marketPrice Decimal  @default(0) @map("market_price") @db.Decimal(18, 2)
  costPrice   Decimal  @default(0) @map("cost_price") @db.Decimal(18, 2)
  stock       Int      @default(0)
  sales       Int      @default(0)
  weight      Decimal  @default(0) @db.Decimal(18, 3)
  volume      Decimal  @default(0) @db.Decimal(18, 3)
  barcode     String   @default("") @db.VarChar(64)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([shopId, uniqueId])
  @@map("brand_product_skus")
}

/// 快递公司：shopId=0 为平台预置（全店铺可见，店铺不可删改）。
model BrandExpressCompany {
  id        Int      @id @default(autoincrement())
  shopId    Int      @default(0) @map("shop_id")
  name      String   @db.VarChar(40)
  code      String   @default("") @db.VarChar(40)
  phone     String   @default("") @db.VarChar(30)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([shopId, enabled, sortOrder])
  @@map("brand_express_companies")
}

/// 商品评价：C 端确认收货后提交，status 控制显隐。
model BrandProductReview {
  id          Int      @id @default(autoincrement())
  shopId      Int      @map("shop_id")
  productId   Int      @map("product_id")
  orderId     Int      @default(0) @map("order_id")
  orderItemId Int      @default(0) @map("order_item_id")
  customerId  Int      @map("customer_id")
  rating      Int      @default(5)
  content     String   @default("") @db.VarChar(500)
  images      Json     @default("[]")
  /// PENDING 待审 | PUBLISHED 展示 | HIDDEN 隐藏
  status      String   @default("PUBLISHED") @db.VarChar(16)
  reply       String   @default("") @db.VarChar(500)
  replyAt     DateTime? @map("reply_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, createdAt])
  @@index([productId, status])
  @@index([customerId])
  @@map("brand_product_reviews")
}

/// C 端顾客：一店一套，按 (shopId, openid) 唯一，与站内 User 完全隔离。
model BrandCustomer {
  id          Int       @id @default(autoincrement())
  shopId      Int       @map("shop_id")
  openid      String    @db.VarChar(64)
  unionId     String    @default("") @map("union_id") @db.VarChar(64)
  nickname    String    @default("") @db.VarChar(60)
  avatar      String    @default("") @db.VarChar(500)
  phone       String    @default("") @db.VarChar(20)
  gender      Int       @default(0)
  /// 会员等级名（自由文案，首期不做等级权益表）
  level       String    @default("") @db.VarChar(30)
  points      Int       @default(0)
  balance     Decimal   @default(0) @db.Decimal(18, 2)
  /// 店主备注
  remark      String    @default("") @db.VarChar(500)
  /// MINIPROGRAM | H5 | QR | MANUAL
  source      String    @default("MINIPROGRAM") @db.VarChar(16)
  /// ACTIVE | BLOCKED
  status      String    @default("ACTIVE") @db.VarChar(16)
  /// 首期只存关系不写分销逻辑，二期分销复用此列
  referrerCustomerId Int @default(0) @map("referrer_customer_id")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([shopId, openid], map: "brand_customers_shop_openid_uniq")
  @@index([shopId, phone])
  @@index([shopId, createdAt])
  @@map("brand_customers")
}

/// 顾客收货地址。
model BrandCustomerAddress {
  id         Int      @id @default(autoincrement())
  shopId     Int      @map("shop_id")
  customerId Int      @map("customer_id")
  realName   String   @map("real_name") @db.VarChar(30)
  phone      String   @db.VarChar(20)
  province   String   @default("") @db.VarChar(40)
  city       String   @default("") @db.VarChar(40)
  district   String   @default("") @db.VarChar(40)
  detail     String   @db.VarChar(200)
  postalCode String   @default("") @map("postal_code") @db.VarChar(10)
  isDefault  Boolean  @default(false) @map("is_default")
  tag        String   @default("") @db.VarChar(10)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([shopId, customerId])
  @@map("brand_customer_addresses")
}

/// 顾客积分/余额流水：points 系积分增减（有符号），amount 留给二期储值。
model BrandCustomerBill {
  id          Int      @id @default(autoincrement())
  shopId      Int      @map("shop_id")
  customerId  Int      @map("customer_id")
  /// POINT_EARN | POINT_USE | BALANCE_PAY | BALANCE_REFUND
  type        String   @db.VarChar(20)
  points      Int      @default(0)
  pointsAfter Int      @default(0) @map("points_after")
  amount      Decimal  @default(0) @db.Decimal(18, 2)
  relatedType String   @default("") @map("related_type") @db.VarChar(20)
  relatedId   Int      @default(0) @map("related_id")
  remark      String   @default("") @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([shopId, customerId, id])
  @@map("brand_customer_bills")
}

/// 购物车：一店一客一 SKU 一行，改数量即 upsert。
model BrandCartItem {
  id         Int      @id @default(autoincrement())
  shopId     Int      @map("shop_id")
  customerId Int      @map("customer_id")
  productId  Int      @map("product_id")
  /// 0 = 无规格商品
  skuId      Int      @default(0) @map("sku_id")
  quantity   Int      @default(1)
  selected   Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([shopId, customerId, skuId], map: "brand_cart_items_shop_customer_sku_uniq")
  @@index([shopId, customerId])
  @@map("brand_cart_items")
}

/// 订单主表：状态机 PENDING_PAYMENT → PAID → SHIPPED → COMPLETED，超时/手动作废进 CANCELLED。
model BrandOrder {
  id             Int       @id @default(autoincrement())
  shopId         Int       @map("shop_id")
  ownerUserId    String    @map("owner_user_id") @db.VarChar(64)
  orderNo        String    @unique @map("order_no") @db.VarChar(32)
  customerId     Int       @map("customer_id")
  /// PENDING_PAYMENT | PAID | SHIPPED | COMPLETED | CANCELLED
  status         String    @default("PENDING_PAYMENT") @db.VarChar(20)
  /// UNPAID | PAID | REFUNDING | REFUNDED
  payStatus      String    @default("UNPAID") @map("pay_status") @db.VarChar(20)
  /// NONE | PENDING | APPROVED | REJECTED | DONE（订单上的售后汇总态）
  refundStatus   String    @default("NONE") @map("refund_status") @db.VarChar(20)
  goodsAmount    Decimal   @default(0) @map("goods_amount") @db.Decimal(18, 2)
  freightAmount  Decimal   @default(0) @map("freight_amount") @db.Decimal(18, 2)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(18, 2)
  payAmount      Decimal   @default(0) @map("pay_amount") @db.Decimal(18, 2)
  /// 本单抵扣积分数
  pointsDeduct   Int       @default(0) @map("points_deduct")
  /// 本单返积分数
  pointsReturn   Int       @default(0) @map("points_return")
  couponTicketId Int       @default(0) @map("coupon_ticket_id")
  couponName     String    @default("") @map("coupon_name") @db.VarChar(60)
  /// WECHAT | BALANCE | OFFLINE
  payType        String    @default("WECHAT") @map("pay_type") @db.VarChar(16)
  transactionId  String    @default("") @map("transaction_id") @db.VarChar(64)
  prepayId       String    @default("") @map("prepay_id") @db.VarChar(64)
  receiverName   String    @default("") @map("receiver_name") @db.VarChar(30)
  receiverPhone  String    @default("") @map("receiver_phone") @db.VarChar(20)
  receiverProvince String  @default("") @map("receiver_province") @db.VarChar(40)
  receiverCity   String    @default("") @map("receiver_city") @db.VarChar(40)
  receiverDistrict String  @default("") @map("receiver_district") @db.VarChar(40)
  receiverDetail String    @default("") @map("receiver_detail") @db.VarChar(200)
  buyerRemark    String    @default("") @map("buyer_remark") @db.VarChar(200)
  sellerRemark   String    @default("") @map("seller_remark") @db.VarChar(500)
  expressCompany String    @default("") @map("express_company") @db.VarChar(40)
  expressNo      String    @default("") @map("express_no") @db.VarChar(60)
  cancelReason   String    @default("") @map("cancel_reason") @db.VarChar(200)
  paidAt         DateTime? @map("paid_at")
  shippedAt      DateTime? @map("shipped_at")
  receivedAt     DateTime? @map("received_at")
  completedAt    DateTime? @map("completed_at")
  cancelledAt    DateTime? @map("cancelled_at")
  /// 未付款自动取消锚点（定时任务按它扫）
  expireAt       DateTime? @map("expire_at")
  clientIp       String    @default("") @map("client_ip") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([shopId, status, createdAt])
  @@index([shopId, customerId, id])
  @@index([shopId, expireAt])
  @@index([ownerUserId])
  @@map("brand_orders")
}

/// 订单明细：下单瞬间的商品快照，改价改名不影响历史单。
model BrandOrderItem {
  id             Int      @id @default(autoincrement())
  orderId        Int      @map("order_id")
  shopId         Int      @map("shop_id")
  customerId     Int      @default(0) @map("customer_id")
  productId      Int      @map("product_id")
  skuId          Int      @default(0) @map("sku_id")
  title          String   @db.VarChar(200)
  skuName        String   @default("") @map("sku_name") @db.VarChar(200)
  image          String   @default("") @db.VarChar(500)
  price          Decimal  @default(0) @db.Decimal(18, 2)
  quantity       Int      @default(1)
  totalPrice     Decimal  @default(0) @map("total_price") @db.Decimal(18, 2)
  /// 行级售后态（与订单汇总态同枚举）
  refundStatus   String   @default("NONE") @map("refund_status") @db.VarChar(20)
  refundedAmount Decimal  @default(0) @map("refunded_amount") @db.Decimal(18, 2)
  reviewed       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([shopId, productId])
  @@map("brand_order_items")
}

/// 订单时间线：店主端与 C 端共用一份。
model BrandOrderLog {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  shopId       Int      @map("shop_id")
  /// SYSTEM | CUSTOMER | OWNER
  operatorType String   @default("SYSTEM") @map("operator_type") @db.VarChar(16)
  operatorId   String   @default("") @map("operator_id") @db.VarChar(64)
  action       String   @db.VarChar(40)
  content      String   @default("") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([orderId, id])
  @@index([shopId, createdAt])
  @@map("brand_order_logs")
}

/// 售后单：一行一笔退款申请，退款直连用户自己的商户号原路退回。
model BrandRefundOrder {
  id                  Int       @id @default(autoincrement())
  shopId              Int       @map("shop_id")
  refundNo            String    @unique @map("refund_no") @db.VarChar(32)
  orderId             Int       @map("order_id")
  orderItemId         Int       @default(0) @map("order_item_id")
  customerId          Int       @map("customer_id")
  productId           Int       @default(0) @map("product_id")
  /// REFUND_ONLY 仅退款 | RETURN_REFUND 退货退款
  type                String    @default("REFUND_ONLY") @db.VarChar(20)
  reason              String    @default("") @db.VarChar(100)
  description         String    @default("") @db.VarChar(500)
  images              Json      @default("[]")
  amount              Decimal   @default(0) @db.Decimal(18, 2)
  /// PENDING | AGREED | REJECTED | REFUNDED | CANCELLED
  status              String    @default("PENDING") @db.VarChar(20)
  adminRemark         String    @default("") @map("admin_remark") @db.VarChar(200)
  rejectReason        String    @default("") @map("reject_reason") @db.VarChar(200)
  returnExpress       String    @default("") @map("return_express") @db.VarChar(60)
  refundTransactionId String    @default("") @map("refund_transaction_id") @db.VarChar(64)
  refundedAt          DateTime? @map("refunded_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([shopId, status, createdAt])
  @@index([orderId])
  @@index([customerId])
  @@map("brand_refund_orders")
}

/// 优惠券模板：DISCOUNT 时 value 是折扣百分比（88 = 8.8 折）。
model BrandCoupon {
  id            Int       @id @default(autoincrement())
  shopId        Int       @map("shop_id")
  name          String    @db.VarChar(40)
  /// FULL_REDUCE 满减 | DISCOUNT 折扣
  type          String    @default("FULL_REDUCE") @db.VarChar(16)
  value         Decimal   @default(0) @db.Decimal(18, 2)
  /// 使用门槛（满多少元），0 = 无门槛
  threshold     Decimal   @default(0) @db.Decimal(18, 2)
  totalCount    Int       @default(0) @map("total_count")
  receivedCount Int       @default(0) @map("received_count")
  usedCount     Int       @default(0) @map("used_count")
  perLimit      Int       @default(1) @map("per_limit")
  /// FIXED 固定有效期 | DAYS 领取后 N 天
  validType     String    @default("FIXED") @map("valid_type") @db.VarChar(16)
  startAt       DateTime? @map("start_at")
  endAt         DateTime? @map("end_at")
  validDays     Int       @default(7) @map("valid_days")
  /// ALL | CATEGORY | PRODUCT
  scope         String    @default("ALL") @db.VarChar(16)
  /// 作用域 id 列表（分类或商品 id）
  scopeIds      Json      @default("[]") @map("scope_ids")
  /// ONLINE 发放中 | OFFLINE 已停发 | ENDED 已结束
  status        String    @default("ONLINE") @db.VarChar(16)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([shopId, status, createdAt])
  @@map("brand_coupons")
}

/// 顾客手里的券票。
model BrandCouponTicket {
  id         Int       @id @default(autoincrement())
  shopId     Int       @map("shop_id")
  couponId   Int       @map("coupon_id")
  customerId Int       @map("customer_id")
  /// UNUSED | USED | EXPIRED
  status     String    @default("UNUSED") @db.VarChar(16)
  orderId    Int       @default(0) @map("order_id")
  receivedAt DateTime  @default(now()) @map("received_at")
  usedAt     DateTime? @map("used_at")
  expireAt   DateTime? @map("expire_at")

  @@index([shopId, customerId, status])
  @@index([couponId, customerId])
  @@map("brand_coupon_tickets")
}

/// DIY 装修页：components/styles 是草稿，published* 是 C 端读的线上快照。
model BrandDiyPage {
  id                  Int       @id @default(autoincrement())
  shopId              Int       @map("shop_id")
  name                String    @db.VarChar(40)
  /// HOME 首页 | CATEGORY 分类页 | MINE 个人中心 | ACTIVITY 活动页
  type                String    @default("ACTIVITY") @db.VarChar(16)
  /// [{ id, type, props }]，组件白名单见 mall.diy-widgets.ts
  components          Json      @default("[]")
  styles              Json      @default("{}")
  coverImage          String    @default("") @map("cover_image") @db.VarChar(500)
  /// 同 type 下只有一条 isDefault，C 端按它取
  isDefault           Boolean   @default(false) @map("is_default")
  /// DRAFT | PUBLISHED
  status              String    @default("DRAFT") @db.VarChar(16)
  publishedComponents Json?     @map("published_components")
  publishedStyles     Json?     @map("published_styles")
  publishedAt         DateTime? @map("published_at")
  sortOrder           Int       @default(0) @map("sort_order")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([shopId, type, status])
  @@map("brand_diy_pages")
}

/// 运费模板：店铺级；商品通过 freight_template_id 指向它，未指定时用店铺默认模板。
model BrandShippingTemplate {
  id        Int      @id @default(autoincrement())
  shopId    Int      @map("shop_id")
  name      String   @db.VarChar(60)
  /// 同店铺默认模板唯一：保存时由服务层把其余模板置 false
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([shopId, isDefault])
  @@map("brand_shipping_templates")
}

/// 模板内的一条地区规则：regions 为空数组表示全国兜底行。
model BrandShippingTemplateRule {
  id                 Int     @id @default(autoincrement())
  templateId         Int     @map("template_id")
  shopId             Int     @map("shop_id")
  name               String  @default("") @db.VarChar(60)
  /// 收货市名列表（与地址簿 city 对齐）；空数组 = 全国
  regions            Json    @default("[]")
  firstPiece         Int     @default(1) @map("first_piece")
  firstFee           Decimal @default(0) @map("first_fee") @db.Decimal(18, 2)
  additionalPiece    Int     @default(0) @map("additional_piece")
  additionalFee      Decimal @default(0) @map("additional_fee") @db.Decimal(18, 2)
  /// 满 N 件包邮，0 = 不启用
  freePiece          Int     @default(0) @map("free_piece")
  sortOrder          Int     @default(0) @map("sort_order")

  @@index([templateId, sortOrder])
  @@map("brand_shipping_template_rules")
}

/// 商品参数与售后保障：一行一商品，参数清单与保障标签都存 JSON。
model BrandProductParam {
  id         Int      @id @default(autoincrement())
  shopId     Int      @map("shop_id")
  productId  Int      @unique @map("product_id")
  /// [{ name, value }]
  params     Json     @default("[]")
  /// 售后保障标签
  protection Json     @default("[]")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([shopId])
  @@map("brand_product_params")
}

/// 退款副作用幂等台账：一个售后单的每种副作用一行，重试只补未完成的步。
model BrandRefundEffect {
  id         Int       @id @default(autoincrement())
  shopId     Int       @map("shop_id")
  refundId   Int       @map("refund_id")
  /// RESTORE_STOCK | RELEASE_COUPON | RETURN_POINTS | REVOKE_POINTS | REVOKE_COMMISSION
  effect     String    @db.VarChar(24)
  /// PENDING | DONE | FAILED
  status     String    @default("PENDING") @db.VarChar(16)
  /// 执行明细：回补数量、券票 id、积分变动等
  detail     Json      @default("{}")
  error      String    @default("") @db.VarChar(200)
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([refundId, effect])
  @@index([shopId, status])
  @@map("brand_refund_effects")
}

/// SCRM 身份绑定：商城顾客 ↔ 企微客户。contactId 只引用 scrm_contacts.id，
/// 不建外键、不在 scrm_* 表上加列——SCRM 关掉时这张表只剩本地数据，商城照常营业。
model BrandScrmBinding {
  id          Int       @id @default(autoincrement())
  shopId      Int       @map("shop_id")
  ownerUserId String    @map("owner_user_id") @db.VarChar(64)
  customerId  Int       @map("customer_id")
  /// 0 = 未匹配（不猜、不新建企微客户）
  contactId   Int       @default(0) @map("contact_id")
  unionId     String    @default("") @map("union_id") @db.VarChar(64)
  /// HMAC-SHA256 摘要（上下文串 scrm-match），明文手机号不落商城库
  mobileHash  String    @default("") @map("mobile_hash") @db.VarChar(64)
  /// AUTO_UNIONID | AUTO_MOBILE | MANUAL
  bindSource  String    @default("AUTO_UNIONID") @map("bind_source") @db.VarChar(16)
  /// BOUND | UNBOUND | IGNORED
  status      String    @default("BOUND") @db.VarChar(16)
  lastSyncAt  DateTime? @map("last_sync_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([shopId, customerId])
  @@index([shopId, status])
  @@index([ownerUserId, status])
  @@map("brand_scrm_bindings")
}

/// SCRM 事件外发箱（outbox 模式）：交易事务内只写一行，提交即返回；
/// 投递由 scheduler 异步完成，SCRM 挂掉只是网络抖动，不影响下单速度。
model BrandScrmOutbox {
  id           Int       @id @default(autoincrement())
  shopId       Int       @map("shop_id")
  ownerUserId  String    @map("owner_user_id") @db.VarChar(64)
  customerId   Int       @map("customer_id")
  /// ScrmEventKind（commerce-core/scrm-port.ts）
  eventKind    String    @map("event_kind") @db.VarChar(32)
  /// <biz>:<eventKind>:<业务主键>，重放不产生重复时间线
  dedupeKey    String    @unique @map("dedupe_key") @db.VarChar(120)
  /// 快照时刻的事实：金额、单号等，补发时不回读商城现值
  payloadJson  Json      @default("{}") @map("payload_json")
  /// PENDING | SENT | SKIPPED | DEAD
  status       String    @default("PENDING") @db.VarChar(16)
  attempts     Int       @default(0)
  nextAt       DateTime? @map("next_at")
  lastError    String    @default("") @map("last_error") @db.VarChar(500)
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status, nextAt])
  @@index([shopId, createdAt])
  @@index([ownerUserId, status])
  @@map("brand_scrm_outbox")
}

// ============================================================================
// 私域小程序底座 + 上门服务小程序工具（docs/私域小程序·上门服务小程序工具设计方案.md §四）
// ============================================================================

/// 私域小程序·租户主体：每个本站用户的每一部自营小程序一行（上门服务 / 电商工具共用）。
/// 凭据一律密文列（EXTERNAL_CRED_KEY + 掺 AppID 的上下文串），任何读接口只回 xxxConfigured。
/// 与平台版小程序（system_settings 的 miniprogram_settings 单行）互不影响：那是站内移动办公壳，
/// 这里是用户自己的小程序主体，资金、域名、类目都归用户自己。
model MiniProgramApp {
  id          Int      @id @default(autoincrement())
  ownerUserId String   @map("owner_user_id") @db.VarChar(64)
  /// 业务场景：ONSITE 上门服务 | BRAND 品牌商城
  scene       String   @db.VarChar(16)
  /// 业务实例 id（onsite_shops.id；BRAND 品牌商城指向 brand_shops.id）
  shopId      Int      @default(0) @map("shop_id")
  /// 用户自有小程序 AppID，全局唯一（同 AppID 不允许被两个主体重复占用）
  appId       String   @unique @map("app_id") @db.VarChar(64)
  appSecretCipher String @default("") @map("app_secret_cipher") @db.Text
  /// 微信支付商户号与 APIv3 凭据（资金直进用户自己账户，平台不经手）
  mchId            String @default("") @map("mch_id") @db.VarChar(64)
  payApiV3KeyCipher String @default("") @map("pay_api_v3_key_cipher") @db.Text
  payCertSerial     String @default("") @map("pay_cert_serial") @db.VarChar(128)
  payPrivateKeyCipher String @default("") @map("pay_private_key_cipher") @db.Text
  /// 0 = 未开启在线收款（下单走线下标记），1 = 已开启
  payEnabled    Int      @default(0) @map("pay_enabled") @db.TinyInt
  /// 腾讯地图 key（车费算距与定位用）密文；缺省时车费降级为直线距离
  mapKeyCipher  String   @default("") @map("map_key_cipher") @db.Text
  /// 小程序订阅消息模板 id：{ order, accept, cancel, coachChange, help }
  templates     Json     @default("{}")
  /// 小程序码图片地址（对象存储直链）
  qrcodeUrl     String   @default("") @map("qrcode_url") @db.VarChar(500)
  /// UNVERIFIED 未自检 | VERIFIED 凭据可用 | FAILED 自检失败（附 lastError）
  status        String   @default("UNVERIFIED") @db.VarChar(16)
  lastError     String   @default("") @map("last_error") @db.VarChar(500)
  verifiedAt    DateTime? @map("verified_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  /// 账号级场景（快递/圈子）shopId=0，唯一键必须带 ownerUserId，否则第二个账号会覆盖第一个账号的主体。
  @@unique([ownerUserId, scene, shopId], map: "miniprogram_apps_owner_scene_shop_uniq")
  @@index([ownerUserId, scene])
  @@map("miniprogram_apps")
}

/// 上门服务小程序·店铺实例（= 用户自营的上门服务平台上游业务底座）。
/// 默认一人一店，平台侧配额可放开；交易参数与主题不落独立表，一店一行 JSON（与 GeoSite / KpSite 同口径）。
model OnsiteShop {
  id               Int      @id @default(autoincrement())
  /// 归属账号（本站用户 = 平台主人）
  ownerUserId      String   @map("owner_user_id") @db.VarChar(64)
  /// 企业档案 id（0 = 未绑定企业；代客作业留痕）
  enterpriseId     Int      @default(0) @map("enterprise_id")
  enterpriseUserId String   @default("") @map("enterprise_user_id") @db.VarChar(64)
  name             String   @db.VarChar(120)
  /// 公开寻址码：小程序包内 shopCode，全局唯一，创建后不变
  shopCode         String   @unique @map("shop_code") @db.VarChar(16)
  logo             String   @default("") @db.VarChar(500)
  slogan           String   @default("") @db.VarChar(120)
  servicePhone     String   @default("") @map("service_phone") @db.VarChar(32)
  /// DRAFT 未上线 | ONLINE 营业中 | SUSPENDED 平台停服（数据保留）| CLOSED 已关闭
  status           String   @default("DRAFT") @db.VarChar(16)
  /// 主题：{ themeColor, navigationTitle, tabBar 文案与顺序 }
  themeJson        Json     @default("{}") @map("theme_json")
  /// 交易与运营参数：{ autoCancelMinutes, timeUnitMinutes, bufferMinutes, maxDays,
  /// allowCrossDay, dispatchMode, allowSelfOrder, reviewEnabled, canTxHours, ... }
  tradeJson        Json     @default("{}") @map("trade_json")
  shareImage       String   @default("") @map("share_image") @db.VarChar(500)
  /// 平台停服/强制下线操作人与原因（合规处置留痕）
  offBy            String   @default("") @map("off_by") @db.VarChar(64)
  offReason        String   @default("") @map("off_reason") @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, status])
  @@index([enterpriseId])
  @@map("onsite_shops")
}

/// 上门服务小程序·C 端顾客（一店一套，与站内 User 物理隔离）。
/// 顾客令牌只在本域有效（private-mini/customer-token），绝不能拿到站内用户权限面。
model OnsiteCustomer {
  id         Int      @id @default(autoincrement())
  shopId     Int      @map("shop_id")
  /// 微信 openId（同一 openId 在不同小程序主体下不同，故按店唯一）
  openid     String   @db.VarChar(64)
  unionId    String   @default("") @map("union_id") @db.VarChar(64)
  nickname   String   @default("") @db.VarChar(120)
  avatar     String   @default("") @db.VarChar(500)
  phone      String   @default("") @db.VarChar(32)
  gender     Int      @default(0) @db.TinyInt
  city       String   @default("") @db.VarChar(60)
  /// ACTIVE 正常 | BLOCKED 店主拉黑
  status     String   @default("ACTIVE") @db.VarChar(16)
  /// P2：店内余额与积分（与站内 AWcoin 物理隔离，只在 C 端顾客域内流转）
  balance    Decimal  @default(0) @db.Decimal(12, 2)
  points     Int      @default(0)
  source     String   @default("MINIPROGRAM") @db.VarChar(16)
  referrerCustomerId Int @default(0) @map("referrer_customer_id")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([shopId, openid])
  @@index([shopId, phone])
  @@map("onsite_customers")
}

// ============================================================================
// 上门服务小程序工具 P1 第一批：服务目录 / 服务人员 / 排期 / 城市与车费 / 内容与表单
// （docs/私域小程序·上门服务小程序工具设计方案.md §四 4.1、§五）
// 金额一律 DECIMAL(12,2)，服务层换算成分做整数运算；经纬度用 DECIMAL(10,6)。
// ============================================================================

/// 服务分类（两级：parentId=0 为一级）。小程序首页与分类页的栏目骨架。
model OnsiteCategory {
  id        Int      @id @default(autoincrement())
  shopId    Int      @map("shop_id")
  parentId  Int      @default(0) @map("parent_id")
  name      String   @db.VarChar(60)
  image     String   @default("") @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([shopId, enabled, sortOrder])
  @@index([parentId])
  @@map("onsite_categories")
}

/// 上门服务的服务：时长 / 价格 / 物料费 / 加钟 / 车费模式决定算价与排期。
model OnsiteService {
  id                 Int      @id @default(autoincrement())
  shopId             Int      @map("shop_id")
  title              String   @db.VarChar(120)
  subtitle           String   @default("") @db.VarChar(160)
  coverImage         String   @default("") @map("cover_image") @db.VarChar(500)
  /// 图集（string[]）
  images             Json     @default("[]")
  /// 图文详情（富文本 HTML，与站内素材库同一渲染口径）
  detail             String   @default("") @db.Text
  price              Decimal  @default(0) @db.Decimal(12, 2)
  marketPrice        Decimal  @default(0) @map("market_price") @db.Decimal(12, 2)
  durationMinutes    Int      @default(60) @map("duration_minutes")
  /// 0 = 与 durationMinutes 相同（用于「最长可约时长」）
  maxDurationMinutes Int      @default(0) @map("max_duration_minutes")
  /// 加钟：是否可加、单位时长、费率（100 = 按原价，120 = 加价两成）
  addonEnabled       Boolean  @default(true) @map("addon_enabled")
  addonUnitMinutes   Int      @default(30) @map("addon_unit_minutes")
  addonRate          Decimal  @default(100) @map("addon_rate") @db.Decimal(5, 2)
  materialFee        Decimal  @default(0) @map("material_fee") @db.Decimal(12, 2)
  /// CITY = 按城市车费规则算距；CUSTOM = 用 customTravelFee 固定值
  travelFeeMode      String   @default("CITY") @map("travel_fee_mode") @db.VarChar(12)
  customTravelFee    Decimal  @default(0) @map("custom_travel_fee") @db.Decimal(12, 2)
  /// 服务特性标签词快照，列表页直出不再 JOIN
  highlights         Json     @default("[]")
  doorEnabled        Boolean  @default(true) @map("door_enabled")
  /// 到店形态在 P3 生效，字段先留位（参考源码 is_store）
  storeEnabled       Boolean  @default(false) @map("store_enabled")
  /// DRAFT | ONLINE | OFFLINE
  status             String   @default("DRAFT") @db.VarChar(12)
  sortOrder          Int      @default(0) @map("sort_order")
  /// 销量：virtual 是店主设置的展示值，true 是真实值（参考源码三列口径）
  salesVirtual       Int      @default(0) @map("sales_virtual")
  salesTrue          Int      @default(0) @map("sales_true")
  rating             Decimal  @default(5) @db.Decimal(3, 2)
  reviewCount        Int      @default(0) @map("review_count")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, sortOrder])
  @@map("onsite_services")
}

/// 服务多分类归属（参考源码 cate_connect）：分类下仍有服务时删除分类会被拦截。
model OnsiteServiceCategoryLink {
  id         Int @id @default(autoincrement())
  shopId     Int @map("shop_id")
  serviceId  Int @map("service_id")
  categoryId Int @map("category_id")

  @@unique([serviceId, categoryId])
  @@index([shopId, categoryId])
  @@map("onsite_service_category_links")
}

/// 标签词：FEATURE 服务特性、REVIEW 评价词（参考源码 service_lable + comment_lable 合一）。
model OnsiteServiceLabel {
  id        Int      @id @default(autoincrement())
  shopId    Int      @map("shop_id")
  name      String   @db.VarChar(40)
  /// FEATURE | REVIEW
  type      String   @default("FEATURE") @db.VarChar(16)
  sortOrder Int      @default(0) @map("sort_order")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([shopId, name, type])
  @@map("onsite_service_labels")
}

/// 服务 × 标签关系。
model OnsiteServiceLabelLink {
  id        Int @id @default(autoincrement())
  shopId    Int @map("shop_id")
  serviceId Int @map("service_id")
  labelId   Int @map("label_id")

  @@unique([serviceId, labelId])
  @@index([shopId, labelId])
  @@map("onsite_service_label_links")
}

/// 技师对某服务的独立定价（参考源码 service_service_coach.price=-1 的显式化）。
model OnsiteServiceStaffPrice {
  id              Int     @id @default(autoincrement())
  shopId          Int     @map("shop_id")
  serviceId       Int     @map("service_id")
  staffId         Int     @map("staff_id")
  price           Decimal @default(0) @db.Decimal(12, 2)
  /// 0 = 沿用服务时长
  durationMinutes Int     @default(0) @map("duration_minutes")

  @@unique([serviceId, staffId])
  @@index([shopId, staffId])
  @@map("onsite_service_staff_prices")
}

/// 轮播位（首页 / 分类页）：link 为 {type,value} 结构，由界面链接选择器产出。
model OnsiteBanner {
  id        Int      @id @default(autoincrement())
  shopId    Int      @map("shop_id")
  position  String   @default("HOME") @db.VarChar(20)
  title     String   @default("") @db.VarChar(80)
  image     String   @db.VarChar(500)
  link      Json     @default("{}")
  sortOrder Int      @default(0) @map("sort_order")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([shopId, position, enabled, sortOrder])
  @@map("onsite_banners")
}

/// 服务人员（参考源码 service_coach_list 51 列，按语义分组重写）。
model OnsiteStaff {
  id               Int       @id @default(autoincrement())
  shopId           Int       @map("shop_id")
  staffNo          String    @default("") @map("staff_no") @db.VarChar(32)
  name             String    @db.VarChar(60)
  gender           Int       @default(0) @db.TinyInt
  phone            String    @db.VarChar(32)
  /// 登录手机号对应的站内账号（空 = 纯小程序端人员，不占站内席位）
  accountUserId    String    @default("") @map("account_user_id") @db.VarChar(64)
  avatar           String    @default("") @db.VarChar(500)
  /// 身份证密文（按店铺 + 技师维度派生密钥，跨店不可解）
  idCardCipher     String    @default("") @map("id_card_cipher") @db.Text
  licenseImages    Json      @default("[]") @map("license_images")
  workYears        Int       @default(0) @map("work_years")
  intro            String    @default("") @db.Text
  images           Json      @default("[]")
  video            String    @default("") @db.VarChar(500)
  levelId          Int       @default(0) @map("level_id")
  cityId           Int       @default(0) @map("city_id")
  serviceCity      String    @default("") @map("service_city") @db.VarChar(60)
  lng              Decimal   @default(0) @db.Decimal(10, 6)
  lat              Decimal   @default(0) @db.Decimal(10, 6)
  address          String    @default("") @db.VarChar(200)
  /// 每日可服务时段（HH:mm）；crossDay 为真时 end < start 表示跨零点夜班
  serviceStartAt   String    @default("09:00") @map("service_start_at") @db.VarChar(5)
  serviceEndAt     String    @default("19:00") @map("service_end_at") @db.VarChar(5)
  crossDay         Boolean   @default(false) @map("cross_day")
  /// 每技师每日最多接单数（0 = 不限）
  dailyOrderLimit  Int       @default(0) @map("daily_order_limit")
  selfPriceEnabled Boolean   @default(true) @map("self_price_enabled")
  /// 技师自定车费（参考源码 car_price）：关闭时一律走城市规则
  carFeeEnabled    Boolean   @default(false) @map("car_fee_enabled")
  carFee           Decimal   @default(0) @map("car_fee") @db.Decimal(12, 2)
  rating           Decimal   @default(5) @db.Decimal(3, 2)
  reviewCount      Int       @default(0) @map("review_count")
  orderCountVirtual Int      @default(0) @map("order_count_virtual")
  orderCountTrue    Int      @default(0) @map("order_count_true")
  recommendTop     Boolean   @default(false) @map("recommend_top")
  sortTop          Int       @default(0) @map("sort_top")
  /// 实时定位上报开关与最近定位时间（个人信息，默认关闭）
  locationEnabled  Boolean   @default(false) @map("location_enabled")
  lastLocationAt   DateTime? @map("last_location_at")
  /// PENDING 待审核 | ONLINE 在岗 | OFF_DUTY 休息 | SUSPENDED 停用 | LEFT 离场
  status           String    @default("PENDING") @db.VarChar(16)
  authStatus       String    @default("UNVERIFIED") @map("auth_status") @db.VarChar(16)
  reviewRemark     String    @default("") @map("review_remark") @db.VarChar(200)
  reviewedAt       DateTime? @map("reviewed_at")
  /// 资料修改待审副本（参考源码 coach_update）：审核通过后由服务层合并回主行
  profilePending   Json      @default("{}") @map("profile_pending")
  /// OWNER 店主录入 | APPLY 小程序报名
  source           String    @default("OWNER") @db.VarChar(12)
  storeId          Int       @default(0) @map("store_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([shopId, status])
  @@index([shopId, cityId])
  @@index([shopId, levelId])
  @@index([accountUserId])
  @@map("onsite_staff")
}

/// 技师等级：服务费分成比例、加钟费率、升级门槛（参考源码 coach_level）。
model OnsiteStaffLevel {
  id                  Int      @id @default(autoincrement())
  shopId              Int      @map("shop_id")
  name                String   @db.VarChar(40)
  rank                Int      @default(1)
  commissionRate      Decimal  @default(50) @map("commission_rate") @db.Decimal(5, 2)
  addonRate           Decimal  @default(100) @map("addon_rate") @db.Decimal(5, 2)
  minPerformance      Decimal  @default(0) @map("min_performance") @db.Decimal(12, 2)
  onlineHoursRequired Int      @default(0) @map("online_hours_required")
  points              Int      @default(0)
  agreementArticleId  Int      @default(0) @map("agreement_article_id")
  sortOrder           Int      @default(0) @map("sort_order")
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([shopId, enabled, rank])
  @@map("onsite_staff_levels")
}

/// 休息/请假时段（参考源码 coach_time_log）：与订单区间一样参与时间轴判定。
model OnsiteStaffRestPeriod {
  id            Int      @id @default(autoincrement())
  shopId        Int      @map("shop_id")
  staffId       Int      @map("staff_id")
  startAt       DateTime @map("start_at")
  endAt         DateTime @map("end_at")
  allDay        Boolean  @default(false) @map("all_day")
  reason        String   @default("") @db.VarChar(200)
  /// OWNER 店主设置 | STAFF 本人 | SYSTEM 规则
  createdByRole String   @default("OWNER") @map("created_by_role") @db.VarChar(16)
  createdBy     String   @default("") @map("created_by") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([staffId, startAt])
  @@index([shopId, staffId])
  @@map("onsite_staff_rest_periods")
}

/// 实际工时台账（参考源码 coach_work_log）：服务与路途分开记。
model OnsiteStaffWorkLog {
  id          Int      @id @default(autoincrement())
  shopId      Int      @map("shop_id")
  staffId     Int      @map("staff_id")
  orderId     Int      @default(0) @map("order_id")
  /// YYYY-MM-DD（按当地日切冗余存字符串，双库分组不依赖日期函数）
  day         String   @db.VarChar(10)
  minutes     Int      @default(0)
  trueMinutes Int      @default(0) @map("true_minutes")
  /// SERVICE 服务 | TRAVEL 路途
  type        String   @default("SERVICE") @db.VarChar(12)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([shopId, staffId, day])
  @@map("onsite_staff_work_logs")
}

/// 时间轴缓存（参考源码 coach_time + coach_time_list 合一）：真值永远由排期引擎重算。
model OnsiteStaffScheduleCache {
  id              Int      @id @default(autoincrement())
  shopId          Int      @map("shop_id")
  staffId         Int      @map("staff_id")
  day             String   @db.VarChar(10)
  timeUnitMinutes Int      @map("time_unit_minutes")
  maxDays         Int      @default(0) @map("max_days")
  slots           Json     @default("[]")
  generatedAt     DateTime @default(now()) @map("generated_at")

  @@unique([staffId, day, timeUnitMinutes])
  @@index([shopId, day])
  @@map("onsite_staff_schedule_cache")
}

/// 开城与行政区划：shopId=0 是平台预置全量城市，店铺只维护自己开通的子集。
model OnsiteCity {
  id           Int      @id @default(autoincrement())
  shopId       Int      @default(0) @map("shop_id")
  parentId     Int      @default(0) @map("parent_id")
  name         String   @db.VarChar(60)
  /// PROVINCE | CITY | DISTRICT
  level        String   @default("CITY") @db.VarChar(12)
  provinceCode String   @default("") @map("province_code") @db.VarChar(12)
  cityCode     String   @default("") @map("city_code") @db.VarChar(12)
  areaCode     String   @default("") @map("area_code") @db.VarChar(12)
  lng          Decimal  @default(0) @db.Decimal(10, 6)
  lat          Decimal  @default(0) @db.Decimal(10, 6)
  sortOrder    Int      @default(0) @map("sort_order")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([shopId, enabled, sortOrder])
  @@index([parentId])
  @@map("onsite_cities")
}

/// 车费计价规则（参考源码 service_car_price）：按城市一条，cityId=0 为店铺默认。
model OnsiteTravelFeeRule {
  id                     Int      @id @default(autoincrement())
  shopId                 Int      @map("shop_id")
  cityId                 Int      @default(0) @map("city_id")
  freeKilometers         Decimal  @default(0) @map("free_kilometers") @db.Decimal(6, 2)
  startFee               Decimal  @default(0) @map("start_fee") @db.Decimal(12, 2)
  startKilometers        Decimal  @default(0) @map("start_kilometers") @db.Decimal(6, 2)
  pricePerKilometer      Decimal  @default(0) @map("price_per_kilometer") @db.Decimal(8, 2)
  /// 虚拟里程加成：把实际里程人为抬高（参考源码 invented_distance）
  virtualExtraKilometers Decimal  @default(0) @map("virtual_extra_kilometers") @db.Decimal(6, 2)
  publicTransitEnabled   Boolean  @default(false) @map("public_transit_enabled")
  minFee                 Decimal  @default(0) @map("min_fee") @db.Decimal(12, 2)
  enabled                Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@unique([shopId, cityId])
  @@map("onsite_travel_fee_rules")
}

/// 文章：协议、说明、招募公告。挂表单时兼作报名收集器（参考源码 article_list.is_form）。
model OnsiteArticle {
  id          Int      @id @default(autoincrement())
  shopId      Int      @map("shop_id")
  title       String   @db.VarChar(120)
  summary     String   @default("") @db.VarChar(200)
  content     String   @default("") @db.Text
  cover       String   @default("") @db.VarChar(500)
  formEnabled Boolean  @default(false) @map("form_enabled")
  /// AGREEMENT 协议 | STAFF_APPLY 人员报名 | CUSTOM
  formPurpose String   @default("CUSTOM") @map("form_purpose") @db.VarChar(20)
  sortOrder   Int      @default(0) @map("sort_order")
  /// DRAFT | PUBLISHED | OFFLINE
  status      String   @default("DRAFT") @db.VarChar(12)
  pv          Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, sortOrder])
  @@map("onsite_articles")
}

/// 自定义表单字段（参考源码 article_form_field）：题型闭集，前后端共用校验。
model OnsiteFormField {
  id          Int      @id @default(autoincrement())
  shopId      Int      @map("shop_id")
  name        String   @db.VarChar(60)
  /// text | textarea | number | select | phone | idcard | date | region
  fieldType   String   @default("text") @map("field_type") @db.VarChar(20)
  options     Json     @default("[]")
  placeholder String   @default("") @db.VarChar(80)
  required    Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([shopId, enabled, sortOrder])
  @@map("onsite_form_fields")
}

/// 文章 × 表单字段（参考源码 article_connect）。
model OnsiteArticleFormField {
  id        Int @id @default(autoincrement())
  articleId Int @map("article_id")
  fieldId   Int @map("field_id")
  sortOrder Int @default(0) @map("sort_order")

  @@unique([articleId, fieldId])
  @@index([fieldId])
  @@map("onsite_article_form_fields")
}

/// 表单提交（报名/申请）：审核通过后可升级为技师档案。
model OnsiteFormSubmission {
  id          Int       @id @default(autoincrement())
  shopId      Int       @map("shop_id")
  articleId   Int       @default(0) @map("article_id")
  customerId  Int       @default(0) @map("customer_id")
  staffId     Int       @default(0) @map("staff_id")
  name        String    @default("") @db.VarChar(60)
  phone       String    @default("") @db.VarChar(32)
  /// PENDING | APPROVED | REJECTED
  status      String    @default("PENDING") @db.VarChar(12)
  auditRemark String    @default("") @map("audit_remark") @db.VarChar(200)
  auditedBy   String    @default("") @map("audited_by") @db.VarChar(64)
  auditedAt   DateTime? @map("audited_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([shopId, status, createdAt])
  @@index([articleId])
  @@map("onsite_form_submissions")
}

/// 提交明细（参考源码 article_sub_data）：label 冗余存字段名，导出与回看不再 JOIN 定义表。
model OnsiteFormData {
  id           Int    @id @default(autoincrement())
  submissionId Int    @map("submission_id")
  fieldId      Int    @default(0) @map("field_id")
  label        String @default("") @db.VarChar(60)
  value        String @default("") @db.Text

  @@index([submissionId])
  @@map("onsite_form_data")
}

/// 屏蔽与拉黑（参考源码 shield_list）：顾客屏蔽技师、技师拉黑顾客。
model OnsiteShieldLink {
  id         Int      @id @default(autoincrement())
  shopId     Int      @map("shop_id")
  customerId Int      @map("customer_id")
  staffId    Int      @map("staff_id")
  /// BLOCK_STAFF 顾客屏蔽技师 | BLOCK_CUSTOMER 技师拉黑顾客
  type       String   @default("BLOCK_STAFF") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([customerId, staffId, type])
  @@index([shopId, staffId])
  @@map("onsite_shield_links")
}

// ============================================================================
// 上门服务小程序工具 P1 第二批：订单 / 履约打卡 / 加钟 / 换人 / 退款 / 评价 / 反馈 / 报警
// （docs/私域小程序·上门服务小程序工具设计方案.md §四 4.1、§五 状态机）
// 参考源码把订单状态塞进 pay_type 字段（名叫支付方式、实为状态机），本批彻底拆开：
// status 是履约状态、payStatus 是资金状态、refundStatus 是售后状态，三者互不兼职。
// ============================================================================

/// 上门服务订单主表。金额与打卡字段按「金额 / 预约 / 履约时间轴 / 归属快照 / 结算」分组。
model OnsiteOrder {
  id           Int       @id @default(autoincrement())
  shopId       Int       @map("shop_id")
  /// OS + 14 位时间 + 6 位随机（单据号方言适配口径）
  orderNo      String    @unique @map("order_no") @db.VarChar(40)
  customerId   Int       @map("customer_id")
  customerName String    @default("") @map("customer_name") @db.VarChar(60)
  customerPhone String   @default("") @map("customer_phone") @db.VarChar(32)
  staffId      Int       @map("staff_id")
  staffName    String    @default("") @map("staff_name") @db.VarChar(60)
  staffPhone   String    @default("") @map("staff_phone") @db.VarChar(32)
  /// PENDING_PAYMENT/PAID/ACCEPTED/EN_ROUTE/ON_SITE/SERVING/COMPLETED/SIGNED/REVIEWED/CANCELLED/EXPIRED/REJECTED/REFUND_PENDING/REFUNDED
  status       String    @default("PENDING_PAYMENT") @db.VarChar(24)
  /// UNPAID/PAID/REFUNDING/REFUNDED
  payStatus    String    @default("UNPAID") @map("pay_status") @db.VarChar(16)
  /// NONE/PENDING/PARTIAL/DONE/REJECTED
  refundStatus String    @default("NONE") @map("refund_status") @db.VarChar(16)
  /// DOOR 上门 | STORE 到店（P3 生效）
  serviceMode  String    @default("DOOR") @map("service_mode") @db.VarChar(12)
  addressId    Int       @default(0) @map("address_id")
  startAt      DateTime  @map("start_at")
  endAt        DateTime  @map("end_at")
  durationMinutes     Int     @default(0) @map("duration_minutes")
  /// 真实时长 = 时长 − 已退服务时长，工时与分账都按它算
  trueDurationMinutes Int     @default(0) @map("true_duration_minutes")
  // ---------- 金额（元，两位小数；服务层按分运算）----------
  serviceFee          Decimal @default(0) @map("service_fee") @db.Decimal(12, 2)
  trueServiceFee      Decimal @default(0) @map("true_service_fee") @db.Decimal(12, 2)
  travelFee           Decimal @default(0) @map("travel_fee") @db.Decimal(12, 2)
  trueTravelFee       Decimal @default(0) @map("true_travel_fee") @db.Decimal(12, 2)
  materialFee         Decimal @default(0) @map("material_fee") @db.Decimal(12, 2)
  discount            Decimal @default(0) @db.Decimal(12, 2)
  /// P2：用的券票 id（0 = 未用券）与券抵扣金额，下单时快照
  couponTicketId      Int     @default(0) @map("coupon_ticket_id")
  couponAmount        Decimal @default(0) @map("coupon_amount") @db.Decimal(12, 2)
  /// P2：余额抵扣金额（payType=BALANCE 或混合支付时记录）
  balanceAmount       Decimal @default(0) @map("balance_amount") @db.Decimal(12, 2)
  payAmount           Decimal @default(0) @map("pay_amount") @db.Decimal(12, 2)
  payType             String  @default("WECHAT") @map("pay_type") @db.VarChar(12)
  transactionId       String  @default("") @map("transaction_id") @db.VarChar(64)
  prepayId            String  @default("") @map("prepay_id") @db.VarChar(64)
  paidAt              DateTime? @map("paid_at")
  expireAt            DateTime? @map("expire_at")
  // ---------- 履约时间轴（每一步只允许前进，回退走换人/退款）----------
  acceptedAt          DateTime? @map("accepted_at")
  rejectedAt          DateTime? @map("rejected_at")
  rejectReason        String  @default("") @map("reject_reason") @db.VarChar(200)
  departedAt          DateTime? @map("departed_at")
  departedLng         Decimal @default(0) @map("departed_lng") @db.Decimal(10, 6)
  departedLat         Decimal @default(0) @map("departed_lat") @db.Decimal(10, 6)
  departedAddress     String  @default("") @map("departed_address") @db.VarChar(200)
  arrivedAt           DateTime? @map("arrived_at")
  /// 到达必须拍照（参考源码 arrive_img），是纠纷举证的第一现场
  arrivalImage        String  @default("") @map("arrival_image") @db.VarChar(500)
  arrivalAddress      String  @default("") @map("arrival_address") @db.VarChar(200)
  serviceStartedAt    DateTime? @map("service_started_at")
  completedAt         DateTime? @map("completed_at")
  leaveImage          String  @default("") @map("leave_image") @db.VarChar(500)
  leaveLng            Decimal @default(0) @map("leave_lng") @db.Decimal(10, 6)
  leaveLat            Decimal @default(0) @map("leave_lat") @db.Decimal(10, 6)
  leaveAddress        String  @default("") @map("leave_address") @db.VarChar(200)
  tripStartAddress    String  @default("") @map("trip_start_address") @db.VarChar(200)
  tripEndAddress      String  @default("") @map("trip_end_address") @db.VarChar(200)
  verifyOperator      String  @default("") @map("verify_operator") @db.VarChar(64)
  // ---------- 算价快照（改配置不影响历史单）----------
  distanceMeters      Int     @default(0) @map("distance_meters")
  /// DRIVING 驾车 | STRAIGHT 直线 | CUSTOM 固定 | NONE 未计费
  travelFeeSource     String  @default("NONE") @map("travel_fee_source") @db.VarChar(12)
  travelFeeRuleNote   String  @default("") @map("travel_fee_rule_note") @db.VarChar(300)
  cityId              Int     @default(0) @map("city_id")
  // ---------- 评价 / 结算 ----------
  reviewed            Boolean @default(false)
  signedAt            DateTime? @map("signed_at")
  /// NONE/SETTLING/SETTLED/REVERSED（分账在 P2，状态先留位）
  settlementStatus    String  @default("NONE") @map("settlement_status") @db.VarChar(16)
  settleableAt        DateTime? @map("settleable_at")
  // ---------- 加钟 ----------
  isAddon             Boolean @default(false) @map("is_addon")
  parentOrderId       Int     @default(0) @map("parent_order_id")
  addonCount          Int     @default(0) @map("addon_count")
  ownerRemark         String  @default("") @map("owner_remark") @db.VarChar(300)
  customerRemark      String  @default("") @map("customer_remark") @db.VarChar(300)
  createdIp           String  @default("") @map("created_ip") @db.VarChar(64)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, createdAt])
  @@index([shopId, staffId, startAt])
  @@index([customerId, createdAt])
  @@index([shopId, payStatus, expireAt])
  @@map("onsite_orders")
}

/// 订单服务明细（下单快照）：支持一单多服务、按份数部分退。
model OnsiteOrderItem {
  id                Int      @id @default(autoincrement())
  orderId           Int      @map("order_id")
  shopId            Int      @map("shop_id")
  serviceId         Int      @map("service_id")
  title             String   @db.VarChar(120)
  coverImage        String   @default("") @map("cover_image") @db.VarChar(500)
  unitPrice         Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  quantity          Int      @default(1)
  durationMinutes   Int      @default(0) @map("duration_minutes")
  materialFee       Decimal  @default(0) @map("material_fee") @db.Decimal(12, 2)
  couponDiscount    Decimal  @default(0) @map("coupon_discount") @db.Decimal(12, 2)
  payAmount         Decimal  @default(0) @map("pay_amount") @db.Decimal(12, 2)
  refundableQuantity Int     @default(0) @map("refundable_quantity")
  refundedQuantity  Int      @default(0) @map("refunded_quantity")
  refundedAmount    Decimal  @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  trueDurationMinutes Int    @default(0) @map("true_duration_minutes")
  addonEnabled      Boolean  @default(false) @map("addon_enabled")
  reviewed          Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([shopId, serviceId])
  @@map("onsite_order_items")
}

/// 订单地址快照 + 技师位置快照（车费算距的锚点，改地址不影响历史单）。
model OnsiteOrderAddress {
  id          Int     @id @default(autoincrement())
  orderId     Int     @map("order_id")
  shopId      Int     @map("shop_id")
  contactName String  @default("") @map("contact_name") @db.VarChar(60)
  phone       String  @default("") @db.VarChar(32)
  province    String  @default("") @db.VarChar(60)
  city        String  @default("") @db.VarChar(60)
  district    String  @default("") @db.VarChar(60)
  detail      String  @default("") @db.VarChar(200)
  lng         Decimal @default(0) @db.Decimal(10, 6)
  lat         Decimal @default(0) @db.Decimal(10, 6)
  cityId      Int     @default(0) @map("city_id")
  staffLng    Decimal @default(0) @map("staff_lng") @db.Decimal(10, 6)
  staffLat    Decimal @default(0) @map("staff_lat") @db.Decimal(10, 6)
  staffAddress String @default("") @map("staff_address") @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([orderId])
  @@map("onsite_order_addresses")
}

/// 状态流水：每次迁移同事务写入（参考源码 order_control_log 的用途）。
model OnsiteOrderStatusLog {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  shopId       Int      @map("shop_id")
  fromStatus   String   @default("") @map("from_status") @db.VarChar(24)
  toStatus     String   @map("to_status") @db.VarChar(24)
  /// OWNER 店主 | STAFF 技师 | CUSTOMER 顾客 | PLATFORM_ADMIN 平台 | SYSTEM 定时任务
  operatorRole String   @default("SYSTEM") @map("operator_role") @db.VarChar(16)
  operatorId   String   @default("") @map("operator_id") @db.VarChar(64)
  action       String   @db.VarChar(32)
  content      String   @default("") @db.VarChar(500)
  images       Json     @default("[]")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@index([shopId, createdAt])
  @@map("onsite_order_status_logs")
}

/// 履约轨迹打点（阶段 + 坐标 + 照片），与状态流水分工：这里只记物理位置证据。
model OnsiteOrderTrack {
  id         Int      @id @default(autoincrement())
  orderId    Int      @map("order_id")
  shopId     Int      @map("shop_id")
  stage      String   @db.VarChar(24)
  lng        Decimal  @default(0) @db.Decimal(10, 6)
  lat        Decimal  @default(0) @db.Decimal(10, 6)
  address    String   @default("") @db.VarChar(200)
  image      String   @default("") @db.VarChar(500)
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([orderId, recordedAt])
  @@map("onsite_order_tracks")
}

/// 收款台账：一单可能有多次收款（原单 + 加钟），退款上限从这里取可退余额。
model OnsiteOrderPriceFlow {
  id               Int      @id @default(autoincrement())
  orderId          Int      @map("order_id")
  shopId           Int      @map("shop_id")
  flowNo           String   @unique @map("flow_no") @db.VarChar(40)
  /// ORDER 原单 | ADDON 加钟 | OFFLINE 线下登记
  type             String   @default("ORDER") @db.VarChar(12)
  amount           Decimal  @default(0) @db.Decimal(12, 2)
  refundableAmount Decimal  @default(0) @map("refundable_amount") @db.Decimal(12, 2)
  transactionId    String   @default("") @map("transaction_id") @db.VarChar(64)
  paidAt           DateTime? @map("paid_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("onsite_order_price_flows")
}

/// 完工手写签名（参考源码 order_list_data.sign_img）：服务完成与「客户已确认」的凭证。
model OnsiteOrderSignature {
  id             Int      @id @default(autoincrement())
  orderId        Int      @unique @map("order_id")
  shopId         Int      @map("shop_id")
  signatureImage String   @default("") @map("signature_image") @db.VarChar(500)
  signedAt       DateTime @default(now()) @map("signed_at")
  /// CUSTOMER 顾客签 | STAFF 技师代传
  confirmedBy    String   @default("CUSTOMER") @map("confirmed_by") @db.VarChar(16)

  @@map("onsite_order_signatures")
}

/// 加钟子单：挂在主单之上，占用继续参与排期判定。
model OnsiteAddonOrder {
  id              Int      @id @default(autoincrement())
  shopId          Int      @map("shop_id")
  orderId         Int      @map("order_id")
  orderItemId     Int      @default(0) @map("order_item_id")
  customerId      Int      @map("customer_id")
  staffId         Int      @map("staff_id")
  quantity        Int      @default(1)
  durationMinutes Int      @default(0) @map("duration_minutes")
  amount          Decimal  @default(0) @db.Decimal(12, 2)
  payAmount       Decimal  @default(0) @map("pay_amount") @db.Decimal(12, 2)
  payType         String   @default("WECHAT") @map("pay_type") @db.VarChar(12)
  status          String   @default("PENDING_PAYMENT") @db.VarChar(24)
  payStatus       String   @default("UNPAID") @map("pay_status") @db.VarChar(16)
  transactionId   String   @default("") @map("transaction_id") @db.VarChar(64)
  prepayId        String   @default("") @map("prepay_id") @db.VarChar(64)
  expireAt        DateTime? @map("expire_at")
  paidAt          DateTime? @map("paid_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([shopId, status])
  @@map("onsite_addon_orders")
}

/// 换技师留痕（参考源码合并 order_coach_change_log / _logs 两张同义表）。
model OnsiteStaffChange {
  id                Int      @id @default(autoincrement())
  shopId            Int      @map("shop_id")
  orderId           Int      @map("order_id")
  fromStaffId       Int      @map("from_staff_id")
  toStaffId         Int      @map("to_staff_id")
  fromStaffName     String   @default("") @map("from_staff_name") @db.VarChar(60)
  toStaffName       String   @default("") @map("to_staff_name") @db.VarChar(60)
  fromStaffPhone    String   @default("") @map("from_staff_phone") @db.VarChar(32)
  toStaffPhone      String   @default("") @map("to_staff_phone") @db.VarChar(32)
  firstStaffId      Int      @default(0) @map("first_staff_id")
  travelFeeDelta    Decimal  @default(0) @map("travel_fee_delta") @db.Decimal(12, 2)
  travelFeeSettled  Boolean  @default(false) @map("travel_fee_settled")
  originalStartAt   DateTime? @map("original_start_at")
  originalEndAt     DateTime? @map("original_end_at")
  status            String   @default("DONE") @db.VarChar(16)
  remark            String   @default("") @db.VarChar(200)
  operatorRole      String   @default("OWNER") @map("operator_role") @db.VarChar(16)
  operatorId        String   @default("") @map("operator_id") @db.VarChar(64)
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([shopId, toStaffId])
  @@map("onsite_staff_changes")
}

/// 退款单：金额可整单申请，也可按明细行退（源码 refund_order_goods 想做的事在这里做实）。
model OnsiteRefund {
  id                  Int      @id @default(autoincrement())
  shopId              Int      @map("shop_id")
  refundNo            String   @unique @map("refund_no") @db.VarChar(40)
  orderId             Int      @map("order_id")
  customerId          Int      @default(0) @map("customer_id")
  staffId             Int      @default(0) @map("staff_id")
  applyAmount         Decimal  @default(0) @map("apply_amount") @db.Decimal(12, 2)
  refundAmount        Decimal  @default(0) @map("refund_amount") @db.Decimal(12, 2)
  reason              String   @default("") @db.VarChar(200)
  description         String   @default("") @db.Text
  evidenceImages      Json     @default("[]") @map("evidence_images")
  /// PENDING/AGREED/REJECTED/REFUNDED/CANCELLED
  status              String   @default("PENDING") @db.VarChar(16)
  auditRemark         String   @default("") @map("audit_remark") @db.VarChar(300)
  refundTransactionId String   @default("") @map("refund_transaction_id") @db.VarChar(64)
  durationMinutes     Int      @default(0) @map("duration_minutes")
  travelFee           Decimal  @default(0) @map("travel_fee") @db.Decimal(12, 2)
  materialFee         Decimal  @default(0) @map("material_fee") @db.Decimal(12, 2)
  auditedAt           DateTime? @map("audited_at")
  refundedAt          DateTime? @map("refunded_at")
  cancelledAt         DateTime? @map("cancelled_at")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([shopId, status, createdAt])
  @@index([orderId])
  @@map("onsite_refunds")
}

/// 退款明细行：按服务份数与金额拆分，退完的可退数量回写订单明细。
model OnsiteRefundItem {
  id          Int      @id @default(autoincrement())
  refundId    Int      @map("refund_id")
  orderId     Int      @map("order_id")
  orderItemId Int      @map("order_item_id")
  shopId      Int      @map("shop_id")
  quantity    Int      @default(0)
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  materialFee Decimal  @default(0) @map("material_fee") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([refundId])
  @@index([orderItemId])
  @@map("onsite_refund_items")
}

/// 顾客评价：总分 + 分项 + 标签词 + 匿名；一单一评（加钟不重复开评）。
model OnsiteReview {
  id            Int      @id @default(autoincrement())
  shopId        Int      @map("shop_id")
  orderId       Int      @unique @map("order_id")
  customerId    Int      @map("customer_id")
  staffId       Int      @default(0) @map("staff_id")
  rating        Int      @default(5) @db.TinyInt
  serviceRating Int      @default(5) @map("service_rating") @db.TinyInt
  attitudeRating Int     @default(5) @map("attitude_rating") @db.TinyInt
  tags          Json     @default("[]")
  content       String   @default("") @db.Text
  images        Json     @default("[]")
  anonymous     Boolean  @default(false)
  /// PENDING 待审核 | PUBLISHED 已展示 | HIDDEN 店主隐藏
  status        String   @default("PUBLISHED") @db.VarChar(16)
  reply         String   @default("") @db.Text
  repliedAt     DateTime? @map("replied_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([shopId, status, createdAt])
  @@index([staffId, status])
  @@map("onsite_reviews")
}

/// 评价按服务打分的明细行（参考源码 comment_goods）。
model OnsiteReviewItem {
  id        Int    @id @default(autoincrement())
  reviewId  Int    @map("review_id")
  shopId    Int    @map("shop_id")
  serviceId Int    @map("service_id")
  title     String @default("") @db.VarChar(120)
  rating    Int    @default(5) @db.TinyInt

  @@index([reviewId])
  @@map("onsite_review_items")
}

/// 差评申诉：技师对低分评价提出异议，店主处理后回复留痕。
model OnsiteReviewAppeal {
  id         Int      @id @default(autoincrement())
  shopId     Int      @map("shop_id")
  reviewId   Int      @map("review_id")
  orderId    Int      @default(0) @map("order_id")
  staffId    Int      @default(0) @map("staff_id")
  reason     String   @default("") @db.VarChar(300)
  images     Json     @default("[]")
  /// PENDING/ACCEPTED/REJECTED
  status     String   @default("PENDING") @db.VarChar(16)
  reply      String   @default("") @db.VarChar(300)
  handledBy  String   @default("") @map("handled_by") @db.VarChar(64)
  handledAt  DateTime? @map("handled_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([shopId, status, createdAt])
  @@index([reviewId])
  @@map("onsite_review_appeals")
}

/// 服务人员问题反馈（与申诉分开：申诉针对评价，反馈是通用问题上报）。
model OnsiteFeedback {
  id         Int      @id @default(autoincrement())
  shopId     Int      @map("shop_id")
  customerId Int      @default(0) @map("customer_id")
  staffId    Int      @default(0) @map("staff_id")
  orderId    Int      @default(0) @map("order_id")
  category   String   @default("其他") @db.VarChar(40)
  content    String   @db.Text
  images     Json     @default("[]")
  video      String   @default("") @db.VarChar(500)
  status     String   @default("PENDING") @db.VarChar(16)
  reply      String   @default("") @db.VarChar(300)
  handledBy  String   @default("") @map("handled_by") @db.VarChar(64)
  handledAt  DateTime? @map("handled_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([shopId, status, createdAt])
  @@map("onsite_feedbacks")
}

/// 一键报警：上门服务的人身安全兜底，位置与处理状态必须留痕。
model OnsiteAlert {
  id           Int      @id @default(autoincrement())
  shopId       Int      @map("shop_id")
  staffId      Int      @default(0) @map("staff_id")
  customerId   Int      @default(0) @map("customer_id")
  orderId      Int      @default(0) @map("order_id")
  lng          Decimal  @default(0) @db.Decimal(10, 6)
  lat          Decimal  @default(0) @db.Decimal(10, 6)
  address      String   @default("") @db.VarChar(200)
  content      String   @default("") @db.VarChar(300)
  audioUrl     String   @default("") @map("audio_url") @db.VarChar(500)
  /// 已通知的电话与站内名单（发过什么留痕，事后能说清责任）
  notifyPhones Json     @default("[]") @map("notify_phones")
  notifyUsers  Json     @default("[]") @map("notify_users")
  notifyResult String   @default("") @map("notify_result") @db.VarChar(300)
  /// PENDING/PROCESSING/RESOLVED/MISFIRE
  status       String   @default("PENDING") @db.VarChar(16)
  handledBy    String   @default("") @map("handled_by") @db.VarChar(64)
  handleRemark String   @default("") @map("handle_remark") @db.VarChar(300)
  handledAt    DateTime? @map("handled_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([shopId, status, createdAt])
  @@index([staffId])
  @@map("onsite_alerts")
}


/// 顾客服务地址（一店一套）。cityId 决定命中哪条车费规则；lng/lat 缺失时算价降级为兜底车费。
model OnsiteCustomerAddress {
  id          Int      @id @default(autoincrement())
  shopId      Int      @map("shop_id")
  customerId  Int      @map("customer_id")
  contactName String   @default("") @map("contact_name") @db.VarChar(60)
  phone       String   @db.VarChar(32)
  province    String   @default("") @db.VarChar(60)
  city        String   @default("") @db.VarChar(60)
  district    String   @default("") @db.VarChar(60)
  detail      String   @default("") @db.VarChar(200)
  lng         Decimal  @default(0) @db.Decimal(10, 6)
  lat         Decimal  @default(0) @db.Decimal(10, 6)
  cityId      Int      @default(0) @map("city_id")
  tag         String   @default("") @db.VarChar(20)
  isDefault   Boolean  @default(false) @map("is_default")
  isTop       Boolean  @default(false) @map("is_top")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([shopId, customerId])
  @@map("onsite_customer_addresses")
}

// ============================================================================
// 上门服务小程序工具 P2 第一批：分销体系 / 分账引擎 / 结算与提现
// （docs/私域小程序·上门服务小程序工具设计方案.md §4.2、§5.4）
//
// 佣金口径（不得改成"支付后才算佣"）：下单预生成 PENDING → 支付生效 ACTIVE →
// 退款按行按比例冲销 REVERSED。承担方拆分：佣金按 totalRate 从技师收入与店主收入
// 里按 staffBorneRate / ownerBorneRate 扣，平台承担比例默认 0，平台不为佣金垫钱。
// 金额一律 DECIMAL(12,2)，服务层按「分」做整数运算。
// ============================================================================

/// 分销商档案：顾客在小程序内申请，店主审核；rate 为个人覆盖比例（0 = 用规则表）。
model OnsiteDistributorProfile {
  id           Int      @id @default(autoincrement())
  shopId       Int      @map("shop_id")
  customerId   Int      @map("customer_id")
  realName     String   @default("") @map("real_name") @db.VarChar(60)
  phone        String   @default("") @db.VarChar(32)
  levelName    String   @default("分销商") @map("level_name") @db.VarChar(40)
  /// 个人佣金比例（%），0 = 用规则表默认
  rate         Decimal  @default(0) @db.Decimal(5, 2)
  /// PENDING 待审核 | APPROVED 已通过 | REJECTED 已驳回 | DISABLED 已停用
  status       String   @default("PENDING") @db.VarChar(16)
  /// 上级分销商顾客 id（0 = 无上级）
  pid          Int      @default(0)
  rejectReason String   @default("") @map("reject_reason") @db.VarChar(200)
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([shopId, customerId])
  @@index([shopId, status])
  @@map("onsite_distributor_profiles")
}

/// 代理账号：省/市/区县代，一条链路父级靠 parentId；不建独立账号体系，代理人为店主录入。
model OnsiteAgentAccount {
  id             Int      @id @default(autoincrement())
  shopId         Int      @map("shop_id")
  /// PROVINCE 省代 | CITY 市代 | DISTRICT 区县代
  agentType      String   @default("CITY") @map("agent_type") @db.VarChar(12)
  name           String   @db.VarChar(60)
  phone          String   @default("") @db.VarChar(32)
  provinceCode   String   @default("") @map("province_code") @db.VarChar(20)
  cityCode       String   @default("") @map("city_code") @db.VarChar(20)
  areaCode       String   @default("") @map("area_code") @db.VarChar(20)
  commissionRate Decimal  @default(0) @map("commission_rate") @db.Decimal(5, 2)
  parentId       Int      @default(0) @map("parent_id")
  /// ACTIVE 正常 | DISABLED 已停用
  status         String   @default("ACTIVE") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([shopId, agentType, status])
  @@index([shopId, parentId])
  @@map("onsite_agent_accounts")
}

/// 业务员：挂在一个代理（agentId）下，可带小区/片区备注。
model OnsiteSalesman {
  id         Int      @id @default(autoincrement())
  shopId     Int      @map("shop_id")
  agentId    Int      @default(0) @map("agent_id")
  name       String   @db.VarChar(60)
  phone      String   @default("") @db.VarChar(32)
  area       String   @default("") @db.VarChar(120)
  rate       Decimal  @default(0) @db.Decimal(5, 2)
  /// ACTIVE 正常 | DISABLED 已停用
  status     String   @default("ACTIVE") @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([shopId, agentId, status])
  @@map("onsite_salesmen")
}

/// 渠道分类（门店/异业/社群等），渠道商按分类归组。
model OnsiteChannelCategory {
  id         Int      @id @default(autoincrement())
  shopId     Int      @map("shop_id")
  name       String   @db.VarChar(40)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([shopId, sortOrder])
  @@map("onsite_channel_categories")
}

/// 渠道商：带渠道码绑定顾客（onsite_relations.channelId）。
model OnsiteChannel {
  id         Int      @id @default(autoincrement())
  shopId     Int      @map("shop_id")
  categoryId Int      @default(0) @map("category_id")
  name       String   @db.VarChar(80)
  contact    String   @default("") @db.VarChar(60)
  phone      String   @default("") @db.VarChar(32)
  rate       Decimal  @default(0) @db.Decimal(5, 2)
  /// ACTIVE 正常 | DISABLED 已停用
  status     String   @default("ACTIVE") @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([shopId, categoryId, status])
  @@map("onsite_channels")
}

/// 技师合伙人：技师参与邀请充值/带教时的身份，rate 覆盖规则表默认。
model OnsitePartner {
  id         Int      @id @default(autoincrement())
  shopId     Int      @map("shop_id")
  staffId    Int      @map("staff_id")
  name       String   @default("") @db.VarChar(60)
  rate       Decimal  @default(0) @db.Decimal(5, 2)
  /// ACTIVE 正常 | DISABLED 已停用
  status     String   @default("ACTIVE") @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([shopId, staffId])
  @@map("onsite_partners")
}

/// 扫码/链接绑定关系：顾客归属哪个上级顾客/渠道/业务员/代理，带有效期。
/// 同一顾客可有多条历史，取最新未过期一条生效（下单预生成佣金时读取）。
model OnsiteRelation {
  id           Int      @id @default(autoincrement())
  shopId       Int      @map("shop_id")
  customerId   Int      @map("customer_id")
  pid          Int      @default(0)
  channelId    Int      @default(0) @map("channel_id")
  salesmanId   Int      @default(0) @map("salesman_id")
  agentId      Int      @default(0) @map("agent_id")
  /// QR 扫码 | LINK 链接 | MANUAL 后台绑定
  source       String   @default("QR") @db.VarChar(12)
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([shopId, customerId, createdAt])
  @@index([shopId, channelId])
  @@map("onsite_relations")
}

/// 佣金规则矩阵：层级 × 承担方。一条规则＝一类角色拿 totalRate，
/// 其中 staffBorneRate / ownerBorneRate / platformBorneRate 是这笔佣金的出资构成。
model OnsiteCommissionRule {
  id                Int      @id @default(autoincrement())
  shopId            Int      @map("shop_id")
  /// DISTRIBUTOR 分销商 | SALESMAN 业务员 | CHANNEL 渠道商 | PARTNER 合伙人 | AGENT 代理 | TECH_INVITE 技师邀请充值
  role              String   @db.VarChar(20)
  totalRate         Decimal  @default(10) @map("total_rate") @db.Decimal(5, 2)
  staffBorneRate    Decimal  @default(50) @map("staff_borne_rate") @db.Decimal(5, 2)
  ownerBorneRate    Decimal  @default(50) @map("owner_borne_rate") @db.Decimal(5, 2)
  platformBorneRate Decimal  @default(0) @map("platform_borne_rate") @db.Decimal(5, 2)
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([shopId, role])
  @@map("onsite_commission_rules")
}

/// 订单佣金总表：一单一行，下单预生成 PENDING，支付生效 ACTIVE，全额退后 REVERSED。
model OnsiteOrderCommission {
  id          Int      @id @default(autoincrement())
  shopId      Int      @map("shop_id")
  orderId     Int      @unique @map("order_id")
  orderNo     String   @default("") @map("order_no") @db.VarChar(40)
  customerId  Int      @default(0) @map("customer_id")
  /// PENDING 下单预生成 | ACTIVE 已生效 | REVERSED 已全额冲销
  status      String   @default("PENDING") @db.VarChar(16)
  baseAmount  Decimal  @default(0) @map("base_amount") @db.Decimal(12, 2)
  totalAmount Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  itemCount   Int      @default(0) @map("item_count")
  paidAt      DateTime? @map("paid_at")
  reversedAt  DateTime? @map("reversed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, createdAt])
  @@index([shopId, customerId])
  @@map("onsite_order_commissions")
}

/// 佣金明细：订单行 × 层级角色。sourceId 是该角色的业务主体 id
/// （分销商=顾客 id / 业务员 / 渠道 / 合伙人=技师 id / 代理）。
model OnsiteOrderCommissionItem {
  id                 Int      @id @default(autoincrement())
  commissionId       Int      @map("commission_id")
  shopId             Int      @map("shop_id")
  orderId            Int      @map("order_id")
  orderItemId        Int      @map("order_item_id")
  serviceId          Int      @default(0) @map("service_id")
  sourceRole         String   @map("source_role") @db.VarChar(20)
  sourceId           Int      @default(0) @map("source_id")
  totalRate          Decimal  @default(0) @map("total_rate") @db.Decimal(5, 2)
  staffBorneRate     Decimal  @default(0) @map("staff_borne_rate") @db.Decimal(5, 2)
  ownerBorneRate     Decimal  @default(0) @map("owner_borne_rate") @db.Decimal(5, 2)
  platformBorneRate  Decimal  @default(0) @map("platform_borne_rate") @db.Decimal(5, 2)
  baseAmount         Decimal  @default(0) @map("base_amount") @db.Decimal(12, 2)
  totalAmount        Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  staffBorneAmount   Decimal  @default(0) @map("staff_borne_amount") @db.Decimal(12, 2)
  ownerBorneAmount   Decimal  @default(0) @map("owner_borne_amount") @db.Decimal(12, 2)
  platformBorneAmount Decimal @default(0) @map("platform_borne_amount") @db.Decimal(12, 2)
  /// ACTIVE 生效 | REVERSED 已冲销
  status             String   @default("PENDING") @db.VarChar(16)
  reversedAmount     Decimal  @default(0) @map("reversed_amount") @db.Decimal(12, 2)
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([shopId, commissionId])
  @@index([shopId, sourceRole, sourceId, status])
  @@index([orderItemId])
  @@map("onsite_order_commission_items")
}

/// 承担方拆分表：谁为这笔佣金出钱（技师 / 代理 / 平台），用于结算单与对账。
model OnsiteOrderCommissionShare {
  id            Int      @id @default(autoincrement())
  commissionId  Int      @map("commission_id")
  shopId        Int      @map("shop_id")
  orderId       Int      @map("order_id")
  /// STAFF 技师承担 | AGENT 代理承担 | PLATFORM 平台承担
  bearerRole    String   @map("bearer_role") @db.VarChar(12)
  bearerId      Int      @default(0) @map("bearer_id")
  amount        Decimal  @default(0) @db.Decimal(12, 2)
  /// ACTIVE 生效 | REVERSED 已冲销
  status        String   @default("PENDING") @db.VarChar(16)
  reversedAmount Decimal @default(0) @map("reversed_amount") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([shopId, commissionId])
  @@index([shopId, bearerRole, bearerId, status])
  @@map("onsite_order_commission_shares")
}

/// 技师结算单：按周期汇总服务费、佣金扣减与净额，状态推进后写提现。
model OnsiteSettlement {
  id             Int      @id @default(autoincrement())
  shopId         Int      @map("shop_id")
  staffId        Int      @map("staff_id")
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  orderCount     Int      @default(0) @map("order_count")
  grossAmount    Decimal  @default(0) @map("gross_amount") @db.Decimal(12, 2)
  commissionAmount Decimal @default(0) @map("commission_amount") @db.Decimal(12, 2)
  netAmount      Decimal  @default(0) @map("net_amount") @db.Decimal(12, 2)
  /// PENDING 待发放 | PAID 已发放 | REVERSED 已回滚
  status         String   @default("PENDING") @db.VarChar(16)
  paidAt         DateTime? @map("paid_at")
  remark         String   @default("") @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([shopId, staffId, periodStart, periodEnd])
  @@index([shopId, status, periodEnd])
  @@map("onsite_settlements")
}

/// 提现单：四种处理动作（通过并打款 / 驳回 / 线下已付 / 撤销）由 status 推进。
model OnsiteWithdrawal {
  id           Int      @id @default(autoincrement())
  shopId       Int      @map("shop_id")
  /// STAFF 技师 | AGENT 代理 | DISTRIBUTOR 分销商 | PARTNER 合伙人
  ownerType    String   @map("owner_type") @db.VarChar(16)
  ownerId      Int      @map("owner_id")
  amount       Decimal  @default(0) @db.Decimal(12, 2)
  taxRate      Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount    Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  actualAmount Decimal  @default(0) @map("actual_amount") @db.Decimal(12, 2)
  /// WECHAT 微信零钱 | ALIPAY 支付宝 | OFFLINE 线下转账
  method       String   @default("WECHAT") @db.VarChar(12)
  /// 收款信息快照（账号掩码、开户名等），不存明文密钥
  payInfo      Json     @default("{}") @map("pay_info")
  /// PENDING 待处理 | APPROVED 已通过待打款 | PAID 已打款 | REJECTED 已驳回 | CANCELLED 已撤销
  status       String   @default("PENDING") @db.VarChar(16)
  rejectReason String   @default("") @map("reject_reason") @db.VarChar(200)
  transactionId String  @default("") @map("transaction_id") @db.VarChar(64)
  handledBy    String   @default("") @map("handled_by") @db.VarChar(64)
  handledAt    DateTime? @map("handled_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, createdAt])
  @@index([shopId, ownerType, ownerId])
  @@map("onsite_withdrawals")
}

// ============================================================================
// 上门服务小程序工具 P2 第二批：充值卡 / 余额 / 积分 / 卡券 / 邀请有礼
// 余额与积分只在本店 C 端顾客域内流转（onsite_customers.balance/points），
// 与站内 AWcoin 物理隔离；余额流水必须复式（before/after 连续可对账）。
// ============================================================================

/// 充值卡（储值卡模板）：面值 = 实付 + 赠送。
model OnsiteBalanceCard {
  id           Int      @id @default(autoincrement())
  shopId       Int      @map("shop_id")
  name         String   @db.VarChar(60)
  faceAmount   Decimal  @default(0) @map("face_amount") @db.Decimal(12, 2)
  giftAmount   Decimal  @default(0) @map("gift_amount") @db.Decimal(12, 2)
  price        Decimal  @default(0) @db.Decimal(12, 2)
  validityDays Int      @default(0) @map("validity_days")
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([shopId, enabled, sortOrder])
  @@map("onsite_balance_cards")
}

/// 充值单：支付成功后落余额并写余额流水（复式）。
model OnsiteRechargeOrder {
  id            Int      @id @default(autoincrement())
  shopId        Int      @map("shop_id")
  customerId    Int      @map("customer_id")
  orderNo       String   @unique @map("order_no") @db.VarChar(40)
  cardId        Int      @default(0) @map("card_id")
  amount        Decimal  @default(0) @db.Decimal(12, 2)
  giftAmount    Decimal  @default(0) @map("gift_amount") @db.Decimal(12, 2)
  totalAmount   Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  /// UNPAID 待支付 | PAID 已支付 | CANCELLED 已取消 | EXPIRED 已超时
  status        String   @default("UNPAID") @db.VarChar(16)
  payType       String   @default("WECHAT") @map("pay_type") @db.VarChar(12)
  transactionId String   @default("") @map("transaction_id") @db.VarChar(64)
  paidAt        DateTime? @map("paid_at")
  expireAt      DateTime? @map("expire_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([shopId, customerId, createdAt])
  @@index([shopId, status, expireAt])
  @@map("onsite_recharge_orders")
}

/// 余额流水（复式）：每笔都带 before/after，任何时刻 after 必须等于下一条的 before。
model OnsiteBalanceFlow {
  id               Int      @id @default(autoincrement())
  shopId           Int      @map("shop_id")
  customerId       Int      @map("customer_id")
  /// RECHARGE 充值 | CONSUME 下单抵扣 | REFUND 退款回充 | ADJUST 店主调整 | INVITE 邀请奖励
  type             String   @db.VarChar(16)
  changeAmount     Decimal  @default(0) @map("change_amount") @db.Decimal(12, 2)
  beforeBalance    Decimal  @default(0) @map("before_balance") @db.Decimal(12, 2)
  afterBalance     Decimal  @default(0) @map("after_balance") @db.Decimal(12, 2)
  relatedOrderId   Int      @default(0) @map("related_order_id")
  relatedRechargeId Int     @default(0) @map("related_recharge_id")
  remark           String   @default("") @db.VarChar(200)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([shopId, customerId, id])
  @@map("onsite_balance_flows")
}

/// 积分流水（复式口径同余额）。
model OnsitePointFlow {
  id             Int      @id @default(autoincrement())
  shopId         Int      @map("shop_id")
  customerId     Int      @map("customer_id")
  /// ORDER 消费返积分 | REFUND 退款扣回 | ADJUST 店主调整 | INVITE 邀请奖励
  type           String   @db.VarChar(16)
  changePoints   Int      @default(0) @map("change_points")
  beforePoints   Int      @default(0) @map("before_points")
  afterPoints    Int      @default(0) @map("after_points")
  relatedOrderId Int      @default(0) @map("related_order_id")
  remark         String   @default("") @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([shopId, customerId, id])
  @@map("onsite_point_flows")
}

/// 优惠券模板：满减 / 折扣 / 新客专享；适用范围由 onsite_coupon_scope_links 指定。
model OnsiteCoupon {
  id             Int      @id @default(autoincrement())
  shopId         Int      @map("shop_id")
  name           String   @db.VarChar(60)
  /// FULL_REDUCTION 满减 | DISCOUNT 折扣 | NEW_USER 新客券
  type           String   @default("FULL_REDUCTION") @db.VarChar(16)
  thresholdAmount Decimal @default(0) @map("threshold_amount") @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  /// 折扣率（%）：90 = 9 折，仅 DISCOUNT 使用
  discountRate   Decimal  @default(0) @map("discount_rate") @db.Decimal(5, 2)
  newUserOnly    Boolean  @default(false) @map("new_user_only")
  totalQuantity  Int      @default(0) @map("total_quantity")
  issuedCount    Int      @default(0) @map("issued_count")
  perLimit       Int      @default(1) @map("per_limit")
  /// ALL 全场 | CATEGORY 指定分类 | SERVICE 指定服务
  scope          String   @default("ALL") @db.VarChar(12)
  validStartAt   DateTime? @map("valid_start_at")
  validEndAt     DateTime? @map("valid_end_at")
  /// ON 启用 | OFF 停用
  status         String   @default("ON") @db.VarChar(8)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, createdAt])
  @@map("onsite_coupons")
}

/// 券的适用范围：分类或服务 id（scope=CATEGORY/SERVICE 时生效）。
model OnsiteCouponScopeLink {
  id         Int      @id @default(autoincrement())
  shopId     Int      @map("shop_id")
  couponId   Int      @map("coupon_id")
  /// CATEGORY | SERVICE
  scopeType  String   @map("scope_type") @db.VarChar(12)
  targetId   Int      @map("target_id")

  @@index([shopId, couponId])
  @@map("onsite_coupon_scope_links")
}

/// 券票：领到顾客名下的实例，核销时绑定订单。
model OnsiteCouponTicket {
  id          Int      @id @default(autoincrement())
  shopId      Int      @map("shop_id")
  couponId    Int      @map("coupon_id")
  customerId  Int      @map("customer_id")
  code        String   @unique @db.VarChar(32)
  /// UNUSED 未用 | USED 已用 | EXPIRED 已过期 | VOID 已作废
  status      String   @default("UNUSED") @db.VarChar(12)
  usedOrderId Int      @default(0) @map("used_order_id")
  usedAt      DateTime? @map("used_at")
  expireAt    DateTime? @map("expire_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([shopId, customerId, status])
  @@index([shopId, couponId])
  @@map("onsite_coupon_tickets")
}

/// 营销活动（P2 只有邀请有礼）：奖励余额/积分/券。
model OnsiteActivity {
  id          Int      @id @default(autoincrement())
  shopId      Int      @map("shop_id")
  /// INVITE 邀请有礼
  type        String   @default("INVITE") @db.VarChar(16)
  name        String   @db.VarChar(60)
  /// BALANCE 余额 | POINTS 积分 | COUPON 优惠券
  rewardType  String   @default("BALANCE") @map("reward_type") @db.VarChar(12)
  rewardValue Decimal  @default(0) @map("reward_value") @db.Decimal(12, 2)
  couponId    Int      @default(0) @map("coupon_id")
  startAt     DateTime? @map("start_at")
  endAt       DateTime? @map("end_at")
  /// ON 启用 | OFF 停用
  status      String   @default("ON") @db.VarChar(8)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([shopId, type, status])
  @@map("onsite_activities")
}

/// 活动记录：邀请人与被邀请人成对留痕，奖励一次（唯一键防刷）。
model OnsiteActivityRecord {
  id                 Int      @id @default(autoincrement())
  shopId             Int      @map("shop_id")
  activityId         Int      @map("activity_id")
  inviterCustomerId  Int      @map("inviter_customer_id")
  inviteeCustomerId  Int      @map("invitee_customer_id")
  /// PENDING 待发放 | REWARDED 已发放 | REJECTED 已驳回
  status             String   @default("PENDING") @db.VarChar(12)
  rewardAmount       Decimal  @default(0) @map("reward_amount") @db.Decimal(12, 2)
  rewardedAt         DateTime? @map("rewarded_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([activityId, inviteeCustomerId])
  @@index([shopId, inviterCustomerId])
  @@map("onsite_activity_records")
}

/// 邀请码：每个邀请人在每个活动一个码，扫码/输入码建立绑定关系。
model OnsiteActivityInvite {
  id                Int      @id @default(autoincrement())
  shopId            Int      @map("shop_id")
  activityId        Int      @map("activity_id")
  inviterCustomerId Int      @map("inviter_customer_id")
  code              String   @unique @db.VarChar(32)
  inviteCount       Int      @default(0) @map("invite_count")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([activityId, inviterCustomerId])
  @@map("onsite_activity_invites")
}

// =====================================================================
// 建站管理 · 卡密商城小程序工具（设计见 docs/建站管理·卡密商城小程序工具设计方案.md）
//
// 两层租户：本站用户＝店主（ownerUserId + siteId 归属），C 端买家归站点
// （card_shop_customers），与站内 User 物理隔离。收款走店主自己的微信支付
// 商户号（凭据在 miniprogram_apps，scene='CARD_SHOP'），平台不经手资金，
// 因此本域没有资金账本与提现链路。在线客服复用系统 AI 客服（service-desk），
// 站点只存绑定的 deskSiteKey，不建任何会话表。
// 金额一律 DECIMAL(18, 2)，服务层按「分」做整数运算。
// =====================================================================

/// 卡密商城站点：默认一人一站，配额由平台侧 card_shop_platform_settings 控制。
/// 微信凭据与出包台账不在本域建表，走 miniprogram_apps /
/// miniprogram_tenant_releases（scene='CARD_SHOP' + shopId=站点 id）。
model CardShopSite {
  id               Int      @id @default(autoincrement())
  /// 归属账号（本站用户＝店主）
  ownerUserId      String   @map("owner_user_id") @db.VarChar(64)
  /// 企业档案 id（0 = 未绑定企业），与 BrandShop / GeoSite 同口径用于代客作业留痕
  enterpriseId     Int      @default(0) @map("enterprise_id")
  enterpriseUserId String   @default("") @map("enterprise_user_id") @db.VarChar(64)
  /// 公开寻址码：小程序 config.js 的 site 值，创建后不变
  siteCode         String   @unique @map("site_code") @db.VarChar(16)
  name             String   @db.VarChar(120)
  logo             String   @default("") @db.VarChar(500)
  slogan           String   @default("") @db.VarChar(200)
  themeColor       String   @default("#3370FF") @map("theme_color") @db.VarChar(16)
  /// 首页常驻滚动公告
  notice           String   @default("") @db.VarChar(500)
  /// 联系方式兜底 JSON：{ phone, qq, wechat, email }（未绑 AI 客服服务站时小程序展示它）
  serviceContact   Json     @default("{}") @map("service_contact")
  /// 在线客服：绑定的 AI 客服（service-desk）服务站 siteKey，空 = 不启用在线会话
  deskSiteKey      String   @default("") @map("desk_site_key") @db.VarChar(64)
  /// 模块显隐 JSON：indexBanner/indexNotice/indexHot/categoryPage/search/coupon/protocol/article/deskChat/contact/myOrders
  toggles          Json     @default("{}")
  /// ACTUAL 展示实际库存数 | RANGE 展示分段（充足/紧张/售罄）
  stockDisplayMode String   @default("RANGE") @map("stock_display_mode") @db.VarChar(16)
  /// 出卡顺序默认值：OLDEST 先卖老卡 | NEWEST 先卖新卡 | RANDOM 随机（商品可覆盖）
  cardOrderMode    String   @default("OLDEST") @map("card_order_mode") @db.VarChar(16)
  /// 未支付订单锁卡时长（分钟），到期由调度器放回库存
  lockMinutes      Int      @default(15) @map("lock_minutes")
  /// 购卡协议富文本（买家下单必须勾选）
  protocolText     String   @default("") @map("protocol_text") @db.MediumText
  /// DRAFT 未上线 | ONLINE 营业中 | SUSPENDED 平台停服 | CLOSED 已关闭
  status           String   @default("DRAFT") @db.VarChar(16)
  offBy            String   @default("") @map("off_by") @db.VarChar(64)
  offReason        String   @default("") @map("off_reason") @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, status])
  @@index([enterpriseId])
  @@map("card_shop_sites")
}

/// 商品分类（首页与小程序分类页按此分组，sort 大者靠前）。
model CardShopCategory {
  id        Int      @id @default(autoincrement())
  siteId    Int      @map("site_id")
  name      String   @db.VarChar(60)
  icon      String   @default("") @db.VarChar(500)
  remark    String   @default("") @db.VarChar(200)
  sort      Int      @default(0)
  status    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([siteId, status, sort])
  @@map("card_shop_categories")
}

/// 卡密商品：一个商品 = 一种卡的一池库存，价格与交易规则都挂商品上。
model CardShopProduct {
  id             Int      @id @default(autoincrement())
  siteId         Int      @map("site_id")
  categoryId     Int      @default(0) @map("category_id")
  name           String   @db.VarChar(200)
  subtitle       String   @default("") @db.VarChar(200)
  coverImage     String   @default("") @map("cover_image") @db.VarChar(500)
  images         Json     @default("[]")
  price          Decimal  @default(0) @db.Decimal(18, 2)
  /// 划线价（仅展示，可为 0 不显示）
  marketPrice    Decimal  @default(0) @map("market_price") @db.Decimal(18, 2)
  /// 批发阶梯价 JSON：[{ min, price }]，空数组 = 不启用
  wholesaleTiers Json     @default("[]") @map("wholesale_tiers")
  /// 起购数量（0 = 不限）
  limitQuantity  Int      @default(0) @map("limit_quantity")
  /// 单笔限购（0 = 不限）
  maxQuantity    Int      @default(0) @map("max_quantity")
  /// 库存预警阈值（0 = 不预警），低于阈值提示店主补卡
  stockWarn      Int      @default(0) @map("stock_warn")
  /// 是否允许使用优惠券
  couponEnabled  Boolean  @default(false) @map("coupon_enabled")
  /// 取卡密码：OFF 关闭 | REQUIRED 必填 | OPTIONAL 选填
  takeCardMode   String   @default("OFF") @map("take_card_mode") @db.VarChar(16)
  /// 访问密码密文（空 = 关闭），命中后按商品维度短时放行
  visitPassword  String   @default("") @map("visit_password") @db.VarChar(200)
  /// 买家必填联系方式：NONE | ANY | MOBILE | EMAIL | QQ
  contactMode    String   @default("ANY") @map("contact_mode") @db.VarChar(16)
  /// 售出通知 JSON：{ merchantStation, buyerEmail }
  notifyFlags    Json     @default("{}") @map("notify_flags")
  /// SINGLE 只有卡密 | PAIR 卡号 + 卡密
  cardFormat     String   @default("SINGLE") @map("card_format") @db.VarChar(16)
  intro          String   @default("") @db.VarChar(500)
  /// 图文详情（HTML）
  detail         String   @default("") @db.MediumText
  /// 使用说明（取卡后展示，如兑换入口与步骤）
  remark         String   @default("") @db.MediumText
  /// 出卡顺序覆盖站点默认：'' 跟随站点 | OLDEST | NEWEST | RANDOM
  cardOrderMode  String   @default("") @map("card_order_mode") @db.VarChar(16)
  hot            Boolean  @default(false)
  sort           Int      @default(0)
  viewCount      Int      @default(0) @map("view_count")
  soldCount      Int      @default(0) @map("sold_count")
  /// DRAFT 草稿 | OFFLINE 已下架 | ONLINE 销售中 | FROZEN 平台冻结
  status         String   @default("DRAFT") @db.VarChar(16)
  /// 软删时间（回收站），非空即不可售不可见
  trashedAt      DateTime? @map("trashed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([siteId, status, sort])
  @@index([siteId, categoryId, status])
  @@index([siteId, hot, status])
  @@index([siteId, trashedAt])
  @@map("card_shop_goods")
}

/// 卡密导入批次台账：按批统计与整批撤回的依据（口径统计在批次上，真值在 cards 上）。
model CardShopCardBatch {
  id              Int      @id @default(autoincrement())
  siteId          Int      @map("site_id")
  goodsId         Int      @map("goods_id")
  /// CSB + yyyyMMddHHmmss + 6 位随机，站点内唯一
  batchNo         String   @map("batch_no") @db.VarChar(40)
  /// TEXT 粘贴 | FILE 上传（txt/csv）
  source          String   @default("TEXT") @db.VarChar(16)
  /// 本次实际采用的分隔符（AUTO 识别结果也落这里）
  splitter        String   @default("") @db.VarChar(8)
  totalLines      Int      @default(0) @map("total_lines")
  importedCount   Int      @default(0) @map("imported_count")
  duplicatedCount Int      @default(0) @map("duplicated_count")
  invalidCount    Int      @default(0) @map("invalid_count")
  /// SEQUENTIAL 顺序 | SHUFFLE 乱序
  orderMode       String   @default("SEQUENTIAL") @map("order_mode") @db.VarChar(16)
  operator        String   @default("") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([siteId, batchNo], map: "card_shop_card_batches_site_batch_no_key")
  @@index([siteId, goodsId, createdAt])
  @@map("card_shop_card_batches")
}

/// 卡密本体。状态机：AVAILABLE 可售 → LOCKED 未支付占用 → SOLD 已售；
/// DISABLED 人工停用、VOID 作废（撤回批次时未售出的置此态，不物理删，保留取证）。
model CardShopCard {
  id           Int       @id @default(autoincrement())
  siteId       Int       @map("site_id")
  goodsId      Int       @map("goods_id")
  batchId      Int       @default(0) @map("batch_id")
  /// 卡号（cardFormat=SINGLE 时存空串）
  number       String    @default("") @db.VarChar(191)
  /// 卡密
  secret       String    @db.VarChar(191)
  remark       String    @default("") @db.VarChar(200)
  /// AVAILABLE | LOCKED | SOLD | DISABLED | VOID
  status       String    @default("AVAILABLE") @db.VarChar(16)
  /// 导入序号：OLDEST/NEWEST 出卡依据（同站点内递增）
  seq          Int       @default(0)
  /// 锁卡归属订单与到期时间（支付成功或关单后清空）
  lockOrderId  Int       @default(0) @map("lock_order_id")
  lockExpireAt DateTime? @map("lock_expire_at")
  soldOrderId  Int       @default(0) @map("sold_order_id")
  soldAt       DateTime? @map("sold_at")
  soldIp       String    @default("") @map("sold_ip") @db.VarChar(64)
  /// 软删时间（卡密回收站，可还原）
  trashedAt    DateTime? @map("trashed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([siteId, goodsId, status, seq])
  @@index([siteId, batchId])
  @@index([siteId, lockOrderId])
  @@index([siteId, lockExpireAt])
  @@index([siteId, trashedAt])
  @@map("card_shop_cards")
}

/// 订单：下单即锁卡，支付成功出货，超时/关闭释放。takeCardPasswordHash 只存摘要，
/// 明文永不落库、不进日志。
model CardShopOrder {
  id                   Int       @id @default(autoincrement())
  siteId               Int       @map("site_id")
  ownerUserId          String    @map("owner_user_id") @db.VarChar(64)
  /// CS + yyyyMMddHHmmss + 6 位随机
  orderNo              String    @map("order_no") @db.VarChar(40)
  goodsId              Int       @map("goods_id")
  goodsName            String    @default("") @map("goods_name") @db.VarChar(200)
  goodsCover           String    @default("") @map("goods_cover") @db.VarChar(500)
  cardFormat           String    @default("SINGLE") @map("card_format") @db.VarChar(16)
  unitPrice            Decimal   @default(0) @map("unit_price") @db.Decimal(18, 2)
  quantity             Int       @default(1)
  productAmount        Decimal   @default(0) @map("product_amount") @db.Decimal(18, 2)
  couponId             Int       @default(0) @map("coupon_id")
  discountAmount       Decimal   @default(0) @map("discount_amount") @db.Decimal(18, 2)
  /// 买家实付
  totalAmount          Decimal   @default(0) @map("total_amount") @db.Decimal(18, 2)
  notifyEmail          String    @default("") @db.VarChar(120)
  contact              String    @default("") @db.VarChar(120)
  takeCardPasswordHash String    @default("") @map("take_card_password_hash") @db.VarChar(120)
  /// PENDING 待支付 | PAID 已支付 | CLOSED 已关闭 | REFUNDED 已退款
  payState             String    @default("PENDING") @map("pay_state") @db.VarChar(16)
  transactionId        String    @default("") @map("transaction_id") @db.VarChar(64)
  prepayId             String    @default("") @map("prepay_id") @db.VarChar(64)
  paidAt               DateTime? @map("paid_at")
  closedAt             DateTime? @map("closed_at")
  refundedAt           DateTime? @map("refunded_at")
  /// 已出卡数量（等于 quantity 即出货完成）
  cardCount            Int       @default(0) @map("card_count")
  customerId           Int       @default(0) @map("customer_id")
  openid               String    @default("") @db.VarChar(64)
  createIp             String    @default("") @map("create_ip") @db.VarChar(64)
  failReason           String    @default("") @map("fail_reason") @db.VarChar(300)
  /// 锁卡到期时间（与 cards.lock_expire_at 一致，关单扫描用）
  expireAt             DateTime? @map("expire_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([siteId, orderNo], map: "card_shop_orders_site_order_no_key")
  @@index([siteId, payState, createdAt])
  @@index([siteId, contact])
  @@index([siteId, expireAt])
  @@index([customerId])
  @@map("card_shop_orders")
}

/// 订单出货快照：卡密内容复制一份，卡被删除或改密也不影响历史取证与重查。
model CardShopOrderCard {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  siteId    Int      @map("site_id")
  cardId    Int      @default(0) @map("card_id")
  number    String   @default("") @db.VarChar(191)
  secret    String   @db.VarChar(191)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId, sort])
  @@index([siteId, cardId])
  @@map("card_shop_order_cards")
}

/// 券码：一码一用。FIXED 减额（value 为元），PERCENT 折扣（value 为 1-99 的折让百分比）。
model CardShopCoupon {
  id          Int       @id @default(autoincrement())
  siteId      Int       @map("site_id")
  code        String    @db.VarChar(40)
  kind        String    @default("FIXED") @db.VarChar(16)
  value       Decimal   @default(0) @db.Decimal(18, 2)
  /// 0 = 全部分类可用
  categoryId  Int       @default(0) @map("category_id")
  /// 满多少可用（元）
  minAmount   Decimal   @default(0) @map("min_amount") @db.Decimal(18, 2)
  remark      String    @default("") @db.VarChar(200)
  batchNo     String    @default("") @map("batch_no") @db.VarChar(40)
  /// UNUSED 未使用 | LOCKED 下单占用 | USED 已核销 | DISABLED 已停用
  status      String    @default("UNUSED") @db.VarChar(16)
  usedOrderId Int       @default(0) @map("used_order_id")
  usedAt      DateTime? @map("used_at")
  expireAt    DateTime? @map("expire_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([siteId, code], map: "card_shop_coupons_site_code_key")
  @@index([siteId, status, expireAt])
  @@map("card_shop_coupons")
}

/// C 端顾客（openid 维度，与站内 User 物理隔离；匿名下单不落这张表）。
model CardShopCustomer {
  id          Int       @id @default(autoincrement())
  siteId      Int       @map("site_id")
  ownerUserId String    @map("owner_user_id") @db.VarChar(64)
  openid      String    @db.VarChar(64)
  unionid     String    @default("") @db.VarChar(64)
  nickname    String    @default("") @db.VarChar(60)
  avatar      String    @default("") @db.VarChar(500)
  orderCount  Int       @default(0) @map("order_count")
  lastOrderAt DateTime? @map("last_order_at")
  status      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([siteId, openid], map: "card_shop_customers_site_openid_key")
  @@index([siteId, createdAt])
