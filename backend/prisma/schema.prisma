  durationSec Int      @default(0) @map("duration_sec")
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([siteId, memberId, lessonId], map: "kp_progress_site_member_lesson_key")
  @@index([siteId, memberId, updatedAt])
  @@index([siteId, resourceId])
  @@map("knowledge_pay_progress")
}

/// 课程评价：一个会员对同一课程一条（再次提交即更新）。
/// status=false 为站点方隐藏；reply 为站点方一次回复。
