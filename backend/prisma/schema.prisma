  voiceSource    String   @default("clone") @map("voice_source") @db.VarChar(16)
  voiceId        Int      @default(0) @map("voice_id")
  voiceSpeakerId String   @default("") @map("voice_speaker_id") @db.VarChar(120)
  /// tts（文案合成语音）| audio（自传音频）
  audioType      String   @default("tts") @map("audio_type") @db.VarChar(16)
  script         String   @default("") @db.Text
  sourceAudioUrl String   @default("") @map("source_audio_url") @db.VarChar(500)
  bgmId          Int      @default(0) @map("bgm_id")
  bgmVolume      Int      @default(30) @map("bgm_volume")
