  orderNo      String   @default("") @map("order_no") @db.VarChar(40)
  remark       String   @default("") @db.VarChar(200)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([siteId, createdAt])
  @@index([riderId, createdAt])
  @@map("errand_wallet_txs")
}

/// 骑手收款银行卡：只存脱敏卡号与哈希，不落明文；提现时按卡快照到申请单。
