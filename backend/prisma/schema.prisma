  revision             Int       @default(1)
  quotedAt             DateTime? @map("quoted_at")
  /// 基础服务费
  baseAmount           Decimal   @default(0) @map("base_amount") @db.Decimal(14, 2)
  otherFees            Json      @default("[]") @map("other_fees")
  feeAmount            Decimal   @default(0) @map("fee_amount") @db.Decimal(14, 2)
  totalAmount          Decimal   @default(0) @map("total_amount") @db.Decimal(14, 2)
  quoteNote            String    @default("") @map("quote_note") @db.VarChar(500)
  /// 报价联系人（服务商/承办职员报价时必填，供企业确认前后商务磋商）
  providerContactName  String    @default("") @map("provider_contact_name") @db.VarChar(64)
  providerContactPhone String    @default("") @map("provider_contact_phone") @db.VarChar(32)
  confirmNote          String    @default("") @map("confirm_note") @db.VarChar(500)
  confirmedAt          DateTime? @map("confirmed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([enterpriseId, status])
  @@index([providerUserId, status])
  @@index([staffUserId, status])
  @@index([stationId, status])
  @@map("supply_bookings")
}

/// 供销网络 · 单据操作留痕（提交/报价/确认/驳回/修改，支持溯源核查）
model SupplyOrderLog {
  id             Int      @id @default(autoincrement())
  /// ORDER 订货单 | BOOKING 服务预约单
  bizType        String   @map("biz_type") @db.VarChar(16)
  bizId          Int      @map("biz_id")
  action         String   @db.VarChar(32)
  operatorUserId String   @map("operator_user_id") @db.VarChar(64)
  operatorName   String   @default("") @map("operator_name") @db.VarChar(64)
  /// 操作内容（如「报价 12,300.00 元」）
  detail         String   @default("") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([bizType, bizId])
  @@map("supply_order_logs")
}

/// GEO 分析 · 品牌项目（GEO优化大师技能包口径：品牌/竞品/监控平台）
model GeoProject {
  id               Int       @id @default(autoincrement())
  /// 创建人（企业用户本人，或代客作业的服务商/职员/平台管理员）
  ownerUserId      String    @map("owner_user_id") @db.VarChar(64)
  /// 企业档案 id（0 = 未绑定企业）
  enterpriseId     Int       @default(0) @map("enterprise_id")
  /// 品牌方当事人 userId（企业用户创建时=本人，数据可见性用）
  enterpriseUserId String    @default("") @map("enterprise_user_id") @db.VarChar(64)
  brand            String    @db.VarChar(120)
  /// 品牌别名（逗号分隔，用于回答中识别点名）
  brandAliases     String    @default("") @map("brand_aliases") @db.VarChar(300)
  industry         String    @default("") @db.VarChar(120)
  /// 竞品品牌名（JSON 数组）
  competitors      Json      @default("[]")
  /// 监控平台（JSON 数组，来自五平台常量）
  platforms        Json      @default("[]")
  status           String    @default("ACTIVE") @db.VarChar(16)
  /// 自动采集开关（1 = 每周日凌晨窗口自动采集本期问题 × 平台）
  autoCollect      Int       @default(0) @map("auto_collect")
  /// 开关操作人 / 时间
  autoCollectBy    String    @default("") @map("auto_collect_by") @db.VarChar(64)
  autoCollectAt    DateTime? @map("auto_collect_at")
  note             String    @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([ownerUserId])
  @@index([enterpriseId])
  @@map("geo_projects")
}

/// GEO 分析 · 监控问题库（起步 30 条：12 品类 / 8 决策 / 8 对比 / 2 品牌）
model GeoQuestion {
  id                 Int      @id @default(autoincrement())
  projectId          Int      @map("project_id")
  /// 人类可读编号 P0-01 / P1-03
  seq                String   @default("") @db.VarChar(16)
  text               String   @db.Text
  /// 品类词 | 决策词 | 竞品对比词 | 品牌词
  type               String   @default("品类词") @db.VarChar(32)
  /// 真实决策场景（需求引导第二轮的用户原话场景）
  scenario           String   @default("") @db.VarChar(300)
  /// 期望答案形态（如「清单/对比表」）
  expectedAnswerForm String   @default("") @map("expected_answer_form") @db.VarChar(200)
  priority           String   @default("P1") @db.VarChar(8)
  status             String   @default("ACTIVE") @db.VarChar(16)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("geo_questions")
}

/// GEO 分析 · 采集批次（通道 A 人工 / B 自动化 / C AI 采集；数据性质 simulated 必须标注）
model GeoBatch {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  periodLabel String   @map("period_label") @db.VarChar(64)
  /// A 人工 | B 自动化 | C AI 采集（每周自动采集建出的批次）
  channel     String   @default("A") @db.VarChar(8)
  /// simulated 模拟数据 | real 真实采集
  dataNature  String   @default("simulated") @map("data_nature") @db.VarChar(16)
  /// 本期监控平台（JSON 数组）
  platforms   Json     @default("[]")
  note        String   @db.Text
  createdBy   String   @default("") @map("created_by") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("geo_batches")
}

/// GEO 分析 · 观测记录（问题 × 平台 一条回答）
model GeoObservation {
  id              Int      @id @default(autoincrement())
  batchId         Int      @map("batch_id")
  questionId      Int      @map("question_id")
  platform        String   @db.VarChar(32)
  /// 品牌是否被点名（0/1）
  brandMentioned  Int      @default(0) @map("brand_mentioned")
  /// 上榜名次（未上榜为空）
  rankPosition    Int?     @map("rank_position")
  /// 正面 | 中性 | 负面 | 未提及
  sentiment       String   @default("未提及") @db.VarChar(16)
  /// 报告 | 官网 | 评测 | 百科 | 社区 | 无
  citationGenre   String   @default("无") @map("citation_genre") @db.VarChar(16)
  citationDomains String   @default("") @map("citation_domains") @db.VarChar(500)
  modelVersion    String   @default("") @map("model_version") @db.VarChar(64)
  answerExcerpt   String   @map("answer_excerpt") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([batchId])
  @@index([questionId])
  @@map("geo_observations")
}

/// GEO 分析 · 差距选题池（四维评分：缺口强度30% + AI可引性30% + 商业价值25% + 供给难度15%）
model GeoTopic {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  title         String   @db.VarChar(200)
  /// 引用真空点 | 竞品覆盖点 | 弱覆盖点 | 品牌被错误描述点 | 无缺口
  gapType       String   @default("引用真空点") @map("gap_type") @db.VarChar(32)
  /// 来源问题 id（可空：用户自拟题材）
  questionId    Int      @default(0) @map("question_id")
  /// 命中平台数（≥3 平台同现缺口，缺口强度 +2）
  platformCount Int      @default(0) @map("platform_count")
  /// 四维原始分（1-10）+ 加成
  gapScore      Int      @default(0) @map("gap_score")
  citableScore  Int      @default(0) @map("citable_score")
  businessScore Int      @default(0) @map("business_score")
  supplyScore   Int      @default(0) @map("supply_score")
  /// 内容形态加成（干货/对比/数据 +2、案例 +1）
  styleBonus    Int      @default(0) @map("style_bonus")
  /// 加权总分（后端按公式计算，不取前端值）
  totalScore    Float    @default(0) @map("total_score")
  /// 黑名单题材：判 0 分淘汰
  blacklisted   Int      @default(0)
  /// CANDIDATE 候选 | SELECTED 已选 | REJECTED 淘汰
  status        String   @default("CANDIDATE") @db.VarChar(16)
  note          String   @default("") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("geo_topics")
}

/// GEO 采集平台 API Key（每个账号在「营销工具」里配自己的）：
/// key_cipher 只存 AES-256-GCM 密文（iv:tag:payload），明文不落库、不回传前端；
/// 严格按 user_id 归属取用，不共享、不回落到别人的 Key，也没有环境变量回退。
model GeoProviderSetting {
  userId    String   @map("user_id") @db.VarChar(64)
  code      String   @db.VarChar(32)
  /// 模型名 / 方舟接入点（ep-xxx），空则该平台不可用
  model     String   @default("") @db.VarChar(128)
  /// 接口地址覆盖，空则用平台默认
  baseUrl   String   @default("") @map("base_url") @db.VarChar(255)
  keyCipher String?  @map("key_cipher") @db.Text
  updatedBy String   @default("") @map("updated_by") @db.VarChar(64)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([userId, code])
  @@index([userId])
  @@map("geo_provider_settings")
}

/// GEO 分析 · 每周自动采集任务（一个项目一周一期）：
/// 周日凌晨 02:00 窗口开跑，06:00 停；没跑完的项顺延到次日同窗口继续，直到全部有终态。
model GeoCollectRun {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  /// 本期归属周的周日 00:00（本地时区），一个项目一周只有一期
  weekStart   DateTime  @map("week_start")
  /// 期次标签（如 2026-W39），同时作为自动批次的 period_label
  periodLabel String    @map("period_label") @db.VarChar(64)
  /// PENDING 已排期待跑 | RUNNING 窗口内执行中 | DONE 本期收口（含部分失败）| CANCELLED 关停自动采集
  status      String    @default("PENDING") @db.VarChar(16)
  /// 计划项数（ACTIVE 问题 × 可用平台）/ 已落观测 / 重试耗尽
  planned     Int       @default(0)
  done        Int       @default(0)
  failed      Int       @default(0)
  /// 本期自动建出的采集批次（0 = 尚未建）
  batchId     Int       @default(0) @map("batch_id")
  /// 首次开跑 / 全部终态时间
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  /// 当前这次窗口的起止（周日晚 02:00–06:00，顺延日为次日同窗口）
  windowStart DateTime? @map("window_start")
  windowEnd   DateTime? @map("window_end")
  /// 多实例防重复：执行实例标识 + 心跳（RUNNING 且心跳过期才能被其它实例接管）
  claimedBy   String    @default("") @map("claimed_by") @db.VarChar(64)
  heartbeatAt DateTime? @map("heartbeat_at")
  /// 最近一次窗口级错误（如全平台密钥缺失），供管理端排查
  lastError   String    @default("") @map("last_error") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([projectId, weekStart])
  @@index([status])
  @@index([weekStart])
  @@map("geo_collect_runs")
}

/// GEO 分析 · 自动采集逐项明细（问题 × 平台一条）：
/// 先向该平台提问（原始回答存 rawAnswer，解析失败可只重解析不重复计费），
/// 再用豆包解析成观测字段，直接落真实观测并把 observationId 记回本行。
model GeoCollectItem {
  id            Int       @id @default(autoincrement())
  runId         Int       @map("run_id")
  projectId     Int       @map("project_id")
  questionId    Int       @map("question_id")
  platform      String    @db.VarChar(32)
  /// PENDING 待采 | DONE 已落观测 | FAILED 重试耗尽
  status        String    @default("PENDING") @db.VarChar(16)
  attempts      Int       @default(0)
  /// 最近一次错误（平台报错 / 解析失败 / 超时）
  error         String    @default("") @db.VarChar(500)
  observationId Int       @default(0) @map("observation_id")
  /// 采集平台本次回答所用模型（观测的 model_version 取此值）
  modelVersion  String    @default("") @map("model_version") @db.VarChar(64)
  /// 平台原始回答（留档：解析失败时复用它重试，不再重复提问；NULL = 尚未拿到回答）
  rawAnswer     String?   @map("raw_answer") @db.Text
  answeredAt    DateTime? @map("answered_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([runId, questionId, platform])
  @@index([runId, status])
  @@map("geo_collect_items")
}

/// GEO 独立站（营销工具 · GEO · 建站）：拖拽元素树存 Json，发布即快照一份线上内容。
model GeoSite {
  id               Int       @id @default(autoincrement())
  /// 归属账号（与 GeoProject 同口径：企业用户本人，或代客作业的服务商/职员/平台管理员）
  ownerUserId      String    @map("owner_user_id") @db.VarChar(64)
  /// 企业档案 id（0 = 未绑定企业）
  enterpriseId     Int       @default(0) @map("enterprise_id")
  /// 品牌方当事人 userId（数据可见性用，与 GeoProject 同语义）
  enterpriseUserId String    @default("") @map("enterprise_user_id") @db.VarChar(64)
  /// 关联 GEO 项目（0 = 未关联；用于把品牌上下文灌进站点 SEO 结构化数据）
  geoProjectId     Int       @default(0) @map("geo_project_id")
  title            String    @db.VarChar(120)
  /// 平台子域标识：{slug}.<站点域名>，全局唯一
  slug             String    @unique @db.VarChar(63)
  /// 站点默认语言：与平台 SUPPORTED_LANGUAGES 同口径；默认语言走无前缀地址
  defaultLanguage  String    @default("zh-CN") @map("default_language") @db.VarChar(16)
  /// 已启用的语言码（JSON string[]，含默认语言）；空数组按 [defaultLanguage] 处理
  languages        Json      @default("[]")
  /// 草稿元素树（Framely EditorElement[] 同构）
  content          Json      @default("[]")
  /// 站点级 SEO/GEO 档案：meta / OG / JSON-LD 勾选 / llms.txt 开关
  seo              Json      @default("{}")
  favicon          String    @default("") @db.VarChar(500)
  coverImage       String    @default("") @map("cover_image") @db.VarChar(500)
  /// DRAFT 草稿 | PUBLISHED 已发布 | SUSPENDED 欠费停服（数据保留）
  status           String    @default("DRAFT") @db.VarChar(16)
  /// 线上快照：访客读这份，编辑草稿不影响线上
  publishedContent Json?     @map("published_content")
  publishedSeo     Json?     @map("published_seo")
  publishedAt      DateTime? @map("published_at")
  /// 线上导航快照：站点发布时把菜单树冻结一份，草稿改菜单不影响线上
  publishedMenus   Json?     @map("published_menus")
  /// 站点级自定义脚本开关（0 = 本站关闭注入，平台开关与域名闸门之外的第三道闸）
  scriptsEnabled   Int       @default(1) @map("scripts_enabled") @db.TinyInt
  /// 欠费停服时间（用于 72 小时缓冲与恢复判定）
  suspendedAt      DateTime? @map("suspended_at")
  /// 计费起始时间（首月按天折算的锚点）
  billingFrom      DateTime  @default(now()) @map("billing_from")
  /// 停服/强制下线操作人与原因（合规处置留痕）
  offBy            String    @default("") @map("off_by") @db.VarChar(64)
  offReason        String    @default("") @map("off_reason") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([ownerUserId])
  @@index([enterpriseId])
  @@index([status])
  @@map("geo_sites")
}

/// 用户自助绑定的自定义域名（一个站点可多个域名，其中一个为主域名）。
model GeoSiteDomain {
  id          Int       @id @default(autoincrement())
  siteId      Int       @map("site_id")
  ownerUserId String    @map("owner_user_id") @db.VarChar(64)
  /// 纯主机名（小写、无协议），全站唯一
  domain      String    @unique @db.VarChar(253)
  /// 随机校验令牌：TXT 记录值与探针回显都用它
  verifyToken String    @map("verify_token") @db.VarChar(32)
  /// PENDING 待校验 | VERIFYING 校验中 | ACTIVE 生效 | ERROR 校验失败 | DISABLED 平台停用
  status      String    @default("PENDING") @db.VarChar(16)
  /// 主域名（1 = 是，一个站最多一个）
  isPrimary   Int       @default(0) @map("is_primary") @db.TinyInt
  lastCheckAt DateTime? @map("last_check_at")
  lastError   String    @default("") @map("last_error") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([siteId])
  @@index([status])
  @@map("geo_site_domains")
}

/// 站点月度账单：唯一键 (siteId, periodMonth) 是出账幂等的硬保证（日批重跑不会重复扣费）。
model GeoSiteBill {
  id           Int      @id @default(autoincrement())
  siteId       Int      @map("site_id")
  ownerUserId  String   @map("owner_user_id") @db.VarChar(64)
  /// 账期 YYYY-MM
  periodMonth  String   @map("period_month") @db.VarChar(7)
  /// 本期计费的当月在册天数（首月/末月按天折算）
  days         Int      @default(0)
  pointsAmount Decimal  @default(0) @map("points_amount") @db.Decimal(18, 4)
  /// CHARGED 已扣 | ARREARS 余额不足 | WAIVED 免费额内/未计费
  status       String   @default("CHARGED") @db.VarChar(16)
  txId         Int      @default(0) @map("tx_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([siteId, periodMonth], map: "geo_site_bills_site_period_uniq")
  @@index([ownerUserId, periodMonth])
  @@map("geo_site_bills")
}

/// 站点页面：一个站点多页，path 为站内路径（'' = 首页）。列表/详情页通过 contentType 绑定内容库。
model GeoSitePage {
  id               Int       @id @default(autoincrement())
  siteId           Int       @map("site_id")
  ownerUserId      String    @map("owner_user_id") @db.VarChar(64)
  /// 站内路径片段：'' 首页 | products | blog（无前后斜杠，小写连字符，可多段）
  path             String    @db.VarChar(191)
  /// 语言码：'' = 站点默认语言（存量数据零迁移），其余为已启用的语言
  lang             String    @default("") @db.VarChar(16)
  title            String    @db.VarChar(120)
  /// 页面模板类型：home/landing/articleList/articleDetail/productList/productDetail/blank/custom
  kind             String    @default("custom") @db.VarChar(24)
  /// 首页标记（一个站点最多一个 1）
  isHome           Int       @default(0) @map("is_home") @db.TinyInt
  /// 列表页绑定的内容类型：article | product（'' = 不绑定）
  contentType      String    @default("") @map("content_type") @db.VarChar(16)
  /// 列表页每页条数
  pageSize         Int       @default(9) @map("page_size")
  sort             Int       @default(0)
  /// DRAFT 草稿 | PUBLISHED 已发布
  status           String    @default("DRAFT") @db.VarChar(16)
  content          Json      @default("[]")
  seo              Json      @default("{}")
  /// 页面自定义脚本（白名单校验后的 https 外链：[{ src, host, label }]）
  scripts          Json      @default("[]")
  publishedContent Json?     @map("published_content")
  publishedSeo     Json?     @map("published_seo")
  publishedScripts Json?     @map("published_scripts")
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([siteId, lang, path], map: "geo_site_pages_site_lang_path_uniq")
  @@index([ownerUserId])
  @@index([siteId, lang, sort])
  @@map("geo_site_pages")
}

/// 站点导航菜单：HEADER 顶部 / FOOTER 页脚，支持两级与五种目标类型（页面/文章/产品/外链/锚点）。
model GeoSiteMenuItem {
  id          Int      @id @default(autoincrement())
  siteId      Int      @map("site_id")
  ownerUserId String   @map("owner_user_id") @db.VarChar(64)
  /// HEADER 顶部导航 | FOOTER 页脚导航
  location    String   @default("HEADER") @db.VarChar(16)
  /// 语言码：'' = 站点默认语言；每个语言各一棵导航树
  lang        String   @default("") @db.VarChar(16)
  /// 父菜单 id（0 = 顶级）
  parentId    Int      @default(0) @map("parent_id")
  label       String   @db.VarChar(60)
  /// PAGE 站内页面 | ARTICLE 文章 | PRODUCT 产品 | URL 外部链接 | ANCHOR 页内锚点
  targetType  String   @default("PAGE") @map("target_type") @db.VarChar(16)
  /// 目标 id（page/article/product），URL 与 ANCHOR 时为 0
  targetId    Int      @default(0) @map("target_id")
  /// 外部链接（http/https）或页内锚点（#xxx）
  url         String   @default("") @db.VarChar(500)
  sort        Int      @default(0)
  /// 是否显示
  visible     Int      @default(1) @db.TinyInt
  /// 新标签页打开
  openNewTab  Int      @default(0) @map("open_new_tab") @db.TinyInt
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([siteId, lang, location, sort])
  @@index([ownerUserId])
  @@map("geo_site_menu_items")
}

/// 站点内容库 · 文章：正文存元素树，与页面共用同一套转义与样式白名单渲染管线。
model GeoSiteArticle {
  id          Int       @id @default(autoincrement())
  siteId      Int       @map("site_id")
  ownerUserId String    @map("owner_user_id") @db.VarChar(64)
  title       String    @db.VarChar(200)
  /// 站内标识：/blog/{slug}，同一站点同一语言内唯一
  slug        String    @db.VarChar(191)
  /// 语言码：'' = 站点默认语言
  lang        String    @default("") @db.VarChar(16)
  summary     String    @default("") @db.VarChar(500)
  /// 正文元素树（同 GeoSitePage.content 结构）
  body        Json      @default("[]")
  coverImage  String    @default("") @map("cover_image") @db.VarChar(500)
  /// 图集：[{ url, alt }]
  gallery     Json      @default("[]")
  category    String    @default("") @db.VarChar(60)
  /// 标签列表：string[]
  tags        Json      @default("[]")
  authorName  String    @default("") @map("author_name") @db.VarChar(60)
  /// FAQ 问答：[{ q, a }]，用于 FAQPage JSON-LD
  faqs        Json      @default("[]")
  /// 关联产品 id：number[]
  relatedIds  Json      @default("[]") @map("related_ids")
  seo         Json      @default("{}")
  /// DRAFT 草稿 | PUBLISHED 已发布 | OFFLINE 下线
  status      String    @default("DRAFT") @db.VarChar(16)
  publishedAt DateTime? @map("published_at")
  viewCount   Int       @default(0) @map("view_count")
  sort        Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([siteId, lang, slug], map: "geo_site_articles_site_lang_slug_uniq")
  @@index([siteId, lang, status, publishedAt])
  @@index([ownerUserId])
  @@map("geo_site_articles")
}

/// 站点内容库 · 产品：字段用于产品详情页模板的规格/价格区块。
model GeoSiteProduct {
  id          Int       @id @default(autoincrement())
  siteId      Int       @map("site_id")
  ownerUserId String    @map("owner_user_id") @db.VarChar(64)
  title       String    @db.VarChar(200)
  slug        String    @db.VarChar(191)
  /// 语言码：'' = 站点默认语言
  lang        String    @default("") @db.VarChar(16)
  summary     String    @default("") @db.VarChar(500)
  body        Json      @default("[]")
  coverImage  String    @default("") @map("cover_image") @db.VarChar(500)
  gallery     Json      @default("[]")
  category    String    @default("") @db.VarChar(60)
  tags        Json      @default("[]")
  /// 展示价格（数值，文案单位由 unit 描述）
  price       Decimal   @default(0) @db.Decimal(18, 2)
  /// 价格单位：元/件、万元/年…
  unit        String    @default("") @db.VarChar(20)
  /// 是否「联系我们询价」（隐藏价格）
  priceOnAsk  Int       @default(0) @map("price_on_ask") @db.TinyInt
  /// 规格参数：[{ name, value }]
  specs       Json      @default("[]")
  /// 购买/咨询跳转链接
  buyUrl      String    @default("") @map("buy_url") @db.VarChar(500)
  faqs        Json      @default("[]")
  seo         Json      @default("{}")
  /// 首页/列表置顶推荐
  featured    Int       @default(0) @db.TinyInt
  status      String    @default("DRAFT") @db.VarChar(16)
  publishedAt DateTime? @map("published_at")
  viewCount   Int       @default(0) @map("view_count")
  sort        Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([siteId, lang, slug], map: "geo_site_products_site_lang_slug_uniq")
  @@index([siteId, lang, status, publishedAt])
  @@index([ownerUserId])
  @@map("geo_site_products")
}

/// 发布台账：站点每次发布留一行，供管理端追溯与内容统计。
model GeoSitePublishLog {
  id          Int      @id @default(autoincrement())
  siteId      Int      @map("site_id")
  ownerUserId String   @map("owner_user_id") @db.VarChar(64)
  /// SITE 整站发布 | PAGE 单页 | ARTICLE 文章 | PRODUCT 产品
  targetKind  String   @map("target_kind") @db.VarChar(16)
  targetId    Int      @default(0) @map("target_id")
  label       String   @default("") @db.VarChar(200)
  /// 本次变更摘要（页面数/内容数等，纯展示）
  note        String   @default("") @db.VarChar(500)
  operator    String   @default("") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([siteId, createdAt])
  @@map("geo_site_publish_logs")
}

/// 站点模板库：BLOCK = 画布里另存的可复用区块，PAGE = 整页另存；元素树与页面共用同一套白名单校验。
model GeoSiteTemplate {
  id          Int      @id @default(autoincrement())
  siteId      Int      @map("site_id")
  ownerUserId String   @map("owner_user_id") @db.VarChar(64)
  /// BLOCK 区块片段 | PAGE 整页模板
  kind        String   @default("BLOCK") @db.VarChar(16)
  name        String   @db.VarChar(60)
  note        String   @default("") @db.VarChar(200)
  /// 顶层元素数组（与 geo_site_pages.content 同构）
  content     Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([siteId, kind, id])
  @@index([ownerUserId])
  @@map("geo_site_templates")
}

/// Atomic per-day document sequences. Initialized from the maximum existing document number.
model DocumentCounter {
  key   String @id @db.VarChar(32)
  value Int

  @@map("document_counters")
}

// ---------------------------------------------------------------------------
// 自动化工具：多维表格 / RPA / Workbuddy 企业版 / AI 调用账号
// 归属口径：全部按「账号」（createdBy / userId）归属，不挂企业档案。
// ---------------------------------------------------------------------------

model DataTable {
  id          Int      @id @default(autoincrement())
  /// 归属账号：建表人即归属人，结构与授权只归他管
  createdBy   String   @map("created_by") @db.VarChar(64)
  name        String   @db.VarChar(200)
  description String   @default("") @db.VarChar(500)
  /// 内建应用实体表：>0 表示由低代码实体创建，归属项目
  projectId   Int      @default(0) @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([createdBy])
  @@index([projectId])
  @@map("data_tables")
}

model DataTableGrant {
  id            Int      @id @default(autoincrement())
  tableId       Int      @map("table_id")
  /// 被授权账号（必须是归属人的旗下成员）
  granteeUserId String   @map("grantee_user_id") @db.VarChar(64)
  canRead       Boolean  @default(false) @map("can_read")
  canCreate     Boolean  @default(false) @map("can_create")
  canUpdate     Boolean  @default(false) @map("can_update")
  canDelete     Boolean  @default(false) @map("can_delete")
  grantedBy     String   @map("granted_by") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([tableId, granteeUserId])
  @@index([granteeUserId])
  @@map("data_table_grants")
}

model DataTableField {
  id        Int      @id @default(autoincrement())
  tableId   Int      @map("table_id")
  /// 列名（界面表头，可改）
  name      String   @db.VarChar(200)
  /// 列键：小写字母/数字/下划线，表内唯一，同时是行数据 JSON 的键
  fieldKey  String   @map("field_key") @db.VarChar(64)
  /// 列类型：text / number / boolean / date / url / email / json / select
  fieldType String   @default("text") @map("field_type") @db.VarChar(16)
  /// 列序（「字段排序」按全量列顺序提交后重排）
  sortOrder Int      @default(0) @map("sort_order")
  /// 类型专属配置：select ＝ { "choices": ["…"] }
  options   Json     @default("{}")
  required  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tableId, fieldKey])
  @@index([tableId, sortOrder])
  @@map("data_table_fields")
}

model DataTableRow {
  id        Int      @id @default(autoincrement())
  tableId   Int      @map("table_id")
  /// 行数据：{ 列键: 值 }
  data      Json
  createdBy String   @map("created_by") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tableId, createdAt])
  @@map("data_table_rows")
}

/// 表格视图：一张表可存多个视图（网格 / 看板 / 汇总），与列定义、行数据共用一份。
/// 视图只影响呈现，不改数据；看板按某个单选列分组，汇总按数字列做合计。
model DataTableView {
  id        Int      @id @default(autoincrement())
  tableId   Int      @map("table_id")
  createdBy String   @map("created_by") @db.VarChar(64)
  name      String   @db.VarChar(200)
  /// GRID | KANBAN | DASHBOARD
  type      String   @default("GRID") @db.VarChar(16)
  /// 视图配置：看板＝{ groupBy }，汇总＝{ metrics:[{key,agg}] }，网格＝{ filters, sort }
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tableId, createdAt])
  @@map("data_table_views")
}

/// 多维表格 ↔ 飞书多维表格同步绑定：表归属账号配置，凭据 AES-256-GCM 密文落库。
/// 一个本地表可绑多个飞书表；方向 pull（飞书→本地）/ push（本地→飞书）/ both（双向）。
model DataTableFeishuSync {
  id                Int       @id @default(autoincrement())
  tableId           Int       @map("table_id")
  createdBy         String    @map("created_by") @db.VarChar(64)
  /// pull | push | both
  direction         String    @default("both") @db.VarChar(16)
  /// 飞书自建应用 App ID
  appId             String    @map("app_id") @db.VarChar(128)
  /// App Secret 密文：base64(iv):base64(tag):base64(payload)
  appSecretCipher   String    @map("app_secret_cipher") @db.Text
  /// 飞书多维表格 app_token（表格 URL「/base/」后的串）
  appToken          String    @map("app_token") @db.VarChar(191)
  /// 飞书数据表 table_id（tbl 开头）
  feishuTableId     String    @map("feishu_table_id") @db.VarChar(191)
  /// 事件订阅 Verification Token（可空；填了则回调报文必须带同值）
  verificationToken String    @default("") @map("verification_token") @db.VarChar(191)
  /// 事件订阅 Encrypt Key 密文（可空；填了则回调报文加密）
  encryptKeyCipher  String    @default("") @map("encrypt_key_cipher") @db.Text
  /// 字段映射：[{ localKey, feishuName }]
  fieldMapping      Json      @default("[]") @map("field_mapping")
  /// active | paused
  status            String    @default("active") @db.VarChar(16)
  /// 回调路径里的随机串（每个绑定唯一，用来定位是哪个绑定）
  webhookToken      String    @unique @map("webhook_token") @db.VarChar(64)
  lastSyncAt        DateTime? @map("last_sync_at")
  lastError         String    @default("") @map("last_error") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([tableId])
  @@index([appToken, feishuTableId])
  @@map("data_table_feishu_syncs")
}

/// 本地行 ↔ 飞书记录 的对应关系（双向同步定位与「哪边更新」判定）。
model DataTableFeishuRowLink {
  id              Int       @id @default(autoincrement())
  syncId          Int       @map("sync_id")
  localRowId      Int       @map("local_row_id")
  feishuRecordId  String    @map("feishu_record_id") @db.VarChar(191)
  /// 上一次同步时的两侧时间戳；本地较新则推、飞书较新则拉
  localUpdatedAt  DateTime? @map("local_updated_at")
  feishuUpdatedAt DateTime? @map("feishu_updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([syncId, localRowId])
  @@unique([syncId, feishuRecordId])
  @@index([syncId])
  @@map("data_table_feishu_row_links")
}

/// 同步执行记录（界面「同步记录」；每个绑定只保留最近 50 条）。
model DataTableFeishuSyncLog {
  id        Int      @id @default(autoincrement())
  syncId    Int      @map("sync_id")
  /// pull | push | webhook
  trigger   String   @db.VarChar(16)
  /// success | failed
  status    String   @db.VarChar(16)
  /// 计数：{ pulled, pushed, created, updated, deleted, skipped }
  stats     Json     @default("{}")
  message   String   @default("") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([syncId, createdAt])
  @@map("data_table_feishu_sync_logs")
}

model RpaScript {
  id           Int      @id @default(autoincrement())
  createdBy    String   @map("created_by") @db.VarChar(64)
  name         String   @db.VarChar(200)
  description  String   @default("") @db.VarChar(500)
  /// 业务分组（自由文本，界面按它归类）
  category     String   @default("") @db.VarChar(64)
  tags         Json     @default("[]")
  /// 目标设备：pc（比特浏览器窗口）| android（安卓云手机）| iphone（iPhone 云手机）| chrome（本地 Chrome 插件）| botbuddy（BotBuddy 浏览器）
  deviceType   String   @default("pc") @map("device_type") @db.VarChar(16)
  /// 脚本类型，取值按设备收窄：pc＝automa_json|bitbrowser_rpa|javascript|python，android＝bitphone_json|javascript|python，iphone＝javascript|python，chrome＝chrome_actions，botbuddy＝automa_json
  fileType     String   @default("automa_json") @map("file_type") @db.VarChar(24)
  /// 厂商侧流程 ID：pc 的 bitbrowser_rpa 存比特浏览器 RPA 任务 ID（POST /rpa/run 的 id），android 的 bitphone_json 存云手机 RPA 流程 ID
  vendorFlowId String   @default("") @map("vendor_flow_id") @db.VarChar(64)
  /// 生命周期：draft | testing | published | archived
  status       String   @default("draft") @db.VarChar(16)
  /// 脚本正文，任务认领时原样交给本地执行器
  content      String   @db.Text
  /// 运行参数定义：{ 参数键: { label, required, default } }，新建任务按它渲染输入并校验必填
  paramsSchema Json     @default("{}") @map("params_schema")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([createdBy, fileType])
  @@index([createdBy, status])
  @@index([createdBy, deviceType, status])
  @@map("rpa_scripts")
}

model RpaAccount {
  id                  Int       @id @default(autoincrement())
  createdBy           String    @map("created_by") @db.VarChar(64)
  /// 目标平台 URL（比特浏览器 /browser/add 的 platform 字段），如 https://www.facebook.com
  platform            String    @db.VarChar(500)
  /// 比特浏览器分组 ID（/browser/add 的 groupId）或云手机分组 ID
  groupId             String    @default("") @map("group_id") @db.VarChar(128)
  nickname            String    @default("") @db.VarChar(128)
  username            String    @db.VarChar(191)
  /// 登录口令密文：base64(iv):base64(tag):base64(payload)，AES-256-GCM
  keyCipher           String    @map("key_cipher") @db.Text
  loginUrl            String    @default("") @map("login_url") @db.VarChar(500)
  /// 云手机计费方式（对齐比特浏览器 envType）：0＝套餐计费，1＝按时计费
  envType             Int       @default(1) @map("env_type")
  /// active | disabled | banned | pending
  status              String    @default("active") @db.VarChar(16)
  /// 代理方式（对齐比特浏览器 proxyMethod）：2＝自定义代理，3＝提取 IP
  proxyMethod         Int       @default(2) @map("proxy_method")
  /// 代理类型（对齐比特浏览器 proxyType）：noproxy / http / https / socks5 / ssh
  proxyType           String    @default("noproxy") @map("proxy_type") @db.VarChar(16)
  proxyHost           String    @default("") @map("proxy_host") @db.VarChar(255)
  proxyPort           Int       @default(0) @map("proxy_port")
  proxyUserName       String    @default("") @map("proxy_user_name") @db.VarChar(200)
  /// 代理口令密文：base64(iv):base64(tag):base64(payload)，AES-256-GCM；只有任务派发链路解密
  proxyPasswordCipher String    @default("") @map("proxy_password_cipher") @db.Text
  notes               String    @default("") @db.VarChar(500)
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([createdBy, status])
  @@index([createdBy, platform])
  @@map("rpa_accounts")
}

model RpaTask {
  id                Int       @id @default(autoincrement())
  createdBy         String    @map("created_by") @db.VarChar(64)
  name              String    @db.VarChar(200)
  /// 绑定的脚本；被任务引用的脚本禁止删除
  scriptId          Int       @map("script_id")
  /// 运行设备：创建时由绑定脚本带出并与脚本一致，pc | android | iphone | chrome | botbuddy
  deviceType        String    @default("pc") @map("device_type") @db.VarChar(16)
  /// 绑定的 RPA 账号 ID 数组
  accountIds        Json      @default("[]") @map("account_ids")
  /// 运行参数：{ 参数键: 值 }，按脚本 paramsSchema 校验必填
  params            Json      @default("{}")
  /// pending | running | completed | failed | cancelled
  status            String    @default("pending") @db.VarChar(16)
  /// once | scheduled | recurring
  scheduleType      String    @default("once") @map("schedule_type") @db.VarChar(16)
  /// 排期配置：{ freq, time "HH:MM", weekdays [1-7], day, tz_offset }
  scheduleConfig    Json      @default("{}") @map("schedule_config")
  /// 手机任务跑完后的动作：keep（保持开机）| shutdown（关机）| suspend（挂起）；pc 任务固定 keep
  phoneFinishAction String    @default("keep") @map("phone_finish_action") @db.VarChar(16)
  scheduledAt       DateTime? @map("scheduled_at")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  lastRunAt         DateTime? @map("last_run_at")
  /// 最近一次失败原因（来自执行回传或超时判定）
  lastError         String    @default("") @map("last_error") @db.VarChar(500)
  maxRetries        Int       @default(0) @map("max_retries")
  /// 超过该时长仍未回传结果的执行判为 timeout，任务自动退回 pending 供重新认领
  timeoutSeconds    Int       @default(3600) @map("timeout_seconds")
  /// deviceType=chrome 时绑定的本地 Chrome 设备号（RpaChromeDevice.clientId）；其他设备固定空串
  chromeClientId    String    @default("") @map("chrome_client_id") @db.VarChar(64)
  /// deviceType=botbuddy 时绑定的 BotBuddy 主机（workbuddy_hosts.id）；其他设备为 null
  botHostId         Int?      @map("bot_host_id")
  /// deviceType=botbuddy 时指定的指纹窗口档案 ID（客户端本机 fp-profiles）；空串＝由主机自己定窗口
  fpProfileId       String    @default("") @map("fp_profile_id") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([createdBy, status])
  @@index([createdBy, deviceType, status])
  @@index([scriptId])
  @@map("rpa_tasks")
}

model RpaTaskExecution {
  id               Int       @id @default(autoincrement())
  taskId           Int       @map("task_id")
  /// 任务归属账号，冗余一份让机器通道能按 Key 直接收窄可见范围
  createdBy        String    @map("created_by") @db.VarChar(64)
  /// 设备类型快照（pc | android | iphone）：任务改绑不影响历史记录，报表按它分设备统计
  deviceType       String    @default("pc") @map("device_type") @db.VarChar(16)
  /// running | success | failed | cancelled | timeout
  status           String    @default("running") @db.VarChar(16)
  attempt          Int       @default(1)
  /// 执行端标识（比特浏览器窗口 ID 或本机名），认领时由执行器带上
  executor         String    @default("") @db.VarChar(64)
  /// 本次执行用的比特浏览器窗口 ID（PC 任务，执行时动态创建）
  browserProfileId String    @default("") @map("browser_profile_id") @db.VarChar(64)
  /// 本次执行用的云手机环境 ID（云手机任务，执行时动态创建）
  cloudPhoneId     String    @default("") @map("cloud_phone_id") @db.VarChar(64)
  output           Json      @default("{}")
  errorMessage     String    @default("") @map("error_message") @db.VarChar(500)
  logText          String    @default("") @map("log_text") @db.Text
  startedAt        DateTime  @default(now()) @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  durationMs       Int?      @map("duration_ms")

  @@index([taskId, startedAt])
  @@index([createdBy, status])
  @@map("rpa_task_executions")
}

model RpaLlmSetting {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id") @db.VarChar(64)
  /// 历史按模块存的模型 Key 密文：保留存量，不再读写；平台 Key 统一走 Java 侧 sk_
  keyCipher String?  @map("key_cipher") @db.Text
  model     String   @default("") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rpa_llm_settings")
}

model RpaSetting {
  id                     Int      @id @default(autoincrement())
  createdBy              String   @unique @map("created_by") @db.VarChar(64)
  /// 比特浏览器 API 地址（执行端本地地址，如 http://127.0.0.1:54345）
  bitbrowserApiEndpoint  String   @default("http://127.0.0.1:54345") @map("bitbrowser_api_endpoint") @db.VarChar(500)
  /// 比特浏览器 API Key（可选，加密存储）
  bitbrowserApiKeyCipher String   @default("") @map("bitbrowser_api_key_cipher") @db.Text
  /// 默认分组 ID（账号不填时用这个，从 /group/list 获取）
  bitbrowserGroupId      String   @default("") @map("bitbrowser_group_id") @db.VarChar(128)
  /// 云手机默认区域 ID（从 /phone/region/list 获取）
  bitphoneRegionId       String   @default("") @map("bitphone_region_id") @db.VarChar(64)
  /// 云手机默认配置（如 standard / high，从 /phone/compute/list 获取）
  bitphoneComputeType    String   @default("") @map("bitphone_compute_type") @db.VarChar(64)
  /// 本地 Chrome 插件 RPA 的设置（maxSteps / 超时 / 黑名单 / 敏感确认 / 截图保留天数），JSON 存
  chromeSettings         Json     @default("{}") @map("chrome_settings")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("rpa_settings")
}

/// 本地 Chrome 插件设备（docs/本地Chrome插件RPA控制方案.md §5.1）：插件用本站账号登录后
/// 成为该用户名下的一台设备，心跳维持在线，云端据此下发动作指令。令牌只存 sha256 哈希。
model RpaChromeDevice {
  id               Int       @id @default(autoincrement())
  /// 归属用户（本站账户 userId）
  createdBy        String    @map("created_by") @db.VarChar(64)
  /// 插件本地生成的稳定设备号（安装时 uuid，重装即换）
  clientId         String    @map("client_id") @db.VarChar(64)
  /// 设备显示名（默认「Chrome · 主机名」）
  name             String    @default("") @db.VarChar(80)
  /// 登录时用的本站域（校验插件确实连的是同一套系统）
  domain           String    @default("") @db.VarChar(200)
  /// 设备令牌哈希：sha256(明文)；明文只在登录响应里出现一次
  tokenHash        String    @map("token_hash") @db.VarChar(64)
  extensionVersion String    @default("") @map("extension_version") @db.VarChar(24)
  /// ONLINE | DISABLED（OFFLINE 由心跳超时折算，不落库）
  status           String    @default("ONLINE") @db.VarChar(16)
  /// 插件最近一次心跳回报的打开页面 [{ tabId, url, title }]，仅界面展示
  pages            Json      @default("[]")
  /// 能力指纹 { version, protocol, capabilities, primitives, siteMatrixHash, at }
  /// 派发门与决策提示词菜单的唯一依据：旧插件拿不到只有新版才支持的动作
  caps             Json      @default("{}")
  lastSeenAt       DateTime? @map("last_seen_at")
  lastIp           String    @default("") @map("last_ip") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([createdBy, clientId])
  @@index([createdBy, status])
  @@map("rpa_chrome_devices")
}

/// 云端 → 插件的动作指令队列：心跳顺带领取，按 commandCode 幂等回执。
/// 敏感动作先进 PENDING_CONFIRM，等本人在插件弹窗点「允许本次」再转 DISPATCHED。
model RpaChromeCommand {
  id           Int       @id @default(autoincrement())
  createdBy    String    @map("created_by") @db.VarChar(64)
  clientId     String    @map("client_id") @db.VarChar(64)
  sessionId    Int       @default(0) @map("session_id")
  stepIndex    Int       @default(0) @map("step_index")
  /// 服务端生成的指令码，插件回执按它幂等（唯一）
  commandCode  String    @unique @map("command_code") @db.VarChar(40)
  /// 闭集动作（契约 RC_ACTIONS）及其参数
  action       Json      @default("{}")
  /// PENDING | DISPATCHED | PENDING_CONFIRM | DONE | FAILED | TIMEOUT | CANCELLED
  status       String    @default("PENDING") @db.VarChar(16)
  /// 敏感确认状态：NONE | PENDING | ALLOWED | DENIED
  confirmState String    @default("NONE") @map("confirm_state") @db.VarChar(16)
  /// 插件回执：{ ok, data, errorMessage, elapsedMs, code }
  result       Json      @default("{}")
  dispatchedAt DateTime? @map("dispatched_at")
  finishedAt   DateTime? @map("finished_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([clientId, status, id])
  @@index([sessionId, stepIndex])
  @@map("rpa_chrome_commands")
}

/// 一次「本地 Chrome 自动操作」会话：goal（自然语言）→ 云端 LLM 逐步决策 → 插件执行并回观测。
/// 也可带确定性动作序列（script），此时逐步回放、不调 LLM。
model RpaChromeSession {
  id           Int       @id @default(autoincrement())
  createdBy    String    @map("created_by") @db.VarChar(64)
  clientId     String    @map("client_id") @db.VarChar(64)
  /// 关联的 RPA 任务 ID（页面直接开会话时为 0）
  taskId       Int       @default(0) @map("task_id")
  /// 由任务发起的会话对应的执行记录 ID（直接开会话时为 0）；收尾时按它回写 RpaTaskExecution
  executionId  Int       @default(0) @map("execution_id")
  goal         String    @db.Text
  startUrl     String    @default("") @map("start_url") @db.VarChar(2000)
  /// 能力档：act 操作 / crawl 顺链接批量抓取 / extract 抽取结构化结果
  mode         String    @default("act") @db.VarChar(16)
  /// 采集产物去向（none 只展示 / extract 落抽取台账 / table 落多维表格）：会话级留档，任何档位都不关步骤截图审计
  persist      String    @default("none") @db.VarChar(16)
  /// persist=table 时的目标多维表格（0＝落表时按表名新建）
  tableId      Int       @default(0) @map("table_id")
  /// RUNNING | WAITING_CONFIRM | PAUSED | COMPLETED | FAILED | CANCELLED | TIMEOUT
  status       String    @default("RUNNING") @db.VarChar(16)
  stepCount    Int       @default(0) @map("step_count")
  maxSteps     Int       @default(25) @map("max_steps")
  /// 决策用模型（确定性回放时为空）
  model        String    @default("") @db.VarChar(128)
  /// 结束原因：done | max_steps | no_action | offline | timeout | stopped | error
  stopReason   String    @default("") @map("stop_reason") @db.VarChar(32)
  errorMessage String    @default("") @map("error_message") @db.VarChar(500)
  /// 确定性动作序列（给出时逐步回放，不走 LLM、不产生 AI 积分）
  script       Json      @default("[]")
  /// 落表口径（tableName/fields/dedupBy/source）：persist=table 时收割结果按它原子落表，定时重跑靠 dedupBy 幂等
  landing      Json?
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([createdBy, status, createdAt])
  @@index([clientId, status])
  @@map("rpa_chrome_sessions")
}

/// 会话的每一步：动作 + LLM 思考 + 页面观测（页面地图/截图）留痕，供界面回放与审计。
model RpaChromeStep {
  id            Int      @id @default(autoincrement())
  sessionId     Int      @map("session_id")
  createdBy     String   @map("created_by") @db.VarChar(64)
  stepIndex     Int      @map("step_index")
  commandCode   String   @default("") @map("command_code") @db.VarChar(40)
  action        Json     @default("{}")
  /// LLM 决策理由（确定性回放时为空）
  thought       String   @default("") @db.VarChar(1000)
  /// 动作后的页面观测（页面地图 + 元素 + 截图 key），供 LLM 下一步决策
  observation   Json     @default("{}")
  /// 截图对象存储 key（保留 N 天，超期清理）
  screenshotKey String   @default("") @map("screenshot_key") @db.VarChar(200)
  /// RUNNING | DONE | FAILED | TIMEOUT | CANCELLED
  status        String   @default("RUNNING") @db.VarChar(16)
  elapsedMs     Int      @default(0) @map("elapsed_ms")
  errorMessage  String   @default("") @map("error_message") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([sessionId, stepIndex])
  @@index([sessionId, createdAt])
  @@map("rpa_chrome_steps")
}

/// 浏览器代理会话（docs/浏览器代理插件升级方案.md）：侧边栏 Agent 的编排在插件侧，
/// 云端只存台账与消息流，用于跨设备查看、审计与额度对账。
model RpaChromeAgent {
  id            Int       @id @default(autoincrement())
  createdBy     String    @map("created_by") @db.VarChar(64)
  clientId      String    @map("client_id") @db.VarChar(64)
  /// 插件侧生成的会话本地号（同一设备内稳定），用于幂等 upsert
  clientAgentId String    @default("") @map("client_agent_id") @db.VarChar(64)
  /// act | crawl | extract
  mode          String    @default("act") @db.VarChar(16)
  goal          String    @db.Text
  /// RUNNING | WAITING_CONFIRM | PAUSED | COMPLETED | FAILED | CANCELLED | TIMEOUT
  status        String    @default("RUNNING") @db.VarChar(16)
  stepCount     Int       @default(0) @map("step_count")
  maxSteps      Int       @default(25) @map("max_steps")
  model         String    @default("") @db.VarChar(128)
  /// 本会话累计消耗（先时长卡后积分，与站内 AI 用量同口径）
  credits       Int       @default(0)
  stopReason    String    @default("") @map("stop_reason") @db.VarChar(32)
  errorMessage  String    @default("") @map("error_message") @db.VarChar(500)
  startedAt     DateTime  @default(now()) @map("started_at")
  endedAt       DateTime? @map("ended_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([createdBy, clientId, clientAgentId])
  @@index([createdBy, status, createdAt])
  @@map("rpa_chrome_agents")
}

/// 代理会话消息流：一条卡片一行（思考 / 动作 / 工具 / 结果 / 截图 / 错误 / 追问）。
model RpaChromeMessage {
  id            Int      @id @default(autoincrement())
  agentId       Int      @map("agent_id")
  createdBy     String   @map("created_by") @db.VarChar(64)
  /// 会话内自增序号（界面排序与断点续传的锚点）
  seq           Int      @default(0)
  role          String   @default("agent") @db.VarChar(16)
  kind          String   @default("text") @db.VarChar(16)
  content       String   @default("") @db.Text
  /// 卡片结构化内容（动作参数 / 工具入参回执 / 结果表格）
  payload       Json     @default("{}")
  screenshotKey String   @default("") @map("screenshot_key") @db.VarChar(200)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([agentId, seq])
  @@index([agentId, createdAt])
  /// 能力缺口清单按人 + kind 查（kind='gap'）
  @@index([createdBy, kind])
  @@map("rpa_chrome_messages")
}

/// 插件侧沉淀的技能（personal 个人偏好/工作流 / site 站点操作知识）；site 默认本账号私有。
model RpaChromeSkill {
  id          Int      @id @default(autoincrement())
  createdBy   String   @map("created_by") @db.VarChar(64)
  name        String   @db.VarChar(120)
  /// personal | site
  kind        String   @default("personal") @db.VarChar(16)
  description String   @default("") @db.VarChar(500)
  /// markdown 正文
  content     String   @db.Text
  /// site 类技能的归属站点（hostname）；personal 为空
  site        String   @default("") @db.VarChar(200)
  enabled     Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([createdBy, name])
  @@index([createdBy, kind, updatedAt])
  @@map("rpa_chrome_skills")
}

/// 录制 → 生成的可复用工具：一次成功操作沉淀为闭集动作序列（chrome_actions）。
model RpaChromeRecording {
  id        Int      @id @default(autoincrement())
  createdBy String   @map("created_by") @db.VarChar(64)
  name      String   @db.VarChar(120)
  site      String   @default("") @db.VarChar(200)
  actions   Json     @default("[]")
  stepCount Int      @default(0) @map("step_count")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([createdBy, name])
  @@index([createdBy, updatedAt])
  @@map("rpa_chrome_recordings")
}

/// 抽取结果：一次 Extract 的结构化产物（落库供导出/投递），按会话归属个人。
model RpaChromeExtract {
  id            Int      @id @default(autoincrement())
  createdBy     String   @map("created_by") @db.VarChar(64)
  agentId       Int      @default(0) @map("agent_id")
  url           String   @default("") @db.VarChar(2000)
  /// 抽取口径说明（要了哪些字段 / 怎么抽的）
  schemaNote    String   @default("") @map("schema_note") @db.VarChar(2000)
  data          Json     @default("{}")
  rows          Json     @default("[]")
  screenshotKey String   @default("") @map("screenshot_key") @db.VarChar(200)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdBy, agentId, createdAt])
  @@map("rpa_chrome_extracts")
}

/// 浏览器代理的计划任务：到点让本人某台在线设备按同一套会话引擎跑一个目标。
/// 绿灯闸——设备离线（插件没开）当轮跳过，不排队补跑；账号停用即自动暂停（isStanding 复权）。
model RpaChromeSchedule {
  id             Int       @id @default(autoincrement())
  createdBy      String    @map("created_by") @db.VarChar(64)
  /// 目标设备号；执行时按它取在线设备，离线即跳过本轮
  clientId       String    @default("") @map("client_id") @db.VarChar(64)
  title          String    @db.VarChar(80)
  /// 每轮交给会话引擎的一句话目标（自包含，不看历史）
  goal           String    @db.Text
  /// 能力档：act 操作 / crawl 顺链接批量抓取 / extract 抽取结构化结果
  mode           String    @default("act") @db.VarChar(16)
  startUrl       String    @default("") @map("start_url") @db.VarChar(2000)
  /// 确定性动作序列：给了就逐步回放（不走 LLM），空则走 LLM 决策
  script         Json      @default("[]")
  /// 采集产物去向（none/extract/table）：定时重跑每轮都按它落表，配合 landing.dedupBy 不产生重复行
  persist        String    @default("none") @db.VarChar(16)
  /// persist=table 的目标多维表格（0＝按 landing.tableName 定位或新建）
  tableId        Int       @default(0) @map("table_id")
  /// 落表口径（tableName/fields/dedupBy）：随会话一并下发，重跑口径固定在计划里
  landing        Json?
  /// 决策用模型（空＝「模型设置」默认文本槽位）
  model          String    @default("") @db.VarChar(128)
  maxSteps       Int       @default(25) @map("max_steps")
  /// scheduled＝定时一次；recurring＝周期重复（计划任务不允许 once）
  scheduleType   String    @default("recurring") @map("schedule_type") @db.VarChar(16)
  scheduleConfig Json      @default("{}") @map("schedule_config")
  /// 下一次执行时刻；定时一次跑完即置空
  scheduledAt    DateTime? @map("scheduled_at")
  /// enabled | paused
  status         String    @default("enabled") @db.VarChar(16)
  lastRunAt      DateTime? @map("last_run_at")
  /// 最近一次结果：running | succeeded | failed | skipped；空串＝还没跑过
  lastStatus     String    @default("") @map("last_status") @db.VarChar(16)
  lastError      String    @default("") @map("last_error") @db.VarChar(500)
  /// 最近一次执行产生的会话 id（0＝无），界面据此查看结果
  lastSessionId  Int       @default(0) @map("last_session_id")
  runCount       Int       @default(0) @map("run_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([createdBy, status])
  @@index([status, scheduleType, scheduledAt])
  @@map("rpa_chrome_schedules")
}

model WorkbuddyAccount {
  id              Int       @id @default(autoincrement())
  createdBy       String    @map("created_by") @db.VarChar(64)
  /// 用户自己起的名，便于在派发时区分「哪把 key」
  name            String    @db.VarChar(128)
  secretIdCipher  String    @map("secret_id_cipher") @db.Text
  secretKeyCipher String    @map("secret_key_cipher") @db.Text
  /// 资源所在地域（API Explorer 按地域选，如 ap-beijing / ap-nanjing）；所有接口本身不强制 Region
  region          String    @default("ap-guangzhou") @db.VarChar(32)
  /// active | disabled：停用后不再参与派发，历史任务与消息保留
  status          String    @default("active") @db.VarChar(16)
  /// 最近一次「连通性校验」成功时间（DescribeAgentList 实调通过才更新）
  lastVerifiedAt  DateTime? @map("last_verified_at")
  /// 校验失败原因，界面提示用
  lastError       String    @default("") @map("last_error") @db.VarChar(500)
  notes           String    @default("") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([createdBy, status])
  @@map("workbuddy_accounts")
}

model WorkbuddyLlmSetting {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id") @db.VarChar(64)
  /// 历史按模块存的模型 Key 密文：保留存量，不再读写；平台 Key 统一走 Java 侧 sk_
  keyCipher String?  @map("key_cipher") @db.Text
  model     String   @default("") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workbuddy_llm_settings")
}

model WorkbuddyPlan {
  id             Int       @id @default(autoincrement())
  createdBy      String    @map("created_by") @db.VarChar(64)
  /// 新建方式：ai＝和 AI 沟通分析并确定任务；direct＝明确生成任务；scheduled＝定时任务
  kind           String    @default("ai") @db.VarChar(16)
  title          String    @db.VarChar(200)
  /// 用户原始表述（含多轮澄清的完整对话），回看与重新拆解用
  rawInput       String    @default("") @map("raw_input") @db.Text
  /// 澄清后的任务书：{ goal, steps[], deliverable, acceptance }
  spec           Json      @default("{}")
  /// 拆解出的执行任务数（0 = 还没拆）
  taskCount      Int       @default(0) @map("task_count")
  /// 派发方式：single（单账号）| fan_out（多账号并行，一份任务书各跑一遍）
  strategy       String    @default("single") @db.VarChar(16)
  /// 参与的 Workbuddy 账号 ID 数组（fan_out 时多于 1 个）
  accountIds     Json      @default("[]") @map("account_ids")
  /// 排期方式：once＝不排期；scheduled＝定时一次；recurring＝周期重复（与 RPA 任务同一套字段口径）
  scheduleType   String    @default("once") @map("schedule_type") @db.VarChar(16)
  /// 周期重复配置：{ freq, time, weekdays, day, minute }
  scheduleConfig Json      @default("{}") @map("schedule_config")
  /// 下一次执行时刻（定时一次＝用户选的时间；周期重复＝调度器推算出来的下一轮）
  scheduledAt    DateTime? @map("scheduled_at")
  /// draft | clarifying | ready | running | succeeded | failed | cancelled
  status         String    @default("draft") @db.VarChar(16)
  /// 汇总产出（跑完后由各任务结果收口）
  summary        String    @default("") @db.Text
  lastError      String    @default("") @map("last_error") @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([createdBy, status])
  @@index([createdBy, kind])
  @@index([kind, scheduleType, scheduledAt])
  @@map("workbuddy_plans")
}

model WorkbuddyTask {
  id           Int       @id @default(autoincrement())
  planId       Int       @map("plan_id")
  createdBy    String    @map("created_by") @db.VarChar(64)
  /// 任务类型，跟随所属计划：ai | direct | scheduled（列表按它筛选）
  kind         String    @default("ai") @db.VarChar(16)
  /// 计划内序号，界面按它排序
  seq          Int       @default(1)
  /// 派发用的 Workbuddy 账号（腾讯云凭据），执行期只在这条链路上解密
  accountId    Int       @map("account_id")
  /// 远程 Agent ID / 版本 ID（腾讯云侧主键，字符串）
  agentId      String    @default("") @map("agent_id") @db.VarChar(64)
  versionId    String    @default("") @map("version_id") @db.VarChar(64)
  /// CreateAgentSession 回传的会话 ID 与聊天入口（执行走会话端点，不是 OpenAPI）
  sessionId    String    @default("") @map("session_id") @db.VarChar(128)
  endpoint     String    @default("") @db.VarChar(500)
  /// 本次要交给 Agent 的完整指令（任务书里分给这一段的内容）
  instruction  String    @default("") @db.Text
  /// pending | running | succeeded | failed | cancelled
  status       String    @default("pending") @db.VarChar(16)
  /// 已同步到的消息事件水位（DescribeMessageEventList 的最后一个 seq）
  lastEventSeq Int       @default(0) @map("last_event_seq")
  output       Json      @default("{}")
  lastError    String    @default("") @map("last_error") @db.VarChar(500)
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([planId])
  @@index([createdBy, status])
  @@index([accountId])
  @@map("workbuddy_tasks")
}

model WorkbuddyTaskEvent {
  id         Int      @id @default(autoincrement())
  taskId     Int      @map("task_id")
  /// 腾讯云侧事件序号，唯一约束保证重复轮询不写两遍
  seq        Int
  /// user | tool | assistant
  eventType  String   @map("event_type") @db.VarChar(16)
  content    String   @default("") @db.Text
  toolName   String   @default("") @map("tool_name") @db.VarChar(128)
  toolInput  String   @default("") @map("tool_input") @db.Text
  toolOutput String   @default("") @map("tool_output") @db.Text
  /// TokenUsage：{ input, output, total }
  tokenUsage Json     @default("{}") @map("token_usage")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@unique([taskId, seq])
  @@map("workbuddy_task_events")
}

/// Agent-Bot·Workbuddy 主机：用户本机装了 WorkBuddy + AIPDD Enterprise 客户端的一台机器。
/// 归属账号；客户端主动出站心跳（默认 5 秒），平台经指令队列下发自然语言任务。
model WorkbuddyCloudCommand {
  id              Int       @id @default(autoincrement())
  userId          String    @map("user_id") @db.VarChar(64)
  accountId       Int       @map("account_id")
  agentId         String    @default("") @map("agent_id") @db.VarChar(64)
  versionId       String    @default("") @map("version_id") @db.VarChar(64)
  conversationId  Int       @default(0) @map("conversation_id")
  sessionId       String    @default("") @map("session_id") @db.VarChar(128)
  endpoint        String    @default("") @db.VarChar(500)
  commandCode     String    @unique @map("command_code") @db.VarChar(40)
  kind            String    @default("prompt") @db.VarChar(16)
  title           String    @default("") @db.VarChar(200)
  payload         Json      @default("{}")
  status          String    @default("PENDING") @db.VarChar(16)
  progressText    String    @default("") @map("progress_text") @db.Text
  result          Json      @default("{}")
  error           String    @default("") @db.VarChar(500)
  cancelRequested Boolean   @default(false) @map("cancel_requested")
  /// 派单来源：UI＝企云账号页面手动下发，AGENT＝Agent 群控派发（与主机指令表同口径，见方案 §5 第 7 条）
  source          String    @default("UI") @db.VarChar(16)
  /// 发起派单的站内 Agent 会话（0＝非群控派单）
  agentConversationId Int       @default(0) @map("agent_conversation_id")
  sourceTaskId    Int       @default(0) @map("source_task_id")
  scheduleId      Int       @default(0) @map("schedule_id")
  retryCount      Int       @default(0) @map("retry_count")
  dispatchedAt    DateTime? @map("dispatched_at")
  finishedAt      DateTime? @map("finished_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([accountId, status, id])
  @@index([userId, createdAt])
  @@index([userId, source, id])
  @@index([status, updatedAt])
  @@index([scheduleId, createdAt])
  @@map("workbuddy_cloud_commands")
}

model WorkbuddyCloudSchedule {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id") @db.VarChar(64)
  accountId      Int       @map("account_id")
  title          String    @db.VarChar(80)
  instruction    String    @db.Text
  payload        Json      @default("{}")
  scheduleType   String    @default("recurring") @map("schedule_type") @db.VarChar(16)
  scheduleConfig Json      @default("{}") @map("schedule_config")
  scheduledAt    DateTime? @map("scheduled_at")
  status         String    @default("enabled") @db.VarChar(16)
  /// 派单来源：UI＝企云页面手动创建，AGENT＝Agent 群控创建（台账按它筛「仅 Agent 派单」）
  source         String    @default("UI") @db.VarChar(16)
  /// 创建该定时任务的站内 Agent 会话（0＝非群控创建）
  agentConversationId Int       @default(0) @map("agent_conversation_id")
  lastRunAt      DateTime? @map("last_run_at")
  lastStatus     String    @default("") @map("last_status") @db.VarChar(16)
  lastError      String    @default("") @map("last_error") @db.VarChar(500)
  runCount       Int       @default(0) @map("run_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([userId, source, id])
  @@index([status, scheduleType, scheduledAt])
  @@map("workbuddy_cloud_schedules")
}

model WorkbuddyCloudScheduleRun {
  id             Int       @id @default(autoincrement())
  scheduleId     Int       @map("schedule_id")
  accountId      Int       @map("account_id")
  userId         String    @map("user_id") @db.VarChar(64)
  status         String    @default("queued") @db.VarChar(16)
  commandCode    String    @default("") @map("command_code") @db.VarChar(40)
  conversationId Int       @default(0) @map("conversation_id")
  error          String    @default("") @db.VarChar(500)
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([scheduleId, createdAt])
  @@map("workbuddy_cloud_schedule_runs")
}

model WorkbuddyHost {
  id               Int       @id @default(autoincrement())
  /// 归属用户（本站账户 userId）
  userId           String    @map("user_id") @db.VarChar(64)
  /// 设备显示名（配对时用户填写）
  name             String    @default("") @db.VarChar(80)
  /// DESKTOP＝BotBuddy 桌面主机；AWBOT＝AWBot 手机
  clientKind       String    @default("DESKTOP") @map("client_kind") @db.VarChar(16)
  /// win | mac（客户端自报；本期不含 Linux 主机）
  platform         String    @default("") @db.VarChar(16)
  /// 主机令牌哈希：sha256(明文 wb_...)；明文只在配对成功响应里出现一次
  tokenHash        String    @unique @map("token_hash") @db.VarChar(64)
  /// 令牌前 8 位，仅供界面识别
  tokenPrefix      String    @default("") @map("token_prefix") @db.VarChar(16)
  /// ONLINE | OFFLINE | NEVER | DISABLED（OFFLINE 由心跳超时折算，不落库）
  status           String    @default("NEVER") @db.VarChar(16)
  /// 客户端程序版本
  clientVersion    String    @default("") @map("client_version") @db.VarChar(24)
  /// 心跳自报：本机是否检测到在跑的 WorkBuddy
  wbDetected       Boolean   @default(false) @map("wb_detected")
  /// 能力指纹 { acpPort, acp, os, at }
  caps             Json      @default("{}")
  /// 客户端默认工作区（任务 cwd 缺省取它）
  workingDir       String    @default("") @map("working_dir") @db.VarChar(300)
  /// 心跳周期（秒），随心跳下发
  heartbeatSeconds Int       @default(5) @map("heartbeat_seconds")
  lastSeenAt       DateTime? @map("last_seen_at")
  lastIp           String    @default("") @map("last_ip") @db.VarChar(64)
  enabled          Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId, status])
  @@index([userId, clientKind, status])
  @@map("workbuddy_hosts")
}

/// Workbuddy 主机·「通信」通道：每台主机自带一条内置通道（kind=workbuddy_host），不可删除。
/// 与 ContentAgentAssistantChannel 同构（凭据密文 AES-256-GCM、allowedUsers、启停）。
model WorkbuddyHostChannel {
  id           Int       @id @default(autoincrement())
  hostId       Int       @map("host_id")
  userId       String    @map("user_id") @db.VarChar(64)
  /// 固定 workbuddy_host（主机内置通道）
  kind         String    @default("workbuddy_host") @db.VarChar(24)
  name         String    @default("通信") @db.VarChar(80)
  /// 通道凭据密文（AES-256-GCM），实际鉴权凭据即主机令牌哈希
  configCipher String    @default("") @map("config_cipher") @db.Text
  /// 允许经此通道下发的账号（空＝不限，仅归属人可用）
  allowedUsers Json      @default("[]") @map("allowed_users")
  enabled      Boolean   @default(true)
  lastEventAt  DateTime? @map("last_event_at")
  eventCount   Int       @default(0) @map("event_count")
  lastError    String    @default("") @map("last_error") @db.VarChar(300)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([hostId, kind])
  @@index([userId, enabled])
  @@map("workbuddy_host_channels")
}

/// Workbuddy 主机·指令队列（核心表）：平台写入，主机心跳领取，按 commandCode 幂等回执。
/// kind=prompt 直投 WorkBuddy ACP；schedule 记来源为定时任务（载荷同构，只多回指计划）。
model WorkbuddyHostCommand {
  id                  Int       @id @default(autoincrement())
  userId              String    @map("user_id") @db.VarChar(64)
  hostId              Int       @map("host_id")
  /// 归属会话（WorkbuddyHostConversation.conversationId）；为 0 表示无会话（如纯手动下发）
  conversationId      Int       @default(0) @map("conversation_id")
  /// 服务端生成的指令码，主机回执按它幂等（唯一）
  commandCode         String    @unique @map("command_code") @db.VarChar(40)
  /// prompt | schedule
  kind                String    @default("prompt") @db.VarChar(16)
  title               String    @default("") @db.VarChar(200)
  /// 载荷 { instruction, cwd, timeoutSec }
  payload             Json      @default("{}")
  /// PENDING | DISPATCHED | DONE | FAILED | TIMEOUT | CANCELED
  status              String    @default("PENDING") @db.VarChar(16)
  /// 流式进度累积（客户端 progress 回传的片段，节流写入）
  progressText        String    @default("") @map("progress_text") @db.Text
  /// 终结回执 { text, errorMessage, elapsedMs, acpSessionId }
  result              Json      @default("{}")
  error               String    @default("") @db.VarChar(500)
  acpSessionId        String    @default("") @map("acp_session_id") @db.VarChar(80)
  /// 平台侧取消标记：客户端下次 progress/心跳读到后中断执行
  cancelRequested     Boolean   @default(false) @map("cancel_requested")
  /// 关联的统一任务中心待办（0＝无）
  sourceTaskId        Int       @default(0) @map("source_task_id")
  /// 派单来源：UI＝设备页面手动下发，AGENT＝Agent 群控派单
  source              String    @default("UI") @db.VarChar(16)
  /// Agent 群控派单发起的站内会话（0＝非群控派单）
  agentConversationId Int       @default(0) @map("agent_conversation_id")
  /// 关联的定时任务（0＝非定时）
  scheduleId          Int       @default(0) @map("schedule_id")
  retryCount          Int       @default(0) @map("retry_count")
  dispatchedAt        DateTime? @map("dispatched_at")
  finishedAt          DateTime? @map("finished_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([hostId, status, id])
  @@index([userId, createdAt])
  @@index([scheduleId, createdAt])
  @@index([userId, source, id])
  @@map("workbuddy_host_commands")
}

/// Workbuddy 主机·会话映射：一台主机一个对话框（会话消息复用 ContentAgentConversation / Message）。
model WorkbuddyHostConversation {
  id             Int       @id @default(autoincrement())
  hostId         Int       @unique @map("host_id")
  userId         String    @map("user_id") @db.VarChar(64)
  /// ContentAgentConversation.id
  conversationId Int       @map("conversation_id")
  title          String    @default("") @db.VarChar(80)
  lastMessageAt  DateTime? @map("last_message_at")
  messageCount   Int       @default(0) @map("message_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId, lastMessageAt])
  @@map("workbuddy_host_conversations")
}

/// Workbuddy 主机·定时任务：复用统一时间口径（once/scheduled/recurring），到点由调度器下发指令。
model WorkbuddyHostSchedule {
  id                  Int       @id @default(autoincrement())
  userId              String    @map("user_id") @db.VarChar(64)
  hostId              Int       @map("host_id")
  title               String    @db.VarChar(80)
  /// 每轮下发的自然语言指令（自包含，不看历史）
  instruction         String    @db.Text
  /// 额外载荷 { cwd, timeoutSec }
  payload             Json      @default("{}")
  /// once | scheduled | recurring
  scheduleType        String    @default("recurring") @map("schedule_type") @db.VarChar(16)
  scheduleConfig      Json      @default("{}") @map("schedule_config")
  /// 下一次执行时刻；once 跑完即置空
  scheduledAt         DateTime? @map("scheduled_at")
  /// enabled | paused
  status              String    @default("enabled") @db.VarChar(16)
  lastRunAt           DateTime? @map("last_run_at")
  /// running | queued | succeeded | failed | skipped；空串＝还没跑过
  lastStatus          String    @default("") @map("last_status") @db.VarChar(16)
  lastError           String    @default("") @map("last_error") @db.VarChar(500)
  runCount            Int       @default(0) @map("run_count")
  /// 派单来源：UI＝设备页面手动创建，AGENT＝Agent 群控创建
  source              String    @default("UI") @db.VarChar(16)
  /// Agent 群控创建时的站内会话（0＝非群控创建）
  agentConversationId Int       @default(0) @map("agent_conversation_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([status, scheduleType, scheduledAt])
  @@index([userId, source, id])
  @@map("workbuddy_host_schedules")
}

/// Workbuddy 主机·定时任务运行记录：一行一轮，可跳回当轮对话看结果。
model WorkbuddyHostScheduleRun {
  id             Int       @id @default(autoincrement())
  scheduleId     Int       @map("schedule_id")
  hostId         Int       @map("host_id")
  userId         String    @map("user_id") @db.VarChar(64)
  /// queued | dispatched | succeeded | failed | skipped
  status         String    @default("queued") @db.VarChar(16)
  commandCode    String    @default("") @map("command_code") @db.VarChar(40)
  /// 归属会话（跳转用）
  conversationId Int       @default(0) @map("conversation_id")
  error          String    @default("") @db.VarChar(500)
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([scheduleId, createdAt])
  @@map("workbuddy_host_schedule_runs")
}

/// Workbuddy 主机·配对码：客户端申请 → 用户在平台输码绑定 → 客户端轮询取回令牌。
/// 6 位、单次有效、10 分钟过期、用后即废。
model WorkbuddyHostPairCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(12)
  /// DESKTOP | AWBOT：连接码认领后建出的设备类型
  clientKind  String    @default("DESKTOP") @map("client_kind") @db.VarChar(16)
  /// 客户端自报设备信息 { os, hostname, clientVersion }
  deviceInfo  Json      @default("{}") @map("device_info")
  /// 绑定后回填
  userId      String    @default("") @map("user_id") @db.VarChar(64)
  hostId      Int       @default(0) @map("host_id")
  /// 绑定成功后一次性返回的明文令牌（客户端取走后清空，避免重复泄露）
  issuedToken String    @default("") @map("issued_token") @db.VarChar(80)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("workbuddy_host_pair_codes")
}

/// Bot 主机·平台模型授权（B 方案）：用户/管理员在平台选一个模型渠道 + 模型，
/// 主机心跳时把该渠道的真实密钥一次性下发给客户端，客户端按「平台渠道」使用；
/// 平台只在这里记录授权关系，不保存客户端本地配置。
model WorkbuddyHostModelGrant {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(64)
  hostId    Int      @unique @map("host_id")
  /// 指向 content_model_channels；-1 为本站内置渠道（LocalAPI）
  channelId Int      @map("channel_id")
  model     String   @db.VarChar(128)
  enabled   Boolean  @default(true)
  /// default＝跟随平台默认文本模型 / platform＝平台为本机授权 / client＝客户端改动同步上来
  source    String   @default("platform") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, enabled])
  @@map("workbuddy_host_model_grants")
}

model AiCallAccount {
  id             Int                    @id @default(autoincrement())
  createdBy      String                 @map("created_by") @db.VarChar(64)
  /// 便于在任务里认出「用哪个账号」
  name           String                 @db.VarChar(128)
  /// 平台名或站点地址（如 淘宝 / https://www.taobao.com），由用户按平台填写
  platform       String                 @db.VarChar(191)
  loginUrl       String                 @default("") @map("login_url") @db.VarChar(500)
  username       String                 @default("") @db.VarChar(191)
  /// 登录口令密文：base64(iv):base64(tag):base64(payload)，AES-256-GCM
  passwordCipher String                 @default("") @map("password_cipher") @db.Text
  apiKeyCipher   String                 @default("") @map("api_key_cipher") @db.Text
  cookieCipher   String                 @default("") @map("cookie_cipher") @db.Text
  /// 平台特有的其他凭据（token / 租户 ID 等），明文 JSON，不含口令类敏感值
  extra          Json                   @default("{}")
  /// active | disabled
  status         String                 @default("active") @db.VarChar(16)
  notes          String                 @default("") @db.VarChar(500)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  bindings       AiCallAccountBinding[]

  @@index([createdBy, status])
  @@map("ai_call_accounts")
}

/// AI 调用账号 ↔ Agent 设备绑定：主体是 BotBuddy 主机（DESKTOP）、AWBot 手机（AWBOT）
/// 或 WorkBuddy 企业账号（WORKBUDDY）三者之一；多态引用，归属校验在服务层做。
model AiCallAccountBinding {
  id            Int           @id @default(autoincrement())
  accountId     Int           @map("account_id")
  /// DESKTOP | AWBOT | WORKBUDDY
  principalKind String        @map("principal_kind") @db.VarChar(16)
  /// 指向 workbuddy_hosts.id 或 workbuddy_accounts.id（按 principal_kind 区分）
  principalId   Int           @map("principal_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  account       AiCallAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, principalKind, principalId])
  @@index([principalKind, principalId])
  @@map("ai_call_account_bindings")
}

/// Google 潜客线索挖掘：每账号一份设置（Serper Key + 承载线索的多维表格 + 默认模型）
model LeadProspectingSetting {
  id              Int      @id @default(autoincrement())
  userId          String   @unique @map("user_id") @db.VarChar(64)
  /// Serper.dev API Key 密文：base64(iv):base64(tag):base64(payload)，AES-256-GCM
  serperKeyCipher String   @default("") @map("serper_key_cipher") @db.Text
  /// 承载挖掘结果的多维表格 id（data_tables.id，0＝尚未生成）
  dataTableId     Int      @default(0) @map("data_table_id")
  /// 默认 AIPDD 模型名（Key 走「API Key 管理」统一维护，这里只存 model）
  model           String   @default("") @db.VarChar(128)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("lead_prospecting_settings")
}

/// 一次潜客挖掘任务（AI 澄清意图后由用户提交）
model LeadProspectingTask {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id") @db.VarChar(64)
  /// 结构化后由用户提交的需求 JSON：{ keyword, scene, country, num_results }
  spec         Json     @default("{}")
  /// 原始自然语言需求（首次输入 + AI 澄清后的补充说明）
  rawIntent    String   @default("") @map("raw_intent") @db.Text
  /// pending | running | completed | failed
  status       String   @default("pending") @db.VarChar(16)
  /// 执行结果统计
  totalFound   Int      @default(0) @map("total_found")
  totalSaved   Int      @default(0) @map("total_saved")
  totalSkipped Int      @default(0) @map("total_skipped")
  /// 承载本次结果的多维表格快照 id（可能后续被用户改换）
  dataTableId  Int      @default(0) @map("data_table_id")
  error        String   @default("") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([status])
  @@map("lead_prospecting_tasks")
}

/// 意图澄清对话的消息记录（挂在具体任务上；未成任务时 taskId=0 表示草稿会话）
model LeadProspectingMessage {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(64)
  taskId    Int      @default(0) @map("task_id")
  role      String   @db.VarChar(16)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, taskId, createdAt])
  @@map("lead_prospecting_messages")
}

/// 大数据查询（营销工具）：每账号每数据集一份设置（结果表 + 默认模型）
/// 五个数据集彼此独立：各自的对话、各自的任务列表、各自的多维表格结果表
model BigdataQuerySetting {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.VarChar(64)
  /// 数据集键：enterprise | buyer | person | kol | poi（定义见 contracts 的 BIGDATA_DATASETS）
  dataset     String   @db.VarChar(32)
  /// 承载查询结果的多维表格 id（data_tables.id，0＝尚未生成）
  dataTableId Int      @default(0) @map("data_table_id")
  /// 默认 AIPDD 模型名（Key 走「API Key 管理」统一维护，这里只存 model）
  model       String   @default("") @db.VarChar(128)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, dataset])
  @@map("bigdata_query_settings")
}

/// 一次大数据查询任务（AI 把自然语言需求解析成上游查询参数后由用户提交）
model BigdataQueryTask {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id") @db.VarChar(64)
  dataset      String   @db.VarChar(32)
  /// 结构化后由用户提交的需求 JSON：{ filters, limit, scene }
  spec         Json     @default("{}")
  /// 原始自然语言需求（首次输入 + AI 澄清后的补充说明）
  rawIntent    String   @default("") @map("raw_intent") @db.Text
  /// pending | running | success | failed
  status       String   @default("pending") @db.VarChar(16)
  /// 执行结果统计：上游命中 / 写入结果表 / 因源数据ID已存在而跳过
  totalFound   Int      @default(0) @map("total_found")
  totalSaved   Int      @default(0) @map("total_saved")
  totalSkipped Int      @default(0) @map("total_skipped")
  /// 承载本次结果的多维表格快照 id（可能后续被用户改换）
  dataTableId  Int      @default(0) @map("data_table_id")
  error        String   @default("") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId, dataset, createdAt])
  @@index([status])
  @@map("bigdata_query_tasks")
}

/// 需求澄清对话的消息记录（按数据集分开留存；未成任务时 taskId=0 表示草稿会话）
model BigdataQueryMessage {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(64)
  dataset   String   @db.VarChar(32)
  taskId    Int      @default(0) @map("task_id")
  role      String   @db.VarChar(16)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, dataset, taskId, createdAt])
  @@map("bigdata_query_messages")
}

/// 阿里云智能外呼：每账号一份 AK 设置（地域 + 默认实例）
model AliyunCallSetting {
  id                    Int      @id @default(autoincrement())
  userId                String   @unique @map("user_id") @db.VarChar(64)
  accessKeyId           String   @default("") @map("access_key_id") @db.VarChar(128)
  /// AccessKeySecret 密文：base64(iv):base64(tag):base64(payload)，AES-256-GCM
  accessKeySecretCipher String   @default("") @map("access_key_secret_cipher") @db.Text
  /// outboundbot 地域：只在上海（cn-shanghai）开放
  region                String   @default("cn-shanghai") @db.VarChar(32)
  /// 默认业务实例 id（OutboundBot InstanceId）
  instanceId            String   @default("") @map("instance_id") @db.VarChar(64)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("aliyun_call_settings")
}

/// 一次外呼名单导入批次：new=新建任务组，append=追加到已有任务组
model AliyunCallImport {
  id             Int                   @id @default(autoincrement())
  userId         String                @map("user_id") @db.VarChar(64)
  /// new | append
  mode           String                @db.VarChar(16)
  tableId        Int                   @map("table_id")
  tableName      String                @default("") @map("table_name") @db.VarChar(191)
  /// 字段映射：{ phone, name, honorific, honorificMode, honorificValue, role, extras[] }
  mappingJson    Json                  @default("{}") @map("mapping_json")
  instanceId     String                @map("instance_id") @db.VarChar(64)
  scriptId       String                @default("") @map("script_id") @db.VarChar(64)
  jobGroupId     String                @default("") @map("job_group_id") @db.VarChar(64)
  jobGroupName   String                @default("") @map("job_group_name") @db.VarChar(191)
  strategyJson   Json?                 @map("strategy_json")
  callingNumbers Json?                 @map("calling_numbers")
  /// queued | running | partial | succeeded | failed
  status         String                @default("queued") @db.VarChar(16)
  totalRows      Int                   @default(0) @map("total_rows")
  sentRows       Int                   @default(0) @map("sent_rows")
  failedRows     Int                   @default(0) @map("failed_rows")
  skippedRows    Int                   @default(0) @map("skipped_rows")
  errorCode      String                @default("") @map("error_code") @db.VarChar(64)
  errorMessage   String                @default("") @map("error_message") @db.Text
  jobGroupStatus String                @default("") @map("job_group_status") @db.VarChar(32)
  syncedAt       DateTime?             @map("synced_at")
  startedAt      DateTime?             @map("started_at")
  finishedAt     DateTime?             @map("finished_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  rows           AliyunCallImportRow[]

  @@index([userId, createdAt])
  @@index([userId, jobGroupId])
  @@map("aliyun_call_imports")
}

/// 导入批次的行级结果：号码只留打码值与 SHA-256 哈希，重试时按 source_row_id 回原表取号
model AliyunCallImportRow {
  id           Int              @id @default(autoincrement())
  importId     Int              @map("import_id")
  sourceRowId  Int              @default(0) @map("source_row_id")
  referenceId  String           @default("") @map("reference_id") @db.VarChar(128)
  name         String           @default("") @db.VarChar(191)
  phoneMasked  String           @default("") @map("phone_masked") @db.VarChar(32)
  phoneHash    String           @default("") @map("phone_hash") @db.VarChar(64)
  /// pending | sent | failed | skipped
  status       String           @default("pending") @db.VarChar(16)
  jobId        String           @default("") @map("job_id") @db.VarChar(64)
  errorCode    String           @default("") @map("error_code") @db.VarChar(64)
  errorMessage String           @default("") @map("error_message") @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")
  import       AliyunCallImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, status])
  @@index([phoneHash])
  @@map("aliyun_call_import_rows")
}

/// 阿里云邮件推送：每账号一份 AK 设置（地域 + 默认收件人列表）
model AliyunMailSetting {
  id                    Int      @id @default(autoincrement())
  userId                String   @unique @map("user_id") @db.VarChar(64)
  accessKeyId           String   @default("") @map("access_key_id") @db.VarChar(128)
  /// AccessKeySecret 密文：base64(iv):base64(tag):base64(payload)，AES-256-GCM
  accessKeySecretCipher String   @default("") @map("access_key_secret_cipher") @db.Text
  /// 邮件推送地域：默认华东 1（杭州），必须与控制台选择一致
  region                String   @default("cn-hangzhou") @db.VarChar(32)
  /// 默认收件人列表（Direct Mail ReceiverId）
  defaultReceiverId     String   @default("") @map("default_receiver_id") @db.VarChar(64)
  defaultReceiverName   String   @default("") @map("default_receiver_name") @db.VarChar(191)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("aliyun_mail_settings")
}

/// 一次联系人同步批次：new=新建收件人列表，append=追加到已有列表
model AliyunMailImport {
  id           Int                   @id @default(autoincrement())
  userId       String                @map("user_id") @db.VarChar(64)
  /// new | append
  mode         String                @db.VarChar(16)
  tableId      Int                   @map("table_id")
  tableName    String                @default("") @map("table_name") @db.VarChar(191)
  /// 字段映射：{ emailFieldKey, variables[{key, fieldKey}], writeBack }
  mappingJson  Json                  @default("{}") @map("mapping_json")
  receiverId   String                @default("") @map("receiver_id") @db.VarChar(64)
  receiverName String                @default("") @map("receiver_name") @db.VarChar(191)
  /// queued | running | partial | succeeded | failed
  status       String                @default("queued") @db.VarChar(16)
  totalRows    Int                   @default(0) @map("total_rows")
  sentRows     Int                   @default(0) @map("sent_rows")
  failedRows   Int                   @default(0) @map("failed_rows")
  skippedRows  Int                   @default(0) @map("skipped_rows")
  errorCode    String                @default("") @map("error_code") @db.VarChar(64)
  errorMessage String                @default("") @map("error_message") @db.Text
  /// 同步后回读的列表总人数（0＝未回读）
  listCount    Int                   @default(0) @map("list_count")
  startedAt    DateTime?             @map("started_at")
  finishedAt   DateTime?             @map("finished_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  rows         AliyunMailImportRow[]

  @@index([userId, createdAt])
  @@index([userId, receiverId])
  @@map("aliyun_mail_imports")
}

/// 同步批次的行级结果：邮箱只留打码值与 SHA-256 哈希，重试时按 source_row_id 回原表取值
model AliyunMailImportRow {
  id           Int              @id @default(autoincrement())
  importId     Int              @map("import_id")
  sourceRowId  Int              @default(0) @map("source_row_id")
  emailMasked  String           @default("") @map("email_masked") @db.VarChar(191)
  emailHash    String           @default("") @map("email_hash") @db.VarChar(64)
  /// success | duplicate | invalid | failed
  status       String           @default("pending") @db.VarChar(16)
  errorCode    String           @default("") @map("error_code") @db.VarChar(64)
  errorMessage String           @default("") @map("error_message") @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")
  import       AliyunMailImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, status])
  @@index([emailHash])
  @@map("aliyun_mail_import_rows")
}

/// 本地台账：账号 + 收件人列表 + 邮箱哈希唯一，追加模式据此跳过已推过的联系人
model AliyunMailContact {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id") @db.VarChar(64)
  receiverId   String   @map("receiver_id") @db.VarChar(64)
  emailHash    String   @map("email_hash") @db.VarChar(64)
  lastImportId Int      @default(0) @map("last_import_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([userId, receiverId, emailHash])
  @@index([lastImportId])
  @@map("aliyun_mail_contacts")
}

/// 腾讯企点营销云：一个产品一套凭据（企业ID + secretId + secretKey + 空间ID），按登录账号归属
model TpAccount {
  id              Int       @id @default(autoincrement())
  userId          String    @map("user_id") @db.VarChar(64)
  /// CDP | SCRM | CA | LM | MA | RTA
  product         String    @db.VarChar(16)
  label           String    @default("") @db.VarChar(191)
  /// 网关基址：SaaS 为 https://tmc.qidian.qq.com，私有化填客户自己的域名（路径同为 /api/gateway/v1）
  gateway         String    @default("https://tmc.qidian.qq.com") @db.VarChar(191)
  corporationId   String    @map("corporation_id") @db.VarChar(64)
  secretId        String    @default("") @map("secret_id") @db.VarChar(128)
  /// secretKey 密文：base64(iv):base64(tag):base64(payload)，AES-256-GCM
  secretKeyCipher String    @default("") @map("secret_key_cipher") @db.Text
  /// 空间ID（bizId），决定可见数据范围
  bizId           String    @map("biz_id") @db.VarChar(64)
  /// active | disabled
  status          String    @default("active") @db.VarChar(16)
  lastVerifiedAt  DateTime? @map("last_verified_at")
  lastError       String    @default("") @map("last_error") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([userId, product, corporationId, bizId])
  @@index([userId, product])
  @@map("tp_accounts")
}

/// 企点侧的每一次批量动作与异步任务（分群导出、图卡取数、导入、写 CRM、群发）
model TpTask {
  id             Int           @id @default(autoincrement())
  userId         String        @map("user_id") @db.VarChar(64)
  accountId      Int           @default(0) @map("account_id")
  /// CDP | SCRM | CA | LM | MA | RTA | CRM
  product        String        @db.VarChar(16)
  /// 逐字等于契约 operationId（Tp_cdpImportCustomers、Tp_crmImport...）
  action         String        @db.VarChar(64)
  /// 关联的多维表格（导入来源或结果写回表；0＝不涉及表格）
  tableId        Int           @default(0) @map("table_id")
  tableName      String        @default("") @map("table_name") @db.VarChar(191)
  /// 字段映射：{ 目标字段: 来源列 }，结构沿用大数据/潜客的映射
  mappingJson    Json          @default("{}") @map("mapping_json")
  /// 动作参数摘要（凭据、明文手机号与邮箱一律不进这里）
  params         Json          @default("{}")
  /// PENDING | RUNNING | SUCCEEDED | PARTIAL | FAILED
  status         String        @default("PENDING") @db.VarChar(16)
  /// 企点侧异步任务ID（导入/导出/图卡结果轮询用）
  upstreamTaskId String        @default("") @map("upstream_task_id") @db.VarChar(128)
  totalRows      Int           @default(0) @map("total_rows")
  successRows    Int           @default(0) @map("success_rows")
  failedRows     Int           @default(0) @map("failed_rows")
  skippedRows    Int           @default(0) @map("skipped_rows")
  errorCode      String        @default("") @map("error_code") @db.VarChar(64)
  errorMessage   String        @default("") @map("error_message") @db.VarChar(500)
  startedAt      DateTime?     @map("started_at")
  finishedAt     DateTime?     @map("finished_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  events         TpTaskEvent[]

  @@index([userId, product, createdAt])
  @@index([userId, status])
  @@index([upstreamTaskId])
  @@map("tp_tasks")
}

/// 任务的过程日志：轮询到的上游状态、分批进度、失败原因，只追加不改
model TpTaskEvent {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  /// info | warn | error
  level     String   @default("info") @db.VarChar(16)
  message   String   @db.VarChar(500)
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  task      TpTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, id])
  @@map("tp_task_events")
}

/// 每个数据集（如 cdp_customer_import）在指定表上的列映射，下次执行不用重填
model TpMapping {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(64)
  datasetKey String   @map("dataset_key") @db.VarChar(64)
  tableId    Int      @map("table_id")
  tableName  String   @default("") @map("table_name") @db.VarChar(191)
  columnMap  Json     @default("{}") @map("column_map")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, datasetKey, tableId])
  @@map("tp_mappings")
}

/// L0 意图事件流：本站「操作/指令」的唯一记忆入口，append-only，写入收口在 AgentMemoryService.record()
model AgentMemoryEvent {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id") @db.VarChar(64)
  /// 业务域：请求路径首段（enterprise/api-v1 之后），如 tax、rpa、data-tables、workbuddy
  domain       String   @db.VarChar(32)
  /// 动作名，逐字等于契约 operationId（如 DataTable_createRow、Rpa_createTasks）
  action       String   @db.VarChar(64)
  /// 操作对象类型（表/任务/计划/企业...），供回放与提炼认对象
  targetType   String   @default("") @map("target_type") @db.VarChar(32)
  targetId     String   @default("") @map("target_id") @db.VarChar(64)
  targetLabel  String   @default("") @map("target_label") @db.VarChar(200)
  /// 脱敏后的参数摘要（凭据、明文邮箱、原文一律不进这里）
  params       Json     @default("{}")
  /// ok | failed | blocked
  outcome      String   @default("ok") @db.VarChar(16)
  errorCode    String   @default("") @map("error_code") @db.VarChar(64)
  errorMessage String   @default("") @map("error_message") @db.VarChar(500)
  /// web＝浏览器；machine＝ek_ 机器身份；mcp＝MCP 客户端；scheduler＝本系统调度器
  channel      String   @default("web") @db.VarChar(16)
  /// 同一次动作写入的 audit_logs 主键（0＝这条没有对应留痕），是两套记录的锚
  auditLogId   Int      @default(0) @map("audit_log_id")
  occurredAt   DateTime @default(now()) @map("occurred_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, occurredAt])
  @@index([userId, action, occurredAt])
  @@index([auditLogId])
  @@map("agent_memory_events")
}

/// 夜间提炼出的待确认候选：必须带出处（sourceEventIds），没有出处的结论不进界面
model AgentMemoryCandidate {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id") @db.VarChar(64)
  /// preference＝参数偏好（表单预填）；playbook＝可重复动作序列（剧本）
  kind           String    @db.VarChar(16)
  /// preference: { key, value }；playbook: { name, description, trigger, steps[] }
  payload        Json      @default("{}")
  sourceEventIds Json      @default("[]") @map("source_event_ids")
  /// 人话证据，如「近 30 天出现 7 次：批量写行 → 建潜客任务」
  evidence       String    @default("") @db.VarChar(500)
  /// candidate | adopted | rejected | expired
  status         String    @default("candidate") @db.VarChar(16)
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId, status, createdAt])
  @@map("agent_memory_candidates")
}

/// L1 已采纳偏好：按账号唯一，键名带业务域前缀，值只存参数默认值
model AgentPreference {
  id             Int      @id @default(autoincrement())
  userId         String   @map("user_id") @db.VarChar(64)
  /// 如 rpa.task.deviceType、bigdata.resultTable、datarow.targetTable
  key            String   @db.VarChar(128)
  value          Json     @default("{}")
  sourceEventIds Json     @default("[]") @map("source_event_ids")
  /// 被表单预填命中的次数，用于排序与淘汰
  hits           Int      @default(0)
  adoptedAt      DateTime @default(now()) @map("adopted_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([userId, key])
  @@map("agent_preferences")
}

/// L2 剧本：参数化步骤序列。steps 只有本站业务域与动作，不含任何客户端专有字段，换执行器不改剧本
model AgentPlaybook {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id") @db.VarChar(64)
  name           String    @db.VarChar(200)
  description    String    @default("") @db.VarChar(500)
  /// { timeWindow, conditions }，供「什么时候该跑」判断与界面展示
  trigger        Json      @default("{}")
  /// [{ domain, action, paramsTemplate, sourceEventId }]
  steps          Json      @default("[]")
  /// self＝本系统调度器直跑；external＝交给 MCP 客户端自取；workbuddy＝投影成 Workbuddy 计划
  executor       String    @default("self") @db.VarChar(16)
  /// candidate | active | retired
  status         String    @default("candidate") @db.VarChar(16)
  runs           Int       @default(0)
  successes      Int       @default(0)
  lastRunAt      DateTime? @map("last_run_at")
  sourceEventIds Json      @default("[]") @map("source_event_ids")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("agent_playbooks")
}

/// L3 授权闸：一次一令。dry-run 预览报文 → 口令签发 → 短时效 + 默认一次性 + 只覆盖本剧本的 domain:action
model AgentGrant {
  id           Int       @id @default(autoincrement())
  userId       String    @map("user_id") @db.VarChar(64)
  playbookId   Int       @map("playbook_id")
  /// 允许的 domain:action 白名单数组，写请求落库前逐条比对
  scope        Json      @default("[]")
  /// 预览时的真实报文摘要（留痕：用户当时到底批了什么）
  dryRunResult Json      @default("{}") @map("dry_run_result")
  oneTime      Boolean   @default(true) @map("one_time")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  /// active | consumed | expired | revoked
  status       String    @default("active") @db.VarChar(16)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId, status])
  @@index([playbookId, status])
  @@map("agent_grants")
}

/// 账号级自动执行授权：勾选过的写动作才允许 MCP 服务端无人值守执行，一行＝一个 operationId
model AgentActionGrant {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.VarChar(64)
  domain      String   @db.VarChar(32)
  /// ACTION＝契约层 operationId（如 DataTable_addRow）；CONNECTOR＝固定存 'CONNECTOR'
  action      String   @db.VarChar(64)
  /// ACTION（契约动作，存量行）| CONNECTOR（用户自建 MCP 连接器，按连接器整体授权）
  scopeType   String   @default("ACTION") @map("scope_type") @db.VarChar(16)
  /// scopeType=CONNECTOR 时指向 content_agent_mcp_connectors.id；ACTION 行为 0
  connectorId Int      @default(0) @map("connector_id")
  createdAt   DateTime @default(now()) @map("created_at")

  /// CONNECTOR 行的 action 是固定值，必须带上 connectorId 才不互相顶掉
  @@unique([userId, scopeType, action, connectorId], name: "agent_action_grants_scope_key")
  @@index([userId])
  @@index([userId, scopeType])
  @@map("agent_action_grants")
}

/// L3 执行记录：剧本的 runs/successes 由这张表回写，界面「执行记录」也读这张表
model AgentPlaybookRun {
  id          Int       @id @default(autoincrement())
  userId      String    @map("user_id") @db.VarChar(64)
  playbookId  Int       @map("playbook_id")
  grantId     Int       @default(0) @map("grant_id")
  /// self | external | workbuddy，与剧本同一枚举（记当次实际由谁执行）
  executor    String    @default("self") @db.VarChar(16)
  /// ok | failed | blocked
  outcome     String    @default("ok") @db.VarChar(16)
  /// [{ step, domain, action, ok, errorCode, errorMessage }]，错误文案已过 sanitizeErrorMessage
  stepsResult Json      @default("[]") @map("steps_result")
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")

  @@index([userId, startedAt])
  @@index([playbookId, startedAt])
  @@map("agent_playbook_runs")
}

// ---------------------------------------------------------------------------
// 内容创作与 Agent（P0）：会话/消息/长期记忆、模型渠道与槽位、生成任务、资产台账
// 全部按登录账号（userId）归属；模型凭据列只存密文（content-crypto 的 AES-256-GCM）
// ---------------------------------------------------------------------------

/// Agent 会话：标题可改；model 为会话默认模型（空＝跟随模型设置的文本槽位）
model ContentAgentConversation {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.VarChar(64)
  title       String   @default("") @db.VarChar(80)
  model       String   @default("") @db.VarChar(128)
  /// 绑定使用的公共专家（0＝无）；专家被删也不清历史会话上的名字
  expertId    Int      @default(0) @map("expert_id")
  expertName  String   @default("") @map("expert_name") @db.VarChar(40)
  /// 本会话使用的数字分身（0＝自动：模型按每轮语义自选）；分身被删也不清历史会话上的名字
  personaId   Int      @default(0) @map("persona_id")
  personaName String   @default("") @map("persona_name") @db.VarChar(30)
  /// 会话归属台面：agent（Agent 页）/ workbuddy_host（Workbuddy 主机对话）。
  /// 两个台面各自只读自己的会话，主机对话不会出现在 Agent 的会话列表里。
  scene       String   @default("agent") @map("scene") @db.VarChar(24)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@index([userId, scene, updatedAt])
  @@map("content_agent_conversations")
}

/// 会话消息：toolCalls 记本轮工具调用（名称/参数摘要/结果），media 记产出的媒体卡
model ContentAgentMessage {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  userId         String   @map("user_id") @db.VarChar(64)
  /// user | assistant | tool
  role           String   @db.VarChar(16)
  content        String   @default("") @db.Text
  toolCalls      Json     @default("[]") @map("tool_calls")
  media          Json     @default("[]")
  /// 用户这一轮带的参考素材：[{label,fileName,url,media}]；只存在 user 行
  references     Json     @default("[]")
  /// ok | failed | canceled
  status         String   @default("ok") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@map("content_agent_messages")
}

/// 长期记忆：Agent 的 save_memory 与用户在「记忆」页写入；normalized 做去重键
model ContentAgentMemory {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(64)
  /// 0＝账号共用记忆（所有分身都注入）；>0＝只属于该数字分身
  personaId  Int      @default(0) @map("persona_id")
  /// fact | preference | instruction
  kind       String   @default("fact") @db.VarChar(16)
  content    String   @db.Text
  normalized String   @db.VarChar(200)
  /// agent | user
  source     String   @default("agent") @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, personaId, normalized])
  @@index([userId, createdAt])
  @@map("content_agent_memories")
}

/// 数字分身：一个登录账号可建多个，每个一套回复风格 + 人设，并可挂默认知识范围与执行模型
model ContentAgentPersona {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(64)
  /// 名称：在对话与问题大厅里选中分身时显示，同账号内唯一
  name       String   @db.VarChar(30)
  /// professional | friendly | direct | imaginative | sarcastic | efficient | socratic；空＝不限定
  style      String   @default("") @db.VarChar(32)
  /// 用户自己写的人设，最多 500 字；只影响语气与表达方式
  persona    String   @default("") @db.VarChar(500)
  /// 默认知识空间：本轮没另选时知识检索只在这个空间＋资料库里查；0＝不限定
  spaceId    Int      @default(0) @map("space_id")
  /// 默认资料库 id 清单；本轮输入区另选资料时以本轮为准
  libraryIds Json?    @map("library_ids")
  /// 默认执行渠道（模型设置里的 channelId）；0＝跟随「模型设置 → 文本」槽位
  channelId  Int      @default(0) @map("channel_id")
  /// 默认执行模型；空＝跟随槽位默认模型
  model      String   @default("") @db.VarChar(128)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId, id])
  @@map("content_agent_personas")
}

/// 模型渠道：aipdd 为内置（Key 取自「API Key 管理」，本表不存）；custom/mediakit 存密文
model ContentModelChannel {
  id           Int       @id @default(autoincrement())
  userId       String    @map("user_id") @db.VarChar(64)
  /// aipdd | custom | mediakit
  provider     String    @db.VarChar(16)
  name         String    @db.VarChar(64)
  baseUrl      String    @default("") @map("base_url") @db.VarChar(300)
  keyCipher    String    @default("") @map("key_cipher") @db.Text
  /// 火山引擎专用：豆包语音识别（openspeech）的 Key，与方舟 Key 不通用
  asrKeyCipher String    @default("") @map("asr_key_cipher") @db.Text
  /// 预设：openai / anthropic / deepseek / qwen / moonshot / zhipu / openrouter / custom
  preset       String    @default("") @db.VarChar(16)
  enabled      Boolean   @default(true)
  /// Key 通过连通校验的时间；换 Key / 换地址后清空，未校验的渠道不允许被选为默认模型
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([userId, provider, name])
  @@index([userId])
  @@map("content_model_channels")
}

/// 默认模型槽位：一个账号每种类型一行；enhance 记视频增强默认档位
model ContentModelSlot {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(64)
  /// text | vision | image | video | audio | asr | music | enhance
  mediaType String   @map("media_type") @db.VarChar(16)
  channelId Int      @default(0) @map("channel_id")
  model     String   @default("") @db.VarChar(128)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, mediaType])
  @@map("content_model_slots")
}

/// 生成任务：图片/文本同步完成也落一行，视频/音乐/超分按 PENDING→RUNNING→终态推进
model ContentGenerationJob {
  id                 Int       @id @default(autoincrement())
  userId             String    @map("user_id") @db.VarChar(64)
  tool               String    @db.VarChar(32)
  /// PENDING | RUNNING | SUCCESS | FAILED | CANCELED
  status             String    @default("PENDING") @db.VarChar(16)
  input              Json      @default("{}")
  /// 本轮用户选的模型：{ mediaType: { channelId, model } }；空＝用「模型设置」的默认槽位
  models             Json      @default("{}")
  output             Json      @default("{}")
  assetUrl           String    @default("") @map("asset_url") @db.Text
  aipddAssetId       String    @default("") @map("aipdd_asset_id") @db.VarChar(64)
  error              String    @default("") @db.VarChar(500)
  /// 发起端：tool（内容创作小工具）| canvas（AI 画布）| studio（三个工作台）
  source             String    @default("tool") @db.VarChar(12)
  /// 画布任务归属（source=canvas 时非 0）
  canvasId           Int       @default(0) @map("canvas_id")
  /// 画布节点 id（空串＝非画布任务）
  nodeId             String    @default("") @map("node_id") @db.VarChar(64)
  /// 同一节点一次提交的批次 id：批量出图 N 张共享，节点按 runId 聚合结果
  runId              String    @default("") @map("run_id") @db.VarChar(64)
  /// 生成类型：image | video | music | text
  media              String    @default("") @db.VarChar(12)
  /// 0-100 进度（PENDING=0，起跑 5，产物落库 95，SUCCESS=100）
  progress           Int       @default(0)
  /// 取消/中断原因；CANCELED 时说明上游计费不退回
  cancelReason       String    @default("") @map("cancel_reason") @db.VarChar(200)
  /// 上游受理的子任务号（网关没给就为空）；取消后可据此查上游是否已计费
  upstreamTaskId     String    @default("") @map("upstream_task_id") @db.VarChar(128)
  /// 上游受理时间（提交流转到上游的时刻）
  upstreamAcceptedAt DateTime? @map("upstream_accepted_at")
  startedAt          DateTime? @map("started_at")
  finishedAt         DateTime? @map("finished_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([status, updatedAt])
  /// 调度池取活：status + id，按 PENDING 最老优先
  @@index([status, id])
  @@index([canvasId])
  @@map("content_generation_jobs")
}

/// AI 画布：整包 JSON 快照存节点/连线/视口；高频字段拆列索引，不做节点分表
model ContentCanvasProject {
  id         Int      @id @default(autoincrement())
  /// 作者
  userId     String   @map("user_id") @db.VarChar(64)
  title      String   @default("未命名画布") @db.VarChar(80)
  /// 整包快照：{ version, nodes[], edges[], viewport:{x,y,zoom} }
  doc        Json     @default("{}")
  /// 文档自增版本：保存时校验，冲突返回版本冲突
  version    Int      @default(0)
  /// DRAFT | ACTIVE | ARCHIVED
  status     String   @default("ACTIVE") @db.VarChar(16)
  /// 来源模板（0＝空白新建）
  templateId Int      @default(0) @map("template_id")
  /// 资源引用摘要：[{ assetId, type, name, url }]
  assetRefs  Json     @default("[]") @map("asset_refs")
  nodeCount  Int      @default(0) @map("node_count")
  coverUrl   String   @default("") @map("cover_url") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@index([userId, status])
  @@index([templateId])
  @@map("content_canvas_projects")
}

/// 短视频模版：发布者给出样片、参考图、提示词与所用模型；viewCost>0 时首位非发布者查看扣分给作者
model VideoTemplate {
  id               Int      @id @default(autoincrement())
  userId           String   @map("user_id") @db.VarChar(64)
  /// LOCAL | AIWORKIN；AIWORKIN 由平台管理员开启后从上游补充，固定 owner 无发布者收益
  source           String   @default("LOCAL") @db.VarChar(16)
  /// 上游模版唯一键；本站发布的为空
  upstreamId       String?  @unique @map("upstream_id") @db.VarChar(128)
  title            String   @db.VarChar(200)
  description      String   @default("") @db.Text
  /// all-reference | character-swap | motion | lip-sync | other
  videoType        String   @default("all-reference") @map("video_type") @db.VarChar(24)
  sampleUrl        String   @map("sample_url") @db.Text
  /// 封面图；空＝前端退回第一张参考图
  coverUrl         String   @default("") @map("cover_url") @db.Text
  /// 参考图直链数组：string[]
  referenceImages  Json     @default("[]") @map("reference_images")
  prompt           String   @db.Text
  /// 发布者当时用的渠道显示名与模型名，仅供复刻者选模型时参考
  modelChannelName String   @default("") @map("model_channel_name") @db.VarChar(120)
  modelName        String   @map("model_name") @db.VarChar(200)
  /// 查看积分：0＝免费；同一查看者只扣一次
  viewCost         Int      @default(0) @map("view_cost")
  viewCount        Int      @default(0) @map("view_count")
  useCount         Int      @default(0) @map("use_count")
  favoriteCount    Int      @default(0) @map("favorite_count")
  ratingSum        Int      @default(0) @map("rating_sum")
  ratingCount      Int      @default(0) @map("rating_count")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([videoType, createdAt])
  @@index([useCount])
  @@index([favoriteCount])
  @@map("video_templates")
}

/// 模版收藏：按账号唯一，重复收藏幂等
model VideoTemplateFavorite {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(64)
  templateId Int      @map("template_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, templateId])
  @@index([templateId])
  @@map("video_template_favorites")
}

/// 模版评分：1–5 分，一人一票可改分；聚合值冗余在 video_templates.rating_sum/rating_count
model VideoTemplateRating {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(64)
  templateId Int      @map("template_id")
  score      Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, templateId])
  @@index([templateId])
  @@map("video_template_ratings")
}

/// 付费查看记录：唯一键保证同一账号同一模版只扣一次积分
model VideoTemplateView {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(64)
  templateId Int      @map("template_id")
  /// 本次查看支付的积分（免费模版为 0）
  points     Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, templateId])
  @@index([templateId])
  @@map("video_template_views")
}

/// 资产台账：登记 AIPDD 数字资产的本地留痕（唯一真相在平台侧，这里只用来补登记与展示）
model ContentAsset {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id") @db.VarChar(64)
  jobId        Int      @default(0) @map("job_id")
  /// image | video | audio | text
  kind         String   @default("image") @db.VarChar(16)
  url          String   @db.Text
  aipddAssetId String   @default("") @map("aipdd_asset_id") @db.VarChar(64)
  name         String   @default("") @db.VarChar(200)
  /// ok | failed（failed 保留 url，可重试登记）
  status       String   @default("ok") @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([jobId])
  @@map("content_assets")
}

/// 数字资产归属台账：只记「本系统哪个账号造过/传过哪条平台资产」，展示与打标都以它圈定范围
model DigitalAssetEntry {
  id               Int      @id @default(autoincrement())
  userId           String   @map("user_id") @db.VarChar(64)
  aipddAssetId     Int      @map("aipdd_asset_id")
  /// image | video | audio | file
  type             String   @default("file") @db.VarChar(16)
  name             String   @default("") @db.VarChar(200)
  url              String   @default("") @db.Text
  previewUrl       String   @default("") @map("preview_url") @db.Text
  /// MB（平台口径）
  fileSize         Float    @default(0) @map("file_size")
  /// 本站 OSS 对象键：非空＝字节存在自有阿里云桶（积分改造后的新底座）；空＝存于 AIPDD 的旧资产
  ossKey           String   @default("") @map("oss_key") @db.VarChar(500)
  /// 迁移来源：migrated＝已从 AIPDD 平台转存进自有桶
  migratedFrom     String   @default("") @map("migrated_from") @db.VarChar(16)
  labels           Json     @default("[]")
  /// 抽取正文：上传时对可读文档（md/txt/csv/json/html/docx/pptx/xlsx/pdf）解析存入，
  /// 供知识库按 assetId 投料直接编译（修 assetId 断链）；图片/音视频为空
  text             String?  @db.LongText
  /// AI 视觉理解/摘要（P1-C）：图片走视觉模型、文档走文本模型的简要描述，供找相似与内容创作复用
  caption          String?  @db.Text
  /// 相似检索向量（P1-C）：本地袋装 256 维或远端真实向量，与 kb_chunks 同一套可插拔口径
  embedding        Json?
  /// 向量模型标识：local-hash-256 或 embed:<模型名>；不同模型不混算
  embedModel       String   @default("") @map("embed_model") @db.VarChar(128)
  /// 内容安全检测结论：空＝未检、pass＝通过、block＝拦截、pending＝视频异步待出结果
  moderation       String   @default("") @db.VarChar(16)
  moderationNote   String   @default("") @map("moderation_note") @db.VarChar(300)
  /// 视频异步审核任务 id（阿里云 video/asyncscan），由调度轮询回填结论
  moderationTaskId String   @default("") @map("moderation_task_id") @db.VarChar(128)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, aipddAssetId])
  @@index([userId, updatedAt])
  @@map("digital_asset_entries")
}

/// 共享资料：把一条 AIPDD 数字资产共享给本企业的指定账号（按账号一对一，多选＝多行）
model ContentSharedAsset {
  id           Int      @id @default(autoincrement())
  /// 资料归属账号（同时是这条资产在 AIPDD 的归属账号）
  ownerUserId  String   @map("owner_user_id") @db.VarChar(64)
  assetId      String   @map("asset_id") @db.VarChar(128)
  assetName    String   @default("") @map("asset_name") @db.VarChar(200)
  assetType    String   @default("file") @map("asset_type") @db.VarChar(16)
  assetSize    Float    @default(0) @map("asset_size")
  assetUrl     String   @default("") @map("asset_url") @db.Text
  targetUserId String   @map("target_user_id") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([ownerUserId, assetId, targetUserId])
  @@index([targetUserId, createdAt])
  @@index([ownerUserId, createdAt])
  @@map("content_shared_assets")
}

/// Agent 技能：一句说明进系统提示，模型用 load_skill 取全文；按账号归属
model ContentAgentSkill {
  id            Int       @id @default(autoincrement())
  userId        String    @map("user_id") @db.VarChar(64)
  name          String    @db.VarChar(60)
  description   String    @default("") @db.VarChar(200)
  /// SKILL.md 正文（zip 技能包读出来的主文件）
  content       String    @default("") @db.Text
  /// 技能包内的附加文本文件 [{ path, content }]，load_skill 的 file 参数用它
  files         Json      @default("[]")
  enabled       Boolean   @default(true)
  /// 审查状态（§5.9）：pending＝待审 / passed＝绝对安全可用 / rejected＝红线或 LLM 否决 / needsAdmin＝待管理员人工放行
  reviewStatus  String    @default("pending") @map("review_status") @db.VarChar(16)
  /// 审查结论 { decision, riskLevel, violations[], summary, model }
  reviewVerdict Json      @default("{}") @map("review_verdict")
  reviewedAt    DateTime? @map("reviewed_at")
  /// 放行来源：llm＝自动审查 / admin:userId＝人工放行 / grandfathered＝存量首扫无命中追溯通过
  reviewedBy    String    @default("") @map("reviewed_by") @db.VarChar(32)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId, enabled])
  @@map("content_agent_skills")
}

/// 技能的历史版本快照：同名覆盖前存旧内容，可查可回滚（防第三方包静默替换后无从追溯）
model ContentAgentRevision {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.VarChar(64)
  /// 资产类型（历史取值含 plugin，插件下线后仅保留 skill 写入）
  kind        String   @db.VarChar(8)
  /// 被覆盖的技能 id（行可能已删，只当回溯线索）
  itemId      Int      @map("item_id")
  name        String   @db.VarChar(60)
  description String   @default("") @db.VarChar(200)
  /// 覆盖前的正文
  content     String   @default("") @db.Text
  /// 覆盖前的包内文件 [{ path, content }]
  files       Json     @default("[]")
  /// 快照当时的内容来源：upload＝上传包；skillhub＝目录安装
  source      String   @default("") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, kind, itemId])
  @@map("content_agent_revisions")
}

/// Agent 的 MCP 连接器：把外部 MCP Server 的工具并入 Agent；按账号归属，请求头只存密文
model ContentAgentMcpConnector {
  id            Int       @id @default(autoincrement())
  userId        String    @map("user_id") @db.VarChar(64)
  name          String    @db.VarChar(60)
  /// http＝Streamable HTTP（POST 一条 JSON-RPC）；sse＝旧版 HTTP+SSE（GET 流下发消息）
  transport     String    @default("http") @db.VarChar(8)
  url           String    @db.VarChar(500)
  /// 额外请求头 JSON 的密文（agent-mcp 上下文 AES-256-GCM）；空串＝没有额外头
  headers       String    @default("") @db.Text
  /// 请求头名字清单（明文，仅供界面展示；值只进不出）
  headerNames   Json      @default("[]") @map("header_names")
  enabled       Boolean   @default(true)
  toolCount     Int       @default(0) @map("tool_count")
  /// 最近一次探测到的工具名（供界面展示，不参与调用）
  toolNames     Json      @default("[]") @map("tool_names")
  /// 最近一次探测/调用的中文错误；空串＝正常
  lastError     String    @default("") @map("last_error") @db.VarChar(300)
  lastCheckedAt DateTime? @map("last_checked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId, enabled])
  @@map("content_agent_mcp_connectors")
}

/// Agent 专家：一段指令生成的公共角色（全站可用），只有创建人可删；useCount 记被启用的会话数
model ContentAgentExpert {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(40)
  /// 一句话介绍（卡片副标题）
  description String   @default("") @db.VarChar(200)
  /// 用户填写的原始指令
  instruction String   @default("") @db.Text
  /// 生成好的角色提示，注入 Agent 系统提示
  prompt      String   @default("") @db.Text
  createdBy   String   @map("created_by") @db.VarChar(64)
  creatorName String   @default("") @map("creator_name") @db.VarChar(64)
  useCount    Int      @default(0) @map("use_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([useCount, id])
  @@map("content_agent_experts")
}

/// Agent 资料库条目：把数字资产（或 Agent 产出的报告）收进来，切节点做检索；严格按账号归属
model ContentAgentLibraryItem {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id") @db.VarChar(64)
  /// 来源数字资产的平台 id；纯本地回流（平台不可用）时为 0
  aipddAssetId Int      @default(0) @map("aipdd_asset_id")
  /// asset | report
  source       String   @default("asset") @db.VarChar(16)
  name         String   @default("") @db.VarChar(200)
  /// md | txt | csv | json | html | docx | pptx | xlsx | pdf
  type         String   @default("md") @db.VarChar(16)
  url          String   @default("") @db.Text
  fileSize     Float    @default(0) @map("file_size")
  /// 抽取出的全文（超长截断）；整篇改写时以它为底
  text         String   @default("") @db.Text
  charCount    Int      @default(0) @map("char_count")
  nodeCount    Int      @default(0) @map("node_count")
  /// ready | empty | failed | missing（原件在数字资产里已不存在）
  status       String   @default("ready") @db.VarChar(16)
  /// 失败/失效原因（中文，直接展示；正常时为空）
  note         String   @default("") @db.VarChar(200)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@index([userId, aipddAssetId])
  @@map("content_agent_library_items")
}

/// 资料节点：按 Markdown 标题 / 段落 / 表格块 / PDF 页切出的检索单元
model ContentAgentLibraryNode {
  id        Int      @id @default(autoincrement())
  itemId    Int      @map("item_id")
  userId    String   @map("user_id") @db.VarChar(64)
  /// section | paragraph | table | page | slide
  kind      String   @default("section") @db.VarChar(16)
  /// 标题路径（如「第一章 > 1.2 市场现状」）；整篇改写后重建
  path      String   @default("") @db.VarChar(300)
  ordinal   Int      @default(0)
  content   String   @db.Text
  chars     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([itemId, ordinal])
  @@index([userId])
  @@map("content_agent_library_nodes")
}

/// AI 改写草稿：模型改 Markdown 先落这里，用户点「接受」才写回正文，绝不静默覆盖
model ContentAgentLibraryDraft {
  id        Int       @id @default(autoincrement())
  userId    String    @map("user_id") @db.VarChar(64)
  itemId    Int       @map("item_id")
  /// 0＝整篇；否则只改这个节点
  nodeId    Int       @default(0) @map("node_id")
  nodePath  String    @default("") @map("node_path") @db.VarChar(300)
  reason    String    @default("") @db.VarChar(300)
  before    String    @default("") @db.Text
  after     String    @default("") @db.Text
  /// pending | accepted | rejected
  status    String    @default("pending") @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at")
  decidedAt DateTime? @map("decided_at")

  @@index([userId, status, createdAt])
  @@index([itemId])
  @@map("content_agent_library_drafts")
}

/// Agent 定时任务：到点把 instruction 作为一轮对话交给 Agent 跑；排期字段与 Workbuddy/RPA 同一套口径
model ContentAgentSchedule {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id") @db.VarChar(64)
  /// 预设模板 id（daily_news / weekly_report / daily_report / mail_triage）；空串＝自定义任务
  preset         String    @default("") @db.VarChar(32)
  title          String    @db.VarChar(80)
  /// 每次执行时作为用户消息交给 Agent 的指令（自包含，不看历史）
  instruction    String    @default("") @db.Text
  /// 执行结果落到哪个会话；0＝首次执行时新建一个专属会话
  conversationId Int       @default(0) @map("conversation_id")
  /// 绑定的公共专家（0＝无）
  expertId       Int       @default(0) @map("expert_id")
  /// 本任务使用的数字分身（0＝自动：模型按每轮语义自选）
  personaId      Int       @default(0) @map("persona_id")
  /// 随任务固定引用的技能 id 数组；空＝全部启用中的技能
  skillIds       Json      @default("[]") @map("skill_ids")
  /// 随任务固定引用的资料库条目 id 数组；空＝整库检索
  libraryIds     Json      @default("[]") @map("library_ids")
  /// 随任务固定引用的 MCP 连接器 id 数组（0＝本站 MCP Server）；空＝全部启用中的连接器
  connectorIds   Json      @default("[]") @map("connector_ids")
  /// 本次任务只处理哪些邮箱账号 id；空＝不限定（仅未引用邮件能力时成立）
  mailboxIds     Json      @default("[]") @map("mailbox_ids")
  /// 到点这一轮允许指挥的设备类型：['DESKTOP','AWBOT'] 的子集；空＝不开群控
  dispatchScope  Json      @default("[]") @map("dispatch_scope")
  /// 无人值守是否允许执行写动作；false＝只读取与出草案，修改类动作一律拒
  allowWrite     Boolean   @default(false) @map("allow_write")
  /// 任务固定的参考文件（图片 / 视频 / 音频）：{label,fileName,url,media}
  references     Json      @default("[]")
  /// 文本模型渠道；0＝「模型设置」里的文本槽位
  channelId      Int       @default(0) @map("channel_id")
  model          String    @default("") @db.VarChar(128)
  /// scheduled＝定时一次；recurring＝周期重复（定时任务不允许 once）
  scheduleType   String    @default("recurring") @map("schedule_type") @db.VarChar(16)
  scheduleConfig Json      @default("{}") @map("schedule_config")
  /// 下一次执行时刻；定时一次跑完即置空
  scheduledAt    DateTime? @map("scheduled_at")
  /// enabled | paused
  status         String    @default("enabled") @db.VarChar(16)
  lastRunAt      DateTime? @map("last_run_at")
  /// 最近一次执行结果：succeeded | failed | skipped；空串＝还没跑过
  lastStatus     String    @default("") @map("last_status") @db.VarChar(16)
  lastError      String    @default("") @map("last_error") @db.VarChar(500)
  runCount       Int       @default(0) @map("run_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([status, scheduleType, scheduledAt])
  @@map("content_agent_schedules")
}

/// 定时任务执行记录：一次调度一行；成功时链到那轮对话，界面可一键打开看结果
model ContentAgentScheduleRun {
  id             Int       @id @default(autoincrement())
  scheduleId     Int       @map("schedule_id")
  userId         String    @map("user_id") @db.VarChar(64)
  /// scheduled | manual（用户点「立即执行」）
  trigger        String    @default("scheduled") @db.VarChar(16)
  /// running | succeeded | failed
  status         String    @default("running") @db.VarChar(16)
  /// 本轮对话 id（成功后界面「查看会话」用它跳转）
  conversationId Int       @default(0) @map("conversation_id")
  /// 助手消息 id
  messageId      Int       @default(0) @map("message_id")
  /// 产出摘要（成功时取回复前 500 字）
  summary        String    @default("") @db.VarChar(500)
  /// 失败原因（中文，直接展示）
  error          String    @default("") @db.VarChar(500)
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")

  @@index([scheduleId, startedAt])
  @@index([userId, startedAt])
  @@map("content_agent_schedule_runs")
}

/// Agent 助理：一条第三方消息通道的接入配置；凭据整体加密，webhook_token 走公开回调定位到这一行
model ContentAgentAssistantChannel {
  id           Int       @id @default(autoincrement())
  userId       String    @map("user_id") @db.VarChar(64)
  /// wecom_app / wecom_bot / wecom_kf / dingtalk_robot / dingtalk_webhook / feishu_app / qq_onebot / wechat_mp
  kind         String    @db.VarChar(32)
  name         String    @db.VarChar(80)
  /// 公开回调路径里的 32 位随机串；出站型（群机器人）也生成一个，便于统一展示
  webhookToken String    @unique @map("webhook_token") @db.VarChar(32)
  /// 平台凭据与参数（JSON）的 AES-256-GCM 密文
  configCipher String    @default("") @map("config_cipher") @db.Text
  /// 回复用的数字分身；0＝自动（按语义自选），分身自带的渠道/模型只在渠道与模型都为空时兜底
  personaId    Int       @default(0) @map("persona_id")
  /// 执行用的文本模型渠道；0＝「模型设置」文本槽位（无人值守时取不到账号 Key，会失败）
  channelId    Int       @default(0) @map("channel_id")
  model        String    @default("") @db.VarChar(128)
  /// 允许的发送者 ID，逗号分隔；空串＝不限制
  allowedUsers String    @default("") @map("allowed_users") @db.VarChar(500)
  enabled      Boolean   @default(true)
  lastEventAt  DateTime? @map("last_event_at")
  lastError    String    @default("") @map("last_error") @db.VarChar(500)
  eventCount   Int       @default(0) @map("event_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("content_agent_assistant_channels")
}

/// 助理会话映射：一个外部聊天对应一条 Agent 会话，保证远程对话有上下文
model ContentAgentAssistantChat {
  id             Int       @id @default(autoincrement())
  channelId      Int       @map("channel_id")
  userId         String    @map("user_id") @db.VarChar(64)
  /// 外部聊天标识：企业微信 userid / 飞书 chat_id / 钉钉 conversationId / QQ 群号或 QQ 号 / 微信客服 external_userid / 公众号 openid
  externalChatId String    @map("external_chat_id") @db.VarChar(191)
  conversationId Int       @map("conversation_id")
  title          String    @default("") @db.VarChar(120)
  /// 微信客服增量拉取游标（其它渠道为空串）
  cursor         String    @default("") @db.VarChar(191)
  lastUserId     String    @default("") @map("last_user_id") @db.VarChar(191)
  lastMessageAt  DateTime? @map("last_message_at")
  messageCount   Int       @default(0) @map("message_count")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([channelId, externalChatId])
  @@index([userId, lastMessageAt])
  @@map("content_agent_assistant_chats")
}

/// 助理消息日志：入站一条、回出的一条各一行；外部消息 ID 唯一用于平台重推去重
model ContentAgentAssistantMessage {
  id             Int      @id @default(autoincrement())
  channelId      Int      @map("channel_id")
  userId         String   @map("user_id") @db.VarChar(64)
  externalChatId String   @map("external_chat_id") @db.VarChar(191)
  externalMsgId  String?  @map("external_msg_id") @db.VarChar(191)
  /// in | out
  direction      String   @db.VarChar(8)
  content        String   @default("") @db.Text
  /// received | running | succeeded | failed | ignored
  status         String   @default("received") @db.VarChar(16)
  error          String   @default("") @db.VarChar(500)
  conversationId Int      @default(0) @map("conversation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([channelId, externalMsgId])
  @@index([channelId, createdAt])
  @@index([userId, createdAt])
  @@map("content_agent_assistant_messages")
}

/// 邮箱服务账号：一个登录账号可配多个邮箱；密码只存密文，邮件正文一律不落库
model MailAccount {
  id               Int       @id @default(autoincrement())
  userId           String    @map("user_id") @db.VarChar(64)
  address          String    @db.VarChar(160)
  displayName      String    @default("") @map("display_name") @db.VarChar(80)
  /// imap | pop3
  protocol         String    @default("imap") @db.VarChar(8)
  incomingHost     String    @map("incoming_host") @db.VarChar(160)
  incomingPort     Int       @map("incoming_port")
  /// ssl | starttls | none
  incomingSecurity String    @default("ssl") @map("incoming_security") @db.VarChar(10)
  incomingUsername String    @map("incoming_username") @db.VarChar(160)
  /// 收信密码/授权码密文（mailbox 上下文 AES-256-GCM）
  incomingSecret   String    @map("incoming_secret") @db.VarChar(1000)
  inboxFolder      String    @default("INBOX") @map("inbox_folder") @db.VarChar(80)
  draftsFolder     String    @default("Drafts") @map("drafts_folder") @db.VarChar(80)
  /// IMAP 发件箱：发出的回复留一份副本；POP3 无文件夹，忽略
  sentFolder       String    @default("Sent") @map("sent_folder") @db.VarChar(80)
  outgoingHost     String    @default("") @map("outgoing_host") @db.VarChar(160)
  outgoingPort     Int       @default(465) @map("outgoing_port")
  outgoingSecurity String    @default("ssl") @map("outgoing_security") @db.VarChar(10)
  outgoingUsername String    @default("") @map("outgoing_username") @db.VarChar(160)
  /// 发信密码密文；空串＝复用收信密码
  outgoingSecret   String    @default("") @map("outgoing_secret") @db.VarChar(1000)
  signature        String    @default("") @db.Text
  /// draft_only＝只写草稿；auto_send＝写好草稿并自动发出
  replyMode        String    @default("draft_only") @map("reply_mode") @db.VarChar(16)
  maxPerRun        Int       @default(10) @map("max_per_run")
  enabled          Boolean   @default(true)
  /// 随邮箱固定引用的资料库条目 id 数组；空＝整库检索
  libraryIds       Json      @default("[]") @map("library_ids")
  lastRunAt        DateTime? @map("last_run_at")
  lastError        String    @default("") @map("last_error") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([userId, address])
  @@index([userId, enabled])
  @@map("mail_accounts")
}

/// 邮箱场景话术：关键词/发件人命中时随 Agent 上下文注入，与技能、资料同为不可信资料
model MailScript {
  id            Int      @id @default(autoincrement())
  /// 兼容旧数据：旧话术归属的邮箱（新话术为 0）
  mailboxId     Int      @default(0) @map("mailbox_id")
  /// 生效邮箱（可多选；空数组＝全部邮箱）
  mailboxIds    Json     @default("[]") @map("mailbox_ids")
  userId        String   @map("user_id") @db.VarChar(64)
  name          String   @db.VarChar(80)
  /// 触发关键词，逗号分隔；空串＝不按关键词过滤
  keywords      String   @default("") @db.VarChar(300)
  /// 发件人匹配（子串）；空串＝不限
  senderPattern String   @default("") @map("sender_pattern") @db.VarChar(160)
  /// 同一封邮件命中多条时取数值小的
  priority      Int      @default(100)
  content       String   @db.Text
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([mailboxId, enabled, priority])
  @@map("mail_scripts")
}

/// 处理台账（最小化）：只记去重键、发件人与结果，不存主题、正文、附件
model MailHandleLog {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id") @db.VarChar(64)
  mailboxId   Int      @map("mailbox_id")
  /// 去重键：优先 Message-ID，缺失时用 UID/UIDL 派生的稳定串
  messageKey  String   @map("message_key") @db.VarChar(255)
  fromAddress String   @default("") @map("from_address") @db.VarChar(160)
  /// draft | sent | skipped
  result      String   @db.VarChar(16)
  /// 跳过原因或失败原因；空串＝正常
  reason      String   @default("") @db.VarChar(300)
  /// 处理日（Asia/Shanghai 当天零点），统计按它聚合
  handledOn   DateTime @map("handled_on") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([mailboxId, messageKey])
  @@index([userId, handledOn])
  @@index([mailboxId, fromAddress, handledOn])
  @@map("mail_handle_logs")
}

// ---------------------------------------------------------------- 统一组织成员 / 通知 / AI客服 / 活码（2026-10-30）

/// 统一组织成员：企业与服务商共用同一套关系（服务商旧表 provider_staff 在 dual 模式保持读写并镜像到本表）
model OrgStaff {
  id           Int       @id @default(autoincrement())
  /// ENTERPRISE | PROVIDER
  orgType      String    @map("org_type") @db.VarChar(16)
  orgUserId    String    @map("org_user_id") @db.VarChar(64)
  memberUserId String    @map("member_user_id") @db.VarChar(64)
  /// STAFF 职员 | AGENT 代理人
  memberKind   String    @default("STAFF") @map("member_kind") @db.VarChar(16)
  /// 角色：服务商沿用服务类目；企业用业务板块/岗位编码
  roles        Json      @default("[]")
  department   String    @default("") @db.VarChar(64)
  /// 岗位列表：[{ name, description }]，一人多岗；由本组织赋予
  positions    Json      @default("[]")
  /// 能力说明（本组织内一份，由本组织赋予）
  capabilities String    @default("") @db.Text
  /// 代理人的指派范围（业务模块/类目）；职员为空＝全量
  scope        Json      @default("[]")
  /// PENDING | ACTIVE | REMOVED
  status       String    @default("ACTIVE") @db.VarChar(16)
  invitedBy    String    @default("") @map("invited_by") @db.VarChar(64)
  confirmedAt  DateTime? @map("confirmed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, memberUserId])
  @@index([orgType, orgUserId, status])
  @@index([memberUserId, status])
  @@map("org_staff")
}

/// 组织职能目录：部门。OA 流程可按「部门 + 岗位」选签批人。
model OrgDepartment {
  id          Int      @id @default(autoincrement())
  orgType     String   @map("org_type") @db.VarChar(16)
  orgUserId   String   @map("org_user_id") @db.VarChar(64)
  name        String   @db.VarChar(64)
  description String   @default("") @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, name])
  @@index([orgType, orgUserId])
  @@map("org_departments")
}

/// 组织职能目录：岗位（含岗位说明）。一人可多岗，赋给成员时再落到 org_staff。
model OrgPosition {
  id          Int      @id @default(autoincrement())
  orgType     String   @map("org_type") @db.VarChar(16)
  orgUserId   String   @map("org_user_id") @db.VarChar(64)
  name        String   @db.VarChar(64)
  description String   @default("") @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, name])
  @@index([orgType, orgUserId])
  @@map("org_positions")
}

/// 组织成员邀请 / 申请（企业只开放 INVITE：邀请 → 本人确认）
model OrgApplication {
  id           Int       @id @default(autoincrement())
  orgType      String    @map("org_type") @db.VarChar(16)
  orgUserId    String    @map("org_user_id") @db.VarChar(64)
  memberUserId String    @map("member_user_id") @db.VarChar(64)
  memberKind   String    @default("STAFF") @map("member_kind") @db.VarChar(16)
  /// INVITE | JOIN
  direction    String    @db.VarChar(16)
  roles        Json      @default("[]")
  scope        Json      @default("[]")
  department   String    @default("") @db.VarChar(64)
  positions    Json      @default("[]")
  capabilities String    @default("") @db.Text
  note         String    @default("") @db.VarChar(500)
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status       String    @default("PENDING") @db.VarChar(16)
  createdBy    String    @default("") @map("created_by") @db.VarChar(64)
  decidedAt    DateTime? @map("decided_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([orgType, orgUserId, status])
  @@index([memberUserId, status])
  @@map("org_applications")
}

/// 全站系统消息（右上角铃铛）；所有模块统一经 NotificationService 写入
model Notification {
  id         Int       @id @default(autoincrement())
  userId     String    @map("user_id") @db.VarChar(64)
  /// service_desk | demand | identity | tax | automation | account | platform
  category   String    @db.VarChar(32)
  /// info | warning | error
  level      String    @default("info") @db.VarChar(16)
  title      String    @db.VarChar(200)
  body       String    @default("") @db.Text
  link       String    @default("") @db.VarChar(500)
  entityType String    @default("") @map("entity_type") @db.VarChar(32)
  entityId   String    @default("") @map("entity_id") @db.VarChar(64)
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt, id])
  @@index([userId, category])
  @@map("notifications")
}

/// AI客服渠道接入：企业自备官方开放平台凭据，只接双向官方 API
model ServiceDeskChannel {
  id            Int       @id @default(autoincrement())
  ownerUserId   String    @map("owner_user_id") @db.VarChar(64)
  /// wecom_kf | wecom_app | wechat_mp | feishu_app | dingtalk_robot
  kind          String    @db.VarChar(32)
  name          String    @db.VarChar(80)
  /// 平台凭据密文（service-desk 上下文 AES-256-GCM）
  config        String    @db.Text
  /// 回调地址里的随机串
  callbackToken String    @unique @map("callback_token") @db.VarChar(32)
  enabled       Boolean   @default(true)
  /// 微信客服增量拉取游标（其它渠道为空串）
  cursor        String    @default("") @db.Text
  lastEventAt   DateTime? @map("last_event_at")
  lastError     String    @default("") @map("last_error") @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([ownerUserId])
  @@map("service_desk_channels")
}

/// AI客服站点（一个账号多个官网/多语言站）
model ServiceDeskSite {
  id             Int      @id @default(autoincrement())
  ownerUserId    String   @map("owner_user_id") @db.VarChar(64)
  siteKey        String   @unique @map("site_key") @db.VarChar(48)
  name           String   @db.VarChar(80)
  /// 允许引用该站点的来源域名列表
  allowedOrigins Json     @default("[]")
  /// 外观：标题、颜色、头像、欢迎语、默认语言
  appearance     Json     @default("{}")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId])
  @@map("service_desk_sites")
}

/// AI客服账号级设置
model ServiceDeskSetting {
  id                Int      @id @default(autoincrement())
  ownerUserId       String   @unique @map("owner_user_id") @db.VarChar(64)
  /// { days: number[], start: "09:00", end: "18:00" }
  businessHours     Json     @default("{}") @map("business_hours")
