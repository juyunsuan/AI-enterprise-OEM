  contactName  String   @default("") @map("contact_name") @db.VarChar(64)
  phone        String   @default("") @db.VarChar(32)
  email        String   @default("") @db.VarChar(120)
  taxNo        String   @default("") @map("tax_no") @db.VarChar(32)
  address      String   @default("") @db.VarChar(200)
  /// 一个主体可同时承担多种角色
  roles        Json     @default("[]")
  /// 能力标签、行业、区域、交付类型
  capabilities Json     @default("[]")
  /// 报价：{ hourlyRate, dailyRate, currency, byRole: [] }
  rateCard     Json     @default("{}") @map("rate_card")
  /// 档期与产能：{ availableFrom, capacityHoursPerWeek, leadTimeDays }
  availability Json     @default("{}")
  /// 资质与合规：{ qualification, contractSigned, ndaSigned, invoiceType, note }
  compliance   Json     @default("{}")
  rating       Decimal  @default(0) @db.Decimal(4, 2)
  /// MANUAL | DEMAND | ERP | CRM
  source       String   @default("MANUAL") @db.VarChar(16)
  /// ACTIVE | PAUSED | BLACKLISTED
  status       String   @default("ACTIVE") @db.VarChar(16)
  note         String   @default("") @db.VarChar(500)
  createdBy    String   @default("") @map("created_by") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([orgType, orgUserId, name])
  @@index([orgType, orgUserId, status])
  @@index([orgType, orgUserId, kind])
  @@map("biz_parties")
}

