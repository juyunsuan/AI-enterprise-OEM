  lng        Float    @default(0)
  lat        Float    @default(0)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([siteId, openid, type])
  @@map("errand_addresses")
}

/// 顾客积分流水：下单抵扣、退款返还、完成返积分都记一条。
model ErrandPointTx {
  id          Int      @id @default(autoincrement())
  siteId      Int      @map("site_id")
  customerId  Int      @map("customer_id")
  /// USE 抵扣 | EARN 返积分 | REFUND 退款返还
  type        String   @db.VarChar(16)
  points      Int
  balanceAfter Int     @map("balance_after")
  orderId     Int      @default(0) @map("order_id")
  orderNo     String   @default("") @map("order_no") @db.VarChar(40)
  remark      String   @default("") @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([siteId, customerId, createdAt])
  @@map("errand_point_txs")
}

/// 优惠券：满减或折扣，领取后按 customer 记一张票。
model ErrandCoupon {
  id            Int       @id @default(autoincrement())
  siteId        Int       @map("site_id")
  cityId        Int       @default(0) @map("city_id")
  ownerUserId   String    @map("owner_user_id") @db.VarChar(64)
  name          String    @db.VarChar(60)
  /// FIXED 满减 | PERCENT 折扣
  type          String    @default("FIXED") @db.VarChar(8)
  discountValue Decimal   @default(0) @map("discount_value") @db.Decimal(10, 2)
  minAmount     Decimal   @default(0) @map("min_amount") @db.Decimal(18, 2)
  total         Int       @default(0)
  claimed       Int       @default(0)
  used          Int       @default(0)
  startAt       DateTime? @map("start_at")
  endAt         DateTime? @map("end_at")
  enabled       Boolean   @default(true)
  /// 适用服务类型 JSON：[] = 全部
  serviceTypes  Json      @default("[]") @map("service_types")
  /// 仅限首单顾客使用
  firstOrderOnly Boolean  @default(false) @map("first_order_only")
  /// 顾客首次登录自动发一张
  autoIssue     Boolean   @default(false) @map("auto_issue")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([siteId, cityId, enabled])
  @@map("errand_coupons")
}

/// 顾客领取的券：一张票只能抵一单。
model ErrandCustomerCoupon {
  id         Int       @id @default(autoincrement())
  siteId     Int       @map("site_id")
  customerId Int       @map("customer_id")
  couponId   Int       @map("coupon_id")
  /// UNUSED | USED | EXPIRED
  status     String    @default("UNUSED") @db.VarChar(16)
  orderId    Int       @default(0) @map("order_id")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([customerId, couponId])
  @@index([siteId, status])
  @@map("errand_customer_coupons")
}

/// 骑手钱包流水：订单完成入账、提现申请冻结/回退，余额在骑手行上。
model ErrandWalletTx {
