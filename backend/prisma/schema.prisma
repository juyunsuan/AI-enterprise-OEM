/// 统一外部主体：供应商 / OPC / 个人 / 合作伙伴 / 客户
model BizParty {
  id           Int      @id @default(autoincrement())
  orgType      String   @default("ENTERPRISE") @map("org_type") @db.VarChar(16)
  orgUserId    String   @map("org_user_id") @db.VarChar(64)
  /// VENDOR | OPC | INDIVIDUAL | PARTNER | CUSTOMER
  kind         String   @default("VENDOR") @db.VarChar(16)
