/// 数字人视频作品（三段状态机：TTS→对口型→成片；任一失败按 pointCost 原路退费）。
model DigitalHumanWork {
  id             Int      @id @default(autoincrement())
  siteId         Int      @map("site_id")
  memberId       Int      @map("member_id")
  title          String   @default("") @db.VarChar(120)
  bodyId         Int      @default(0) @map("body_id")
