  cardNoMasked String   @map("card_no_masked") @db.VarChar(32)
  cardNoHash   String   @map("card_no_hash") @db.VarChar(64)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
