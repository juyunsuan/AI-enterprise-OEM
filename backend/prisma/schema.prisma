/// 分账比例规则（作用域优先级：SERVICE > PRACTITIONER > ORGAN > TEAM > DEFAULT）。
model HealthCommissionRule {
  id                  Int      @id @default(autoincrement())
  shopId              Int      @map("shop_id")
  /// DEFAULT | ORGAN | PRACTITIONER | SERVICE | TEAM
  scope               String   @db.VarChar(16)
  scopeId             Int      @default(0) @map("scope_id")
  bizTypesJson        Json     @default("[]") @map("biz_types_json")
  organPercent        Int      @default(0) @map("organ_percent")
  practitionerPercent Int      @default(0) @map("practitioner_percent")
  promoterPercent     Int      @default(0) @map("promoter_percent")
  teamPercent         Int      @default(0) @map("team_percent")
  shopPercent         Int      @default(0) @map("shop_percent")
  status              String   @default("ON") @db.VarChar(8)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([shopId, scope, scopeId])
  @@index([shopId, scope, status])
  @@map("health_commission_rules")
}

