// ============================================================================
// 建站管理 · 健康管理小程序工具（health_*）
//
// 与 onsite_* / brand_* / knowledge_pay_* 完全分表；小程序主体凭据与出包台账
// 走私域底座（mini_program_apps / mini_program_tenant_releases，scene='HEALTH'）。
// 金额列一律 DECIMAL(12,2)（元），服务层按分运算；时间存 UTC。
// ============================================================================

/// 健康管理店铺（= 一个平台账号自营的一部健康管理小程序）。
model HealthShop {
  id           Int      @id @default(autoincrement())
  ownerUserId  String   @map("owner_user_id") @db.VarChar(64)
  name         String   @db.VarChar(120)
  /// 小程序包内公开寻址键（8 位去混淆字母表）。
  shopCode     String   @unique @map("shop_code") @db.VarChar(16)
  logo         String   @default("") @db.VarChar(500)
  slogan       String   @default("") @db.VarChar(120)
  servicePhone String   @default("") @map("service_phone") @db.VarChar(32)
  shareImage   String   @default("") @map("share_image") @db.VarChar(500)
  city         String   @default("") @db.VarChar(60)
  /// DRAFT | ONLINE | SUSPENDED | CLOSED
  status       String   @default("DRAFT") @db.VarChar(16)
  themeJson    Json     @map("theme_json")
  tradeJson    Json     @map("trade_json")
  /// 绑定的 AI客服站点 key（本域只存 key，会话与消息都在 service_desk_*）
  serviceDeskSiteKey String @default("") @map("service_desk_site_key") @db.VarChar(48)
  /// AI医护总开关：店主或医护端小程序管理员关掉后，医护工作台不再给 AI 医护入口
  aiStaffEnabled Boolean @default(false) @map("ai_staff_enabled")
  /// 舌象分析增值服务开关：关掉后小程序端入口隐藏，分析接口拒绝
  tongueAiEnabled Boolean @default(false) @map("tongue_ai_enabled")
  /// 舌象分析指定的视觉渠道（0 表示跟随账号模型设置的「视觉理解」槽位）
  tongueAiChannelId Int @default(0) @map("tongue_ai_channel_id")
  /// 舌象分析指定模型（空串表示跟随账号模型设置）
  tongueAiModel String @default("") @map("tongue_ai_model") @db.VarChar(128)
  offBy        String   @default("") @map("off_by") @db.VarChar(64)
  offReason    String   @default("") @map("off_reason") @db.VarChar(200)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([ownerUserId, status])
  @@map("health_shops")
}

/// 店内岗位与权限面（本站账号，不是顾客令牌）。
model HealthShopStaff {
  id          Int      @id @default(autoincrement())
  shopId      Int      @map("shop_id")
  userId      String   @map("user_id") @db.VarChar(64)
  label       String   @default("") @db.VarChar(60)
  /// OWNER | OPERATION | MEDICAL | PHARMACY | FINANCE
  role        String   @default("OPERATION") @db.VarChar(20)
  scopesJson  Json     @default("[]") @map("scopes_json")
  status      String   @default("ON") @db.VarChar(8)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([shopId, userId])
  @@index([userId, status])
  @@map("health_shop_staff")
}

model HealthBanner {
  id        Int      @id @default(autoincrement())
  shopId    Int      @map("shop_id")
  title     String   @default("") @db.VarChar(60)
  image     String   @db.VarChar(500)
  linkType  String   @default("NONE") @map("link_type") @db.VarChar(20)
  linkValue String   @default("") @map("link_value") @db.VarChar(500)
  sort      Int      @default(0)
  status    String   @default("ON") @db.VarChar(8)
  startAt   DateTime? @map("start_at")
  endAt     DateTime? @map("end_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, sort])
  @@map("health_banners")
}

model HealthNotice {
  id        Int      @id @default(autoincrement())
  shopId    Int      @map("shop_id")
  title     String   @db.VarChar(80)
  content   String   @db.Text
  sort      Int      @default(0)
  status    String   @default("ON") @db.VarChar(8)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([shopId, status, sort])
  @@map("health_notices")
}

/// 页面装修（首页 / 我的页等），块顺序与可见性都在这份 JSON 里。
