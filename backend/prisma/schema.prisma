/// C 端顾客（底座令牌主体，与站内 User 物理隔离）。
model HealthCustomer {
  id            Int      @id @default(autoincrement())
  shopId        Int      @map("shop_id")
  appId         String   @default("") @map("app_id") @db.VarChar(64)
  openid        String   @db.VarChar(64)
  unionid       String   @default("") @db.VarChar(64)
  nickname      String   @default("") @db.VarChar(60)
  avatar        String   @default("") @db.VarChar(500)
  phone         String   @default("") @db.VarChar(32)
  gender        String   @default("") @db.VarChar(8)
  city          String   @default("") @db.VarChar(60)
  source        String   @default("MINI") @db.VarChar(20)
  promoterId    Int      @default(0) @map("promoter_id")
  memberLevelId Int      @default(0) @map("member_level_id")
  walletAmount  Decimal  @default(0) @map("wallet_amount") @db.Decimal(12, 2)
  pointValue    Int      @default(0) @map("point_value")
  totalPay      Decimal  @default(0) @map("total_pay") @db.Decimal(12, 2)
  remark        String   @default("") @db.VarChar(500)
  status        String   @default("ON") @db.VarChar(8)
  lastActiveAt  DateTime? @map("last_active_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([shopId, openid])
  @@index([shopId, phone])
  @@index([shopId, unionid])
  @@map("health_customers")
}

/// 舌象分析记录：原图入数字资产台账，结构化结论落库供顾客与店主回看。
model HealthTongueRecord {
  id             Int      @id @default(autoincrement())
  shopId         Int      @map("shop_id")
  customerId     Int      @map("customer_id")
  imageKey       String   @map("image_key") @db.VarChar(500)
  imageUrl       String   @map("image_url") @db.VarChar(800)
  /// GOOD | FAIR（POOR 的图片在分析前就被拒绝，不落库）
  quality        String   @default("GOOD") @db.VarChar(8)
  tongueColor    String   @default("") @map("tongue_color") @db.VarChar(40)
  coatingColor   String   @default("") @map("coating_color") @db.VarChar(40)
  tongueShape    String   @default("") @map("tongue_shape") @db.VarChar(60)
  constitution   String   @default("") @db.VarChar(100)
  interpretation String   @default("") @db.Text
  suggestionsJson Json    @map("suggestions_json")
  cautionsJson   Json     @map("cautions_json")
  /// 模型自评置信度（0-100）
  confidence     Int      @default(0)
  model          String   @default("") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([shopId, createdAt])
  @@index([customerId, createdAt])
  @@map("health_tongue_records")
}

model HealthCustomerAddress {
