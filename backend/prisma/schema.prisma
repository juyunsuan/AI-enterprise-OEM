/// 分账流水（内部记账，非微信分账 API）。
model HealthOrderShare {
  id        Int      @id @default(autoincrement())
  shopId    Int      @map("shop_id")
  orderId   Int      @map("order_id")
  /// PRACTITIONER | ORGAN | PROMOTER | TEAM | PLATFORM
  earnerKind String  @map("earner_type") @db.VarChar(20)
  earnerId  Int      @map("earner_id")
  earnerName String  @default("") @map("earner_name") @db.VarChar(60)
