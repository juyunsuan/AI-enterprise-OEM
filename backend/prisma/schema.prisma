  rating     Int       @default(5)
  content    String    @default("") @db.Text
  reply      String    @default("") @db.Text
  status     Boolean   @default(true)
  repliedAt  DateTime? @map("replied_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([siteId, memberId, resourceId], map: "kp_reviews_site_member_resource_key")
  @@index([siteId, resourceId, status, id])
  @@map("knowledge_pay_reviews")
}

/// 课程章节：课时按章分组，章内再按课时 sort 排。
model KnowledgePayChapter {
  id         Int      @id @default(autoincrement())
  siteId     Int      @map("site_id")
  userId     String   @map("user_id") @db.VarChar(64)
  resourceId Int      @map("resource_id")
  title      String   @db.VarChar(120)
  sort       Int      @default(0)
