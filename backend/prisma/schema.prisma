  startAt   String   @default("") @map("start_at") @db.VarChar(20)
  endAt     String   @default("") @map("end_at") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([shopId, patientId, type])
  @@map("health_record_items")
}

/// 医疗事件（门诊/住院/手术/急诊）。
model HealthMedicalEvent {
  id            Int      @id @default(autoincrement())
  shopId        Int      @map("shop_id")
  patientId     Int      @map("patient_id")
  /// OUTPATIENT | INPATIENT | OPERATION | EMERGENCY | OTHER
  kind          String   @default("OUTPATIENT") @db.VarChar(16)
  title         String   @db.VarChar(120)
  hospitalName  String   @default("") @map("hospital_name") @db.VarChar(120)
