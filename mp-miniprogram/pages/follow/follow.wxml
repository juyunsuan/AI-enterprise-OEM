<view class="wrap">
  <view wx:if="{{loading}}" class="empty">正在加载关注店铺…</view>

  <view wx:elif="{{error}}" class="card">
    <view class="error-box">{{error}}</view>
    <view class="btn btn-primary" style="margin-top:20rpx" bindtap="load">重新加载</view>
  </view>

  <view wx:elif="{{!shops.length}}" class="card">
    <view class="empty" style="padding:60rpx 0">还没有关注任何店铺</view>
    <view class="btn btn-primary" bindtap="goShopping">去逛逛</view>
  </view>

  <view wx:else class="card">
    <view
      wx:for="{{shops}}"
      wx:key="shopId"
      class="shop-row"
      data-id="{{item.shopId}}"
      bindtap="goShop"
    >
      <image wx:if="{{item.logo}}" class="shop-logo" src="{{item.logo}}" mode="aspectFill" />
      <view class="grow">
        <view>{{item.name}}</view>
        <view class="muted">{{item.shopCode}} · 关注于 {{item.followedText}}</view>
      </view>
      <view
        class="btn btn-small"
        data-id="{{item.shopId}}"
        catchtap="unfollow"
      >取消关注</view>
    </view>
  </view>
</view>
