<view class="wrap" style="padding-bottom:200rpx">
  <view wx:if="{{loading}}" class="empty">正在加载订单…</view>

  <view wx:elif="{{error}}" class="card">
    <view class="error-box">{{error}}</view>
  </view>

  <block wx:else>
    <view class="status-card" style="background:{{statusColor}}">
      <view class="status-text">{{statusText}}</view>
      <view class="status-sub">订单号 {{order.orderNo}}</view>
      <view wx:if="{{order.status === 'PENDING_PAYMENT' && order.expireAt}}" class="status-sub">
        请在下单后尽快完成支付，超时订单会自动关闭
      </view>
    </view>

    <view class="card">
      <view class="section-title">收货信息</view>
      <view>{{order.receiverName}} {{order.receiverPhone}}</view>
      <view class="muted" style="margin-top:6rpx">{{order.receiverAddress}}</view>
      <view wx:if="{{order.buyerRemark}}" class="muted" style="margin-top:6rpx">
        留言：{{order.buyerRemark}}
      </view>
    </view>

    <view wx:for="{{shops}}" wx:key="id" class="card">
      <view class="row">
        <text class="section-title" style="margin-bottom:0">{{item.shopName}}</text>
        <text style="color:{{item.statusColor}};font-weight:600">{{item.statusText}}</text>
      </view>
      <view class="muted">子单号 {{item.subOrderNo}}</view>

      <view wx:for="{{item.items}}" wx:key="id" wx:for-item="line" class="row order-line">
        <image class="thumb small" src="{{line.image}}" mode="aspectFill" />
        <view class="grow">
          <view>{{line.title}}</view>
          <view class="muted">{{line.skuName}}</view>
        </view>
        <view style="text-align:right">
          <view class="money">¥{{line.priceText}}</view>
          <view class="muted">×{{line.quantity}}</view>
        </view>
      </view>

      <view wx:if="{{item.expressNo}}" class="divider"></view>
      <view wx:if="{{item.expressNo}}" class="muted">
        物流：{{item.expressCompany}} {{item.expressNo}}
      </view>

      <view class="divider"></view>
      <view class="pay-row muted">
        <text>商品小计</text>
        <text>{{item.goodsText}}</text>
      </view>
      <view class="pay-row muted">
        <text>运费</text>
        <text>{{item.freightText}}</text>
      </view>
      <view wx:if="{{item.refundStatus}}" class="pay-row muted">
        <text>售后</text>
        <text>{{item.refundStatus}}</text>
      </view>
      <view wx:if="{{item.canAfterSale}}" class="actions">
        <view class="btn btn-small" data-id="{{item.id}}" bindtap="applyAfterSale">申请售后</view>
      </view>
    </view>

    <view class="card">
      <view class="pay-row">
        <text class="muted">商品合计</text>
        <text>{{goodsText}}</text>
      </view>
      <view class="pay-row">
        <text class="muted">运费</text>
        <text>{{freightText}}</text>
      </view>
      <view class="pay-row">
        <text>实付款</text>
        <text class="money">{{payText}}</text>
      </view>
      <view class="divider"></view>
      <view class="pay-row muted">
        <text>下单时间</text>
        <text>{{timeText}}</text>
      </view>
    </view>

    <view class="muted footer" bindtap="goAfterSales">查看售后记录 ›</view>
  </block>
</view>

<view wx:if="{{order}}" class="bottom-bar">
  <view class="btn btn-small" bindtap="goAfterSales">售后</view>
  <view class="btn btn-small" bindtap="goService">客服</view>
  <view class="grow"></view>
  <block wx:if="{{order.status === 'PENDING_PAYMENT'}}">
    <view class="btn" bindtap="cancel">取消订单</view>
    <view class="btn btn-primary" bindtap="repay">{{busy ? '支付中…' : '去支付'}}</view>
  </block>
  <block wx:elif="{{order.status === 'SHIPPED'}}">
    <view class="btn btn-primary" bindtap="confirm">确认收货</view>
  </block>
</view>
