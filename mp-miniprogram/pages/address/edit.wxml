<view class="wrap" style="padding-bottom:180rpx">
  <view wx:if="{{loading}}" class="empty">正在加载地址…</view>

  <block wx:else>
    <view class="card">
      <view class="field">
        <view class="field-label">收货人</view>
        <input
          value="{{realName}}"
          maxlength="30"
          placeholder="姓名"
          placeholder-class="placeholder"
          data-field="realName"
          bindinput="onInput"
        />
      </view>
      <view class="field">
        <view class="field-label">手机号</view>
        <input
          value="{{phone}}"
          maxlength="20"
          type="number"
          placeholder="11 位手机号"
          placeholder-class="placeholder"
          data-field="phone"
          bindinput="onInput"
        />
      </view>
      <picker mode="region" value="{{[province, city, district]}}" bindchange="onRegion">
        <view class="field">
          <view class="field-label">所在地区</view>
          <view class="grow {{regionText ? '' : 'placeholder'}}">{{regionText || '省 / 市 / 区'}}</view>
        </view>
      </picker>
      <view class="field" style="border-bottom:none">
        <view class="field-label">详细地址</view>
        <textarea
          value="{{detail}}"
          maxlength="200"
          auto-height
          placeholder="街道、门牌号、楼层等"
          placeholder-class="placeholder"
          data-field="detail"
          bindinput="onInput"
        />
      </view>
    </view>

    <view class="card">
      <view class="row">
        <view>
          <view>设为默认地址</view>
          <view class="muted">下单时优先使用这个地址</view>
        </view>
        <switch checked="{{isDefault}}" color="#3370ff" bindchange="onDefault" />
      </view>
    </view>
  </block>
</view>

<view wx:if="{{!loading}}" class="bottom-bar">
  <view class="btn btn-primary grow" bindtap="save">{{saving ? '保存中…' : '保存地址'}}</view>
</view>
