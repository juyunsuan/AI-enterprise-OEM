{
  "description": "多店铺商城买家小程序（每个市场一部，AppID 由平台出包时写入）",
  "packOptions": {
    "ignore": [
      {
        "type": "file",
        "value": "project.private.config.json"
      },
      {
        "type": "folder",
        "value": ".DS_Store"
      }
    ]
  },
  "setting": {
    "urlCheck": true,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "bigPackageSizeSupport": false,
    "coverView": false,
    "packNpmManually": false,
    "packNpmRelationList": []
  },
  "compileType": "miniprogram",
  "libVersion": "3.5.5",
  "appid": "touristappid",
  "projectname": "mp-miniprogram",
  "srcMiniprogramRoot": "./",
  "miniprogramRoot": "./"
}
