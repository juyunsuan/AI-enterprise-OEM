.profile {
  display: flex;
  align-items: center;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eef0f3;
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
  background: var(--primary);
}

.profile-main {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.profile-points {
  text-align: right;
  flex-shrink: 0;
}

.points-value {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary);
}

.retry-btn {
  margin-top: 20rpx;
}

.sign-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sign-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
}

.stat-card {
  width: 32%;
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.cell-title {
  font-size: 28rpx;
}

.contact-btn {
  display: inline-block;
  padding: 0 28rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin: 0;
  border-radius: 999rpx;
  background: rgba(51, 112, 255, 0.1);
  color: var(--primary);
  font-size: 24rpx;
  border: none;
}

.contact-btn::after {
  border: none;
}

.ad-label {
  margin-bottom: 12rpx;
}

.site-footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.popup {
  width: 86%;
  max-height: 76vh;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.popup-body {
  flex: 1;
  font-size: 28rpx;
  line-height: 46rpx;
  word-break: break-all;
}

.popup-close {
  margin-top: 24rpx;
}
