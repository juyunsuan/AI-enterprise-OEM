<view class="page" style="{{themeStyle}}">
  <view class="empty" wx:if="{{loading}}">加载中…</view>
  <view class="empty" wx:elif="{{error}}">{{error}}</view>

  <view class="card" wx:else>
    <view class="title">{{page.title}}</view>
    <view class="divider"></view>
    <rich-text class="body" nodes="{{page.content}}"></rich-text>
    <view class="muted" wx:if="{{!page.content}}">暂无内容</view>
  </view>
</view>
