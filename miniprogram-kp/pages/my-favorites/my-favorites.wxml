<view class="page" style="{{themeStyle}}">
  <view class="muted count" wx:if="{{!loading && list.length}}">共收藏 {{total}} 条</view>

  <resource-card
    wx:for="{{list}}"
    wx:key="id"
    item="{{item}}"
    bindtap="openResource"
    data-resourceid="{{item.resourceId}}"
  />

  <view class="empty" wx:if="{{!loading && !list.length}}">{{error || '还没有收藏任何内容'}}</view>
  <view class="load-tip" wx:if="{{loadingMore}}">加载中…</view>
  <view class="load-tip" wx:elif="{{!hasMore && list.length}}">没有更多了</view>
  <view class="footer-gap"></view>
</view>
