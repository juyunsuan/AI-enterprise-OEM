<view class="page" style="{{themeStyle}}">
  <view class="empty" wx:if="{{loading}}">加载中…</view>
  <view class="empty" wx:elif="{{loginFailed}}">
    <view>登录状态不可用，请重新登录后查看学习记录。</view>
    <view class="btn empty-btn" bindtap="retryLogin">重新登录</view>
  </view>
  <view class="empty" wx:elif="{{!list.length}}">
    还没有学习记录，去首页挑一门课开始吧。
    <view class="btn empty-btn" bindtap="goHome">去逛逛</view>
  </view>

  <block wx:else>
    <view
      class="card course-card"
      wx:for="{{list}}"
      wx:key="resourceId"
      bindtap="openItem"
      data-index="{{index}}"
    >
      <view class="cover">
        <image wx:if="{{item.cover}}" class="cover-img" src="{{item.cover}}" mode="aspectFill" />
        <view wx:else class="cover-ph">{{item.completed ? '已完成' : '学习中'}}</view>
      </view>
      <view class="course-main">
        <view class="course-title ellipsis">{{item.title}}</view>
        <view class="muted course-meta">
          已学 {{item.completedCount}}/{{item.lessonCount}} 讲
          <text wx:if="{{item.lastLessonTitle}}"> · {{item.lastLessonTitle}}</text>
        </view>
        <progress percent="{{item.percent}}" active-color="{{themeColor}}" stroke-width="3" />
        <view class="course-foot">
          <text class="muted">{{item.updatedText}}</text>
          <text class="continue-text">{{item.completed ? '再次学习' : '继续学习'}} ›</text>
        </view>
      </view>
    </view>
  </block>
</view>
