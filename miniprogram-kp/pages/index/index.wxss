.search-bar {
  padding-bottom: 20rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.search-icon {
  font-size: 22rpx;
  color: #fff;
  background: var(--primary);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-right: 16rpx;
}

.search-ph {
  color: #8a8f99;
  font-size: 26rpx;
}

.banner {
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}

.banner-img {
  width: 100%;
  height: 100%;
  display: block;
}

.banner-title {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx 20rpx;
  background: rgba(0, 0, 0, 0.35);
  color: #fff;
  font-size: 24rpx;
}

.notice-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}

.notice-flag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--primary);
  background: rgba(51, 112, 255, 0.1);
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
  margin-right: 16rpx;
}

.notice-swiper {
  flex: 1;
  height: 44rpx;
}

.notice-item {
  height: 44rpx;
  line-height: 44rpx;
  font-size: 26rpx;
}

.quick {
  display: flex;
  padding: 8rpx 0;
}

.quick-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
}

.quick-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 6rpx;
}

.vip-name {
  color: var(--vip);
}

.section-block {
  margin-bottom: 8rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 16rpx;
}

.h-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.h-list {
  display: inline-flex;
}

.h-item {
  width: 220rpx;
  margin-right: 20rpx;
  white-space: normal;
}

.h-cover {
  position: relative;
  width: 220rpx;
  height: 150rpx;
  border-radius: 12rpx;
}

.h-img {
  width: 100%;
  height: 100%;
  display: block;
}

.h-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b6bac2;
  font-size: 24rpx;
}

.h-badge {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  padding: 0 12rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 20rpx;
}

.h-title {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  height: 72rpx;
  overflow: hidden;
}

.more-entry .section-title {
  color: var(--primary);
}
