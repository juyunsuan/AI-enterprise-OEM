.header {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #e7e9ee;
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: var(--primary);
  font-size: 44rpx;
}

.main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 600;
}

.section-title.small {
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.intro {
  font-size: 27rpx;
  line-height: 44rpx;
  word-break: break-all;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 4rpx 16rpx;
}
