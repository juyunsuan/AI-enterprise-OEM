.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.search-icon {
  font-size: 22rpx;
  color: #fff;
  background: var(--primary);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-right: 16rpx;
}

.search-ph {
  color: #8a8f99;
  font-size: 26rpx;
}

.kind-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.kind-card {
  width: 32%;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.kind-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 6rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 16rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-item {
  position: relative;
  width: 48.5%;
  height: 220rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.grid-img {
  width: 100%;
  height: 100%;
  display: block;
}

.grid-ph {
  width: 100%;
  height: 100%;
  background: #e7e9ee;
}

/* 分类名压在封面底部，和旧版知识付费小程序的读图习惯一致 */
.grid-title {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx 16rpx;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 26rpx;
}
