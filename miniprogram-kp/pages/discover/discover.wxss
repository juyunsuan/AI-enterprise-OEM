.search-bar {
  padding: 0 0 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fff;
}

.search-icon {
  color: var(--primary);
  font-size: 24rpx;
  margin-right: 16rpx;
}

.search-ph {
  color: #b6bac2;
  font-size: 26rpx;
}

.section-title.small {
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.nav-grid {
  display: flex;
  flex-wrap: wrap;
}

.nav-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.nav-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #f2f3f5;
  margin-bottom: 10rpx;
}

.nav-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: var(--primary);
  font-size: 32rpx;
}

.nav-title {
  max-width: 140rpx;
  font-size: 24rpx;
}

.teacher-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--line);
}

.teacher-row:first-of-type {
  border-top: none;
}

.teacher-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #e7e9ee;
}

.teacher-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: var(--primary);
  font-size: 30rpx;
}

.teacher-main {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}

.teacher-name {
  font-size: 28rpx;
  font-weight: 600;
}

.teacher-title {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: var(--muted);
  font-weight: normal;
}

.arrow {
  color: #c4c8cf;
  font-size: 32rpx;
}
