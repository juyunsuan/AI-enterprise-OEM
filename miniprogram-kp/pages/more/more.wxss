.link-item {
  display: flex;
  align-items: center;
}

.link-body {
  flex: 1;
  overflow: hidden;
}

.link-title {
  font-size: 28rpx;
  font-weight: 600;
}

.link-summary {
  margin-top: 10rpx;
  line-height: 36rpx;
}

.link-cover {
  width: 140rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin: 0 16rpx;
  flex-shrink: 0;
}

.link-img {
  width: 100%;
  height: 100%;
  display: block;
}
