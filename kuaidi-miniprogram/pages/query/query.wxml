<view class="wrap">
  <view class="card">
    <view class="section-title">查订单</view>
    <view class="muted">未登录也能查：订单号 + 下单时填写的寄件人手机号，用于保护收寄信息。</view>
    <view class="field" style="margin-top:16rpx">
      <text class="field-label">订单号</text>
      <input placeholder="如 KX202601010001" placeholder-class="placeholder" value="{{orderNo}}" bindinput="onOrderNo" />
    </view>
    <view class="field">
      <text class="field-label">手机号</text>
      <input type="number" maxlength="11" placeholder="寄件人手机号" placeholder-class="placeholder" value="{{mobile}}" bindinput="onMobile" />
    </view>
    <view class="btn btn-primary" style="margin-top:24rpx" bindtap="search">查询</view>
  </view>

  <view wx:if="{{history.length}}" class="card">
    <view class="row">
      <view class="section-title" style="margin-bottom:0">最近查询</view>
      <view class="muted" bindtap="clearHistory">清空</view>
    </view>
    <view wx:for="{{history}}" wx:key="orderNo" class="history-row" data-index="{{index}}" bindtap="useHistory">
      <view class="grow">
        <view class="history-no">{{item.orderNo}}</view>
        <view class="muted">{{item.mobile}} · {{item.at}}</view>
      </view>
      <view class="link" data-order="{{item.orderNo}}" catchtap="copyOrderNo">复制单号</view>
    </view>
  </view>
</view>
