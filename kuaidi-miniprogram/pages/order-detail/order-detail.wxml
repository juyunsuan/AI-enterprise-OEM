<view class="wrap">
  <view wx:if="{{loading}}" class="empty">正在读取订单…</view>

  <view wx:elif="{{error}}" class="card">
    <view class="error-box">{{error}}</view>
    <view wx:if="{{needSite}}" class="btn btn-primary" style="margin-top:20rpx" bindtap="goPickSite">去选寄件点</view>
    <view wx:else class="btn btn-primary" style="margin-top:20rpx" bindtap="retry">重试</view>
  </view>

  <block wx:else>
    <view class="card status-card">
      <view class="row">
        <view>
          <view class="status-text" style="color:{{detail.stateColor}}">{{detail.stateText}}</view>
          <view class="muted" style="margin-top:6rpx">{{detail.payStateText}} · {{detail.payModeText}}</view>
        </view>
        <view class="money status-fee">{{detail.feeText}}</view>
      </view>
      <view wx:if="{{detail.payable && detail.expireAtText}}" class="muted" style="margin-top:10rpx">
        请在 {{detail.expireAtText}} 前完成支付，超时订单自动关闭
      </view>
    </view>

    <view class="card">
      <view class="section-title">物流信息</view>
      <view class="kv"><text class="muted">快递公司</text><text>{{detail.companyName}}</text></view>
      <view wx:if="{{detail.trackingNo}}" class="kv" bindtap="copyTracking">
        <text class="muted">运单号</text>
        <text class="link">{{detail.trackingNo}}（点击复制）</text>
      </view>
      <view wx:if="{{detail.pickupSlot}}" class="kv"><text class="muted">取件时段</text><text>{{detail.pickupSlot}}</text></view>
      <view class="kv"><text class="muted">下单时间</text><text>{{detail.createdAtText}}</text></view>
      <view wx:if="{{detail.paidAtText}}" class="kv"><text class="muted">支付时间</text><text>{{detail.paidAtText}}</text></view>
      <view wx:if="{{detail.cancelReason}}" class="kv"><text class="muted">取消原因</text><text>{{detail.cancelReason}}</text></view>
      <view wx:if="{{events.length}}" class="timeline">
        <view wx:for="{{events}}" wx:key="id" class="timeline-item">
          <view class="timeline-dot"></view>
          <view class="grow">
            <view class="timeline-label">{{item.label}}</view>
            <view wx:if="{{item.note}}" class="muted">{{item.note}}</view>
            <view class="muted">{{item.at}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">收寄信息</view>
      <view class="party">
        <view class="muted">寄件人</view>
        <view class="party-text">{{detail.senderText}}</view>
      </view>
      <view class="divider"></view>
      <view class="party">
        <view class="muted">收件人</view>
        <view class="party-text">{{detail.receiverText}}</view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">物品与费用</view>
      <view class="kv"><text class="muted">物品</text><text>{{detail.itemLine}}</text></view>
      <view wx:if="{{detail.dimsText}}" class="kv"><text class="muted">尺寸</text><text>{{detail.dimsText}}</text></view>
      <view wx:if="{{detail.chargeWeightText}}" class="kv"><text class="muted">计费</text><text>{{detail.chargeWeightText}}</text></view>
      <view wx:if="{{detail.insuredValueText}}" class="kv"><text class="muted">保价</text><text>{{detail.insuredValueText}}</text></view>
      <view class="divider"></view>
      <view class="kv"><text class="muted">基础运费</text><text>{{detail.baseFeeText}}</text></view>
      <view wx:if="{{detail.extraFeeText !== '¥0.00'}}" class="kv"><text class="muted">续重费</text><text>{{detail.extraFeeText}}</text></view>
      <view wx:if="{{detail.remoteFeeText !== '¥0.00'}}" class="kv"><text class="muted">偏远附加</text><text>{{detail.remoteFeeText}}</text></view>
      <view wx:if="{{detail.insuranceFeeText !== '¥0.00'}}" class="kv"><text class="muted">保价费</text><text>{{detail.insuranceFeeText}}</text></view>
      <view class="kv total"><text>合计</text><text class="money">{{detail.feeText}}</text></view>
      <view wx:if="{{detail.remark}}" class="muted" style="margin-top:10rpx">备注：{{detail.remark}}</view>
    </view>

    <view class="muted footer">订单号 {{detail.orderNo}}</view>

    <view wx:if="{{detail.payable || detail.cancellable}}" class="action-bar">
      <view wx:if="{{detail.cancellable}}" class="btn btn-ghost action-btn" bindtap="cancelOrder">
        {{cancelling ? "取消中…" : "取消订单"}}
      </view>
      <view wx:if="{{detail.payable}}" class="btn btn-primary action-btn" bindtap="pay">
        {{paying ? "支付中…" : "立即支付"}}
      </view>
      <view wx:elif="{{!detail.payable}}" class="btn action-btn" bindtap="goService">联系店方</view>
    </view>
  </block>
</view>
