<view class="wrap">
  <view wx:if="{{loading}}" class="empty">正在读取地址…</view>

  <block wx:else>
    <view class="card">
      <picker mode="selector" range="{{typeLabels}}" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="field">
          <text class="field-label">地址类型</text>
          <text>{{typeLabels[typeIndex]}}</text>
        </view>
      </picker>
      <view class="field">
        <text class="field-label">联系人</text>
        <input placeholder="姓名" placeholder-class="placeholder" value="{{form.name}}" data-field="name" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="field-label">手机号</text>
        <input type="number" maxlength="11" placeholder="11 位手机号" placeholder-class="placeholder" value="{{form.mobile}}" data-field="mobile" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="field-label">省 / 市 / 区</text>
        <input class="triple" placeholder="省" placeholder-class="placeholder" value="{{form.province}}" data-field="province" bindinput="onInput" />
        <input class="triple" placeholder="市" placeholder-class="placeholder" value="{{form.city}}" data-field="city" bindinput="onInput" />
        <input class="triple" placeholder="区" placeholder-class="placeholder" value="{{form.district}}" data-field="district" bindinput="onInput" />
      </view>
      <view class="field last">
        <text class="field-label">详细地址</text>
        <input placeholder="街道、门牌号等" placeholder-class="placeholder" value="{{form.address}}" data-field="address" bindinput="onInput" />
      </view>
    </view>

    <view class="card row">
      <view class="muted">设为该类地址的默认</view>
      <switch checked="{{form.isDefault}}" color="#1f6feb" bindchange="onDefaultChange" />
    </view>

    <view class="btn btn-primary" bindtap="save">{{saving ? "保存中…" : "保存地址"}}</view>
  </block>
</view>
