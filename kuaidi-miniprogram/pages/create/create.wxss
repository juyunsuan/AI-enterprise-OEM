.field.last {
  border-bottom: none;
}

.link {
  color: #1f6feb;
  font-size: 26rpx;
}

.triple {
  width: 0;
  flex: 1;
  margin-right: 12rpx;
}

.triple:last-child {
  margin-right: 0;
}

.count-input {
  width: 120rpx;
  text-align: right;
  flex: none;
}

.field-label.small {
  width: auto;
  margin-left: 20rpx;
  font-size: 24rpx;
}

.remark {
  width: 100%;
  height: 120rpx;
  font-size: 26rpx;
}

.quote {
  display: flex;
  align-items: center;
  border: 2rpx solid #eef0f3;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
}

.quote.active {
  border-color: #1f6feb;
  background: #f5f9ff;
}

.quote-main {
  flex: 1;
  min-width: 0;
}

.quote-name {
  font-size: 30rpx;
  font-weight: 600;
}

.quote-check {
  width: 76rpx;
  text-align: right;
  color: #1f6feb;
  font-size: 24rpx;
}

.stale {
  color: #d97706;
  margin-top: 10rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
}

.agree-row checkbox {
  margin-right: 10rpx;
}

.submit-placeholder {
  height: 140rpx;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(31, 35, 41, 0.06);
}

.submit-total {
  font-size: 34rpx;
  font-weight: 600;
  color: #e5484d;
}

.submit-btn {
  width: 280rpx;
  flex: none;
  height: 80rpx;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}

.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
}

.protocol-body {
  max-height: 50vh;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #4e5461;
  line-height: 1.7;
}
