<view class="page">
  <view class="card" wx:if="{{patients.length}}">
    <view class="row">
      <text class="kv-label">就诊人</text>
      <picker
        mode="selector"
        range="{{patientNames}}"
        value="{{patientIndex}}"
        bindchange="onPatient"
      >
        <view class="picker-inline">{{patientNames[patientIndex] || '请选择'}} ›</view>
      </picker>
    </view>
  </view>

  <view class="card" wx:elif="{{!loading}}">
    <view class="empty">请先添加就诊人</view>
    <button class="button-primary" bindtap="onAddPatient">添加就诊人</button>
  </view>

  <block wx:if="{{patients.length}}">
    <scroll-view class="metric-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="pills metric-pills">
        <view
          class="pill {{metricId === item.id ? 'pill-active' : ''}}"
          wx:for="{{metrics}}"
          wx:key="id"
          data-index="{{index}}"
          bindtap="onMetricTap"
        >{{item.name}}</view>
      </view>
    </scroll-view>

    <view class="card" wx:if="{{metric}}">
      <view class="row">
        <text class="block-title">{{metric.name}}</text>
        <text class="item-meta" wx:if="{{metric.normalMin || metric.normalMax}}">
          参考 {{metric.normalMin}} ~ {{metric.normalMax}} {{metric.unit}}
        </text>
      </view>

      <view class="chart" wx:if="{{trend.length}}">
        <view class="bar-item" wx:for="{{trend}}" wx:key="measuredAt">
          <text class="bar-value {{item.abnormal ? 'bar-abnormal' : ''}}">{{item.valueText}}</text>
          <view
            class="bar {{item.abnormal ? 'bar-abnormal-bg' : ''}}"
            style="height: {{item.barHeight}}rpx"
          ></view>
          <text class="bar-time">{{item.timeText}}</text>
        </view>
      </view>
      <view class="empty small" wx:else>还没有记录，先记一条吧</view>
    </view>

    <view class="card">
      <view class="block-title">记录 {{metric ? metric.name : ''}}</view>
      <view class="record-row">
        <input
          class="input value-input"
          type="digit"
          placeholder="数值"
          value="{{form.value}}"
          data-field="value"
          bindinput="onInput"
        />
        <text class="unit-text">{{metric.unit}}</text>
      </view>
      <view class="field-row">
        <picker mode="date" value="{{form.date}}" end="{{today}}" bindchange="onDate">
          <view class="picker-field">{{form.date}}</view>
        </picker>
        <picker mode="time" value="{{form.time}}" bindchange="onTime">
          <view class="picker-field">{{form.time}}</view>
        </picker>
      </view>
      <input
        class="input note-input"
        maxlength="200"
        placeholder="备注（选填）"
        value="{{form.note}}"
        data-field="note"
        bindinput="onInput"
      />
      <button
        class="button-primary save-button"
        disabled="{{saving || !metricId}}"
        bindtap="onSave"
      >{{saving ? '保存中…' : '保存记录'}}</button>
    </view>

    <view class="card" wx:if="{{logs.length}}">
      <view class="block-title">最近记录</view>
      <view class="log" wx:for="{{logs}}" wx:key="id">
        <view class="log-main">
          <view class="log-name">
            {{item.nameText}}
            <text class="tag tag-red" wx:if="{{item.abnormal}}">异常</text>
          </view>
          <view class="item-meta">{{item.timeText}}<text wx:if="{{item.note}}"> · {{item.note}}</text></view>
        </view>
        <text class="log-value">{{item.valueText}}</text>
      </view>
    </view>
  </block>

  <view class="empty" wx:elif="{{loading}}">正在加载…</view>
</view>
