<view class="page">
  <view class="card">
    <view class="field">
      <view class="field-label">姓名 <text class="field-required">*</text></view>
      <input
        class="input"
        maxlength="60"
        placeholder="就诊人真实姓名"
        value="{{form.name}}"
        data-field="name"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <view class="field-label">与本人关系</view>
      <picker
        mode="selector"
        range="{{relations}}"
        value="{{relationIndex}}"
        bindchange="onRelation"
      >
        <view class="picker-field">{{relations[relationIndex]}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="field-label">性别</view>
      <picker
        mode="selector"
        range="{{genders}}"
        value="{{genderIndex}}"
        bindchange="onGender"
      >
        <view class="picker-field">{{genders[genderIndex]}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="field-label">出生日期</view>
      <picker
        mode="date"
        end="{{today}}"
        value="{{form.birthday}}"
        bindchange="onBirthday"
      >
        <view class="picker-field {{form.birthday ? '' : 'picker-placeholder'}}">
          {{form.birthday || '请选择出生日期'}}
        </view>
      </picker>
    </view>

    <view class="field">
      <view class="field-label">手机号</view>
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="用于接诊联系"
        value="{{form.phone}}"
        data-field="phone"
        bindinput="onInput"
      />
      <view class="item-meta" wx:if="{{phoneHint}}">{{phoneHint}}</view>
    </view>

    <view class="field">
      <view class="field-label">证件号</view>
      <input
        class="input"
        maxlength="32"
        placeholder="挂号实名制使用，留空则不修改"
        value="{{form.idCard}}"
        data-field="idCard"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <view class="field-label">血型</view>
      <picker
        mode="selector"
        range="{{bloodTypes}}"
        value="{{bloodIndex}}"
        bindchange="onBlood"
      >
        <view class="picker-field">{{bloodTypes[bloodIndex]}}</view>
      </picker>
    </view>

    <view class="field-row">
      <view class="field half">
        <view class="field-label">身高（cm）</view>
        <input
          class="input"
          type="digit"
          placeholder="选填"
          value="{{form.heightCm}}"
          data-field="heightCm"
          bindinput="onInput"
        />
      </view>
      <view class="field half">
        <view class="field-label">体重（kg）</view>
        <input
          class="input"
          type="digit"
          placeholder="选填"
          value="{{form.weightKg}}"
          data-field="weightKg"
          bindinput="onInput"
        />
      </view>
    </view>

    <view class="field">
      <view class="field-label">备注</view>
      <textarea
        class="textarea"
        maxlength="500"
        placeholder="慢性病、过敏、行动不便等需要注意的情况"
        value="{{form.remark}}"
        data-field="remark"
        bindinput="onInput"
      ></textarea>
    </view>

    <view class="default-row">
      <text class="kv-label">设为默认就诊人</text>
      <switch checked="{{form.isDefault}}" color="#1a73e8" bindchange="onDefault" />
    </view>
  </view>

  <view class="footer">
    <button
      class="button-primary"
      disabled="{{saving}}"
      bindtap="onSubmit"
    >{{saving ? '保存中…' : '保存'}}</button>
  </view>
</view>
