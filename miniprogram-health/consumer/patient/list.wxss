.patient {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.patient:last-child {
  border-bottom: none;
}

.patient-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.patient-name {
  font-size: 32rpx;
  font-weight: 600;
}

.patient-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.action {
  margin-left: 32rpx;
}

.danger {
  color: #f5413d;
}

.bar-button {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
}
