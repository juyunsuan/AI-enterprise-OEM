.gallery {
  width: 100%;
  height: 500rpx;
  background: #f0f1f5;
}

.gallery-image {
  width: 100%;
  height: 100%;
}

.price-row {
  display: flex;
  align-items: baseline;
}

.origin {
  margin-left: 12rpx;
  color: #a6abb3;
  font-size: 24rpx;
  text-decoration: line-through;
}

.goods-name {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.goods-sub {
  margin-top: 6rpx;
  color: #8a8f99;
  font-size: 24rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.meta-row .item-meta {
  margin-left: auto;
}

.block-title {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.skus {
  display: flex;
  flex-wrap: wrap;
}

.sku {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 24rpx;
  border: 2rpx solid #f0f1f5;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.sku-on {
  border-color: #1a73e8;
  background: #f5f9ff;
  color: #1a73e8;
}

.sku-off {
  opacity: 0.45;
}

.qty-row,
.qty-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.step {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #f0f1f5;
  border-radius: 8rpx;
  font-size: 32rpx;
}

.step-value {
  width: 80rpx;
  text-align: center;
  font-size: 28rpx;
}

.rx-notice {
  margin: 0 24rpx;
}

.review {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.review:last-child {
  border-bottom: none;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.review-stars {
  color: #f5a623;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.footer-tip {
  padding: 24rpx;
  color: #a6abb3;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.bar-icon {
  width: 96rpx;
  text-align: center;
  color: #5c6068;
  font-size: 24rpx;
}

.bar-ghost {
  flex: 1;
  margin: 0 12rpx;
}

.bar-button {
  flex: 1;
}
