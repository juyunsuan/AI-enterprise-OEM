.cart-card {
  padding: 0 24rpx;
}

.cart-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.cart-row:last-child {
  border-bottom: none;
}

.check {
  width: 36rpx;
  height: 36rpx;
  margin: 12rpx 16rpx 0 0;
  border: 2rpx solid #c4c8d0;
  border-radius: 50%;
  flex-shrink: 0;
}

.check-on {
  border-color: #1a73e8;
  background: radial-gradient(circle, #1a73e8 0 55%, #fff 58%);
}

.check-off {
  opacity: 0.4;
}

.cart-body {
  flex: 1;
  min-width: 0;
}

.cart-name {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.cart-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.cart-ops {
  margin-top: 6rpx;
  text-align: right;
}

.stepper {
  display: flex;
  align-items: center;
}

.step {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #f0f1f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.step-value {
  width: 64rpx;
  text-align: center;
  font-size: 26rpx;
}

.all-label {
  margin-right: auto;
  color: #5c6068;
  font-size: 26rpx;
}

.bar-price {
  margin-right: 20rpx;
}

.bar-label {
  margin-right: 8rpx;
  color: #8a8f99;
  font-size: 24rpx;
}

.bar-button {
  min-width: 240rpx;
}

.empty-link {
  margin-top: 16rpx;
  color: #1a73e8;
  font-size: 26rpx;
}
