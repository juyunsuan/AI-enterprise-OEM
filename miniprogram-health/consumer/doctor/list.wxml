<view class="page">
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜医生、健管师、药师"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onKeyword"
      bindconfirm="onSearch"
    />
  </view>

  <view class="card" wx:if="{{list.length}}">
    <view
      class="doctor"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onDoctor"
    >
      <image wx:if="{{item.avatar}}" class="avatar" src="{{item.avatar}}" mode="aspectFill" />
      <view wx:else class="avatar"></view>
      <view class="doctor-body">
        <view class="doctor-line">
          <text class="doctor-name">{{item.name}}</text>
          <text class="tag tag-blue">{{item.roleLabel}}</text>
          <text class="tag tag-orange" wx:if="{{item.scoreText}}">{{item.scoreText}} 分</text>
        </view>
        <view class="item-meta">{{item.title || '认证医护'}}<text wx:if="{{item.city}}"> · {{item.city}}</text></view>
        <view class="item-meta" wx:if="{{item.goodAtText}}">擅长：{{item.goodAtText}}</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>

  <view class="empty" wx:elif="{{!loading}}">没有找到匹配的医护</view>
  <view class="list-tip" wx:if="{{loading}}">正在加载…</view>
  <view class="list-tip" wx:elif="{{list.length && !hasMore}}">没有更多了</view>
</view>
