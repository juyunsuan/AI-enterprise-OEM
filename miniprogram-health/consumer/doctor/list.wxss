.doctor {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.doctor:last-child {
  border-bottom: none;
}

.doctor-body {
  flex: 1;
  min-width: 0;
}

.doctor-line {
  display: flex;
  align-items: center;
}

.doctor-name {
  margin-right: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.arrow {
  margin-left: 12rpx;
  color: #c4c8d0;
  font-size: 36rpx;
}

.list-tip {
  padding: 24rpx;
  text-align: center;
  color: #8a8f99;
  font-size: 24rpx;
}
