.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.head .title {
  flex: 1;
  margin-right: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

.block-title {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.images {
  display: flex;
  flex-wrap: wrap;
}

.image {
  width: 160rpx;
  height: 160rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 12rpx;
  background: #f0f1f5;
}

.eval-score {
  margin-bottom: 8rpx;
  color: #f5a623;
  font-size: 28rpx;
  font-weight: 600;
}

.tip {
  margin: 24rpx;
}

.bar-button {
  padding: 0 32rpx;
  margin-left: 16rpx;
  height: 72rpx;
  line-height: 72rpx;
}
