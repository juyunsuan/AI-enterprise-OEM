.chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6f8;
}

.msgs {
  flex: 1;
  box-sizing: border-box;
  padding: 16rpx 24rpx 0;
}

.chat-notice {
  margin: 0 0 24rpx;
}

.msg {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.msg.mine {
  align-items: flex-end;
}

.msg-name {
  margin-bottom: 8rpx;
  color: #8a8f99;
  font-size: 22rpx;
}

.bubble {
  max-width: 70%;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 4rpx 20rpx 20rpx 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.mine .bubble {
  background: #1a73e8;
  color: #fff;
  border-radius: 20rpx 4rpx 20rpx 20rpx;
}

.msg-image {
  width: 360rpx;
  border-radius: 8rpx;
}

.msg-file {
  margin-top: 8rpx;
  color: #8a8f99;
  font-size: 24rpx;
}

.mine .msg-file {
  color: rgba(255, 255, 255, 0.8);
}

.msg-time {
  margin-top: 8rpx;
  color: #a6abb3;
  font-size: 20rpx;
}

.pad {
  height: 24rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(31, 35, 41, 0.06);
}

.msg-input {
  flex: 1;
  margin-right: 16rpx;
}

.send {
  flex: none;
  width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  font-size: 26rpx;
}
