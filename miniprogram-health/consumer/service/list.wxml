<view class="page">
  <view class="search-bar" bindtap="onSearch">
    <view class="search-input">搜服务、医生、文章</view>
  </view>

  <view class="card list-card" wx:if="{{list.length}}">
    <view
      class="service"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onService"
    >
      <image wx:if="{{item.coverImage}}" class="thumb" src="{{item.coverImage}}" mode="aspectFill" />
      <view wx:else class="thumb"></view>
      <view class="service-body">
        <view class="service-name">{{item.name}}</view>
        <view class="service-meta">
          <text class="tag tag-blue">{{item.bizLabel}}</text>
          <text class="tag" wx:if="{{item.durationText}}">{{item.durationText}}</text>
          <text class="tag tag-orange" wx:if="{{item.needSlot}}">需预约</text>
        </view>
        <view class="service-price">
          <text class="amount">{{item.priceText}}</text>
          <text class="origin" wx:if="{{item.originText}}">{{item.originText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:elif="{{!loading}}">该分类下暂时没有可预约的内容</view>
  <view class="list-tip" wx:if="{{loading}}">正在加载…</view>
  <view class="list-tip" wx:elif="{{list.length && !hasMore}}">没有更多了</view>
</view>
