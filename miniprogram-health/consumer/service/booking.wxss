.summary {
  display: flex;
  align-items: center;
}

.summary-body {
  flex: 1;
  min-width: 0;
}

.summary-name {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

.summary-price {
  margin-top: 10rpx;
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.block-title {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.practitioner-scroll {
  white-space: nowrap;
}

.practitioner {
  display: inline-flex;
  align-items: center;
  width: 360rpx;
  margin-right: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border: 2rpx solid #f0f1f5;
  border-radius: 12rpx;
  vertical-align: top;
}

.practitioner-on {
  border-color: #1a73e8;
  background: #f5f9ff;
}

.avatar-sm {
  width: 72rpx;
  height: 72rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #f0f1f5;
}

.practitioner-body {
  flex: 1;
  min-width: 0;
}

.practitioner-name {
  font-size: 28rpx;
  font-weight: 600;
}

.practitioner-price {
  margin-top: 4rpx;
  color: #f5413d;
  font-size: 24rpx;
}

.day-scroll {
  white-space: nowrap;
}

.day {
  display: inline-block;
  width: 156rpx;
  margin-right: 12rpx;
  padding: 16rpx 8rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  text-align: center;
  vertical-align: top;
}

.day-on {
  background: #eef3ff;
  box-shadow: inset 0 0 0 2rpx #1a73e8;
}

.day-off {
  opacity: 0.45;
}

.day-label {
  font-size: 26rpx;
  font-weight: 600;
}

.day-sub {
  margin-top: 4rpx;
  color: #8a8f99;
  font-size: 20rpx;
}

.slots {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.slot {
  width: 31%;
  margin: 0 3.5% 12rpx 0;
  padding: 14rpx 8rpx;
  box-sizing: border-box;
  border: 2rpx solid #f0f1f5;
  border-radius: 10rpx;
  text-align: center;
}

.slot:nth-child(3n) {
  margin-right: 0;
}

.slot-on {
  border-color: #1a73e8;
  background: #f5f9ff;
}

.slot-time {
  font-size: 26rpx;
  font-weight: 600;
}

.slot-sub {
  margin-top: 4rpx;
  color: #8a8f99;
  font-size: 20rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.empty-mini {
  padding: 24rpx 0;
  text-align: center;
  color: #8a8f99;
  font-size: 24rpx;
}

.flow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  color: #5c6068;
  font-size: 26rpx;
}

.bar-price {
  margin-right: 24rpx;
}

.bar-label {
  margin-right: 8rpx;
  color: #8a8f99;
  font-size: 24rpx;
}

.bar-button {
  flex: 1;
}
