<view class="page page-with-bar" wx:if="{{service}}">
  <view class="card summary">
    <image wx:if="{{service.coverImage}}" class="thumb" src="{{service.coverImage}}" mode="aspectFill" />
    <view class="summary-body">
      <view class="summary-name">{{service.name}}</view>
      <view class="item-meta"><text class="tag tag-blue">{{bizLabel}}</text></view>
      <view class="amount summary-price">{{payText || '待试算'}}</view>
    </view>
  </view>

  <!-- 就诊人 -->
  <view class="card" wx:if="{{needsPatient}}">
    <view class="field-head">
      <text class="block-title">就诊人</text>
      <text class="link" bindtap="onAddPatient">+ 添加就诊人</text>
    </view>
    <picker
      wx:if="{{patients.length}}"
      mode="selector"
      range="{{patientNames}}"
      value="{{patientIndex}}"
      bindchange="onPatient"
    >
      <view class="picker-field">
        {{patientIndex >= 0 ? patientNames[patientIndex] : '请选择就诊人'}}
      </view>
    </picker>
    <view class="notice notice-warn" wx:else>还没有就诊人，建档后才能预约与问诊。</view>
  </view>

  <!-- 医护 -->
  <view class="card" wx:if="{{practitioners.length > 1}}">
    <view class="block-title">接诊医护</view>
    <scroll-view class="practitioner-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        class="practitioner {{practitionerId === item.id ? 'practitioner-on' : ''}}"
        wx:for="{{practitioners}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onPractitioner"
      >
        <image wx:if="{{item.avatar}}" class="avatar-sm" src="{{item.avatar}}" mode="aspectFill" />
        <view class="practitioner-body">
          <view class="practitioner-name">{{item.name}}</view>
          <view class="item-meta">{{item.title || item.roleLabel}}</view>
          <view class="practitioner-price">{{item.priceText}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 号源 -->
  <view class="card" wx:if="{{service.needSlot}}">
    <view class="block-title">预约时间</view>
    <scroll-view class="day-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        class="day {{day === item.day ? 'day-on' : ''}} {{item.soldOut ? 'day-off' : ''}}"
        wx:for="{{days}}"
        wx:key="day"
        data-day="{{item.day}}"
        data-sold="{{item.soldOut}}"
        bindtap="onDay"
      >
        <view class="day-label">{{item.label}}</view>
        <view class="day-sub">{{item.soldOut ? '无号' : item.available + ' 个号源'}}</view>
      </view>
    </scroll-view>
    <view class="slots" wx:if="{{slots.length}}">
      <view
        class="slot {{slotId === item.id ? 'slot-on' : ''}}"
        wx:for="{{slots}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onSlot"
      >
        <view class="slot-time">{{item.label}}</view>
        <view class="slot-sub">{{item.doctorLabel}} · 余 {{item.remaining}}</view>
      </view>
    </view>
    <view class="empty-mini" wx:else>{{day ? '该日暂无可约号源，换一天看看' : '近期没有放号'}}</view>
    <view class="notice" wx:if="{{slotText}}">已选：{{slotText}}</view>
  </view>

  <!-- 问诊信息 -->
  <view class="card" wx:if="{{consultWay}}">
    <view class="block-title">{{consultWay === 'TEXT' ? '图文问诊' : consultWay === 'PHONE' ? '电话问诊' : '视频问诊'}}</view>
    <view class="field">
      <view class="field-label">症状描述 <text class="field-required">*</text></view>
      <textarea
        class="textarea"
        placeholder="描述主要不适、持续时间、既往病史等，便于医护提前准备"
        value="{{consult.symptomText}}"
        maxlength="2000"
        data-field="symptomText"
        bindinput="onConsultInput"
      ></textarea>
    </view>
    <view class="field">
      <view class="field-label">联系电话 <text class="field-required">*</text></view>
      <input
        class="input"
        type="number"
        placeholder="医护需要时与你联系"
        value="{{consult.contactPhone}}"
        data-field="contactPhone"
        bindinput="onConsultInput"
      />
    </view>
    <block wx:if="{{consultWay !== 'TEXT'}}">
      <view class="field">
        <view class="field-label">期望日期 <text class="field-required">*</text></view>
        <picker mode="date" start="{{today}}" value="{{consult.appointDate}}" bindchange="onConsultDate">
          <view class="picker-field {{consult.appointDate ? '' : 'picker-placeholder'}}">
            {{consult.appointDate || '请选择日期'}}
          </view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">期望时间</view>
        <picker mode="time" value="{{consult.appointTime}}" bindchange="onConsultTime">
          <view class="picker-field">{{consult.appointTime}}</view>
        </picker>
      </view>
    </block>
  </view>

  <!-- 绿通 -->
  <view class="card" wx:if="{{isGreen}}">
    <view class="block-title">绿通需求</view>
    <view class="field">
      <view class="field-label">需求类型</view>
      <picker mode="selector" range="{{needTypeLabels}}" bindchange="onNeedType">
        <view class="picker-field">{{needTypeLabel}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">目标医院 <text class="field-required">*</text></view>
      <input
        class="input"
        placeholder="填写希望就诊的医院与科室"
        value="{{green.targetHospital}}"
        data-field="targetHospital"
        bindinput="onGreenInput"
      />
    </view>
    <view class="field">
      <view class="field-label">病情与诉求</view>
      <textarea
        class="textarea"
        placeholder="简要说明病情、已有检查与希望安排的时间"
        value="{{green.symptoms}}"
        maxlength="2000"
        data-field="symptoms"
        bindinput="onGreenInput"
      ></textarea>
    </view>
    <view class="field">
      <view class="field-label">联系电话</view>
      <input
        class="input"
        type="number"
        placeholder="便于协调资源时联系"
        value="{{green.contactPhone}}"
        data-field="contactPhone"
        bindinput="onGreenInput"
      />
    </view>
    <view class="notice notice-warn">绿通为协调服务，能否安排与时间以医院实际排期为准。</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="field-label">备注</view>
      <input class="input" placeholder="选填，例如到达时间、特殊要求" value="{{remark}}" bindinput="onRemark" />
    </view>
  </view>

  <view class="card" wx:if="{{quote}}">
    <view class="block-title">费用明细</view>
    <view class="flow" wx:for="{{flowTexts}}" wx:key="index">
      <text>{{item.label}}</text>
      <text>{{item.amount}}</text>
    </view>
  </view>

  <view class="action-bar">
    <view class="bar-price">
      <text class="bar-label">应付</text>
      <text class="amount">{{payText || '待试算'}}</text>
    </view>
    <button class="button-primary bar-button" loading="{{submitting}}" bindtap="onSubmit">
      提交并按提示支付
    </button>
  </view>
</view>

<view class="empty" wx:else>正在准备预约信息…</view>
