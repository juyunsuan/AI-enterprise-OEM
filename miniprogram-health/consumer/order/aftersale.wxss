.block-title {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.pills {
  display: flex;
  flex-wrap: wrap;
}

.pills .pill {
  margin: 0 16rpx 16rpx 0;
}

.line {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.line:last-child {
  border-bottom: none;
}

.line-thumb {
  width: 96rpx;
  height: 96rpx;
  margin-right: 16rpx;
}

.line-body {
  flex: 1;
  min-width: 0;
}

.line-price {
  margin-left: 16rpx;
  color: #1f2329;
  font-size: 28rpx;
}

.radio {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  border: 2rpx solid #c4c8d0;
  border-radius: 50%;
}

.radio-on {
  border-color: #1a73e8;
  background: radial-gradient(circle, #1a73e8 0 55%, #fff 58%);
}

.chip-wrap {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  margin: 0 16rpx 16rpx 0;
}

.chip-active {
  border-color: #1a73e8;
  color: #1a73e8;
}

.reason-input {
  margin-top: 8rpx;
}

.textarea {
  width: 100%;
  height: 200rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.footer {
  padding: 8rpx 24rpx 48rpx;
}

.footer .notice {
  margin-bottom: 16rpx;
}

.button-primary {
  height: 88rpx;
  line-height: 88rpx;
}
