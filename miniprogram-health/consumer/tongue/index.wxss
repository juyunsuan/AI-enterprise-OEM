.hero {
  padding: 36rpx 32rpx 8rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2329;
}

.hero-desc {
  margin-top: 12rpx;
  color: #5c6068;
  font-size: 27rpx;
  line-height: 1.7;
}

.hero-tip {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #fff7e8;
  color: #a15c00;
  font-size: 23rpx;
  line-height: 1.6;
}

.pick-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 24rpx;
  border: 2rpx dashed #c9d3e3;
  border-radius: 16rpx;
  background: #f8faff;
}

.pick-plus {
  width: 86rpx;
  height: 86rpx;
  line-height: 78rpx;
  text-align: center;
  border-radius: 50%;
  background: #e8f0ff;
  color: #1a73e8;
  font-size: 54rpx;
  font-weight: 300;
}

.pick-title {
  margin-top: 18rpx;
  color: #1a73e8;
  font-size: 30rpx;
  font-weight: 600;
}

.pick-desc {
  margin-top: 8rpx;
  color: #8a8f99;
  font-size: 23rpx;
}

.preview {
  width: 100%;
  height: 460rpx;
  border-radius: 16rpx;
  background: #eef1f5;
}

.preview-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.preview-actions .button-ghost {
  flex: 1;
  margin: 0;
}

.analyze-btn {
  margin-top: 20rpx;
}

.analyze-tip {
  margin-top: 10rpx;
  text-align: center;
  color: #8a8f99;
  font-size: 22rpx;
}

.result-card .title {
  font-size: 32rpx;
}

.confidence {
  color: #1a73e8;
  font-size: 24rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.result-block {
  margin-top: 24rpx;
}

.result-label {
  color: #8a8f99;
  font-size: 23rpx;
}

.result-text {
  margin-top: 8rpx;
  color: #1f2329;
  font-size: 27rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.bullet {
  margin-top: 8rpx;
  color: #1f2329;
  font-size: 27rpx;
  line-height: 1.7;
}

.bullet-warn {
  color: #a15c00;
}

.result-foot {
  margin-top: 26rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0f1f5;
  color: #8a8f99;
  font-size: 22rpx;
  line-height: 1.6;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.history-item:last-child {
  border-bottom: none;
}

.history-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #eef1f5;
  flex-shrink: 0;
}

.history-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.history-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.history-time {
  margin-top: 6rpx;
  color: #8a8f99;
  font-size: 22rpx;
}

.history-arrow {
  color: #c4c8cf;
  font-size: 40rpx;
  margin-left: 8rpx;
}