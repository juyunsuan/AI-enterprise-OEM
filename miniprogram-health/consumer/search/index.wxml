<view class="page">
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜商品、服务、医护、科普"
      value="{{keyword}}"
      confirm-type="search"
      focus="{{!searched}}"
      bindinput="onKeyword"
      bindconfirm="onConfirm"
    />
    <view class="search-action" bindtap="onConfirm">搜索</view>
  </view>

  <block wx:if="{{!searched}}">
    <view class="card" wx:if="{{hotKeywords.length}}">
      <view class="block-title">热门搜索</view>
      <view class="hot-list">
        <view
          class="pill hot"
          wx:for="{{hotKeywords}}"
          wx:key="*this"
          data-word="{{item}}"
          bindtap="onHot"
        >{{item}}</view>
      </view>
    </view>
    <view class="empty" wx:elif="{{!loading}}">输入关键词，搜索商品、服务、医护与科普内容</view>
  </block>

  <block wx:else>
    <scroll-view class="tab-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="pills">
        <view
          class="pill {{tab === item.key ? 'pill-active' : ''}}"
          wx:for="{{tabs}}"
          wx:key="key"
          data-tab="{{item.key}}"
          bindtap="onTab"
        >{{item.label}}</view>
      </view>
    </scroll-view>

    <block wx:if="{{tab === 'all' || tab === 'goods'}}">
      <view class="card" wx:if="{{goods.length}}">
        <view class="block-title">商品</view>
        <view class="row-item" wx:for="{{goods}}" wx:key="id" data-id="{{item.id}}" bindtap="onGoods">
          <view class="row-main">
            <view class="row-title">{{item.name}}</view>
            <view class="item-meta" wx:if="{{item.soldOut}}">缺货</view>
          </view>
          <text class="amount">{{item.priceText}}</text>
        </view>
      </view>
      <view class="section-empty" wx:elif="{{!loading && tab === 'goods'}}">没有找到相关商品</view>
    </block>

    <block wx:if="{{tab === 'all' || tab === 'service'}}">
      <view class="card" wx:if="{{services.length}}">
        <view class="block-title">服务</view>
        <view class="row-item" wx:for="{{services}}" wx:key="id" data-id="{{item.id}}" bindtap="onService">
          <view class="row-main">
            <view class="row-title">{{item.name}}</view>
            <view class="item-meta">{{item.bizLabel}}</view>
          </view>
          <text class="amount">{{item.priceText}}</text>
        </view>
      </view>
      <view class="section-empty" wx:elif="{{!loading && tab === 'service'}}">没有找到相关服务</view>
    </block>

    <block wx:if="{{tab === 'all' || tab === 'doctor'}}">
      <view class="card" wx:if="{{doctors.length}}">
        <view class="block-title">医护</view>
        <view class="row-item" wx:for="{{doctors}}" wx:key="id" data-id="{{item.id}}" bindtap="onDoctor">
          <view class="row-main">
            <view class="row-title">{{item.name}} <text class="tag tag-blue">{{item.roleLabel}}</text></view>
            <view class="item-meta" wx:if="{{item.goodAtText}}">擅长：{{item.goodAtText}}</view>
          </view>
          <text class="arrow">›</text>
        </view>
      </view>
      <view class="section-empty" wx:elif="{{!loading && tab === 'doctor'}}">没有找到相关医护</view>
    </block>

    <block wx:if="{{tab === 'all' || tab === 'article'}}">
      <view class="card" wx:if="{{articles.length}}">
        <view class="block-title">科普</view>
        <view class="row-item" wx:for="{{articles}}" wx:key="id" data-id="{{item.id}}" bindtap="onArticle">
          <view class="row-main">
            <view class="row-title">{{item.title}}</view>
            <view class="item-meta">{{item.timeText}}</view>
          </view>
          <text class="arrow">›</text>
        </view>
      </view>
      <view class="section-empty" wx:elif="{{!loading && tab === 'article'}}">没有找到相关科普内容</view>
    </block>

    <view class="empty" wx:if="{{loading}}">正在搜索…</view>
    <view
      class="empty"
      wx:elif="{{tab === 'all' && !goods.length && !services.length && !doctors.length && !articles.length}}"
    >没有找到「{{keyword}}」相关内容，换个词试试</view>
  </block>
</view>
