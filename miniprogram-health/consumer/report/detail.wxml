<view class="page" wx:if="{{report}}">
  <view class="card">
    <view class="head">
      <view class="title">{{report.title}}</view>
      <text class="tag tag-blue">{{report.typeLabel}}</text>
    </view>
    <view class="item-meta" wx:if="{{report.hospitalName}}">{{report.hospitalName}}</view>
    <view class="item-meta" wx:if="{{report.timeText}}">报告时间 {{report.timeText}}</view>
    <view class="stat-row" wx:if="{{items.length}}">
      <text class="tag tag-red" wx:if="{{abnormalItems}}">{{abnormalItems}} 项异常</text>
      <text class="tag tag-green" wx:else>各项指标正常</text>
    </view>
  </view>

  <view class="card" wx:if="{{files.length}}">
    <view class="block-title">报告文件</view>
    <view
      class="file"
      wx:for="{{files}}"
      wx:key="url"
      data-url="{{item.url}}"
      bindtap="onFile"
    >
      <text class="file-name">{{item.name || '报告文件'}}</text>
      <text class="link">查看</text>
    </view>
  </view>

  <view class="card" wx:if="{{report.summary}}">
    <view class="block-title">报告摘要</view>
    <view class="detail-text">{{report.summary}}</view>
  </view>

  <view class="card" wx:if="{{items.length}}">
    <view class="block-title">检查项</view>
    <view class="item-row item-head">
      <text class="col-name">项目</text>
      <text class="col-value">结果</text>
      <text class="col-ref">参考</text>
    </view>
    <view class="item-row" wx:for="{{items}}" wx:key="name">
      <view class="col-name">
        {{item.name}}
        <text class="tag tag-red" wx:if="{{item.abnormal}}">{{item.flagLabel}}</text>
      </view>
      <text class="col-value {{item.abnormal ? 'abnormal' : ''}}">
        {{item.valueText}}{{item.unit}}
      </text>
      <text class="col-ref">{{item.refRange || '—'}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{report.conclusion}}">
    <view class="block-title">结论</view>
    <view class="detail-text">{{report.conclusion}}</view>
  </view>

  <view class="card" wx:if="{{advices.length}}">
    <view class="block-title">医生建议</view>
    <view class="advice" wx:for="{{advices}}" wx:key="index">
      <view class="detail-text">{{item.content}}</view>
      <view class="item-meta">
        <text wx:if="{{item.doctorName}}">{{item.doctorName}}</text>
        <text wx:if="{{item.timeText}}"> · {{item.timeText}}</text>
      </view>
    </view>
  </view>

  <view class="notice notice-warn tip" wx:if="{{disclaimer}}">{{disclaimer}}</view>
</view>

<view class="empty" wx:elif="{{!loading}}">报告不存在或已删除</view>
<view class="empty" wx:else>正在加载…</view>
