<view class="page {{mode === 'article' ? '' : 'page-with-bar'}}">
  <scroll-view class="tab-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="pills">
      <view
        class="pill {{mode === item.key ? 'pill-active' : ''}}"
        wx:for="{{modes}}"
        wx:key="key"
        data-mode="{{item.key}}"
        bindtap="onMode"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="search-bar">
    <input
      class="search-input"
      placeholder="{{placeholder}}"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onKeyword"
      bindconfirm="onSearch"
    />
  </view>

  <scroll-view
    class="category-scroll"
    scroll-x
    enhanced
    show-scrollbar="{{false}}"
    wx:if="{{mode === 'article' && categories.length}}"
  >
    <view class="pills">
      <view
        class="pill {{categoryId === 0 ? 'pill-active' : ''}}"
        data-id="0"
        bindtap="onCategory"
      >全部</view>
      <view
        class="pill {{categoryId === item.id ? 'pill-active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCategory"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <block wx:if="{{mode === 'article'}}">
    <view
      class="card item"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onItem"
    >
      <image wx:if="{{item.coverImage}}" class="thumb" src="{{item.coverImage}}" mode="aspectFill" />
      <view class="item-body">
        <view class="item-title">{{item.title}}</view>
        <view class="item-meta line2" wx:if="{{item.summary}}">{{item.summary}}</view>
        <view class="item-meta">
          <text wx:if="{{item.authorName}}">{{item.authorName}} · </text>{{item.timeText}} · {{item.viewCount}} 阅读
        </view>
      </view>
    </view>
  </block>

  <block wx:elif="{{mode === 'post'}}">
    <view
      class="card post"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onItem"
    >
      <view class="post-head">
        <image wx:if="{{item.authorAvatar}}" class="avatar-sm" src="{{item.authorAvatar}}" mode="aspectFill" />
        <view wx:else class="avatar-sm"></view>
        <view class="post-author">
          <view>{{item.authorName}}</view>
          <view class="item-meta">{{item.timeText}}</view>
        </view>
      </view>
      <view class="post-title" wx:if="{{item.title}}">{{item.title}}</view>
      <view class="post-content">{{item.content}}</view>
      <view class="post-images" wx:if="{{item.images.length}}">
        <image
          wx:for="{{item.images}}"
          wx:for-item="image"
          wx:key="*this"
          class="post-image"
          src="{{image}}"
          mode="aspectFill"
        />
      </view>
      <view class="post-tags" wx:if="{{item.tags.length}}">
        <text class="tag tag-blue" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
      </view>
      <view class="post-foot item-meta">
        <text>{{item.likeCount}} 赞</text>
        <text class="foot-gap">{{item.commentCount}} 评论</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view
      class="card question"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onItem"
    >
      <view class="item-title">{{item.title}}</view>
      <view class="item-meta line2" wx:if="{{item.detail}}">{{item.detail}}</view>
      <view class="question-foot">
        <view>
          <text class="tag tag-orange" wx:if="{{item.bountyText}}">悬赏 {{item.bountyText}}</text>
          <text class="tag tag-green">{{item.answerCount}} 个回答</text>
        </view>
        <text class="item-meta">{{item.timeText}}</text>
      </view>
    </view>
  </block>

  <view class="empty" wx:if="{{!loading && !list.length}}">
    {{mode === 'post' ? '还没有病友分享，来发第一条吧' : mode === 'question' ? '还没有公开问答，来提第一个问题吧' : '暂无科普内容'}}
  </view>
  <view class="list-tip" wx:if="{{loading}}">正在加载…</view>
  <view class="list-tip" wx:elif="{{list.length && !hasMore}}">没有更多了</view>

  <view class="action-bar" wx:if="{{mode !== 'article'}}">
    <view class="action-bar-spacer"></view>
    <button class="button-primary publish-button" bindtap="onOpenComposer">
      {{mode === 'post' ? '发布动态' : '我要提问'}}
    </button>
  </view>

  <view class="mask" wx:if="{{composer}}" bindtap="onCloseComposer">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{mode === 'post' ? '发布病友动态' : '发起健康提问'}}</view>

      <block wx:if="{{mode === 'post'}}">
        <view class="field">
          <view class="field-label">标题（选填）</view>
          <input
            class="input"
            maxlength="120"
            placeholder="一句话概括你的分享"
            value="{{postForm.title}}"
            data-field="title"
            bindinput="onPostInput"
          />
        </view>
        <view class="field">
          <view class="field-label">内容 <text class="field-required">*</text></view>
          <textarea
            class="textarea"
            maxlength="2000"
            placeholder="说说你的就医、用药或康复经验（至少 5 个字）"
            value="{{postForm.content}}"
            data-field="content"
            bindinput="onPostInput"
          ></textarea>
        </view>
        <view class="field">
          <view class="field-label">标签（逗号分隔，最多 6 个）</view>
          <input
            class="input"
            maxlength="120"
            placeholder="如：高血压，饮食"
            value="{{postForm.tagsText}}"
            data-field="tagsText"
            bindinput="onPostInput"
          />
        </view>
        <view class="field">
          <view class="field-label">话题（选填）</view>
          <input
            class="input"
            maxlength="60"
            placeholder="如：控糖日常"
            value="{{postForm.topic}}"
            data-field="topic"
            bindinput="onPostInput"
          />
        </view>
      </block>

      <block wx:else>
        <view class="field">
          <view class="field-label">问题标题 <text class="field-required">*</text></view>
          <input
            class="input"
            maxlength="120"
            placeholder="如：血压 150/95 需要马上就医吗"
            value="{{questionForm.title}}"
            data-field="title"
            bindinput="onQuestionInput"
          />
        </view>
        <view class="field">
          <view class="field-label">问题描述</view>
          <textarea
            class="textarea"
            maxlength="2000"
            placeholder="补充症状、持续时间、用药与检查情况"
            value="{{questionForm.detail}}"
            data-field="detail"
            bindinput="onQuestionInput"
          ></textarea>
        </view>
        <view class="notice notice-warn">问答内容仅供参考，不构成诊断或用药建议；紧急情况请直接拨打 120。</view>
      </block>

      <view class="sheet-actions">
        <button class="button-ghost sheet-button" bindtap="onCloseComposer">取消</button>
        <button
          class="button-primary sheet-button"
          disabled="{{publishing}}"
          bindtap="onPublish"
        >{{publishing ? '提交中…' : '提交'}}</button>
      </view>
    </view>
  </view>
</view>
