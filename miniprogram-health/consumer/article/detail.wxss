.post-head {
  display: flex;
  align-items: center;
}

.post-title {
  margin-top: 20rpx;
}

.post-content {
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.7;
  word-break: break-all;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 12rpx;
  background: #f0f1f5;
}

.tags {
  margin-top: 12rpx;
}

.post-foot {
  margin-top: 12rpx;
}

.block-title {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.comment {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.comment:last-child {
  border-bottom: none;
}

.avatar-sm {
  width: 60rpx;
  height: 60rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #f0f1f5;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
  min-width: 0;
}

.comment-name {
  font-size: 26rpx;
  font-weight: 600;
}

.comment-text {
  margin-top: 4rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.comment-input {
  flex: 1;
  padding: 14rpx 20rpx;
  background: #f0f1f5;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.bar-button {
  margin-left: 12rpx;
  padding: 0 28rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 26rpx;
}

.like-button {
  margin-left: 12rpx;
  padding: 0 24rpx;
  height: 68rpx;
  line-height: 68rpx;
  background: #fff;
  color: #5c6068;
  border: 1rpx solid #dcdfe6;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.like-button.liked {
  color: #f5413d;
  border-color: #f5413d;
}

.answer {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.answer:last-child {
  border-bottom: none;
}

.answer-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.article-meta {
  margin-top: 8rpx;
}

.tip {
  margin: 0 24rpx;
}
