.intro {
  margin: 16rpx 0 24rpx;
  line-height: 1.7;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #5c6068;
  font-size: 26rpx;
}

.input {
  height: 84rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  font-size: 28rpx;
}

.action {
  margin-top: 24rpx;
}

.button-ghost {
  margin-top: 16rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #5c6068;
  border: 1rpx solid #dcdfe6;
  font-size: 30rpx;
}

.link-line {
  margin-top: 16rpx;
  color: #1a73e8;
  font-size: 26rpx;
}
