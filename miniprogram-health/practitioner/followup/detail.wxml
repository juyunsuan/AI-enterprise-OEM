<view class="page" wx:if="{{task}}">
  <view class="card">
    <view class="item-head">
      <view class="title">{{task.title}}</view>
      <text class="tag">{{task.statusLabel}}</text>
    </view>
    <view class="item-meta">
      {{task.patientName}}{{task.patientAge ? ' · ' + task.patientAge + ' 岁' : ''}} · 截止 {{task.dueText}}
    </view>
    <view class="item-meta" wx:if="{{task.patientPhoneMasked}}">联系电话 {{task.patientPhoneMasked}}</view>
    <view class="detail-text" wx:if="{{task.content}}">{{task.content}}</view>
    <view class="item-meta" wx:if="{{task.doneText}}">完成于 {{task.doneText}}</view>
    <view class="item-meta" wx:if="{{task.resultSummary}}">结果：{{task.resultSummary}}</view>
  </view>

  <view class="card" wx:if="{{task.status === 'PENDING' || task.status === 'OVERDUE'}}">
    <view class="title">随访记录</view>
    <textarea
      class="textarea"
      maxlength="500"
      placeholder="填写症状变化、用药情况、生活状态等"
      value="{{conclusion}}"
      bindinput="onConclusion"
    ></textarea>

    <view class="line" bindtap="onToggleMetric">
      <text class="link">{{showMetric ? '取消记录指标' : '＋ 同时记录指标'}}</text>
    </view>
    <view class="metric-row" wx:if="{{showMetric}}">
      <picker
        class="metric-picker"
        mode="selector"
        range="{{metricNames}}"
        value="{{metricIndex}}"
        bindchange="onPickMetric"
      >
        <view class="picker-field">{{metricNames[metricIndex] || '选择指标'}}</view>
      </picker>
      <input
        class="input metric-input"
        type="digit"
        placeholder="数值"
        value="{{metricValue}}"
        bindinput="onMetricValue"
      />
    </view>

    <view class="field" wx:if="{{!showMetric}}">
      <view class="field-label">下次随访（选填）</view>
      <picker mode="date" value="{{nextAt}}" bindchange="onNextAt">
        <view class="picker-field">{{nextAt || '不安排下次随访'}}</view>
      </picker>
    </view>

    <button class="button-primary" disabled="{{submitting}}" bindtap="onDone">
      {{submitting ? '提交中…' : '完成随访'}}
    </button>
    <button class="button-ghost" disabled="{{submitting}}" bindtap="onSkip">跳过该任务</button>
  </view>

  <view class="card">
    <view class="title">历史记录</view>
    <view class="list-item" wx:for="{{records}}" wx:key="id">
      <view class="item-head">
        <view class="item-title">{{item.operatorName || '医护'}}</view>
        <text class="muted">{{item.timeText}}</text>
      </view>
      <view class="item-meta" wx:if="{{item.note}}">{{item.note}}</view>
      <view class="item-meta" wx:if="{{item.metricsText}}">指标：{{item.metricsText}}</view>
    </view>
    <view class="muted" wx:if="{{!records.length}}">还没有执行记录</view>
  </view>
</view>

<view class="empty" wx:elif="{{!loading}}">随访任务不存在或不属于你</view>
<view class="empty" wx:else>正在加载…</view>
