<view class="page">
  <view class="tabs">
    <view
      class="tab {{status === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTab"
    >{{item.label}}</view>
  </view>

  <view class="card" wx:if="{{list.length}}">
    <view
      class="list-item"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTask"
    >
      <view class="item-head">
        <view class="item-title">{{item.title}}</view>
        <text class="tag {{item.status}}">{{item.statusLabel}}</text>
      </view>
      <view class="item-meta">{{item.patientName}} · {{item.sourceLabel}} · 截止 {{item.dueText}}</view>
      <view class="item-meta" wx:if="{{item.content}}">{{item.content}}</view>
      <view class="item-meta" wx:if="{{item.resultSummary}}">结果：{{item.resultSummary}}</view>
    </view>
  </view>

  <view class="empty" wx:elif="{{!loading}}">暂无该状态的随访任务</view>
  <view class="empty" wx:else>正在加载…</view>
</view>
