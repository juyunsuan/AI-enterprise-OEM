.tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #eef3ff;
  color: #2b5bd7;
  font-size: 22rpx;
}

.detail-text {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  color: #5c6068;
  font-size: 26rpx;
  line-height: 1.7;
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 200rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  font-size: 28rpx;
}

.line {
  padding: 20rpx 0;
}

.metric-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.metric-picker {
  flex: 1;
  margin-right: 16rpx;
}

.picker-field,
.input {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  font-size: 28rpx;
}

.metric-input {
  width: 180rpx;
}

.field {
  margin-top: 20rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #5c6068;
  font-size: 26rpx;
}

.button-primary {
  margin-top: 32rpx;
}

.button-ghost {
  margin-top: 16rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #8a8f99;
  border: 1rpx solid #dcdfe6;
  font-size: 28rpx;
}
