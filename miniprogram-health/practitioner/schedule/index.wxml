<view class="page">
  <view class="card" wx:for="{{list}}" wx:key="date">
    <view class="item-head">
      <view class="title">{{item.dayLabel}} · {{item.date}}</view>
      <text class="muted">{{item.shifts.length}} 个班次</text>
    </view>
    <view class="item-meta" wx:if="{{item.shiftsText}}">班次：{{item.shiftsText}}</view>
    <view class="slot-grid">
      <view
        class="slot {{slot.status}}"
        wx:for="{{item.slots}}"
        wx:for-item="slot"
        wx:key="id"
        data-id="{{slot.id}}"
        data-status="{{slot.status}}"
        bindtap="onSlot"
      >
        <view class="slot-time">{{slot.text}}</view>
        <view class="slot-state">{{slot.statusLabel}}</view>
      </view>
    </view>
    <view class="muted" wx:if="{{!item.slots.length}}">该日没有切分号源</view>
  </view>

  <view class="empty" wx:if="{{!list.length && !loading}}">未来两周没有排班</view>
  <view class="empty" wx:if="{{loading}}">正在加载…</view>
  <view class="notice card" wx:if="{{list.length}}">点号源可停诊/恢复；已被预约的号源不能停诊。</view>
</view>
