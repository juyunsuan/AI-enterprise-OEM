.input {
  height: 88rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  font-size: 28rpx;
}

.code-input {
  margin-top: 24rpx;
  letter-spacing: 2rpx;
}

.actions {
  display: flex;
  margin-top: 24rpx;
}

.half {
  flex: 1;
}

.button-ghost {
  margin-right: 16rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #1a73e8;
  border: 1rpx solid #c9d9f7;
  font-size: 30rpx;
}

.success {
  margin-bottom: 16rpx;
  text-align: center;
  color: #1a9b5c;
  font-size: 34rpx;
  font-weight: 600;
}
