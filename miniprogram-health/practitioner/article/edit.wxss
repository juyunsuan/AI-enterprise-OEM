.field {
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #5c6068;
  font-size: 26rpx;
}

.required {
  color: #f5413d;
}

.input,
.picker-field {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 400rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  font-size: 28rpx;
}

.button-primary {
  margin-top: 32rpx;
}
