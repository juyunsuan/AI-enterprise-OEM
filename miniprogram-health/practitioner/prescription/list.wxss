.tabs {
  display: flex;
  padding: 0 24rpx;
  background: #fff;
}

.tab {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  color: #5c6068;
  font-size: 28rpx;
  border-bottom: 4rpx solid transparent;
}

.tab.active {
  color: #1a73e8;
  font-weight: 600;
  border-bottom-color: #1a73e8;
}

.tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #eef3ff;
  color: #2b5bd7;
  font-size: 22rpx;
}

.tag.PHARMACY_APPROVED {
  background: #eaf7ef;
  color: #1a9b5c;
}

.tag.PHARMACY_REJECTED {
  background: #fdecec;
  color: #f5413d;
}

.actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.mini {
  margin: 0 0 0 16rpx;
  padding: 0 32rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.approve {
  background: #1a73e8;
  color: #fff;
}

.reject {
  background: #fff;
  color: #f5413d;
  border: 1rpx solid #f5b5b3;
}
