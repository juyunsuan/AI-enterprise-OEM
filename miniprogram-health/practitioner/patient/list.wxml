<view class="page">
  <view class="search">
    <input
      class="search-input"
      placeholder="搜索姓名或手机号"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onKeyword"
      bindconfirm="onSearch"
    />
    <text class="search-btn" bindtap="onSearch">搜索</text>
  </view>

  <view class="card" wx:if="{{list.length}}">
    <view class="muted total">共 {{total}} 位就诊人</view>
    <view
      class="list-item"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onPatient"
    >
      <view class="item-head">
        <view class="item-title">{{item.name}}</view>
        <text class="tag">{{item.gender || '未填'}} · {{item.age || '—'}} 岁</text>
      </view>
      <view class="item-meta">
        手机 {{item.phoneMasked || '未留'}}{{item.bloodType ? ' · ' + item.bloodType + '型' : ''}}
      </view>
      <view class="item-meta" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
    </view>
  </view>

  <view class="empty" wx:elif="{{!loading}}">还没有分配给你的就诊人；顾客下单或店主分配后会出现在这里</view>
  <view class="empty" wx:else>正在加载…</view>
</view>
