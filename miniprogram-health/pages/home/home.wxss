/* 首页：品牌区 + 入口宫格 + 推荐位。只用系统色板，避免店主换主题色后出现花屏。 */

.home {
  padding-bottom: 24rpx;
}

.state-card {
  margin-top: 120rpx;
  text-align: center;
}

.state-title {
  font-size: 34rpx;
  font-weight: 600;
}

.state-reason {
  margin-top: 16rpx;
  color: #8a8f99;
  font-size: 26rpx;
  line-height: 1.6;
}

.state-btn {
  margin-top: 32rpx;
}

.state-phone {
  margin-top: 24rpx;
  color: #1a73e8;
  font-size: 26rpx;
}

/* 品牌 */
.hero {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx 8rpx;
}

.hero-logo {
  width: 112rpx;
  height: 112rpx;
  margin-right: 24rpx;
  border-radius: 24rpx;
  background: #eef3ff;
}

.hero-text {
  flex: 1;
  min-width: 0;
}

.hero-name {
  font-size: 36rpx;
  font-weight: 600;
}

.hero-slogan,
.hero-city {
  margin-top: 6rpx;
  color: #5c6068;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hero-city {
  color: #8a8f99;
}

/* 搜索 */
.search-bar {
  padding: 16rpx 24rpx 8rpx;
}

.search-input {
  padding: 18rpx 28rpx;
  background: #fff;
  border-radius: 36rpx;
  color: #8a8f99;
  font-size: 26rpx;
}

/* 轮播 */
.banner {
  height: 300rpx;
  margin: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 热搜词 */
.keywords {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx 8rpx;
}

.keyword {
  margin: 0 16rpx 16rpx 0;
}

/* 服务入口宫格 */
.entries-card {
  padding: 8rpx 8rpx 16rpx;
}

.entry {
  width: 25%;
  padding: 18rpx 4rpx;
}

.entry-badge {
  width: 84rpx;
  height: 84rpx;
  margin: 0 auto;
  border-radius: 22rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 84rpx;
  text-align: center;
}

.entry-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.tone-0 {
  background: #eef3ff;
  color: #1a73e8;
}

.tone-1 {
  background: #e8f8ef;
  color: #12a150;
}

.tone-2 {
  background: #fff3e0;
  color: #c56a00;
}

.tone-3 {
  background: #fdecec;
  color: #d93026;
}

.tone-4 {
  background: #f2ebff;
  color: #7048c6;
}

.tone-5 {
  background: #e6f6fa;
  color: #1286a3;
}

.tone-6 {
  background: #fdf0f7;
  color: #c2377f;
}

.tone-7 {
  background: #eef0f3;
  color: #4a5059;
}

/* 快捷动作 */
.quick-card {
  display: flex;
  padding: 8rpx 0;
}

.quick {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  border-right: 1rpx solid #f0f1f5;
}

.quick:last-child {
  border-right: none;
}

.quick-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.quick-label {
  margin-top: 4rpx;
  color: #8a8f99;
  font-size: 22rpx;
}

/* 公告 */
.notice-card {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.notice-badge {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
  background: #fff3e0;
  color: #c56a00;
  font-size: 22rpx;
}

.notice-swiper {
  flex: 1;
  height: 72rpx;
}

.notice-line {
  height: 72rpx;
  line-height: 72rpx;
  color: #5c6068;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 区块 */
.section {
  margin-top: 8rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 0;
}

.section-card {
  padding: 0 24rpx;
}

/* 服务 */
.service {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.service:last-child {
  border-bottom: none;
}

.service-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.service-name {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.service-meta {
  margin-top: 8rpx;
}

.service-price {
  margin-top: 10rpx;
}

.origin {
  margin-left: 12rpx;
  color: #a6abb3;
  font-size: 22rpx;
  text-decoration: line-through;
}

/* 医护 */
.doctor-scroll {
  white-space: nowrap;
  padding: 20rpx 0 8rpx;
}

.doctor {
  display: inline-block;
  width: 216rpx;
  margin-left: 24rpx;
  padding: 24rpx 12rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
  vertical-align: top;
}

.doctor:last-child {
  margin-right: 24rpx;
}

.doctor-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #f0f1f5;
}

.doctor-avatar-empty {
  margin: 0 auto;
}

.doctor-name {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.doctor-title {
  margin-top: 4rpx;
  color: #8a8f99;
  font-size: 22rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.doctor-score {
  margin-top: 4rpx;
  color: #c56a00;
  font-size: 22rpx;
}

/* 问诊方式 */
.consult-card {
  display: flex;
  padding: 8rpx 0;
}

.consult-way {
  flex: 1;
  padding: 20rpx 8rpx;
  text-align: center;
}

.consult-label {
  color: #1a73e8;
  font-size: 28rpx;
  font-weight: 600;
}

.consult-desc {
  margin-top: 6rpx;
  color: #8a8f99;
  font-size: 20rpx;
  line-height: 1.5;
}

/* 文章 */
.article {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.article:last-child {
  border-bottom: none;
}

.article-body {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.article-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-summary {
  margin-top: 8rpx;
  color: #5c6068;
  font-size: 24rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-cover {
  width: 180rpx;
  height: 132rpx;
  border-radius: 12rpx;
  background: #f0f1f5;
  flex-shrink: 0;
}

/* 页脚 */
.home-footer {
  padding: 40rpx 24rpx 24rpx;
  text-align: center;
}

.footer-phone {
  display: inline-block;
  padding: 14rpx 40rpx;
  border: 1rpx solid #dcdfe6;
  border-radius: 36rpx;
  color: #1a73e8;
  font-size: 26rpx;
}

.footer-brand {
  margin-top: 20rpx;
  color: #a6abb3;
  font-size: 22rpx;
}

.footer-tip {
  margin-top: 8rpx;
  color: #c56a00;
  font-size: 22rpx;
  line-height: 1.6;
}
