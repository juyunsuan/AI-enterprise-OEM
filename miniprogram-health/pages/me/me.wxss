.me {
  padding-bottom: 40rpx;
}

.profile {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx 24rpx;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: #e5e9f2;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
}

.profile-meta {
  margin-top: 8rpx;
  color: #8a8f99;
  font-size: 24rpx;
}

.stats {
  display: flex;
  padding: 24rpx 0;
}

.stat {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #f0f1f5;
}

.stat:last-child {
  border-right: none;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
}

.stat-label {
  margin-top: 6rpx;
  color: #8a8f99;
  font-size: 22rpx;
}

.entries {
  padding: 16rpx 8rpx;
}

.cell-badge {
  width: 100%;
  padding: 26rpx 0;
  border-radius: 12rpx;
  background: #f7f8fa;
  color: #3d434b;
  font-size: 26rpx;
  text-align: center;
}

.grants-title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.grant {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.grant:last-child {
  border-bottom: none;
}

.grant-code {
  font-size: 34rpx;
  letter-spacing: 4rpx;
  font-weight: 600;
  color: #1a73e8;
}

.rows {
  padding: 4rpx 24rpx;
}

.row-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
  font-size: 28rpx;
}

.row-item:last-child {
  border-bottom: none;
}

.row-arrow {
  color: #c4c8d0;
  font-size: 34rpx;
}

.me-footer {
  padding: 24rpx;
  text-align: center;
}

.logout {
  padding: 24rpx;
  color: #d93026;
  font-size: 28rpx;
}

.footer-tip {
  margin-top: 16rpx;
  color: #a6abb3;
  font-size: 22rpx;
  line-height: 1.6;
}

.guest {
  margin-top: 120rpx;
  text-align: center;
}

.guest-title {
  font-size: 34rpx;
  font-weight: 600;
}

.guest-desc {
  margin: 16rpx 0 32rpx;
  color: #8a8f99;
  font-size: 26rpx;
  line-height: 1.6;
}

.guest-link {
  margin-top: 24rpx;
  color: #1a73e8;
  font-size: 24rpx;
}
