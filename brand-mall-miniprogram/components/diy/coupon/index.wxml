<view class="diy-coupon" wx:if="{{items.length}}">
  <view class="grid {{isTwo ? 'two' : 'one'}}">
    <view class="ticket" wx:for="{{items}}" wx:key="id">
      <view class="left">
        <text class="value">{{item.valueText}}</text>
        <text class="rule ellipsis">{{item.ruleText}}</text>
      </view>
      <view class="main">
        <text class="name ellipsis">{{item.name}}</text>
        <text class="muted">领取后可在「我的券包」查看</text>
      </view>
      <view
        class="btn {{item.received ? 'done' : ''}}"
        style="{{item.received ? '' : 'background:' + themeColor}}"
        data-index="{{index}}"
        bindtap="onReceive"
      >
        {{item.received ? '已领' : '领取'}}
      </view>
    </view>
  </view>
  <view class="more" bindtap="goCenter">领券中心 ›</view>
</view>
