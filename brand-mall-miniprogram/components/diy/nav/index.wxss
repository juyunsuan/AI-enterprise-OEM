.diy-nav {
  padding: 24rpx;
  box-sizing: border-box;
}

.wrap {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.icon {
  width: 88rpx;
  height: 88rpx;
}

.icon-empty {
  border-radius: 50%;
  background: #f4f5f7;
}

.text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #333;
  max-width: 96%;
  text-align: center;
}
