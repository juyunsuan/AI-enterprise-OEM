.diy-goods-list {
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.card {
  padding: 0 8rpx 16rpx;
  box-sizing: border-box;
}

.pic {
  width: 100%;
  height: 340rpx;
  border-radius: 12rpx;
  background: #f4f5f7;
  display: block;
}

.body {
  padding: 12rpx 16rpx 16rpx;
}

.card-title,
.row-title {
  font-size: 28rpx;
  color: #1f1f1f;
  line-height: 40rpx;
}

.card-sub,
.row-sub {
  font-size: 24rpx;
  color: #9aa0aa;
  margin-top: 4rpx;
}

.card-foot,
.row-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 10rpx;
}

.price {
  color: #fa3534;
  font-size: 30rpx;
  font-weight: 600;
}

.sales {
  color: #b0b5bd;
  font-size: 22rpx;
}

.row-item {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border: 1rpx solid #eeeeee;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.row-pic {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
  background: #f4f5f7;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.row-main {
  flex: 1;
  min-width: 0;
}
