.diy-category-line {
  width: 100%;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.list {
  display: flex;
}

.item {
  width: 110rpx;
  margin-right: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.pic {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #f4f5f7;
}

.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #adb2bb;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.name {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #666;
  max-width: 110rpx;
  text-align: center;
}
