.diy-store-head {
  padding: 36rpx 24rpx;
  background: linear-gradient(180deg, rgba(250, 53, 52, 0.08) 0%, #ffffff 100%);
  box-sizing: border-box;
}

.head {
  display: flex;
  align-items: center;
}

.logo {
  width: 104rpx;
  height: 104rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f1f1f;
}

.slogan {
  font-size: 24rpx;
  color: #7b8089;
  margin-top: 6rpx;
}

.phone {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #5c626b;
}

.phone-icon {
  margin-right: 10rpx;
  padding: 0 12rpx;
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 8rpx;
  background: rgba(250, 53, 52, 0.1);
  color: #fa3534;
  font-size: 20rpx;
}
