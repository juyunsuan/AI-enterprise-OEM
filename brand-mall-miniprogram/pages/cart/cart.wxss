.cart-page {
  min-height: 100vh;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.topbar {
  padding: 8rpx 0 16rpx;
}

.row-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.link {
  color: #fa3534;
  font-size: 24rpx;
}

.goods {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 1rpx solid #d0d3d9;
  color: #fff;
  font-size: 26rpx;
  text-align: center;
  line-height: 44rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.check.small {
  margin-right: 12rpx;
}

.check.on {
  background: #fa3534;
  border-color: #fa3534;
}

.check.dis {
  background: #f2f3f5;
}

.pic {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f4f5f7;
  flex-shrink: 0;
}

.info {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.title {
  font-size: 28rpx;
  line-height: 40rpx;
}

.sku {
  margin-top: 6rpx;
}

.invalid {
  display: inline-block;
  margin-top: 6rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #8a8f99;
  font-size: 20rpx;
}

.foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.price {
  color: #fa3534;
  font-size: 30rpx;
  font-weight: 600;
}

.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #eaecef;
  border-radius: 8rpx;
  overflow: hidden;
}

.step {
  width: 56rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #f7f8fa;
  font-size: 28rpx;
}

.num {
  width: 68rpx;
  text-align: center;
  font-size: 26rpx;
}

.muted {
  color: #8a8f99;
  font-size: 22rpx;
}

.empty {
  padding: 140rpx 24rpx;
  text-align: center;
  color: #8a8f99;
  font-size: 26rpx;
}

.empty-btn {
  margin-top: 24rpx;
  display: inline-flex;
  height: 68rpx;
  padding: 0 32rpx;
  align-items: center;
  border-radius: 999rpx;
  background: #fa3534;
  color: #fff;
  font-size: 26rpx;
}

.footer-gap {
  height: 130rpx;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  display: flex;
  align-items: center;
  background: #fff;
  border-top: 1rpx solid #eaecef;
  padding: 0 24rpx;
  box-sizing: border-box;
  z-index: 20;
}

.bar-left {
  display: flex;
  align-items: center;
}

.bar-all {
  font-size: 24rpx;
  color: #4d5159;
}

.bar-total {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  margin-right: 16rpx;
}

.bar-price {
  margin-left: 10rpx;
  color: #fa3534;
  font-size: 34rpx;
  font-weight: 600;
}

.bar-btn {
  min-width: 200rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #fa3534;
  color: #fff;
  font-size: 26rpx;
  padding: 0 20rpx;
}

.bar-btn.dis {
  background: #d8d8d8;
}
