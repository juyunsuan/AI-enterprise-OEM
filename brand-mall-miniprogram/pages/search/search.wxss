.bar { display: flex; align-items: center; padding: 20rpx; background: #fff; }
.bar .field-input { flex: 1; height: 68rpx; background: #f2f3f5; border-radius: 34rpx; padding: 0 24rpx; font-size: 28rpx; }
.go { width: 110rpx; text-align: center; color: #fa3534; font-size: 28rpx; }
.head { padding: 20rpx 20rpx 8rpx; }
.words { display: flex; flex-wrap: wrap; padding: 12rpx 20rpx 20rpx; }
.word { background: #f2f3f5; border-radius: 24rpx; padding: 10rpx 24rpx; margin: 8rpx 12rpx 0 0; font-size: 26rpx; }
.goods { display: flex; background: #fff; padding: 20rpx; }
.thumb { width: 180rpx; height: 180rpx; border-radius: 12rpx; background: #f2f3f5; }
.info { flex: 1; margin-left: 20rpx; min-width: 0; }
.title { font-size: 28rpx; }
