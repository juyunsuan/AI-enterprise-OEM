<view class="page">
  <view class="bar">
    <input class="field-input" value="{{keyword}}" placeholder="搜索商品名称" confirm-type="search" bindinput="onInput" bindconfirm="search" />
    <view class="go" bindtap="search">搜索</view>
  </view>

  <block wx:if="{{!searched}}">
    <view class="card" wx:if="{{history.length}}">
      <view class="row between head">
        <text>搜索历史</text>
        <text class="muted" bindtap="clearHistory">清空</text>
      </view>
      <view class="words">
        <text class="word" wx:for="{{history}}" wx:key="*this" data-keyword="{{item}}" bindtap="useHistory">{{item}}</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="goods" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <image class="thumb" src="{{item.image}}" mode="aspectFill" />
      <view class="info">
        <view class="title ellipsis">{{item.title}}</view>
        <view class="muted ellipsis">{{item.subtitle}}</view>
        <view class="row between">
          <text class="price">{{item.priceText}}</text>
          <text class="muted">{{item.salesText}}</text>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{loading}}">搜索中…</view>
    <view class="empty" wx:elif="{{!items.length}}">没有找到相关商品</view>
    <view class="empty" wx:elif="{{!hasMore}}">没有更多了</view>
  </block>
</view>
