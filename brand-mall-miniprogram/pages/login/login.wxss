.center { display: flex; flex-direction: column; align-items: center; padding: 120rpx 48rpx; }
.title { font-size: 40rpx; font-weight: 600; }
.tip { margin-top: 16rpx; font-size: 26rpx; }
.card { width: 100%; margin-top: 32rpx; padding: 24rpx; border-radius: 16rpx; font-size: 26rpx; line-height: 1.6; }
.warn { background: #fff7e6; color: #8a5a00; }
.error { background: #fff1f0; color: #a8071a; }
.main { margin-top: 48rpx; width: 100%; }
.link { margin-top: 28rpx; font-size: 26rpx; }
