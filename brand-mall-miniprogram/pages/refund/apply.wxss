.apply-page {
  min-height: 100vh;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.item-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eaecef;
}

.item-row:last-child {
  border-bottom: none;
}

.item-row.on .radio {
  background: #fa3534;
  border-color: #fa3534;
  color: #fff;
}

.pic {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f4f5f7;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  line-height: 38rpx;
}

.radio {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 50%;
  border: 1rpx solid #d0d3d9;
  text-align: center;
  color: #fff;
  font-size: 22rpx;
  flex-shrink: 0;
}

.types {
  display: flex;
}

.type {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border: 1rpx solid #eaecef;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #4d5159;
  margin-right: 16rpx;
}

.type:last-child {
  margin-right: 0;
}

.type.on {
  border-color: #fa3534;
  color: #fa3534;
  background: rgba(250, 53, 52, 0.06);
}

.reasons {
  display: flex;
  flex-wrap: wrap;
}

.reason {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #4d5159;
  font-size: 24rpx;
  margin: 0 16rpx 16rpx 0;
}

.reason.on {
  background: rgba(250, 53, 52, 0.1);
  color: #fa3534;
}

.cell {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eaecef;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.cell-label {
  width: 150rpx;
  color: #4d5159;
}

.cell-input {
  flex: 1;
  text-align: right;
  margin-right: 16rpx;
  font-size: 28rpx;
}

.field-label {
  font-size: 26rpx;
  color: #4d5159;
  margin-bottom: 12rpx;
}

.desc {
  width: 100%;
  height: 160rpx;
  padding: 16rpx;
  border: 1rpx solid #eaecef;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  background: #fbfbfc;
}

.muted {
  color: #8a8f99;
  font-size: 22rpx;
}

.footer-gap {
  height: 130rpx;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 1rpx solid #eaecef;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.bar-main {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #fa3534;
  color: #fff;
  font-size: 28rpx;
}

.bar-main.dis {
  opacity: 0.6;
}

.empty {
  padding: 140rpx 24rpx;
  text-align: center;
  color: #8a8f99;
  font-size: 26rpx;
}

.link {
  margin-top: 16rpx;
  color: #fa3534;
  font-size: 24rpx;
}

.thumbs {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.thumb {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f3f4f6;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-del {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(17, 24, 39, 0.6);
  color: #ffffff;
  font-size: 28rpx;
}

.thumb-add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #d1d5db;
  color: #9ca3af;
  font-size: 48rpx;
  box-sizing: border-box;
}
