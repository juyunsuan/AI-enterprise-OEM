.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f5f6f8;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
}

.info {
  border-top: 6rpx solid #fa3534;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 12rpx;
}

.muted {
  color: #8a8f99;
  font-size: 26rpx;
}

.small {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.hint {
  line-height: 1.6;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.contact-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.contact-value {
  font-size: 28rpx;
  color: #222;
  margin-right: 12rpx;
}

.link {
  color: #fa3534;
  font-size: 26rpx;
  padding: 0 8rpx;
}

.order-no {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin: 12rpx 0 8rpx;
  word-break: break-all;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  font-size: 26rpx;
}

.btn-ghost {
  border: 1rpx solid #dcdfe6;
  color: #333;
}
