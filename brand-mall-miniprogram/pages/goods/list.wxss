.list-page {
  min-height: 100vh;
  background: #f5f6f8;
}

.sort-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #eaecef;
}

.sort-item {
  padding: 24rpx 20rpx;
  font-size: 26rpx;
  color: #4d5159;
}

.sort-item.on {
  color: #fa3534;
  font-weight: 600;
}

.sort-total {
  margin-left: auto;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.card {
  width: 50%;
  padding: 12rpx;
  box-sizing: border-box;
}

.pic {
  width: 100%;
  height: 340rpx;
  border-radius: 12rpx;
  background: #f4f5f7;
  display: block;
}

.body {
  background: #fff;
  border-radius: 0 0 12rpx 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.title {
  font-size: 28rpx;
  line-height: 40rpx;
  height: 80rpx;
}

.subtitle {
  font-size: 22rpx;
  color: #9aa0aa;
  margin-top: 6rpx;
}

.tags {
  margin-top: 8rpx;
}

.tag {
  display: inline-block;
  margin-right: 8rpx;
  padding: 0 12rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 999rpx;
  background: rgba(250, 53, 52, 0.1);
  color: #fa3534;
  font-size: 20rpx;
}

.foot {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
}

.price {
  color: #fa3534;
  font-size: 32rpx;
  font-weight: 600;
}

.origin {
  margin-left: 10rpx;
  color: #b0b5bd;
  font-size: 22rpx;
  text-decoration: line-through;
}

.meta {
  margin-top: 6rpx;
  color: #b0b5bd;
  font-size: 22rpx;
}

.muted {
  color: #8a8f99;
  font-size: 22rpx;
}

.empty {
  padding: 140rpx 24rpx;
  text-align: center;
  color: #8a8f99;
  font-size: 26rpx;
}

.empty-sub {
  margin-top: 16rpx;
  color: #fa3534;
  font-size: 24rpx;
}

.loading {
  text-align: center;
  color: #adb2bb;
  font-size: 22rpx;
  padding: 24rpx 0;
}

.footer-gap {
  height: 40rpx;
}
