.detail-page {
  min-height: 100vh;
  background: #f5f6f8;
}

.gallery {
  width: 100%;
  height: 750rpx;
  background: #f4f5f7;
}

.gallery-pic {
  width: 100%;
  height: 100%;
}

.block {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  align-items: baseline;
}

.price {
  color: #fa3534;
  font-weight: 600;
  font-size: 34rpx;
}

.price-lg {
  font-size: 44rpx;
}

.origin {
  margin-left: 14rpx;
  color: #b0b5bd;
  font-size: 24rpx;
  text-decoration: line-through;
}

.sales {
  margin-left: auto;
  color: #b0b5bd;
  font-size: 22rpx;
}

.title {
  margin-top: 12rpx;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 6rpx;
  color: #7b8089;
  font-size: 24rpx;
}

.tags {
  margin-top: 12rpx;
}

.tag {
  display: inline-block;
  margin-right: 10rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(250, 53, 52, 0.08);
  color: #fa3534;
  font-size: 20rpx;
}

.label {
  font-size: 26rpx;
  color: #4d5159;
}

.value {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #1f1f1f;
}

.sku-row .value {
  color: #fa3534;
}

.review-head,
.sku-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sku-row {
  justify-content: flex-start;
}

.sku-row .value {
  flex: 1;
  margin: 0 12rpx;
}

.arrow {
  color: #8a8f99;
}

.review-top {
  display: flex;
  align-items: center;
}

.review-name {
  font-size: 26rpx;
  color: #1f1f1f;
}

.review-stars {
  margin-left: 16rpx;
  color: #ff9900;
  font-size: 22rpx;
}

.review-date {
  margin-left: auto;
}

.review-text {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 38rpx;
}

.muted {
  color: #8a8f99;
  font-size: 24rpx;
}

.rich {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
  word-break: break-all;
}

.footer-gap {
  height: 120rpx;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  height: 100rpx;
  background: #fff;
  border-top: 1rpx solid #eaecef;
  z-index: 20;
}

.bar-icon {
  width: 120rpx;
  text-align: center;
  font-size: 22rpx;
  color: #4d5159;
}

.bar-btn {
  flex: 1;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
}

.bar-btn.add {
  background: #ff9900;
}

.bar-btn.buy {
  background: #fa3534;
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 30;
}

.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 78vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx;
  box-sizing: border-box;
}

.sku-head {
  display: flex;
  align-items: flex-start;
  border-bottom: 1rpx solid #eaecef;
  padding-bottom: 20rpx;
}

.sku-pic {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f4f5f7;
  margin-top: -60rpx;
}

.sku-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.sku-close {
  font-size: 40rpx;
  color: #adb2bb;
  line-height: 40rpx;
  padding: 0 8rpx;
}

.spec {
  margin-top: 28rpx;
}

.spec-name {
  font-size: 26rpx;
  color: #4d5159;
  margin-bottom: 14rpx;
}

.spec-values {
  display: flex;
  flex-wrap: wrap;
}

.spec-value {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #1f2329;
  font-size: 24rpx;
  margin: 0 16rpx 16rpx 0;
}

.spec-value.on {
  background: rgba(250, 53, 52, 0.1);
  color: #fa3534;
  border: 1rpx solid #fa3534;
}

.spec-value.dis {
  opacity: 0.45;
}

.sold-out {
  font-size: 20rpx;
  color: #b0b5bd;
  margin-left: 4rpx;
}

.qty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #eaecef;
  border-radius: 8rpx;
  overflow: hidden;
}

.step {
  width: 64rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #f7f8fa;
  color: #1f2329;
  font-size: 30rpx;
}

.qty-num {
  width: 80rpx;
  text-align: center;
  font-size: 26rpx;
}

.sku-confirm {
  margin-top: 32rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #ff9900;
  color: #fff;
  font-size: 28rpx;
}

.sku-confirm.buy {
  background: #fa3534;
}

.empty {
  padding: 140rpx 24rpx;
  text-align: center;
  color: #8a8f99;
  font-size: 26rpx;
}
