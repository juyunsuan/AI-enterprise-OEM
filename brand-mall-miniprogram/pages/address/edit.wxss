.addr-edit {
  min-height: 100vh;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.field {
  margin-bottom: 24rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 24rpx;
  color: #8a8f99;
  margin-bottom: 10rpx;
}

.input,
.textarea,
.picker {
  width: 100%;
  border: 1rpx solid #eaecef;
  border-radius: 12rpx;
  background: #fbfbfc;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input {
  height: 80rpx;
  padding: 0 20rpx;
}

.textarea {
  min-height: 150rpx;
  padding: 20rpx;
}

.picker {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  color: #1f2329;
}

.tags {
  display: flex;
  margin-bottom: 8rpx;
}

.tag {
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #4d5159;
  font-size: 24rpx;
  margin-right: 16rpx;
}

.tag.on {
  background: rgba(250, 53, 52, 0.1);
  color: #fa3534;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  font-size: 28rpx;
}

.footer-gap {
  height: 130rpx;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-top: 1rpx solid #eaecef;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.op {
  width: 180rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  border: 1rpx solid #ffc9c9;
  color: #fa3534;
  font-size: 28rpx;
}

.submit {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #fa3534;
  color: #fff;
  font-size: 28rpx;
}

.submit.dis {
  opacity: 0.6;
}
