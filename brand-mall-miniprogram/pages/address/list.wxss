.addr-page {
  min-height: 100vh;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.line {
  display: flex;
  align-items: center;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.phone {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #7b8089;
}

.tag {
  margin-left: 12rpx;
  padding: 0 12rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #4d5159;
  font-size: 20rpx;
}

.tag.default {
  background: rgba(250, 53, 52, 0.1);
  color: #fa3534;
}

.detail {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7b8089;
  line-height: 36rpx;
}

.ops {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eaecef;
}

.op {
  padding: 6rpx 22rpx;
  border: 1rpx solid #d0d3d9;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #4d5159;
  margin-left: 16rpx;
}

.op.danger {
  border-color: #ffc9c9;
  color: #fa3534;
}

.empty {
  padding: 140rpx 24rpx;
  text-align: center;
  color: #8a8f99;
  font-size: 26rpx;
}

.footer-gap {
  height: 130rpx;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 1rpx solid #eaecef;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.bar-btn {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #fa3534;
  color: #fff;
  font-size: 28rpx;
}
