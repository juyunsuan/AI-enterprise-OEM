<view class="order-list-page">
  <view class="tabs">
    <view
      class="tab {{status === item.key ? 'on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-status="{{item.key}}"
      bindtap="switchTab"
    >
      {{item.label}}
    </view>
  </view>

  <view class="order" wx:for="{{orders}}" wx:key="id">
    <view class="order-head" data-id="{{item.id}}" bindtap="openDetail">
      <text class="order-no">{{item.orderNo}}</text>
      <text class="order-status">{{item.statusLabel}}</text>
    </view>

    <view class="order-body" data-id="{{item.id}}" bindtap="openDetail">
      <view class="thumb-row" wx:if="{{item.thumbs.length}}">
        <image
          class="thumb"
          wx:for="{{item.thumbs}}"
          wx:for-item="thumb"
          wx:key="index"
          src="{{thumb.image}}"
          mode="aspectFill"
        />
        <view class="more muted" wx:if="{{item.itemCount > 3}}">共 {{item.itemCount}} 件</view>
      </view>
      <view class="order-line">
        <text class="summary ellipsis-2">{{item.summary}}</text>
        <text class="amount">¥{{item.payAmountText}}</text>
      </view>
      <view class="order-line muted">
        <text>{{item.createdAtText}}</text>
        <text wx:if="{{item.refundLabel}}" class="refund-tag">{{item.refundLabel}}</text>
      </view>
      <view class="order-line muted" wx:if="{{item.expireText}}">
        <text>剩余 {{item.expireText}} 自动取消</text>
      </view>
    </view>

    <view class="order-actions">
      <view class="act plain" data-id="{{item.id}}" bindtap="openDetail">订单详情</view>
      <view wx:if="{{item.status === 'PENDING_PAYMENT'}}" class="act plain" data-id="{{item.id}}" bindtap="cancel">取消</view>
      <view wx:if="{{item.status === 'PENDING_PAYMENT'}}" class="act main" data-id="{{item.id}}" bindtap="goPay">去支付</view>
      <view wx:if="{{item.status === 'SHIPPED'}}" class="act main" data-id="{{item.id}}" bindtap="receive">确认收货</view>
    </view>
  </view>

  <view class="empty" wx:if="{{!orders.length && !loading}}">
    <view>{{error || '还没有相关订单'}}</view>
    <view class="btn empty-btn" bindtap="goIndex">去逛逛</view>
  </view>
  <view class="loading" wx:if="{{loading}}">加载中…</view>
  <view class="loading" wx:elif="{{noMore && orders.length}}">没有更多订单了</view>
  <view class="footer-gap"></view>
</view>
