.detail-page {
  min-height: 100vh;
  padding-bottom: 130rpx;
  box-sizing: border-box;
}

.hero {
  background: #fa3534;
  color: #fff;
  padding: 40rpx 24rpx;
}

.hero-status {
  font-size: 36rpx;
  font-weight: 600;
}

.hero-tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.phone {
  font-size: 26rpx;
  color: #7b8089;
}

.addr {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7b8089;
  line-height: 36rpx;
}

.row-line {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.label {
  width: 150rpx;
  color: #4d5159;
  flex-shrink: 0;
}

.value {
  flex: 1;
  min-width: 0;
  color: #1f2329;
  text-align: right;
  word-break: break-all;
}

.link {
  color: #fa3534;
  font-size: 24rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.muted {
  color: #8a8f99;
  font-size: 22rpx;
}

.goods {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eaecef;
}

.goods:last-child {
  border-bottom: none;
}

.pic {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f4f5f7;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.goods-title {
  font-size: 28rpx;
  line-height: 40rpx;
}

.goods-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 8rpx;
}

.price {
  color: #fa3534;
  font-size: 28rpx;
  font-weight: 600;
}

.refund-row {
  margin-top: 10rpx;
}

.refund-btn {
  display: inline-block;
  margin-right: 16rpx;
  padding: 6rpx 20rpx;
  border: 1rpx solid #d0d3d9;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #4d5159;
}

.refund-state {
  font-size: 22rpx;
  color: #d98200;
}

.amounts .row-line {
  padding: 10rpx 0;
}

.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #4d5159;
}

.amount-row .minus {
  color: #fa3534;
}

.amount-row.total {
  border-top: 1rpx solid #eaecef;
  margin-top: 8rpx;
  padding-top: 16rpx;
  color: #1f2329;
}

.total-line {
  border-top: 1rpx solid #eaecef;
  margin-top: 8rpx;
  padding-top: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.refund-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eaecef;
}

.refund-item:last-child {
  border-bottom: none;
}

.log {
  display: flex;
  padding: 14rpx 0;
}

.log-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #fa3534;
  margin: 10rpx 16rpx 0 0;
  flex-shrink: 0;
}

.log-main {
  flex: 1;
  min-width: 0;
}

.log-title {
  font-size: 26rpx;
  color: #1f2329;
}

.log-text {
  font-size: 22rpx;
  color: #7b8089;
  margin-top: 4rpx;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  background: #fff;
  border-top: 1rpx solid #eaecef;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  z-index: 20;
}

.bar-plain,
.bar-main {
  min-width: 180rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.bar-plain {
  border: 1rpx solid #d0d3d9;
  color: #4d5159;
}

.bar-main {
  background: #fa3534;
  color: #fff;
}

.empty {
  padding: 140rpx 24rpx;
  text-align: center;
  color: #8a8f99;
  font-size: 26rpx;
}
