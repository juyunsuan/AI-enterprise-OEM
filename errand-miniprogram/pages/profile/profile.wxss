.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f2f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8f99;
  font-size: 24rpx;
}
.avatar image {
  width: 100%;
  height: 100%;
}
.field {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #eef0f3;
  border-radius: 14rpx;
  padding: 20rpx;
  margin: 20rpx 0 12rpx;
  background: #fafbfc;
}