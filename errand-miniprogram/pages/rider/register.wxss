.field {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #eef0f3;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-top: 16rpx;
  background: #fafbfc;
}
.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.picker {
  color: #1f6feb;
}
.check {
  display: block;
  margin-top: 16rpx;
}
.photos {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.photo {
  flex: 1;
  height: 180rpx;
  border: 1rpx dashed #d5d9e0;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8f99;
  font-size: 24rpx;
  overflow: hidden;
}
.photo image {
  width: 100%;
  height: 100%;
}