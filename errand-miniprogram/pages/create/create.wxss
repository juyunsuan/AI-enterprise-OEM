.tabline {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  color: #5c626b;
}
.tab.active {
  background: #1f6feb;
  color: #ffffff;
  font-weight: 600;
}
.field {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #eef0f3;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-top: 16rpx;
  background: #fafbfc;
}
.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.field-row:last-child {
  border-bottom: none;
}
.short {
  width: 180rpx;
  text-align: right;
  border: 1rpx solid #eef0f3;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  background: #fafbfc;
}
.link {
  color: #1f6feb;
  font-size: 26rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #5c626b;
  font-size: 26rpx;
}
.chip.active {
  background: #eef4ff;
  color: #1f6feb;
  border: 1rpx solid #1f6feb;
}
.picker {
  color: #1f6feb;
}
.fee-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  color: #5c626b;
}
.fee-total {
  display: flex;
  justify-content: space-between;
  padding-top: 18rpx;
  margin-top: 10rpx;
  border-top: 1rpx solid #f2f3f5;
  font-size: 34rpx;
  font-weight: 700;
}
.protocol-line {
  display: block;
  margin: 8rpx 4rpx 24rpx;
  font-size: 26rpx;
  color: #5c626b;
}
.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.photo {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.photo image {
  width: 100%;
  height: 100%;
}
.remove {
  position: absolute;
  right: 4rpx;
  top: 4rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 26rpx;
}
.submit {
  margin-bottom: 40rpx;
}