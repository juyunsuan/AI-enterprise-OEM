{
  "description": "同城跑腿小程序（账号负责人即小程序管理员；AppID 由店主在微信开发者工具自填）",
  "packOptions": {
    "ignore": [
      {
        "type": "file",
        "value": "project.private.config.json"
      },
      {
        "type": "folder",
        "value": ".DS_Store"
      }
    ]
  },
  "setting": {
    "urlCheck": true,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "bigPackageSizeSupport": false,
    "coverView": false,
    "packNpmManually": false,
    "packNpmRelationList": []
  },
  "compileType": "miniprogram",
  "libVersion": "3.5.5",
  "appid": "touristappid",
  "projectname": "errand-miniprogram",
  "srcMiniprogramRoot": "./",
  "miniprogramRoot": "./"
}
